  "entries": [
    {
      "uid": "scr.xfl::1001.gsc::slot/00001",
      "source_text": "ラプンツェル動作テスト。",
      "source_raw_sha256": "4801C0186D58C32E02A2ED05C2412244BBF2973F01C18891BFBF8DCE9039B9F5",
      "target_text": "라푼젤 동작 테스트.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 대기"
    },
    {
      "uid": "scr.xfl::1001.gsc::slot/00002",
      "source_text": "カットイン演出確認。",
      "source_raw_sha256": "544F1361FAF4E76D9AAA7F09C892B2FB880F5364EF60A03F26B530CC3AD108AD",
      "target_text": "컷인 연출 확인.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 대기"
    },
    {
      "uid": "scr.xfl::1001.gsc::slot/00003",
      "source_text": "そうなってみると、彼女の肩や腕はやっぱりな優しくたわやかで、^nこっちがひどい乱暴をした気分にさせられ、手を離した。",
      "source_raw_sha256": "20C87A51B488064DAD3D5B832721152294AFCF655C4094D4C677D7FBC5960A7F",
      "target_text": "막상 그렇게 되고 보니, 역시 그녀의 어깨와 팔은 부드럽고 유연해서,^n내가 몹시 난폭한 짓을 한 듯한 기분이 들어 손을 놓았다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 대기"
    },
    {
      "uid": "scr.xfl::1001.gsc::slot/00004",
      "source_text": "一時の突発的な衝動の嵐だったのか、^n彼女はそれ以上カンバスをどうこうするつもりはなさそうだった。",
      "source_raw_sha256": "23244AD9F6F58025AFA7F0DB36AA94E6C10706B007076A7F993AED162CAF2AFF",
      "target_text": "한때 불쑥 덮친 충동의 폭풍이었는지,^n그녀는 더 이상 캔버스를 어찌할 생각은 없어 보였다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 대기"
    },
    {
      "uid": "scr.xfl::1001.gsc::slot/00005",
      "source_text": "ラプンツェルカットイン配置テスト終了。",
      "source_raw_sha256": "FD634AC1B61644ABBE0BD4090D8EF3D72F461D3EC2887EF23368E0688B3A8DA6",
      "target_text": "라푼젤 컷인 배치 테스트 종료.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 대기"
    },
    {
      "uid": "scr.xfl::1001.gsc::slot/00006",
      "source_text": "ルートジャンプ画面演出テスト",
      "source_raw_sha256": "39B8E2A799479E059A2E3703F21A5AC2033A9CC3467785437C3D032982E10C7D",
      "target_text": "루트 점프 화면 연출 테스트",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 대기"
    },
    {
      "uid": "scr.xfl::1001.gsc::slot/00007",
      "source_text": "──まだ、自分はここにいるんだな。",
      "source_raw_sha256": "3FB3EFCA2B3113E5F14F7FFCEB8C3EF3F62F8C129A3505C5A16A1D312DA1D416",
      "target_text": "──아직 나는 여기 있구나.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 대기"
    },
    {
      "uid": "scr.xfl::1001.gsc::slot/00008",
      "source_text": "ラプンツェル",
      "source_raw_sha256": "A7D1022630570BF73137A5F00E89638087B618CE5FBC41C301A483A64D1158E5",
      "target_text": "라푼젤",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 대기"
    },
    {
      "uid": "scr.xfl::1001.gsc::slot/00009",
      "source_text": "１２３４５６７８９０１２３４５６７８９０１２３４５６７８９０。^n１２３４５６７８９０１２３４５６７８９０１２３４５６７８９０！^n１２３４５６７８９０１２３４５６７８９０１２３４５６７８９０」",
      "source_raw_sha256": "5A0777562D41BF289A747C3D9D26DD60AF1B1E8B81ED71A4624489B43FF02F0D",
      "target_text": "１２３４５６７８９０１２３４５６７８９０１２３４５６７８９０。^n１２３４５６７８９０１２３４５６７８９０１２３４５６７８９０！^n１２３４５６７８９０１２３４５６７８９０１２３４５６７８９０』",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 대기"
    },
    {
      "uid": "scr.xfl::1001.gsc::slot/00010",
      "source_text": "|１２[ルビ]３４５６７８９０１２３４５６７８９０１２３４５６７８９０。^n１２３４５６７８９０１２３４５６７８９０１２３４５６７８９０！^n１２|３４[ルビ]５６７８９０１２３４５６７８９０１２３４５６７８|９０[ルビ]」",
      "source_raw_sha256": "A400ADBB346CDFC8D6FECF0CCD4566FA58CF1A881A0FFE0C371A9D359027F3D1",
      "target_text": "|１２[루비]３４５６７８９０１２３４５６７８９０１２３４５６７８９０。^n１２３４５６７８９０１２３４５６７８９０１２３４５６７８９０！^n１２|３４[루비]５６７８９０１２３４５６７８９０１２３４５６７８|９０[루비]』",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 대기"
    },
    {
      "uid": "scr.xfl::1001.gsc::slot/00011",
      "source_text": "暖炉の灯火がゆらめく|昏[くら]い室内で、^nいくつもの影が少女を取り囲んでいた。",
      "source_raw_sha256": "8C87D2F7CEE0DC4DA13A72BC85C49C613DC9BE73DAFC9BD6B17269A56089C63A",
      "target_text": "난롯불이 일렁이는 어두운 실내에서,^n여러 개의 그림자가 소녀를 둘러싸고 있었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 대기"
    },
    {
      "uid": "scr.xfl::1001.gsc::slot/00012",
      "source_text": "男たちはゲルダに精を放った。^n湯に浸かったような充足のため息をつき、^n或いは、しゃっくりじみた|滑稽[こっけい]な音で|喉[のど]を鳴らしながら。",
      "source_raw_sha256": "0A6469813C031DCA9CAA488E1F410A499EE246B718C23C75A1410135451CD884",
      "target_text": "남자들은 게르다에게 정액을 뿜었다.^n온천물에 몸을 담근 듯 충족된 한숨을 내쉬기도 하고,^n혹은 딸꾹질 같은 우스꽝스러운 소리를 내며 목을 울리기도 하면서.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 대기"
    },
    {
      "uid": "scr.xfl::1001.gsc::slot/00013",
      "source_text": "──お願いだよ、泣きやんで。^n──ね。甘いもの、好きだよね。",
      "source_raw_sha256": "9B4959863BD3AF485CAEC6B718D4D871021E9458B04F4DFA398EE74DC7EE3C5F",
      "target_text": "──부탁이야, 그만 울어.^n──있지. 단것 좋아하지?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 대기"
    },
    {
      "uid": "scr.xfl::1001.gsc::slot/00014",
      "source_text": "──ありがとう、お兄ちゃん。",
      "source_raw_sha256": "B56BC683D3D5E10E14A178E7EBC732AC763937F4DA55C922A507F6A9AB6E6259",
      "target_text": "──고마워, 오빠.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 대기"
    },
    {
      "uid": "scr.xfl::1001.gsc::slot/00015",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 대기"
    },
    {
      "uid": "scr.xfl::1001.gsc::slot/00016",
      "source_text": "（──？　また……）",
      "source_raw_sha256": "320D5B594307DDC728AD0F5B64D993EF6FAD3E1912E0E975315806B7E9A80B87",
      "target_text": "(──? 또……)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 대기"
    },
    {
      "uid": "scr.xfl::1001.gsc::slot/00017",
      "source_text": "一式終了。",
      "source_raw_sha256": "81ADC6D3B5EE12A08325EE61B8F993D1AF082DB57A471FE18803428BF5A7D1CA",
      "target_text": "한 세트 종료.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 대기"
    },
