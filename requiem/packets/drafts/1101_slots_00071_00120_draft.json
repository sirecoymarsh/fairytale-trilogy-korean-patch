  "release_ready": false,
  "entries": [
    {
      "uid": "scr.xfl::1101.gsc::slot/00071",
      "source_text": "？？？",
      "source_raw_sha256": "864E5E1F0B9D10790BFE488EAAA526B3E243476B72430C2F1C91D6F1506104FF",
      "target_text": "???",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 한 차례 검수 전"
    },
    {
      "uid": "scr.xfl::1101.gsc::slot/00072",
      "source_text": "まあ！あらあらどうも、ご丁寧に。^n",
      "source_raw_sha256": "E38F8EBFB01B53A95E4B5588F284A245310D588B0D2FD49A5DE7191C3BC36DBF",
      "target_text": "어머! 어머나, 이렇게 정중하게 인사해 주시다니.^n",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 한 차례 검수 전"
    },
    {
      "uid": "scr.xfl::1101.gsc::slot/00073",
      "source_text": "もみの木がしゃべったということは、^nきっともうそろそろクリスマスなのね。",
      "source_raw_sha256": "538F8CB0E471E30522D2B779296634724C325FEB99A3D35C52C62B2412551ABE",
      "target_text": "전나무가 말을 했다는 건,^n분명 이제 슬슬 크리스마스가 온다는 뜻이겠죠.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 한 차례 검수 전"
    },
    {
      "uid": "scr.xfl::1101.gsc::slot/00074",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 한 차례 검수 전"
    },
    {
      "uid": "scr.xfl::1101.gsc::slot/00075",
      "source_text": "──僕はもみの木じゃないよ。",
      "source_raw_sha256": "44475946E59B236682C851E61335702674562341CAD4ADD5087AAE3D30E805D8",
      "target_text": "──나는 전나무가 아니야.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 한 차례 검수 전"
    },
    {
      "uid": "scr.xfl::1101.gsc::slot/00076",
      "source_text": "？？？",
      "source_raw_sha256": "864E5E1F0B9D10790BFE488EAAA526B3E243476B72430C2F1C91D6F1506104FF",
      "target_text": "???",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 한 차례 검수 전"
    },
    {
      "uid": "scr.xfl::1101.gsc::slot/00077",
      "source_text": "そうなの？^nそれじゃあ一体、あなたはだあれ？",
      "source_raw_sha256": "7CF62426BF1B59212ABD4619569F19084CFEF6071482D8C1748E7969178B0BC4",
      "target_text": "그래요?^n그럼 대체 당신은 누구죠?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 한 차례 검수 전"
    },
    {
      "uid": "scr.xfl::1101.gsc::slot/00078",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 한 차례 검수 전"
    },
    {
      "uid": "scr.xfl::1101.gsc::slot/00079",
      "source_text": "…………。",
      "source_raw_sha256": "0A0A39A23D968038B6135EB7825A35667F28EF942D728F4925E6018672732E6B",
      "target_text": "………….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 한 차례 검수 전"
    },
    {
      "uid": "scr.xfl::1101.gsc::slot/00080",
      "source_text": "すぐに返そうとして、口から息だけが|漏[も]れるのを感じた。^nなんてことだろう。^n──答えが見つからない。",
      "source_raw_sha256": "8E991E3CE04A77DC66D18541EBDC3705D85AA44E3970BCFA533CCAA5FCDA60E8",
      "target_text": "곧장 대답하려 했지만 입에서 숨만 새어 나오는 것이 느껴졌다.^n이게 무슨 일일까.^n──답을 찾을 수 없다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 한 차례 검수 전"
    },
    {
      "uid": "scr.xfl::1101.gsc::slot/00081",
      "source_text": "？？？",
      "source_raw_sha256": "864E5E1F0B9D10790BFE488EAAA526B3E243476B72430C2F1C91D6F1506104FF",
      "target_text": "???",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 한 차례 검수 전"
    },
    {
      "uid": "scr.xfl::1101.gsc::slot/00082",
      "source_text": "どうしたの、また黙ってしまって。^nホッキョクグマだってもう少し言葉がお上手よ。^n",
      "source_raw_sha256": "D731F3E693789AEDC48E6773E0890764D57945137507377ADDA96F51AAD03F6D",
      "target_text": "왜 그래요, 또 입을 다물고.^n북극곰도 이것보다는 말을 잘하겠어요.^n",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 한 차례 검수 전"
    },
    {
      "uid": "scr.xfl::1101.gsc::slot/00083",
      "source_text": "──あ、ああ！　もしかして……。",
      "source_raw_sha256": "3663F5607C0052C3413441B687EEE4479B91A8EEEDF488EC0250F9A55384AEC9",
      "target_text": "──아, 아아!　혹시…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 한 차례 검수 전"
    },
    {
      "uid": "scr.xfl::1101.gsc::slot/00084",
      "source_text": "？？？",
      "source_raw_sha256": "864E5E1F0B9D10790BFE488EAAA526B3E243476B72430C2F1C91D6F1506104FF",
      "target_text": "???",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 한 차례 검수 전"
    },
    {
      "uid": "scr.xfl::1101.gsc::slot/00085",
      "source_text": "わかってる！　わかってるから大丈夫よ。^n今さらこんなことでお説教なんてされたくないわ。^nそうよね、名乗ってほしい時には、まず自分から。",
      "source_raw_sha256": "D2A4A261860BE8FBF0C8623F6FE6D61CEE53AEFB75535F8C2D79BA54B69AC680",
      "target_text": "알아요!　알고 있으니 괜찮아요.^n이제 와서 이런 일로 설교를 듣고 싶지는 않아요.^n그래요, 이름을 듣고 싶을 때는 먼저 자신부터.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 한 차례 검수 전"
    },
    {
      "uid": "scr.xfl::1101.gsc::slot/00086",
      "source_text": "？？？",
      "source_raw_sha256": "864E5E1F0B9D10790BFE488EAAA526B3E243476B72430C2F1C91D6F1506104FF",
      "target_text": "???",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 한 차례 검수 전"
    },
    {
      "uid": "scr.xfl::1101.gsc::slot/00087",
      "source_text": "あたしはアリスよ。^nはじめまして、ごきげんよう。",
      "source_raw_sha256": "A6E19110A71A5D3F36D6FB82A24EFB218688E64847C02290FBA65FDD255538BE",
      "target_text": "나는 앨리스예요.^n처음 뵙겠어요. 안녕하신가요.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 한 차례 검수 전"
    },
    {
      "uid": "scr.xfl::1101.gsc::slot/00088",
      "source_text": "ドレスの|裾[すそ]を持ち上げて、身体全体を沈めて、^n女の子はなんだか|仰々[ぎょうぎょう]しいお|辞儀[じぎ]をする。",
      "source_raw_sha256": "6D1910CE924544F51557B2EB2D0E30A522D8056D2357EA252967AAED5F92503A",
      "target_text": "드레스 자락을 들어 올리고 온몸을 낮춰,^n소녀는 어쩐지 거창한 인사를 했다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 한 차례 검수 전"
    },
    {
      "uid": "scr.xfl::1101.gsc::slot/00089",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 한 차례 검수 전"
    },
    {
      "uid": "scr.xfl::1101.gsc::slot/00090",
      "source_text": "アリス……。",
      "source_raw_sha256": "8A8F1DBAF6F87C878E6E8C2264265BA264721156900418E404D57CDC5A80FCFD",
      "target_text": "앨리스…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 한 차례 검수 전"
    },
    {
      "uid": "scr.xfl::1101.gsc::slot/00091",
      "source_text": "　これだけぴったりな名前も珍しい、と僕は思った。^n　自分の名前は出てこなくても、^n「不思議の国のアリス」という物語はなんとなくわかる。",
      "source_raw_sha256": "36CFB1905DD1C8AA9604B6F411A3F34950ECFE0F98AB01FA127E546975DEFD38",
      "target_text": "　이렇게 꼭 어울리는 이름도 드물겠다고 생각했다.^n　내 이름은 떠오르지 않는데도,^n『이상한 나라의 앨리스』라는 이야기는 어렴풋이 안다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 한 차례 검수 전"
    },
    {
      "uid": "scr.xfl::1101.gsc::slot/00092",
      "source_text": "スカートのトランプ柄に、しましまのチェシャ猫みたいな|襟巻[えりま]き。^nなんとなくそれっぽい格好だ。^n何より、その片手に握られている本のタイトルは──",
      "source_raw_sha256": "89EBECE2D38F7E1ED62DAECCDDE7937868EFD4350F198EEDC1C49E36118B6482",
      "target_text": "치마의 트럼프 무늬, 줄무늬 체셔 고양이 같은 목도리.^n어쩐지 그럴듯한 차림이다.^n무엇보다 한 손에 들린 책의 제목은──",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 한 차례 검수 전"
    },
    {
      "uid": "scr.xfl::1101.gsc::slot/00093",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 한 차례 검수 전"
    },
    {
      "uid": "scr.xfl::1101.gsc::slot/00094",
      "source_text": "きみも、「不思議の国のアリス」が好きなんだね。",
      "source_raw_sha256": "DF657386AC9F1C23C35D5E6C51969EFCC7D2B589868315C6BEE37BC0181C22FA",
      "target_text": "너도 『이상한 나라의 앨리스』를 좋아하는구나.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 한 차례 검수 전"
    },
    {
      "uid": "scr.xfl::1101.gsc::slot/00095",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 한 차례 검수 전"
    },
    {
      "uid": "scr.xfl::1101.gsc::slot/00096",
      "source_text": "──？^nそれはあたしのあだ名よ。^nみんな、あたしのことをそう言うの。",
      "source_raw_sha256": "8F02CD8717E7D659C9C6F09BC932D38899EC5CBFA318FB2C552B714A4AF42252",
      "target_text": "──?^n그건 내 별명이에요.^n다들 나를 그렇게 불러요.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 한 차례 검수 전"
    },
    {
      "uid": "scr.xfl::1101.gsc::slot/00097",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 한 차례 검수 전"
    },
    {
      "uid": "scr.xfl::1101.gsc::slot/00098",
      "source_text": "え……。^nだって、その本は。",
      "source_raw_sha256": "07E66174B2A6987F8D4613C592DC08A7F34F9B6A426BFF9DED6D7EDC69FDA86B",
      "target_text": "어…….^n하지만 그 책은.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 한 차례 검수 전"
    },
    {
      "uid": "scr.xfl::1101.gsc::slot/00099",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 한 차례 검수 전"
    },
    {
      "uid": "scr.xfl::1101.gsc::slot/00100",
      "source_text": "これ？　これはあたしの「聖書」。^nあたしのことが書かれているのよ。^nあたしがどんな女の子で、これからどんな目に|遭[あ]うのか。",
      "source_raw_sha256": "8FEE94F0FE2A495918835805477CF8119AC06EF7A4518BE1019F775AF8A98982",
      "target_text": "이거요?　이건 나의 『성경』.^n나에 관한 이야기가 쓰여 있어요.^n내가 어떤 소녀이고 앞으로 어떤 일을 겪게 될지.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 한 차례 검수 전"
    },
    {
      "uid": "scr.xfl::1101.gsc::slot/00101",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 한 차례 검수 전"
    },
    {
      "uid": "scr.xfl::1101.gsc::slot/00102",
      "source_text": "…………。",
      "source_raw_sha256": "0A0A39A23D968038B6135EB7825A35667F28EF942D728F4925E6018672732E6B",
      "target_text": "………….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 한 차례 검수 전"
    },
    {
      "uid": "scr.xfl::1101.gsc::slot/00103",
      "source_text": "　その瞬間、僕は何故か、^n「この子は物語の中から抜け出てきたアリスなんだ！」^n　と信じてしまった。",
      "source_raw_sha256": "D9C8C251A6F1432622D88639E67A3739F946CA6FCBD186F095723565847261D4",
      "target_text": "　그 순간 나는 어째서인지,^n『이 아이는 이야기 속에서 빠져나온 앨리스야!』^n　라고 믿어 버렸다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 한 차례 검수 전"
    },
    {
      "uid": "scr.xfl::1101.gsc::slot/00104",
      "source_text": "　いやいや、そんなバカな。^n　ここは、こう思うべきだろう。^n",
      "source_raw_sha256": "BC25CE40A8965C175D35B3FB92ED74862FE031DC365B1ED2E324CA4D415EB322",
      "target_text": "　아니, 아니, 그럴 리가.^n　여기서는 이렇게 생각해야겠지.^n",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 한 차례 검수 전"
    },
    {
      "uid": "scr.xfl::1101.gsc::slot/00105",
      "source_text": "「なんてかわいそうな子なんだ」と。",
      "source_raw_sha256": "60991A7EF3519320D08D2E4A0588FFB9F3D57CF04022E92783F19A34E18264F2",
      "target_text": "『정말 가엾은 아이구나.』 하고.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 한 차례 검수 전"
    },
    {
      "uid": "scr.xfl::1101.gsc::slot/00106",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 한 차례 검수 전"
    },
    {
      "uid": "scr.xfl::1101.gsc::slot/00107",
      "source_text": "それで、あなたはだあれ？",
      "source_raw_sha256": "8AE92FC78BC7B4F4CB2F0265AF5A96325C83DA0E6942D404F2EA066F8C611B53",
      "target_text": "그래서, 당신은 누구죠?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 한 차례 검수 전"
    },
    {
      "uid": "scr.xfl::1101.gsc::slot/00108",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 한 차례 검수 전"
    },
    {
      "uid": "scr.xfl::1101.gsc::slot/00109",
      "source_text": "え……ええと……。",
      "source_raw_sha256": "4B8F71B0BD72345B3D5CE45013E2C8D9A5739CF41F7C66F5A0AF43CFC99DC67C",
      "target_text": "어……, 그러니까…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 한 차례 검수 전"
    },
    {
      "uid": "scr.xfl::1101.gsc::slot/00110",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 한 차례 검수 전"
    },
    {
      "uid": "scr.xfl::1101.gsc::slot/00111",
      "source_text": "──ごめん。わからないんだ。",
      "source_raw_sha256": "9619D806E09737A1067B410D406B73B214848F84B74B3EEEC5BA0682DD34F2F9",
      "target_text": "──미안. 모르겠어.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 한 차례 검수 전"
    },
    {
      "uid": "scr.xfl::1101.gsc::slot/00112",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 한 차례 검수 전"
    },
    {
      "uid": "scr.xfl::1101.gsc::slot/00113",
      "source_text": "まあ！　わからない？^nそれは──それはお気の毒ね……。",
      "source_raw_sha256": "AC4D4C590961BDA1595ADDF8871E9BAE8828F3863AE7FCD924B9F936063DDC69",
      "target_text": "어머!　모른다고요?^n그건──참 안됐네요…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 한 차례 검수 전"
    },
    {
      "uid": "scr.xfl::1101.gsc::slot/00114",
      "source_text": "アリスは口元を手で|覆[おお]って品よく驚き、しげしげと僕を見た。",
      "source_raw_sha256": "873113FA48CBED14BA948256CBE39DDEA48DBD93D882BE0113D00E6795DA28ED",
      "target_text": "앨리스는 손으로 입가를 가리며 우아하게 놀라더니, 나를 유심히 바라보았다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 한 차례 검수 전"
    },
    {
      "uid": "scr.xfl::1101.gsc::slot/00115",
      "source_text": "なんてことだ。^n僕の方が「かわいそうな子」みたいだ。",
      "source_raw_sha256": "F20D9659BD6B336295247D92BA2D0F8D7B67A610B9906B0AB6BA9CFF7F98A8ED",
      "target_text": "이럴 수가.^n오히려 내가 『가엾은 아이』처럼 보이잖아.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 한 차례 검수 전"
    },
    {
      "uid": "scr.xfl::1101.gsc::slot/00116",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 한 차례 검수 전"
    },
    {
      "uid": "scr.xfl::1101.gsc::slot/00117",
      "source_text": "わからない……自分が誰だかわからない……。^nそんなことってあるのかしら。^n今時、薔薇だって猫だって、薔薇だ猫だとうるさいくらいなのに。",
      "source_raw_sha256": "2C720711E4096DCE01D51CAF043727021884295485B80FC8949B2E65BB97AF9C",
      "target_text": "모른다…… 자신이 누군지 모른다…….^n그런 일이 있을 수 있나.^n요즘은 장미도 고양이도 자기가 장미다, 고양이다 하고 시끄러울 정도인데.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 한 차례 검수 전"
    },
    {
      "uid": "scr.xfl::1101.gsc::slot/00118",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 한 차례 검수 전"
    },
    {
      "uid": "scr.xfl::1101.gsc::slot/00119",
      "source_text": "あの……。",
      "source_raw_sha256": "FAC50E213ACC52AE07FBFF12F83CA409F6926CCE0D0F4431F3E7AD5D0D53B90C",
      "target_text": "저기…….",
      "translator": "Codex internal model draft",
