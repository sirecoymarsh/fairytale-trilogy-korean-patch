    {
      "uid": "scr.xfl::1103.gsc::slot/00041",
      "source_text": "…………。^n",
      "source_raw_sha256": "60E8B9E030A5AF8E8E660ED46FB8887DEB412C4D9BB6BABD12FA91135AF82B2D",
