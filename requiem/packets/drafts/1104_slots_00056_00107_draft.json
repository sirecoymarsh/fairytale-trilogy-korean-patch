  "target_language": "ko-KR",
  "target_encoding": "cp949",
  "translation_method": "Codex internal model only; no external MT/API",
  "review_passes_completed": 0,
  "release_ready": false,
  "entries": [
    {
      "uid": "scr.xfl::1104.gsc::slot/00056",
      "source_text": "？？？",
      "source_raw_sha256": "864E5E1F0B9D10790BFE488EAAA526B3E243476B72430C2F1C91D6F1506104FF",
      "target_text": "???",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1104.gsc::slot/00057",
      "source_text": "名乗る名前がないんじゃしょうがないわね。^nあたしにはあるから名乗っておくわ。^n──あたしはオディール。",
      "source_raw_sha256": "10CAEFA5D7767C9680C3324EE725D37C33294F54A391C8BD6BA89B52189B5605",
      "target_text": "이름을 댈 이름이 없다면 어쩔 수 없지.^n난 있으니까 말해 둘게.^n──나는 오딜.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1104.gsc::slot/00058",
      "source_text": "オディール",
      "source_raw_sha256": "9A32E06D50E7B4A1663EEA46065CE26A49748CCE0A4311A9776A8E9114F5FDBC",
      "target_text": "오딜",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1104.gsc::slot/00059",
      "source_text": "この子がオデット。",
      "source_raw_sha256": "42A04C8B93DDC0E8576371A4E71CE4808B5DEED6E5A983B9769DF7B65BAEA02F",
      "target_text": "이 아이가 오데트야.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1104.gsc::slot/00060",
      "source_text": "と、湖と地面の境にいた白鳥のオブジェの|傍[そば]に寄って、^n軽く叩いて示す。^nよく見ると、その白鳥だけが冠を|被[かぶ]っていた。",
      "source_raw_sha256": "DDC698FD7FB1688395E0B3E03E93D0D31F20F16C9AAB6FE711533D198D4FA4A8",
      "target_text": "그러고는 호수와 지면의 경계에 있던 백조 장식물 곁으로 가서,^n가볍게 두드려 가리켰다.^n자세히 보니 그 백조만 왕관을 쓰고 있었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1104.gsc::slot/00061",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1104.gsc::slot/00062",
      "source_text": "オディール……と。オデット？",
      "source_raw_sha256": "F552E71C0FFDE781952F446845006E87BF862F186A069592FEE885D4E358E9F6",
      "target_text": "오딜……과. 오데트?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1104.gsc::slot/00063",
      "source_text": "オディール",
      "source_raw_sha256": "9A32E06D50E7B4A1663EEA46065CE26A49748CCE0A4311A9776A8E9114F5FDBC",
      "target_text": "오딜",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1104.gsc::slot/00064",
      "source_text": "そう。オデットよ。",
      "source_raw_sha256": "3733265F5C640F97C20B7197F05C8D391A584DEFA280BB8B96CC047A9A5D390C",
      "target_text": "그래. 오데트야.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1104.gsc::slot/00065",
      "source_text": "オディール",
      "source_raw_sha256": "9A32E06D50E7B4A1663EEA46065CE26A49748CCE0A4311A9776A8E9114F5FDBC",
      "target_text": "오딜",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1104.gsc::slot/00066",
      "source_text": "夜になればもう少しましな格好になるんだけど、^nお|生憎[あいにく]様、今は昼だもの。^n見てやってよ、この間抜けな姿をさ。",
      "source_raw_sha256": "6A29347B16151AEFF89EFE1166304C6D7CA23B6EDD228D643CBB538F7280662A",
      "target_text": "밤이 되면 조금은 나은 모습이 되지만,^n유감스럽게도 지금은 낮이잖아.^n이 얼빠진 모습이나 한번 봐 줘.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1104.gsc::slot/00067",
      "source_text": "ぽんぽん、と白鳥の胴体を叩く。^n空洞なんだろう、間抜けな音だ。",
      "source_raw_sha256": "3FC75DC0C1703D372D24CCD1647DEEE22FBCB09B62191A1DD966EA33451C73DC",
      "target_text": "툭툭 백조의 몸통을 두드린다.^n속이 빈 것인지 얼빠진 소리가 났다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1104.gsc::slot/00068",
      "source_text": "本気なのか冗談なのかわかりかねてオディールを見たけれど、^n相変わらず妖しげに笑んでいるばかり。^n僕の戸惑いを楽しんでいることだけは伝わってくる。",
      "source_raw_sha256": "563C3326DB3569A1D2BBB266C78C7385FA5785AEB1AF4FFF79DCD1FC8B946C39",
      "target_text": "진심인지 농담인지 알 수 없어 오딜을 바라보았지만,^n여전히 요염하게 웃고 있을 뿐이다.^n내 당황을 즐기고 있다는 것만은 전해졌다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1104.gsc::slot/00069",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1104.gsc::slot/00070",
      "source_text": "その、聞きたいことっていうのは、僕の記憶についてなんだ。^nどうしてこうなっているのか、どうすればいいのか、^n何もわからなくて……。",
      "source_raw_sha256": "FB3A7ACAE35D63654E5A1DC38B047D5513ABEF42D1530F6FCA8530FCA112F2D4",
      "target_text": "그, 묻고 싶은 건 내 기억에 관한 거야.^n왜 이렇게 됐는지, 어떻게 해야 하는지,^n아무것도 몰라서…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1104.gsc::slot/00071",
      "source_text": "オディール",
      "source_raw_sha256": "9A32E06D50E7B4A1663EEA46065CE26A49748CCE0A4311A9776A8E9114F5FDBC",
      "target_text": "오딜",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1104.gsc::slot/00072",
      "source_text": "おかしなことを言うのね。^nそんなの、「聖書」を読めばわかることじゃない。",
      "source_raw_sha256": "28F00E638B44AF5F92B269D66D7EF023EE30F5B2220D9D2804A7CD0F5F52DD42",
      "target_text": "이상한 소리를 하네.^n그런 건 『성서』를 읽으면 알 수 있잖아.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1104.gsc::slot/00073",
      "source_text": "必死の|訴[うった]えかけを|遮[さえぎ]るように言われて、僕は戸惑うしかない。",
      "source_raw_sha256": "A6679B0A0FF4FD6EFC699A092BEC51F191197CFAD30527FD60F74152E4372B3E",
      "target_text": "필사적인 호소를 가로막듯 말하니, 나는 당황할 수밖에 없었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1104.gsc::slot/00074",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1104.gsc::slot/00075",
      "source_text": "「聖書」？",
      "source_raw_sha256": "161DF7C749CBAE729312F35D62DBFF2CC61FE33FF1EF0E2C87E00B2714687977",
      "target_text": "『성서』?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1104.gsc::slot/00076",
      "source_text": "そういえば、アリスもそんなことを言っていた。^n確か、片手に持った本のことを……。",
      "source_raw_sha256": "EBA3E84E47B5A8A711CF12C8BC0FB5A949D1F7887DC80376836A854FEC249001",
      "target_text": "그러고 보니 앨리스도 그런 말을 했었다.^n분명 한 손에 들고 있던 책을…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1104.gsc::slot/00077",
      "source_text": "オディール",
      "source_raw_sha256": "9A32E06D50E7B4A1663EEA46065CE26A49748CCE0A4311A9776A8E9114F5FDBC",
      "target_text": "오딜",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1104.gsc::slot/00078",
      "source_text": "そうよ、みんな持ってる。",
      "source_raw_sha256": "35AC06F05E54A415EB66330B024BC10ED057B8722BAD087B9E9DEC2EC8661FA9",
      "target_text": "그래, 누구나 가지고 있어.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1104.gsc::slot/00079",
      "source_text": "オディールは僕の頭の中を読んだように、^n手にした本を見せびらかした。",
      "source_raw_sha256": "B3A9C44477E376C1E74B39C92C10E03BF7A3EDA47DD67215554AC9F900B09E82",
      "target_text": "오딜은 내 머릿속을 읽은 듯,^n손에 든 책을 자랑하듯 보여 주었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1104.gsc::slot/00080",
      "source_text": "黒い革表紙に、「白鳥の湖」と書かれているのが見えた。",
      "source_raw_sha256": "2A6DEC89F6A077E324EF86DCC9AF907090A270F0F1AD9A761C804824771A9211",
      "target_text": "검은 가죽 표지에 『백조의 호수』라고 쓰인 것이 보였다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1104.gsc::slot/00081",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1104.gsc::slot/00082",
      "source_text": "（──「白鳥の湖」って、確かバレエじゃなかったっけ）",
      "source_raw_sha256": "FF864C82E37892F9618BD3A9ED79FBE7591BD11BC4EF7799F03FD90E3662C3F8",
      "target_text": "(──『백조의 호수』는 분명 발레 아니었나?)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1104.gsc::slot/00083",
      "source_text": "オディール",
      "source_raw_sha256": "9A32E06D50E7B4A1663EEA46065CE26A49748CCE0A4311A9776A8E9114F5FDBC",
      "target_text": "오딜",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1104.gsc::slot/00084",
      "source_text": "あんたがどういう人間で、これから誰と出会って、^nどうすればいいのか、全部書いてあるわ。^n──なくしてしまうなんて、間抜けなことね。",
      "source_raw_sha256": "19994AC2DD9D15908AF6F6314941CC08F11C5166F8CBF7BBB2918061E9D0D01C",
      "target_text": "네가 어떤 인간이고, 앞으로 누구를 만나며,^n어떻게 해야 하는지 전부 적혀 있어.^n──잃어버리다니, 얼빠진 짓이네.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1104.gsc::slot/00085",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1104.gsc::slot/00086",
      "source_text": "なくした……のかなあ。",
      "source_raw_sha256": "15BCB78DA4819B406FE69E80CF6A1EDE5148DE3CAB2E7ECD91EBAF930C55371C",
      "target_text": "잃어버린…… 걸까.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1104.gsc::slot/00087",
      "source_text": "オディール",
      "source_raw_sha256": "9A32E06D50E7B4A1663EEA46065CE26A49748CCE0A4311A9776A8E9114F5FDBC",
      "target_text": "오딜",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1104.gsc::slot/00088",
      "source_text": "持っていないのなら、なくしたんでしょう。^n随分と|湿気[しけ]たかわいそうな顔をしているけど、^n過去も未来も本１冊探せばどうにでもなるのよ。",
      "source_raw_sha256": "43E892FEFB3A2368B60A56B2319DC4358CD8C89299F456FC682E327D2DD8D57C",
      "target_text": "가지고 있지 않다면 잃어버린 거겠지.^n꽤나 축 처진 불쌍한 얼굴을 하고 있지만,^n과거도 미래도 책 한 권만 찾으면 어떻게든 되는 거야.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1104.gsc::slot/00089",
      "source_text": "そんな馬鹿な、という思いは消えないけれど、^nそうだったらいいな、という気持ちも膨れ上がって、^n心の中がぐちゃぐちゃだ。",
      "source_raw_sha256": "1E3169D59D886115496510D9985C1FE4AD8CA0440DF79CED6D494DA11DCE80DF",
      "target_text": "그럴 리가 없다는 생각은 사라지지 않지만,^n그랬으면 좋겠다는 마음도 부풀어 올라,^n마음속이 엉망진창이다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1104.gsc::slot/00090",
      "source_text": "この、それこそ|陰鬱[いんうつ]な森を|彷徨[さまよ]っているかのような気持ちが^nただ「自分の本」を見つけるだけですっきりするというのなら、^nこんなに楽なことはない。",
      "source_raw_sha256": "D016FDE1142E51120A45B6A90F9668149C5B3A5D9355D45C4D74FB28375420B4",
      "target_text": "그야말로 이 음울한 숲을 헤매는 듯한 기분이^n그저 『내 책』을 찾는 것만으로 후련해진다면,^n이보다 쉬운 일은 없다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1104.gsc::slot/00091",
      "source_text": "そう、ようやく希望の光を見つけたつもりでいたのに。",
      "source_raw_sha256": "2BC85E437268AC7A6CE1EBDC12DF7C0CCF76A778EB03CF75E412FE789F6F0ED6",
      "target_text": "그래, 이제야 희망의 빛을 찾았다고 생각했는데.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1104.gsc::slot/00092",
      "source_text": "オディール",
      "source_raw_sha256": "9A32E06D50E7B4A1663EEA46065CE26A49748CCE0A4311A9776A8E9114F5FDBC",
      "target_text": "오딜",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1104.gsc::slot/00093",
      "source_text": "でも今頃、燃やされたり破かれたり落書きされていたりして──^nふふ、充分にありえるわね。",
      "source_raw_sha256": "C5A422DA857C391A8BB90BAF2B44D7EC712C39EF36508045E0013CCDC6F0F55D",
      "target_text": "하지만 지금쯤 불에 타거나 찢기거나 낙서투성이가 됐을지도──^n후후, 충분히 있을 법한 일이네.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1104.gsc::slot/00094",
      "source_text": "オディールは平然と、僕の希望にけちをつける。^n|喉[のど]を震わせて笑いさえした。",
      "source_raw_sha256": "EC427322C1400C3C482B01BBC46AB5DECC96223686FEE00E388D46BAA82446E5",
      "target_text": "오딜은 태연하게 내 희망에 흠집을 낸다.^n목을 울리며 웃기까지 했다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1104.gsc::slot/00095",
      "source_text": "オディール",
      "source_raw_sha256": "9A32E06D50E7B4A1663EEA46065CE26A49748CCE0A4311A9776A8E9114F5FDBC",
      "target_text": "오딜",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1104.gsc::slot/00096",
      "source_text": "あっはは、|傑作[けっさく]！　「聖書」を手放したばっかりに、^n過去や未来まで変わってしまうなんてね。^n自分の間抜けさ加減を呪うといいわ。",
      "source_raw_sha256": "7B54746609F58299F20F420E42FC0AD958AF83616E0602593AF5150B2626E13D",
      "target_text": "아하하, 걸작이야!　『성서』를 놓친 것 하나 때문에,^n과거와 미래까지 바뀌어 버리다니.^n자신의 얼빠진 정도를 저주하는 게 좋겠네.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1104.gsc::slot/00097",
      "source_text": "僕は彼女を|睨[にら]もうと──^n不安を|誤魔化[ごまか]すために怒ろうと思ったけれど、^n赤い瞳に|見据[みす]えられて、結局視線を|逸[そ]らしてしまった。",
      "source_raw_sha256": "80BFEF82BB2712C412D45C6506497C31341B649E44FCF74D03F9FAD43D819A14",
      "target_text": "나는 그녀를 노려보려──^n불안을 감추기 위해 화를 내려고 했지만,^n붉은 눈동자에 응시당해 결국 시선을 돌리고 말았다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1104.gsc::slot/00098",
      "source_text": "オディールには「聖書」がある。^n自分が何者で、どんな過去があって、これから何をすればいいのか、^n──全部わかっているという。",
      "source_raw_sha256": "DBB3EDA25F9B3971798B8F53F597C1A9BF32F98437F387C0E0830C2907EB3846",
      "target_text": "오딜에게는 『성서』가 있다.^n자신이 누구고 어떤 과거가 있으며, 앞으로 무엇을 해야 하는지,^n──전부 알고 있다고 한다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1104.gsc::slot/00099",
      "source_text": "今の僕には、それが途方もなく|羨[うらや]ましくて、^n同時にどうしても手に入らない遠い希望のように思えて、^n真正面から彼女の瞳と戦えなかった。",
      "source_raw_sha256": "8CB1045447B9D843710576DDDD07B3E1C9C216A953E9A4B5405BC4818A251D3E",
      "target_text": "지금의 나에게는 그것이 터무니없이 부러우면서도,^n도저히 손에 넣지 못할 아득한 희망처럼 느껴져,^n정면으로 그녀의 눈동자와 맞설 수 없었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1104.gsc::slot/00100",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1104.gsc::slot/00101",
      "source_text": "……ありがとう。参考になったよ。",
      "source_raw_sha256": "51F59CB72C6978D0898C344D2498D92CF4E360EC2FFE116ADB8F11148A9C18A9",
      "target_text": "……고마워. 참고가 됐어.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1104.gsc::slot/00102",
      "source_text": "固い声でどうにか告げて、背を向けた。",
      "source_raw_sha256": "59ED839445F4F32822EE94A9E0543CCAEA881FA24DE2649C1D2C5AB498A66F55",
      "target_text": "딱딱한 목소리로 겨우 말하고 등을 돌렸다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1104.gsc::slot/00103",
      "source_text": "オディール",
      "source_raw_sha256": "9A32E06D50E7B4A1663EEA46065CE26A49748CCE0A4311A9776A8E9114F5FDBC",
      "target_text": "오딜",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1104.gsc::slot/00104",
      "source_text": "見つかるといいわね。^n大事な大事な、あんた自身がさ。",
      "source_raw_sha256": "A6935F6955A50357C7D02983B4D58CF6A6403CA3D3F1D42157CD8BA6D1B81A25",
      "target_text": "찾으면 좋겠네.^n소중하고 소중한, 너 자신을 말이야.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1104.gsc::slot/00105",
      "source_text": "弾む声が|容赦[ようしゃ]なく追いかけてくる。",
      "source_raw_sha256": "BABADC74DC6E10B3C2C3ADB9B6F9BB74871EFDA9EF2F857E5802EE88AF1412CC",
      "target_text": "들뜬 목소리가 가차 없이 쫓아온다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1104.gsc::slot/00106",
      "source_text": "扉の向こうに逃げて、^n気持ちを切り替えるために深呼吸しても、^n僕はどうしようもなくみじめな気分だった。",
      "source_raw_sha256": "BCB9BDE617D7F62F73BB4D31D0E942A39831A4F7D5239B0A9264D8B18DF82238",
      "target_text": "문 너머로 도망쳐,^n기분을 전환하려고 심호흡을 해 보아도,^n나는 어쩔 수 없이 비참한 기분이었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1104.gsc::slot/00107",
      "source_text": "僕の「聖書」はどこへ行ったんだろう。^nそれさえあれば、きっと全てうまくいくのに。",
      "source_raw_sha256": "0E3536559D3A0A2E0F8FE6498EFA03DDEFB7662A85AEBF11BA38B99D1209BD3F",
      "target_text": "내 『성서』는 어디로 간 걸까.^n그것만 있으면 분명 모든 일이 잘 풀릴 텐데.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    }
  ]
}
