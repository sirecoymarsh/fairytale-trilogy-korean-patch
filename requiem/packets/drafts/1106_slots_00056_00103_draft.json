  "review_passes_completed": 0,
  "release_ready": false,
  "entries": [
    {
      "uid": "scr.xfl::1106.gsc::slot/00056",
      "source_text": "何をしたかったか……。",
      "source_raw_sha256": "D53F603070551F9B9D9FD9F8D6812314070230FC97AAEB86DCDF678BD3454C2B",
      "target_text": "무엇을 하고 싶었는지…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1106.gsc::slot/00057",
      "source_text": "？？？",
      "source_raw_sha256": "864E5E1F0B9D10790BFE488EAAA526B3E243476B72430C2F1C91D6F1506104FF",
      "target_text": "???",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1106.gsc::slot/00058",
      "source_text": "したいことが何もなかったなら、思い出さなくてもいいのよ。^nでも、何かを強く願っていたのなら、|忘却[ぼうきゃく]と戦わなくては。",
      "source_raw_sha256": "6914B80F06ABD4B14F185DEE6638625514270523D5E3D892B5AADA29B99EEA66",
      "target_text": "하고 싶은 게 아무것도 없었다면 떠올리지 않아도 돼.^n하지만 무언가를 간절히 바랐다면 망각과 싸워야 해.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1106.gsc::slot/00059",
      "source_text": "淡々と語っていた声が、奇妙な熱を帯びるのを感じた。^n──これは、本当に僕のための言葉なんだろうか。",
      "source_raw_sha256": "C7B9014F70A58A1CCACE29AF3106F0E2DA035030EAAAB28090B01766D561EFA1",
      "target_text": "담담하던 목소리에 기묘한 열기가 깃드는 것을 느꼈다.^n──이건 정말로 나를 위한 말일까.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1106.gsc::slot/00060",
      "source_text": "次の瞬間、^n彼女は失言に気づいたように小さく息を|呑[の]み、目を|逸[そ]らした。",
      "source_raw_sha256": "E9E1408CE4EDEAC6A2BBCFCDD04BDE6F4353DFD114E9283DCCE86E57236ADC4B",
      "target_text": "다음 순간,^n그녀는 말실수를 깨달은 듯 작게 숨을 삼키고 시선을 돌렸다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1106.gsc::slot/00061",
      "source_text": "？？？",
      "source_raw_sha256": "864E5E1F0B9D10790BFE488EAAA526B3E243476B72430C2F1C91D6F1506104FF",
      "target_text": "???",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1106.gsc::slot/00062",
      "source_text": "私に言えることはこれくらいかしら。^n申し訳ないけれど、他にお役に立てそうなことは……。",
      "source_raw_sha256": "4209E8DAEC2456840A7FF1017CD481B01E545EF095C3133211C51B9B292A52EC",
      "target_text": "내가 말해 줄 수 있는 건 이 정도일까.^n미안하지만 다른 도움이 될 만한 건…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1106.gsc::slot/00063",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1106.gsc::slot/00064",
      "source_text": "あ、あの！^nごめんね、ふたつだけ聞かせて。",
      "source_raw_sha256": "1FF48C19CB69792A76B10F6E21B8566144F6A4C34E048101E86738644DE1EA6F",
      "target_text": "저, 저기!^n미안한데 두 가지만 물어봐도 될까.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1106.gsc::slot/00065",
      "source_text": "？？？",
      "source_raw_sha256": "864E5E1F0B9D10790BFE488EAAA526B3E243476B72430C2F1C91D6F1506104FF",
      "target_text": "???",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1106.gsc::slot/00066",
      "source_text": "……？^nええ、どうぞ。",
      "source_raw_sha256": "AB1EC6306DCCF718949700CFC983ED79ECBA9B8470A57091EE656EA350D81CA0",
      "target_text": "……?^n그래, 말해.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1106.gsc::slot/00067",
      "source_text": "数で区切ったのがよかったのかもしれない。^n彼女は扉の隙間を維持して、|頷[うなず]いてくれた。",
      "source_raw_sha256": "1EF77F752037944BAE9F3A1DD666D4ABCA716F1D37417DC42ADCF9073AC0E9EF",
      "target_text": "수를 정해 둔 것이 좋았는지도 모른다.^n그녀는 문틈을 그대로 유지한 채 고개를 끄덕여 주었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1106.gsc::slot/00068",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1106.gsc::slot/00069",
      "source_text": "ひとつめ。^nきみ、他の子みたいに「聖書」は持っていないの？",
      "source_raw_sha256": "7D2BC548353177F47C589EEEB8F45BDA1B49A09FB1476827B5954957B53A1A2C",
      "target_text": "첫 번째.^n너, 다른 아이들처럼 『성서』는 안 가지고 있어?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1106.gsc::slot/00070",
      "source_text": "今までであった子たちは、皆、片手に「聖書」を|携[たずさ]えていた。^nそれぞれが主演している物語の絵本だ。",
      "source_raw_sha256": "E7A655110EA580D9FF80E6A6FD9020256746F07013D757906D234A9495D4823B",
      "target_text": "지금까지 만난 아이들은 모두 한 손에 『성서』를 들고 있었다.^n각자 주인공으로 나오는 이야기의 그림책이다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1106.gsc::slot/00071",
      "source_text": "それを、「自分の過去と未来を示す物語」として、^n大事に大事に抱え込んでいる。",
      "source_raw_sha256": "B120A0AC15501FB76F7866E0C9A97F6202806CAEB0ACBFE335FC82F349AA426A",
      "target_text": "그것을 『자신의 과거와 미래를 보여 주는 이야기』로 여기며,^n무척이나 소중하게 품고 있다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1106.gsc::slot/00072",
      "source_text": "　オディールによれば、^n「これさえあれば自分のことが何でもわかる」と。",
      "source_raw_sha256": "83550B9F91B93A1A7B17DCABC0C0F14B79D9027D48AF518B9A1C9E9E9019B34A",
      "target_text": "　오딜의 말로는,^n『이것만 있으면 자신에 대해 무엇이든 알 수 있다』고.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1106.gsc::slot/00073",
      "source_text": "しかし、彼女の両手はどちらも何も持たないまま、^nそっと扉のふちに添えられている。",
      "source_raw_sha256": "D52D7758F2BBC234137661D89818141C94C2D8CE3A5FD5F1FABAA917F9072B14",
      "target_text": "하지만 그녀의 두 손은 아무것도 들지 않은 채,^n살며시 문 가장자리에 놓여 있다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1106.gsc::slot/00074",
      "source_text": "？？？",
      "source_raw_sha256": "864E5E1F0B9D10790BFE488EAAA526B3E243476B72430C2F1C91D6F1506104FF",
      "target_text": "???",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1106.gsc::slot/00075",
      "source_text": "──ああ、「聖書」ね。^n持っているけれど……私は、始終持ち歩かなくても平気だから。",
      "source_raw_sha256": "45C05F1416356BA5CE97E3FFD6E3171D5F7B745786EAEBAB89B93FBA9E5A9BB9",
      "target_text": "──아, 『성서』 말이지.^n가지고는 있지만…… 나는 늘 들고 다니지 않아도 괜찮으니까.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1106.gsc::slot/00076",
      "source_text": "いかにも含みがありそうな答えに、^nあれこれ聞き出したくなったけれど、ぐっとこらえた。^n質問の数は僕が決めてしまっている。",
      "source_raw_sha256": "7AB3B79393359E96A09143081BF2BE709D82F4D4E0535DC7D30486113CFC2AD0",
      "target_text": "분명 뭔가 의미가 있어 보이는 대답이라,^n이것저것 캐묻고 싶었지만 꾹 참았다.^n질문 개수는 내가 정해 버렸다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1106.gsc::slot/00077",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1106.gsc::slot/00078",
      "source_text": "そうなんだ……じゃあ、ふたつめ。^nきみの名前、教えて貰ってもいいかな。",
      "source_raw_sha256": "86D2B4F13075852D3C57ECC7D17E0D559B09A722FF7D115346AE6C0CF5BCD32A",
      "target_text": "그렇구나…… 그럼 두 번째.^n네 이름을 알려 줄 수 있을까.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1106.gsc::slot/00079",
      "source_text": "？？？",
      "source_raw_sha256": "864E5E1F0B9D10790BFE488EAAA526B3E243476B72430C2F1C91D6F1506104FF",
      "target_text": "???",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1106.gsc::slot/00080",
      "source_text": "──！",
      "source_raw_sha256": "69C6AD1BB9523D32EF47F53A648EF37B4787820999318DCB2169AF862A0EBC31",
      "target_text": "──!",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1106.gsc::slot/00081",
      "source_text": "身体の震えに|伴[ともな]って、銀色の髪が揺れた。^nとても簡単な質問なのに、彼女は明らかに^n今までにない動揺を見せていた。",
      "source_raw_sha256": "C1CF54B16D8EC61E9D5520970E88750A9AD01B732F82CF60EF91165E58ADA5C4",
      "target_text": "몸이 떨리면서 은빛 머리카락도 흔들렸다.^n아주 간단한 질문인데도 그녀는 분명^n지금까지와는 다른 동요를 보이고 있었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1106.gsc::slot/00082",
      "source_text": "？？？",
      "source_raw_sha256": "864E5E1F0B9D10790BFE488EAAA526B3E243476B72430C2F1C91D6F1506104FF",
      "target_text": "???",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1106.gsc::slot/00083",
      "source_text": "な、まえ……。^n私の……。",
      "source_raw_sha256": "1EE81573894CAD853342D68F83E8B036B68D8BA8F34858CBF9864BECBF544138",
      "target_text": "이, 름…….^n내…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1106.gsc::slot/00084",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1106.gsc::slot/00085",
      "source_text": "う、うん。^n僕は名乗る名前もないのに、きみだけ名乗らせて、^nその……申し訳ないけど。",
      "source_raw_sha256": "439512901945F519F82A364BCB6D0EF39C22345E92FABD3D627A364B99C89DA8",
      "target_text": "으, 응.^n나는 댈 이름도 없는데 너만 이름을 말하게 해서,^n그…… 미안하지만.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1106.gsc::slot/00086",
      "source_text": "？？？",
      "source_raw_sha256": "864E5E1F0B9D10790BFE488EAAA526B3E243476B72430C2F1C91D6F1506104FF",
      "target_text": "???",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1106.gsc::slot/00087",
      "source_text": "──っ。^nわ、私は……。",
      "source_raw_sha256": "F869CF53E5613E00A9F147220944EE03368E405BC6F558EEC137DE6B3E6147D6",
      "target_text": "──읏.^n나, 나는…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1106.gsc::slot/00088",
      "source_text": "彼女は片手を挙げて額を|覆[おお]った。^n|軋[きし]む頭を押さえるかのような仕草。^n実際に痛みを|堪[こら]えているのか、何度も首を左右に振る。",
      "source_raw_sha256": "27BE63368812F128A6E604063698DBA9CDBBF4A129AA5CF92945C394A68975B9",
      "target_text": "그녀는 한 손을 들어 이마를 감쌌다.^n삐걱거리는 머리를 누르는 듯한 몸짓.^n정말로 아픔을 견디는지 몇 번이고 고개를 좌우로 흔든다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1106.gsc::slot/00089",
      "source_text": "？？？",
      "source_raw_sha256": "864E5E1F0B9D10790BFE488EAAA526B3E243476B72430C2F1C91D6F1506104FF",
      "target_text": "???",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1106.gsc::slot/00090",
      "source_text": "私は、──ゲルダ。^n……いいえ、違う。^nゲルダじゃない……。",
      "source_raw_sha256": "83B2D01727DBCCB617C258CB282A0FE6EBD4F1A02D084076FE500B88658FBA6A",
      "target_text": "나는, ──게르다.^n……아니, 달라.^n게르다가 아니야…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1106.gsc::slot/00091",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1106.gsc::slot/00092",
      "source_text": "え……？",
      "source_raw_sha256": "96116E591D11E894613110F253FA0F94686D0CBFA44D1AE698A0916A7D6C457D",
      "target_text": "뭐……?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1106.gsc::slot/00093",
      "source_text": "ゲルダ？",
      "source_raw_sha256": "593B25B01C91362B2687624B494CFA65ACC64BE069571C44E5DF10DBD3A2DBA5",
      "target_text": "게르다?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1106.gsc::slot/00094",
      "source_text": "ごめんなさい。^n私、失礼するわ。",
      "source_raw_sha256": "1578F2E4F2BC752794AB5A374E91F44992EF62838223A482E5F0D6B99A8CDFF1",
      "target_text": "미안해.^n나, 이만 가 볼게.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1106.gsc::slot/00095",
      "source_text": "立ちすくむ僕の前で、今度こそ扉は閉じられた。^nその一瞬の間に見えたゲルダの苦しげに|歪[ゆが]んだ顔が、^nチクチクと僕の胸を|棘[とげ]のように傷めた。",
      "source_raw_sha256": "24D92D7E0A192FAB2A8884E59952670B0BD621C7967664A55C69876EC432A459",
      "target_text": "멈춰 선 내 앞에서 이번에야말로 문은 닫혔다.^n그 짧은 순간 보인 게르다의 고통스럽게 일그러진 얼굴이,^n가시처럼 따끔따끔 내 가슴을 아프게 했다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1106.gsc::slot/00096",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1106.gsc::slot/00097",
      "source_text": "（よくわからないけど、苦しめてしまってごめん……）",
      "source_raw_sha256": "B60F62F87D346A8932E81F734C9F2C2B15657ECEF8554040D640FA808FE95BD4",
      "target_text": "(잘 모르겠지만 괴롭게 해서 미안해…….)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1106.gsc::slot/00098",
      "source_text": "氷の扉に向かって、心の中で|詫[わ]びた。",
      "source_raw_sha256": "679097BD3FB637967C7B8F6E62A87712939E1757E9DE2C92FA76C6830DA1844C",
      "target_text": "얼음 문을 향해 마음속으로 사과했다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1106.gsc::slot/00099",
      "source_text": "僕は再び廊下を歩き出しながら、とりとめなく考えを巡らせる。",
      "source_raw_sha256": "A99C630DCCF684B6DB2BF40CFA2F8D48A4FAE9FECE964A69523C97C03B3B5F36",
      "target_text": "나는 다시 복도를 걸으며 두서없이 생각을 이어 갔다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1106.gsc::slot/00100",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1106.gsc::slot/00101",
      "source_text": "（ゲルダで、氷みたいな扉──^n　彼女の「聖書」は、あれかな）",
      "source_raw_sha256": "5E30C5D417A82AC99AEF1E71FDE689623239AF4D70B9ED7938AC0C57CB19A68E",
      "target_text": "(게르다에 얼음 같은 문──^n　그녀의 『성서』는 그건가.)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1106.gsc::slot/00102",
      "source_text": "　子供の頃ではなく、それなりに大人になって読み返したときに^n「いいな」と思った、あの童話。",
      "source_raw_sha256": "9C0C40AFE5D4351514AD2355C3772A740153F75A0D2108857BF925DDEB13827E",
      "target_text": "　어릴 때가 아니라 어느 정도 어른이 되어 다시 읽었을 때^n『좋다』고 생각했던 그 동화.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1106.gsc::slot/00103",
      "source_text": "「雪の女王」──",
      "source_raw_sha256": "D69CF885DFFBEFE774F5AB41F0EC9FC2E76323AB966728FD00ED99B3E43EF101",
      "target_text": "『눈의 여왕』──",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    }
  ]
}
