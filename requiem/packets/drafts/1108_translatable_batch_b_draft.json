  "review_passes_completed": 0,
  "release_ready": false,
  "entries": [
    {
      "uid": "scr.xfl::1108.gsc::slot/00069",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00070",
      "source_text": "（何だろう。──日記か何か？）",
      "source_raw_sha256": "1C4DF67813B6221099DAB4A0439CEB5F0F3B2AF8BD3C3B78C6F5AC5FA6131840",
      "target_text": "(뭘까. ──일기 같은 건가?)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00071",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00072",
      "source_text": "──なんだこれ。",
      "source_raw_sha256": "B770F7901F18A813B8F42B83FB31165DA11029977E16B2002E8BE358437F388B",
      "target_text": "──뭐야, 이거.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00073",
      "source_text": "一通り目を通して、僕はそんな声を|漏[も]らしてしまった。",
      "source_raw_sha256": "770A586208C75495DF88D4C62C4503E1F4F499A47AE73661A6FFC6E38A18176C",
      "target_text": "한 차례 훑어보고 나는 그런 목소리를 흘리고 말았다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00074",
      "source_text": "最初はまだわかる。^n誰かに対する説明なのか、それとも自分のための覚え書きなのか、^nとにかくこの「楽園」についてのメモ。",
      "source_raw_sha256": "7C0203544DED81478A251666E5AB1A2BB92AABC0C35D92B60BD8A28E2980E58F",
      "target_text": "처음 부분은 아직 이해할 수 있다.^n누군가에게 설명하는 건지 스스로를 위한 메모인지,^n아무튼 이 『낙원』에 관한 기록이다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00075",
      "source_text": "後半はひらがなばかりのおかしな文章で、文字も|拙[つたな]い。^n脳天気に、無邪気に、何も考えずに、^n人に言われるがまま書きつけている印象だ。",
      "source_raw_sha256": "C6D2B904FBB9FC90DD330AD04BBF883E465549C6667C19F291C309B8803D2BBE",
      "target_text": "뒷부분은 히라가나뿐인 이상한 문장이고 글씨도 서툴다.^n천진하게, 순진하게, 아무 생각 없이,^n남이 시키는 대로 적은 듯한 인상이다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00076",
      "source_text": "それなのに内容は何だかきな臭くて、^n──そのちぐはぐさが、とても気持ち悪い。",
      "source_raw_sha256": "3F3A8D8B8612E79287BA669DDD1A82E1134B1E5F783407599D6CF54D01A11939",
      "target_text": "그런데도 내용은 왠지 수상쩍고,^n──그 부조화가 무척이나 기분 나쁘다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00077",
      "source_text": "みんなのなかにひとり、つみびとが──^nひとごろしのつみびとが──",
      "source_raw_sha256": "4683D2D29845A9EF53086B99324AA68FE7505658C0CB90C02CDF9036EC9B2E05",
      "target_text": "모두 중에 한 명, 죄지은 사람이──^n사람을 죽인 죄지은 사람이──",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00078",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00079",
      "source_text": "（みんなって、誰？^n　きみは、誰に言われてこんなことを書いているの？）",
      "source_raw_sha256": "E0765E398B4710131E20C5A1CA09C6206A832BA103DFA3BC8C7A9175A21D7F2B",
      "target_text": "(모두라니 누구지?^n　너는 누구에게 이런 걸 쓰라는 말을 들었어?)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00080",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00081",
      "source_text": "（きみは──この後、どうなったの？）",
      "source_raw_sha256": "DA47D116AFA5365E7D8DD2BD6AFD14B5DC1ABC67FD2892671F579660F3452CB6",
      "target_text": "(너는──이 뒤에 어떻게 됐어?)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00082",
      "source_text": "雰囲気の違う前半と後半は、^nそれぞれ別の人間が書いたものなんだろうか。^nそれとも──",
      "source_raw_sha256": "01DE31430573C1723DAA332E33CC945A77FFD5CECFE5D87EBABF09D3715DD694",
      "target_text": "분위기가 다른 앞부분과 뒷부분은,^n각각 다른 사람이 쓴 것일까.^n아니면──",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00083",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00084",
      "source_text": "…………。",
      "source_raw_sha256": "0A0A39A23D968038B6135EB7825A35667F28EF942D728F4925E6018672732E6B",
      "target_text": "………….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00085",
      "source_text": "薄気味悪さを|呑[の]み込んで、僕はさらにページをめくった。",
      "source_raw_sha256": "DFBD3E4F182AEDFC0DD2FF5D007851D1C62F437EF371BCBD347DB9CC96B697D1",
      "target_text": "섬뜩한 기분을 삼키고 나는 페이지를 더 넘겼다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00086",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00087",
      "source_text": "（これは……何だろう？）",
      "source_raw_sha256": "D76233BCF6188AF9D9E620C29C8A1C202646775BC4BE3D6DABDC8C186052BB84",
      "target_text": "(이건…… 뭘까?)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00088",
      "source_text": "今までで一番、意味がわからないページだ。",
      "source_raw_sha256": "532313EEBD0C0D8A27F2116DD1B3FCF8297849E95C4B30F78BAB8E86E72F7407",
      "target_text": "지금까지 중 가장 의미를 알 수 없는 페이지다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00089",
      "source_text": "アリス、グレーテル、オデット＆オディール、^nラプンツェル、ゲルダ──^nつまり、今この「楽園」にいる僕以外の患者の名前が書いてある。",
      "source_raw_sha256": "851C7A93719A9A164942F2330BEA3C00C99B95A61EFC3515EC91EF9BD06F9665",
      "target_text": "앨리스, 그레텔, 오데트＆오딜,^n라푼젤, 게르다──^n즉 지금 이 『낙원』에 있는 나 이외의 환자 이름이 적혀 있다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00090",
      "source_text": "何かの表のような線が引いてあるけれど、^nこの空白は何のためにあるのだろう？",
      "source_raw_sha256": "A4B5B7AAA6257606F9DFC61E144E6B25C16F9E2AFBFA4395CDCEF14F47387857",
      "target_text": "무슨 표처럼 선이 그어져 있는데,^n이 빈칸은 무엇을 위한 걸까?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00091",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00092",
      "source_text": "（何か書き込むため、だよね。^n　なんだろう。表？　カルテ？　解答用紙？）",
      "source_raw_sha256": "985840C9305C02F5C1DA2252E781A46BE99DD9B3755B05F27537C613DF0BB2F8",
      "target_text": "(무언가를 적기 위해서겠지.^n　뭘까. 표?　차트?　답안지?)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00093",
      "source_text": "空白を見つめていると、頭の芯が|疼[うず]くような──^n大事な何かが欠けているような、不安な気持ちになる。",
      "source_raw_sha256": "D34F5A742A616691AFAC706E71479712406D57118038118E66EE86D2AE4A79E6",
      "target_text": "빈칸을 바라보고 있자니 머릿속 깊은 곳이 욱신거리는 듯──^n소중한 무언가가 빠진 듯 불안한 기분이 든다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00094",
      "source_text": "何か書き入れたい。^n不思議な衝動だけど、今の僕には何を書けばいいのかなんて^nさっぱり見当がつかない。",
      "source_raw_sha256": "DF90CBFD5C430AE35C46691CD0EB4316FB5ECC059CCAF0B54DBBA35C6D666187",
      "target_text": "무언가를 써넣고 싶다.^n기묘한 충동이지만 지금의 나는 무엇을 써야 할지^n전혀 짐작할 수 없다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00095",
      "source_text": "残りのページが白紙となっていることに気づき、^n僕は首を|傾[かし]げながらスケッチブックを閉じた。",
      "source_raw_sha256": "7F8D38FF252F9499D27CF6B22CF5B4664710167774BC101E5C1ACDC8C13F5B29",
      "target_text": "나머지 페이지가 백지라는 것을 깨닫고,^n나는 고개를 갸웃하며 스케치북을 덮었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00096",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00097",
      "source_text": "（これは……何だろう？）",
      "source_raw_sha256": "D76233BCF6188AF9D9E620C29C8A1C202646775BC4BE3D6DABDC8C186052BB84",
      "target_text": "(이건…… 뭘까?)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00098",
      "source_text": "今までで一番、意味がわからないページだ。",
      "source_raw_sha256": "532313EEBD0C0D8A27F2116DD1B3FCF8297849E95C4B30F78BAB8E86E72F7407",
      "target_text": "지금까지 중 가장 의미를 알 수 없는 페이지다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00099",
      "source_text": "アリス、グレーテル、オデット＆オディール、^nラプンツェル、ゲルダ──^nつまり、今この「楽園」にいる僕以外の患者の名前が書いてある。",
      "source_raw_sha256": "851C7A93719A9A164942F2330BEA3C00C99B95A61EFC3515EC91EF9BD06F9665",
      "target_text": "앨리스, 그레텔, 오데트＆오딜,^n라푼젤, 게르다──^n즉 지금 이 『낙원』에 있는 나 이외의 환자 이름이 적혀 있다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00100",
      "source_text": "それぞれの名前を線が囲っていて、^nその中には不思議な記号が書きこまれているところもある。",
      "source_raw_sha256": "F71DFE7635C45419D650CB90CA3F549ADE35475A6C9E0D9FF958A14A1E9CC432",
      "target_text": "각각의 이름을 선이 둘러싸고 있고,^n그 안에는 기묘한 기호가 적힌 곳도 있다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00101",
      "source_text": "それを見つめていると、頭の芯が|疼[うず]くような──^n大事な何かが欠けているような、不安な気持ちになる。",
      "source_raw_sha256": "BD39C0A9751467CC7B42BAF715EDC4E32B6963EF3739CEF2491FDECD8B9521E2",
      "target_text": "그것을 바라보고 있자니 머릿속 깊은 곳이 욱신거리는 듯──^n소중한 무언가가 빠진 듯 불안한 기분이 든다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00102",
      "source_text": "勇気を出して見つめ続けるべきだ。",
      "source_raw_sha256": "6C8AADEFA04F1BB5077AAB162C313AF9049F1595B4D7034E31B2860AFFEE1A07",
      "target_text": "용기를 내어 계속 바라봐야 한다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00103",
      "source_text": "いや、一刻も早く目を|逸[そ]らして逃げなければ。",
      "source_raw_sha256": "29DBA1A42B9B0D6044F333EBB26E2D6AD2A517FAFDB4FD88EC9FE5005D09943A",
      "target_text": "아니, 한시라도 빨리 눈을 돌리고 달아나야 한다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00104",
      "source_text": "相反する衝動が、両側から僕を責め立ててくるようだ。^nどっちが正しいのか、間違っているのか──^nそもそも正解なんてあるのか──",
      "source_raw_sha256": "D392C1A52854A852907F2D7A6B2BA4ECB4AC06110A37F30EFBE25F190743CF28",
      "target_text": "서로 반대되는 충동이 양쪽에서 나를 몰아붙이는 듯하다.^n어느 쪽이 옳고 어느 쪽이 틀렸는지──^n애초에 정답 같은 것이 있기는 한지──",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00105",
      "source_text": "僕は頭を強く振って、どちらの考えも振り払った。",
      "source_raw_sha256": "4FCE6D9D6E8D4EC7D8BB3C6EF133907DE18F79D3F7904D800D3B9487A7E02D6B",
      "target_text": "나는 머리를 세차게 흔들어 두 생각을 모두 떨쳐 냈다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00106",
      "source_text": "残りのページに書き込みがないことを確認して、^nスケッチブックを閉じる。",
      "source_raw_sha256": "715456006991FC04B910105549F2F642C7F9096A2CB05688AA6320AC3250BFE4",
      "target_text": "나머지 페이지에 적힌 것이 없음을 확인하고,^n스케치북을 덮었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00156",
      "source_text": "ただスケッチブックを見つけて、|覗[のぞ]いただけなのに、^nなんだか少し心にもやがかかった気分だった。",
      "source_raw_sha256": "FBFD17017B1DB0DEA59B44C69C905BA8005E680E24516FE91BADF9164E7B7C2E",
      "target_text": "그저 스케치북을 찾아 들여다보았을 뿐인데,^n마음에 조금 안개가 낀 듯한 기분이었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00157",
      "source_text": "特にあの、「つみびとがいる」「にげなきゃ」の書き込み。^nあまりに意味がわからないけれど、わからないだけに、^n危うそうな雰囲気だけは伝わってくる。",
      "source_raw_sha256": "06679DE0971968B5AA77DBD28751644475A8C11721E2D0E607356D437FCC043B",
      "target_text": "특히 『죄지은 사람이 있어』 『도망쳐야 해』라는 글.^n너무나 뜻을 알 수 없지만, 모르기 때문에 오히려^n위험해 보이는 분위기만은 전해져 온다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00158",
      "source_text": "あれは、時間を越えて^n今ここにいる僕に警告しているんじゃないだろうか──^nそんなことすら考えてしまう。",
      "source_raw_sha256": "C006E7AF713FFE34FD940E7328E2441D02B7AA63174B0CD6C8C2DBD400A7D415",
      "target_text": "저 글은 시간을 넘어^n지금 이곳에 있는 나에게 경고하는 게 아닐까──^n그런 생각까지 들고 만다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00159",
      "source_text": "　ここに来るまでのことを憶えていたら、^n「そんな、ホラー小説じゃあるまいし」なんて笑って、^n　前の住人の忘れ物として届け出たかもしれない。",
      "source_raw_sha256": "F3BA999D1AE3307CB190D9FFCE0872A5595432A86C5AE645E4B0CE8FB99364C6",
      "target_text": "　이곳에 오기 전 일을 기억했다면,^n『무슨 공포 소설도 아니고』라며 웃고,^n　전에 살던 사람이 두고 간 물건으로 신고했을지도 모른다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00160",
      "source_text": "けれど、僕は頭の中が真っ白な分、^nあれこれと想像で埋めなければならなくて、そうすると、^nホラー小説みたいなことすらも身に迫って感じられて──",
      "source_raw_sha256": "5C46FAD8BEA3AF8AADDEF19226F7CDB60A5D1928E1F353AEA0E3F4F1158E83A1",
      "target_text": "하지만 내 머릿속은 새하얀 만큼,^n이것저것 상상으로 채워야 하고, 그러다 보니,^n공포 소설 같은 일마저 눈앞의 현실처럼 느껴져──",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00161",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00162",
      "source_text": "（だめだ、気分転換しよう）",
      "source_raw_sha256": "E9FC45D75552C314CC58FF0948EA6A3555DA222CF1D5F3368F0CE2E2F198B39E",
      "target_text": "(안 되겠다. 기분 전환하자.)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00163",
      "source_text": "僕はスケッチブックを机の上に置いて、^n再び出かけることにした。",
      "source_raw_sha256": "09CA0D743EC39A7FB989E136D6BD339FF6AE89D9FE8A3A2BF4DBBEE8F72ED7B9",
      "target_text": "나는 스케치북을 책상 위에 놓고,^n다시 밖으로 나가기로 했다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00164",
      "source_text": "部屋に帰される時もひとりだったし、^n今も部屋のドアには鍵をかけられていないし、これは^n自由に出歩いていいということなんだろう。",
      "source_raw_sha256": "7008DE48289236C6D41B5B5A38B6DD45C0E26E0DD827DED2132AC04A636E47B7",
      "target_text": "방으로 돌려보낼 때도 나 혼자였고,^n지금도 방문은 잠겨 있지 않으니, 이는^n자유롭게 돌아다녀도 된다는 뜻이겠지.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00165",
      "source_text": "だったら、まだ行ったことのないところに行くのは^n気分を切り替えるのにちょうどいいかもしれない。",
      "source_raw_sha256": "FBB1FBB6268CF80C99BB9A7391288A40EA838DF367D6A65AE216A634421D941B",
      "target_text": "그렇다면 아직 가 보지 않은 곳에 가는 것이^n기분을 바꾸기에 딱 좋을지도 모른다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00166",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00167",
      "source_text": "（あ、そうだ。図書館）",
      "source_raw_sha256": "DDC6FA047F2E8429315F540E74A17F59A39EF6B2D3DC17B540706D580DEF6255",
      "target_text": "(아, 맞다. 도서관.)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00168",
      "source_text": "あの手記（？）の中に、図書館のことが書いてあった。^nみんなの本について書いてあって、行動の理由がわかるって──",
      "source_raw_sha256": "65C063BF6DE0B0D066A122325D9DCAA81983A7876D2CE775E6DB5BD547378064",
      "target_text": "그 수기(?)에 도서관 이야기가 적혀 있었다.^n모두의 책에 관한 내용이 있어 행동의 이유를 알 수 있다고──",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00169",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00170",
      "source_text": "（みんなの「聖書」である絵本が^n　図書館にも入ってるってことか）",
      "source_raw_sha256": "26FC977855DE76BE964D46A3791F3D64E79B067D95E0822DB11448F845C8CFF7",
      "target_text": "(모두의 『성서』인 그림책이^n　도서관에도 있다는 뜻인가.)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00171",
      "source_text": "今いる患者さんのお話については一通り知っていたけど、^n読みなおしてみるのもいいかもしれない。",
      "source_raw_sha256": "1282C893165848951BED0E247B256E3F0E7A699A836ED68ACD00D734417EC02E",
      "target_text": "지금 있는 환자들의 이야기는 대강 알고 있지만,^n다시 읽어 보는 것도 좋을지 모른다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00172",
      "source_text": "もしかしたら、僕自身のことを知る手がかりになるかもしれないし。",
      "source_raw_sha256": "C6670DDC5A49301E3F9A25DBD5CB53C720BA33F4E8447BDA5767BFCB9B4457C9",
      "target_text": "어쩌면 나 자신을 알 단서가 될지도 모르고.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1108.gsc::slot/00173",
      "source_text": "僕は図書館に向かうために、^n再び白いドアノブを回した。",
      "source_raw_sha256": "E7A096B40D365244B109E8A3572E61AA7D61312B67E5752FC7E329D035841FC3",
      "target_text": "나는 도서관으로 향하려고,^n다시 하얀 문손잡이를 돌렸다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    }
  ]
}
