  "review_passes_completed": 0,
  "release_ready": false,
  "entries": [
    {
      "uid": "scr.xfl::1110.gsc::slot/00001",
      "source_text": "アリスの部屋の前で、僕は少しためらった。",
      "source_raw_sha256": "2A95A4405762DDFBE4A5E642D87D185CB482724A95ACA65AF017DA88C810FA75",
      "target_text": "앨리스의 방 앞에서 나는 잠시 망설였다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00002",
      "source_text": "面白くて、親切な女の子だと思う。^nけれど目まぐるしくて、|突拍子[とっぴょうし]もなくて、^n疲れる相手でもある。",
      "source_raw_sha256": "DF62873148A59A995BA036D8D0C40F6881CA5F31AA0543CE216C307F506CAF4E",
      "target_text": "재미있고 친절한 여자아이라고 생각한다.^n하지만 정신없고 엉뚱해서,^n함께 있으면 피곤하기도 하다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00003",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00004",
      "source_text": "（もう少し話してみたいことはみたいんだけど……）",
      "source_raw_sha256": "355BCA681CD9EA742EEF57ECD1B2C634EC3126755BE8DEA1E2955BB380737AC2",
      "target_text": "(조금 더 이야기해 보고 싶기는 한데…….)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00005",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00006",
      "source_text": "きゃあ……！^nあ……あ、あ、あっ。",
      "source_raw_sha256": "BF9F3AE73FC546BFC3E73F94B31F4BC0054184057CA2D2726FCBD660901602F2",
      "target_text": "꺄아……!^n아…… 아, 아, 앗.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00007",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00008",
      "source_text": "なんてこと、なんてこと。^nなんて日なの。",
      "source_raw_sha256": "953B2BCF2F43138202854AD2871B0787440C08CB3ECDBD6AA12D916FE9BD36E3",
      "target_text": "이럴 수가, 이럴 수가.^n대체 오늘은 무슨 날이에요.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00009",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00010",
      "source_text": "──！？",
      "source_raw_sha256": "7D6BA4F2D206C16E1DA46BF8795774A399EB85371F1CE3938B675AE2ACB24BD8",
      "target_text": "──!?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00011",
      "source_text": "ドアの向こうから響いてきたアリスの声は、^n驚き、苦しみ、困り果てて、最後には心からの嘆きに変わった。",
      "source_raw_sha256": "A805E1B1CB42F32CEA27C6E3EF38DA87E25E838062DCE390C162D1C0BDF12183",
      "target_text": "문 너머에서 울려 온 앨리스의 목소리는,^n놀라고 괴로워하고 어쩔 줄 몰라 하다가 마침내 진심 어린 탄식으로 바뀌었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00012",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00013",
      "source_text": "だ、大丈夫！？",
      "source_raw_sha256": "C614FC2F95B8BD3F0DBFC1F307879461AB8C01973E08F2EE1A95781812BC13B6",
      "target_text": "괘, 괜찮아!?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00014",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00015",
      "source_text": "た、助けて！",
      "source_raw_sha256": "D7C3765A2A0E181C4C8F440E8D440A0F9FFED87D8A9B1EF5766F89DCE1BBFD6A",
      "target_text": "사, 살려 주세요!",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00016",
      "source_text": "僕は思い切ってドアを開いた。",
      "source_raw_sha256": "97C9B43611F60C69F81F9F608C390B7C9EF553D92BF4577B28CCB4E046659119",
      "target_text": "나는 마음을 다잡고 문을 열었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00017",
      "source_text": "アリスの部屋は、分厚いカーテンを閉ざしてできた闇と、^n色とりどりの照明がせめぎあって、^nぼうっと全体が発光して見える、そんな不思議な夜を|迎[むか]えていた。",
      "source_raw_sha256": "C27D5FAB3C3CC79C060F96B32E7533EBFA1C7BE60856CBCC8A2131E2986B9015",
      "target_text": "앨리스의 방에는 두꺼운 커튼을 닫아 만든 어둠과,^n형형색색의 조명이 서로 맞서며,^n방 전체가 희미하게 빛나는 듯한 기묘한 밤이 찾아와 있었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00018",
      "source_text": "一見すると薄暗いから、昼間より落ち着いている印象だけれど、^nよく見ればキノコの傘や花の|露[つゆ]、並べられた|瓶[びん]が光っていて、^n昼間以上に華やかだ。──というか、毒々しい。",
      "source_raw_sha256": "2F7E8332C7086B5007DC823312F63E47E3CA83B8623B5A40F3EA57B6D6905B04",
      "target_text": "언뜻 보면 어두워 낮보다 차분한 인상이지만,^n자세히 보면 버섯 갓과 꽃의 이슬, 늘어놓은 병이 빛나고 있어,^n낮보다 화려하다. ──아니, 독기가 넘친다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00019",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00020",
      "source_text": "た、助けて、助けて！",
      "source_raw_sha256": "C62C2BE899AE49BD584A12276C29B4D6936825E3FCD30573C45F332CE457FB56",
      "target_text": "사, 살려 주세요, 살려 주세요!",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00021",
      "source_text": "助けを求めるアリスにすぐに駆け寄らなかったわけは、^n部屋の様子に気をとられていた、というのがまずひとつ。",
      "source_raw_sha256": "016654B6CFEFB751EFBCAD2D896FD2F662F3AABEDFED97A88FD97E8476A40FAC",
      "target_text": "도움을 청하는 앨리스에게 바로 달려가지 않은 이유는,^n우선 방의 모습에 한눈을 팔았기 때문이다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00022",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00023",
      "source_text": "お願いよ。^nこんなの、あたし自身にはどうにもできないわ！",
      "source_raw_sha256": "40C228A23B7949C07010C22F5BF48987DF10B135A701A4610F2B34245ACC360B",
      "target_text": "부탁이에요.^n이건 저 혼자서는 어쩔 수 없어요!",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00024",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00025",
      "source_text": "え……あ！？",
      "source_raw_sha256": "DB380786C5F158305BE8B202D296C6196B847E43CF41A0F04F0931CAA2545DBD",
      "target_text": "뭐…… 앗!?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00026",
      "source_text": "もうひとつには、アリスが予想していたよりずっと^nおかしな格好で僕を待っていたせいだ。",
      "source_raw_sha256": "01B97646257990AE4BC2E5DA83827594C6E07581782D40088EB8DE15D523B2BD",
      "target_text": "또 하나는 앨리스가 예상보다 훨씬^n기묘한 모습으로 나를 기다리고 있었기 때문이다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00027",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00028",
      "source_text": "助けて！^nあたしの身体、大きくなってしまったの！",
      "source_raw_sha256": "E8C9C53027CFD321DA0FF213C87CED7EAEC4EA45E22553529272104D76F1CDAA",
      "target_text": "살려 주세요!^n제 몸이 커져 버렸어요!",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00029",
      "source_text": "まさか、お尻で|出迎[でむか]えられるなんて。",
      "source_raw_sha256": "D8626CC63E99B7477FB6DB63FC15315E7F2E7DF8CA76929EBE53B7AB67237AF2",
      "target_text": "설마 엉덩이로 맞이할 줄이야.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00030",
      "source_text": "派手にひっくり返ったスカートと、^nそこから伸びているお尻や足は、^nだらしない花と|萎[しお]れた|蘂[しべ]のようだった。",
      "source_raw_sha256": "8B24101B6638676A04DDD0AFD36FD717E8F36DB53B0D0F42A0B7C8C129869D4A",
      "target_text": "화려하게 뒤집힌 치마와,^n거기서 뻗어 나온 엉덩이와 다리는,^n흐트러진 꽃과 시든 꽃술 같았다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00031",
      "source_text": "アリスは──^n真ん中からふたつに割れたドールハウスに手足をとられて、^nハマりこんで、にっちもさっちもいかなくなっているようだった。",
      "source_raw_sha256": "3FCABA5BB3CE8B1A6FC31463F129FE27695CEC4741B6253C141FD3B1C73E87EF",
      "target_text": "앨리스는──^n가운데가 둘로 갈라진 인형의 집에 팔다리가 붙잡혀,^n끼어 꼼짝도 할 수 없는 모양이었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00032",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00033",
      "source_text": "一体、何をどうしたらこうなるの……。",
      "source_raw_sha256": "14C9D5E0778288F4AA0E736066D9D65D1ECEFF9D2E4ACA9D26CE9B807D68AF5C",
      "target_text": "대체 뭘 어떻게 하면 이렇게 되는 거야…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00034",
      "source_text": "僕はまず、あきれ果ててため息をついた。",
      "source_raw_sha256": "87EF6D900998C2360ECD0DC5B9AD9EF1CC273DBA9D7AA18887C7B73F0769743B",
      "target_text": "나는 우선 어이없다는 듯 한숨을 쉬었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00035",
      "source_text": "それから、アリスのお尻が──肌色が透けるほど張りつめた下着が、^nアリスの|嗚咽[おえつ]にあわせてピクピクと震えていることに気づいて、^n慌てて目を|逸[そ]らした。",
      "source_raw_sha256": "25D4A512098CA40220B08C19E933C6721415B39280D41AD3E4E2C4F60F44945E",
      "target_text": "그러다 앨리스의 엉덩이가──살구색이 비칠 만큼 팽팽해진 속옷이,^n앨리스의 흐느낌에 맞춰 움찔움찔 떨리는 것을 깨닫고,^n황급히 시선을 돌렸다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00036",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00037",
      "source_text": "あの……何をしてるの、アリス。",
      "source_raw_sha256": "67659134DAF1673231698763575FC2025D6C34166EB36FEC49F3311DC8D70992",
      "target_text": "저기…… 뭘 하고 있는 거야, 앨리스.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00038",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00039",
      "source_text": "あ、あたし……この家にお使いにきたの。^nうさぎさんに頼まれて。^nどうやら、あたしのことをメイドと間違えたみたいなの。",
      "source_raw_sha256": "281ACF088A4B2CE44B5CB60B531789643F2DA67E8805CF465989E91FFF61CDE2",
      "target_text": "저…… 이 집에 심부름하러 왔어요.^n토끼 씨 부탁으로요.^n아무래도 저를 하녀로 착각한 모양이에요.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00040",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00041",
      "source_text": "　ああ、どうしてあたし、引き受けてしまったのかしら。^n　メアリ・アンなんて名前じゃないのに、^n「勘違いしてくれて助かった」なんて……。",
      "source_raw_sha256": "45273EB8BCA6B6A4372305780916780186B5F5848C9DEA764288DD3B311C27F8",
      "target_text": "　아아, 왜 저는 부탁을 받아들인 걸까요.^n　메리 앤이라는 이름도 아닌데,^n『착각해 줘서 다행이야』라니…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00042",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00043",
      "source_text": "「これで堂々とこのおうちに出入りできる」なんて^n　どうして考えちゃったのかしら。",
      "source_raw_sha256": "DF3CF9D46C5425A6555F460309C4E04F2E428550573C47CA05F1D8397BD019E9",
      "target_text": "『이제 당당하게 이 집에 드나들 수 있어』라고^n　어째서 생각해 버린 걸까요.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00044",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00045",
      "source_text": "何より、そこに|小瓶[こびん]があったからって、^nどうして飲んでしまったのかしら！",
      "source_raw_sha256": "F3F1B4AB1B6B29EE928E657B9C3DD2B766F725138AC29692490C5DF7AEDEF676",
      "target_text": "무엇보다 거기에 작은 병이 있었다고,^n어째서 마셔 버린 걸까요!",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00046",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00047",
      "source_text": "今までさんざん、何か食べる度に飲む度に^n大きくなったり小さくなったりして、今回だって^n頭の|隅[すみ]っこで考えたはずなのに……。",
      "source_raw_sha256": "D98ED9AD8DD7EF001F8BC21A3597D2CFAB21D6CAE1D513064C58064402828D66",
      "target_text": "지금까지 무언가를 먹거나 마실 때마다^n커졌다 작아졌다 했으니, 이번에도^n머리 한구석에서는 생각했을 텐데…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00048",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00049",
      "source_text": "え、えええ……。",
      "source_raw_sha256": "878ABFEAD273B134F17304E27F366179177384CFAE6A9EE09095D53261510BBC",
      "target_text": "어, 어어어…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00050",
      "source_text": "大体のことはわかった──わからないなりにわかった、けど、^n僕の口からは相変わらずため息しか|漏[も]れない。",
      "source_raw_sha256": "A0B47370E3FD5EF6F238F349C1F4211ED92C211A3D476D2E661A13C26EA4C998",
      "target_text": "대략적인 사정은 알았다──모르면서도 알기는 했지만,^n내 입에서는 여전히 한숨만 새어 나온다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00051",
      "source_text": "僕から見たアリスの状態を思わず指摘しかけて、^n口を|噤[つぐ]む。",
      "source_raw_sha256": "423DB6011A0F8D0EB1BFE5E557152719D2CC04B3344BC7090CF250BCBC3A4F76",
      "target_text": "내게 보이는 앨리스의 상태를 무심코 지적하려다,^n입을 다물었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00052",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00053",
      "source_text": "（ドールハウスに無理矢理身体を押し込んで^n「大きくなった」って騒いでいるようにしか見えない、^n　なんて──）",
      "source_raw_sha256": "820E235A3772B9858171139AB46227B922F9DADD4FD724A33EAC088DC0E1356C",
      "target_text": "(인형의 집에 억지로 몸을 밀어 넣고^n『커졌어』라고 소란을 피우는 것으로밖에 보이지 않는다는^n　말은──)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00054",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00055",
      "source_text": "（言えないよね、うん。^n　お医者様にも、みんなの見ている世界を壊すようなこと^n　しないでほしいって言われたし……）",
      "source_raw_sha256": "1BD60472F898E9074AE6EB2A83CDC853CD3E73141F9BD89736574FF03B12DF74",
      "target_text": "(할 수 없겠지, 응.^n　의사 선생님도 모두가 보는 세계를 무너뜨리는 짓은^n　하지 말아 달라고 했고…….)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00056",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00057",
      "source_text": "ええと……どうすればいい？^n引っこ抜けばいいのかな。",
      "source_raw_sha256": "1B97A270DD7317596E4255C90D5B1B3A16FDF7126A1C166A0A42C4C8FFA089BD",
      "target_text": "그러니까…… 어떻게 하면 돼?^n잡아 빼면 될까.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00058",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00059",
      "source_text": "そんなことしたら、おうちが壊れないかしら……。^nうさぎさんが住めなくなったらかわいそうよ。",
      "source_raw_sha256": "D1F5ED5D05D5BEA16ECCF074665DFD0C27F3F57B5E4B02958B177D3A0B33AC30",
      "target_text": "그렇게 하면 집이 무너지지 않을까요…….^n토끼 씨가 살 곳을 잃으면 불쌍해요.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00060",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00061",
      "source_text": "このままじゃ、きみもかわいそうだけど。",
      "source_raw_sha256": "07B9839FAD58EAD9D0DB91F885782DC2C958CC33BF946BAD606664745BF7A5E9",
      "target_text": "이대로면 너도 불쌍한데.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00062",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00063",
      "source_text": "そうなの。あたしもそう思うの！",
      "source_raw_sha256": "7EA6F50CFC5FE39B8E4F90B166EB302E22794574A62C0F2C3EEA0EF79FDB7B7A",
      "target_text": "그래요. 저도 그렇게 생각해요!",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00064",
      "source_text": "思い切って、再び様子を|窺[うかが]うと、^nアリスはハの字|眉[まゆ]をますます下げて、^n泣くのを|堪[こら]えている様子だった。",
      "source_raw_sha256": "9E8D240B975D06542D62F1EBE80EE5F57BC0E012B8F22B09B896B34714F02F09",
      "target_text": "마음을 다잡고 다시 살펴보자,^n앨리스는 팔자눈썹을 더욱 늘어뜨리고,^n울음을 참고 있는 듯했다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00065",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00066",
      "source_text": "（これ、自分で何とかできるんじゃないのかなぁ）",
      "source_raw_sha256": "B4B772CBE2C300BE66F8562A3EE1FC97C6D20F82AB659D8B6C65037F2F8D9864",
      "target_text": "(이거, 혼자서 어떻게든 할 수 있지 않을까.)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00067",
      "source_text": "ドールハウスの窓やドアに|囚[とら]われているのは、^n片手と片足だけ。",
      "source_raw_sha256": "B4F7FEB8B47FB37EAD2880292C8A3A16C581EE3574C432E5611AF5EF027441B5",
      "target_text": "인형의 집 창문과 문에 붙잡힌 것은,^n한쪽 손과 한쪽 다리뿐이다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00068",
      "source_text": "曲芸めいたポーズだから入り組んでいるように見えるけれど、^n落ち着けば自力で抜け出せそうだ。",
      "source_raw_sha256": "9D1A4E626CFBBDFCD754E08B0E0F3BD854573DF248E83C09B255B8304AD9C847",
      "target_text": "곡예 같은 자세라 복잡해 보이지만,^n진정하면 혼자 빠져나올 수 있을 것 같다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00069",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00070",
      "source_text": "（問題は、たぶんアリスは落ち着けない、ということだ）",
      "source_raw_sha256": "0C60E5C1CF3A5087AA4AEBD0F1527E49824CCC696360552007A692F5984FEF96",
      "target_text": "(문제는 아마 앨리스가 진정할 수 없다는 거야.)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00071",
      "source_text": "と、ふと思い当たることがあって、^n彼女の|傍[そば]に落ちている「聖書」を拾い上げる。",
      "source_raw_sha256": "D936E0D6B6947BADA127EB13BD586DA4A42218D368CB698329D74EE9A1651C6D",
      "target_text": "그러다 문득 떠오르는 것이 있어,^n그녀 옆에 떨어진 『성서』를 주워 들었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00072",
      "source_text": "　これはアリスが「聖書」──^n「不思議の国のアリス」に従って起こした行動だから^n「聖書」に沿えば、アリスの中でも元に戻れるかもしれない。",
      "source_raw_sha256": "CB9D623C0FDCBE24B8669652BDC875BD276E5CDF0EC7BB67CDCE093CA3F04273",
      "target_text": "　이건 앨리스가 『성서』──^n『이상한 나라의 앨리스』를 따라 한 행동이니^n『성서』를 따르면 앨리스 안에서도 원래대로 돌아올지 모른다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00073",
      "source_text": "そのページを探り当てて、読む。",
      "source_raw_sha256": "B51A513CC1F2ED1D661EEB57886C6D37AA73B2DD0F5BB78656D0CC5B757525BA",
      "target_text": "해당 페이지를 찾아 읽었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00074",
      "source_text": "アリスが言った通り、白兎にメイドと勘違いされてお使いに行き、^n室内で|瓶[びん]を飲んだせいで巨大化して、家にみっちりと^n押し込められた──とある。",
      "source_raw_sha256": "E5231E28266CB74A87AF1DB4C560DC2E2CDBA9A592C1CCEF37C16094AAE037D6",
      "target_text": "앨리스의 말대로 흰토끼에게 하녀로 오해받아 심부름을 갔다가,^n방 안에서 병의 내용물을 마셔 거대해지고 집 안에 빽빽하게^n갇혔다──고 적혀 있다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00075",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    }
  ]
}
