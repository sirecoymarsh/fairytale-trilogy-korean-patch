  "review_passes_completed": 0,
  "release_ready": false,
  "entries": [
    {
      "uid": "scr.xfl::1110.gsc::slot/00076",
      "source_text": "（ええと……兎たちは、家の中に小石を投げ入れる。^n　ケーキに変わったそれを食べたアリスは、^n　今度はぐんぐん小さくなっていく、か）",
      "source_raw_sha256": "960B7BEEBA1D36B5F2F75540A86D2D19488338A7E4727EA6930B28702A2E39B8",
      "target_text": "(음…… 토끼들은 집 안에 조약돌을 던진다.^n　케이크로 변한 그것을 먹은 앨리스는,^n　이번에는 쭉쭉 작아진다, 인가.)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00077",
      "source_text": "僕は自分のポケットを探った。",
      "source_raw_sha256": "7AC12F5C181B9264C34AFD664C93E1A91182761616E661962A2C01864AB418A4",
      "target_text": "나는 내 주머니를 뒤졌다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00078",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00079",
      "source_text": "アリス、口を開いて。",
      "source_raw_sha256": "FA47CAF4B043EE7C9DE0826DA5553AD8BB3F97F342E19513168364FC516CAF7E",
      "target_text": "앨리스, 입 벌려.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00080",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00081",
      "source_text": "え……？^n──あーーーーー……。",
      "source_raw_sha256": "D21AB63AFB3F91EAE23313A16E687EA3A2D98E070CA537E7F98E8531661E861B",
      "target_text": "네……?^n──아──────…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00082",
      "source_text": "アリスは僕の意図を察しかねたようだったけれど、^nその口を開いてくれた。^n何故か、ついでに声まで出し続けている。",
      "source_raw_sha256": "73D029F5A189A072568CFC8BBE8FBD1E55D27D9A15EBD109998FF438E9E70C8B",
      "target_text": "앨리스는 내 의도를 알아채지 못한 듯했지만,^n입을 벌려 주었다.^n어째서인지 덤으로 목소리까지 계속 내고 있다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00083",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00084",
      "source_text": "小石だけど、きみにとっては小さくなるケーキになるよ。^nそらっ。",
      "source_raw_sha256": "FE2C75AC41952CB386288F22E70B61CB0F2E900EAD37AFC06B5F85CA43F6E9AC",
      "target_text": "조약돌이지만 너한테는 작아지는 케이크가 될 거야.^n자.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00085",
      "source_text": "僕は、お医者様からもらったあの「おくすり」──^n砂糖で固められたチョコレートにしか見えないアレを、^nアリスの口に放り込んだ。",
      "source_raw_sha256": "577888B5F51992A9C961282E40EF82CB681D53CB6334F6D77520AAAA1EBF4C73",
      "target_text": "나는 의사 선생님에게 받은 그 『약』──^n설탕으로 굳힌 초콜릿으로밖에 보이지 않는 그것을,^n앨리스의 입에 던져 넣었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00086",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00087",
      "source_text": "あーーーーーーーー……んッ！？　んむむむ！？",
      "source_raw_sha256": "4CEA1C391E8572E9F8BDC2EAD5639C846379D3C4E22E7B030429670201CB514F",
      "target_text": "아────────……음!?　으므므므!?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00088",
      "source_text": "　慌てて口を閉じたアリス。^n　そのほっぺたがもにゅもにゅと動いて、^n「おくすり」を味わっているのがわかる。",
      "source_raw_sha256": "D314D2329DC6893C46FD2152EBF5D6187FD5B0E691ACDB33F5212FB496E3BFE9",
      "target_text": "　황급히 입을 다문 앨리스.^n　그 뺨이 오물오물 움직여,^n『약』을 맛보고 있다는 것을 알 수 있다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00089",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00090",
      "source_text": "あ……！^nきゃ、わ、あ……わあ！",
      "source_raw_sha256": "85EB8D26688562240731E6EA9EFBECFFCC865685A437A99C6ECB29242B6B98D6",
      "target_text": "아……!^n꺄, 와, 아…… 와아!",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00091",
      "source_text": "と、|素[す]っ|頓狂[とんきょう]な声を上げながら、アリスはお尻をもぞつかせた。^n突き上げるように揺らめかせるたび、^nパンツの|皺[しわ]がはしたない形をとる。",
      "source_raw_sha256": "03612C2780BECEF57FBA913BA9EAD8E882C06237174F7155E427E39B704717A5",
      "target_text": "그러고는 엉뚱한 소리를 지르며 앨리스가 엉덩이를 꿈틀거렸다.^n위로 치켜올리듯 흔들 때마다,^n팬티의 주름이 보기 민망한 모양을 이룬다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00092",
      "source_text": "頭の中で「小さくなって」いるんだろうか──^n僕は慌てて目を|逸[そ]らした。",
      "source_raw_sha256": "A938F6AA6EB7AC597448845D1509878742163989D8AC43E143BC6EA3A6D46C31",
      "target_text": "머릿속에서는 『작아지고』 있는 걸까──^n나는 황급히 시선을 돌렸다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00093",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00094",
      "source_text": "──抜けた！　抜けたわ、あたし！",
      "source_raw_sha256": "12068BF6385C58C897C0A97550D4C4344CE1065A67FE29E2D1368BFE9339856B",
      "target_text": "──빠졌어요!　빠져나왔어요, 저!",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00095",
      "source_text": "ややあって、アリスが解放される間抜けな音と、^n弾むような歓声が聞こえた。",
      "source_raw_sha256": "E7EDAB94BFB56CC033885C8880B34F4FD9E2010491D472F8CC0CD9B9BC5470F8",
      "target_text": "잠시 뒤 앨리스가 풀려나는 우스꽝스러운 소리와,^n튀어 오를 듯한 환호성이 들렸다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00096",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00097",
      "source_text": "ありがとう、ありがとう、あなた！",
      "source_raw_sha256": "55A17E6DFB763C9766EC48D04B9B149F78D30ABF770CB4348A7FC99C6B58EB17",
      "target_text": "고마워요, 고마워요!",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00098",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00099",
      "source_text": "よかったわ、あたし、今度こそ元の大きさに……。^n不自由なく生きていける、一人前のレディにふさわしい^nちょうどいい大きさに──",
      "source_raw_sha256": "60C445244A60CEE0E32CEEA99A303CC2DA6191807311197F8F286DE7FF9DB4CC",
      "target_text": "다행이에요. 이번에야말로 원래 크기로…….^n불편함 없이 살아갈 수 있는 어엿한 숙녀에게 어울리는^n딱 좋은 크기로──",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00100",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00101",
      "source_text": "あら、あら、あらあらあら！？",
      "source_raw_sha256": "4C3E32B5619C5CA166F3A24CA1FA0D67B0B6F1966A5B9AB20F75F8F66E4C0443",
      "target_text": "어머, 어머, 어머어머어머!?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00102",
      "source_text": "|狼狽[ろうばい]の声に、僕はアリスを見た。",
      "source_raw_sha256": "EEAABFBD9360DC079AD4CBFD141327C5CB2518820F07B3D9DF48684BE052E177",
      "target_text": "당황한 목소리에 나는 앨리스를 바라보았다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00103",
      "source_text": "どこかへ吸い込まれるような声を聞いて、^n今度は縮みすぎてしまったのではないか、と思った僕は^nだいぶ彼女にやられているのだろうか。",
      "source_raw_sha256": "CEC1BB4F09BEEFF0FD8D0DBA51909357B3561D90FAD5531E3522599A523CE6AE",
      "target_text": "어딘가로 빨려 들어가는 듯한 목소리를 듣고,^n이번에는 너무 작아진 것이 아닐까 생각한 나는^n상당히 그녀에게 휘둘린 모양이다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00104",
      "source_text": "アリスはドールハウスの前にぺたりと座り込んでいた。",
      "source_raw_sha256": "AA4AB763ACA63B8B017C5F3B3C394DC741E151CC655AEB4944D99BCE4C7ED6D7",
      "target_text": "앨리스는 인형의 집 앞에 털썩 주저앉아 있었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00105",
      "source_text": "僕と目が合うと、彼女はビクリと全身を震わせた。^nなんというか、逃げそびれて困ったといった感じの^n決まり悪い顔をしている。",
      "source_raw_sha256": "443792811D116B1363D95206FE847DAA77A845ACA7048D2FBE80F0E315A918C9",
      "target_text": "나와 눈이 마주치자 그녀는 흠칫 온몸을 떨었다.^n뭐랄까 도망칠 때를 놓쳐 곤란하다는 듯한^n멋쩍은 얼굴을 하고 있다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00106",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00107",
      "source_text": "あ、あの、ありがとう……。^nその──^nずいぶんと、効き目の強いケーキなのね。",
      "source_raw_sha256": "B6A1E69841FF4F6E5994FDA33AF73A225390393C19986DFAB1ECA04012942C12",
      "target_text": "저, 저기, 고마워요…….^n그──^n상당히 효과가 강한 케이크네요.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00108",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00109",
      "source_text": "え？",
      "source_raw_sha256": "AAD930B62C57B98C3EEF6A2F53093BA6B477BD165C065C6B06CF7FCF7ECFB57C",
      "target_text": "뭐?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00110",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00111",
      "source_text": "小さくなったのはいいけれど、小さくなりすぎたみたい……。",
      "source_raw_sha256": "3A8890587280F5EC392AB4FFD66CA8005BEF1282C4159EFE34B2CDE9DFA09115",
      "target_text": "작아진 것은 좋지만 너무 작아진 모양이에요…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00112",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00113",
      "source_text": "だってあなた、^n前に会った時はそんなに大きくなかったでしょう。^nあ、あの……踏まないでね、お願いだから。",
      "source_raw_sha256": "5AB76CA34C08A8249762B377B2215B9B177180282C5AA6F44C41405927796322",
      "target_text": "당신,^n전에 만났을 때는 그렇게 크지 않았잖아요.^n저, 저기…… 밟지 말아 주세요. 부탁이에요.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00114",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00115",
      "source_text": "え……いや、座ってるからじゃないの？^nほら。",
      "source_raw_sha256": "5ADFBB1F4DB58FFC8CEA2751632915F00DC5CB3A0099C7796C64BFA1FF39F7B4",
      "target_text": "뭐…… 아니, 앉아 있어서 그런 것 아니야?^n자.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00116",
      "source_text": "手を差し伸べると、アリスは|露骨[ろこつ]に|怯[おび]えた顔になって、^n座ったままずりずりと後ずさりをした。",
      "source_raw_sha256": "33D8BB886964A311C8EC475912D4685ABA070F6D13B48EB4356CF770C8885DC8",
      "target_text": "손을 내밀자 앨리스는 노골적으로 겁먹은 얼굴이 되어,^n앉은 채로 질질 뒤로 물러났다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00117",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00118",
      "source_text": "あ、あ、あ、あの、だ、大丈夫よ。^nあたし、ひとりで立てるから……。^nごめんなさいね、今は大きいあなたが怖いの。",
      "source_raw_sha256": "FF5AB7005E18458C1073B204D1A206828ED2A06249B1A7F6092CA0233418B17B",
      "target_text": "저, 저, 저, 저기, 괘, 괜찮아요.^n저 혼자 일어설 수 있으니까…….^n미안해요, 지금은 커다란 당신이 무서워요.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00119",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00120",
      "source_text": "だって、あなたからすれば^n今のあたしなんてアリか芋虫みたいな存在でしょう。",
      "source_raw_sha256": "6BCCF88EAFAEC157B6965EB576F47DF860FB6D11DCA98D9DB218611643C38F8C",
      "target_text": "당신이 보기에는^n지금의 저는 개미나 애벌레 같은 존재잖아요.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00121",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00122",
      "source_text": "そんなことはないけど……。^nああ……わかったよ。",
      "source_raw_sha256": "35E359A7386BDCCD73297953FDFEEA1933EB015650BE6A8C2149B2B22E4B043E",
      "target_text": "그렇지는 않지만…….^n아…… 알았어.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00123",
      "source_text": "僕は思い当たって、まだ開いていた「聖書」の^n次のページをめくった。",
      "source_raw_sha256": "99E82DE67F1161C6182FCEE1FE06AD3874E7AE6AE8711A3B2AE0276F16168F51",
      "target_text": "나는 문득 생각나 아직 펼쳐져 있던 『성서』의^n다음 페이지를 넘겼다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00124",
      "source_text": "それによると、ケーキで小さくなりすぎてしまったアリスは、^n家を出た後に普通サイズの子犬という化け物に出くわして、^nたいそう怖い思いをするようだった。",
      "source_raw_sha256": "BC9931BD49894440DEFAD37A3CE9F2A73F27F0A5ED1D5DDF206CBB8C912C5A18",
      "target_text": "내용에 따르면 케이크로 너무 작아진 앨리스는,^n집을 나온 뒤 보통 크기의 강아지라는 괴물과 마주쳐,^n몹시 무서운 경험을 하는 모양이다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00125",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00126",
      "source_text": "（やれやれ、大変なんだな）",
      "source_raw_sha256": "D7B61916C4C4282ED2831F4D63A743EC854A0DEF376CADFF4DFB7B5A0246FAA7",
      "target_text": "(원, 고생이네.)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00127",
      "source_text": "戸口に向かって離れると、アリスはまだ座ったまま^n|露骨[ろこつ]にホッとした顔をしていた。",
      "source_raw_sha256": "E3D8E5CFEE991C7BF365BF997513F8D4880EAA53ED07259BCE78C8E1E867E07E",
      "target_text": "문간으로 물러나자 앨리스는 여전히 앉은 채^n노골적으로 안도한 표정을 지었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00128",
      "source_text": "恩人なのにこの態度──^nでも、ムカムカするというよりも、哀れだ。",
      "source_raw_sha256": "CE9BB4E8D68BDA4D6B6E331D664E7D14B985FF49F609B5402BB951A8AE055108",
      "target_text": "은인에게 이런 태도라니──^n하지만 짜증이 난다기보다 가엾다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00129",
      "source_text": "廊下に出ると、ちょうど看護師さんが通りかかったところだった。",
      "source_raw_sha256": "CA0E62282CA9DBDF04C70DB073A92B168FC1EC712C35BA57EB68E3B4BA506514",
      "target_text": "복도로 나오자 마침 간호사 선생님이 지나가던 참이었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00130",
      "source_text": "看護師",
      "source_raw_sha256": "7C9BC55431F0BD999C9CBD3B5F2EF99ACBA567FB9D25297DB2871A3D7DF766FA",
      "target_text": "간호사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00131",
      "source_text": "あら、アリスちゃんとお話していたの。^nちょっと変わったところがあるけれど、悪い子じゃないからね。",
      "source_raw_sha256": "E1C9694211E8C3B821A1E58BD493EBC2C77069F0D746FD07AE6B877621AA9840",
      "target_text": "어머, 앨리스와 이야기하고 있었니?^n조금 특이한 데가 있지만 나쁜 아이는 아니란다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00132",
      "source_text": "この看護師さんは女の人だ。",
      "source_raw_sha256": "EF933FA8D7EC30A763B211E3289D7218365574C14F64864DD95AA965B6485756",
      "target_text": "이 간호사 선생님은 여자다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00133",
      "source_text": "僕が今し方体験したことを打ち明けると、^n看護師さんはあー、と|相槌[あいづち]を打ちながら悩ましい顔をした。",
      "source_raw_sha256": "9F31CC61B43965E943E391E5DF7DF35EBBEDEACAA9AE86F317D7D0D21A436B63",
      "target_text": "내가 방금 겪은 일을 털어놓자,^n간호사 선생님은 아, 하고 맞장구치며 난감한 얼굴을 했다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00134",
      "source_text": "看護師",
      "source_raw_sha256": "7C9BC55431F0BD999C9CBD3B5F2EF99ACBA567FB9D25297DB2871A3D7DF766FA",
      "target_text": "간호사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00135",
      "source_text": "　今のアリスちゃんはね、^n「不思議の国のアリス症候群」も同時に|患[わずら]っているのよ。",
      "source_raw_sha256": "DCC84EFBEE40D107AE2120818BDA82E5214FFCB974B1C2D31F910F56BF5B9990",
      "target_text": "　지금 앨리스는 말이지,^n『이상한 나라의 앨리스 증후군』도 함께 앓고 있어.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00136",
      "source_text": "看護師",
      "source_raw_sha256": "7C9BC55431F0BD999C9CBD3B5F2EF99ACBA567FB9D25297DB2871A3D7DF766FA",
      "target_text": "간호사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00137",
      "source_text": "「不思議の国のアリス症候群」は「|お伽話症候群[フェアリーテイル・シンドローム]」とは別で、^n　見えるものの大きさが不安定になってしまう病気。^n　ものがありえないほど大きく見えたり、小さく見えたりするの。",
      "source_raw_sha256": "0ECD362EC7CF7631E083A166C9509209CF7DB59C31F31798E41BFBB05DFA3590",
      "target_text": "『이상한 나라의 앨리스 증후군』은 『동화 증후군』과 별개로,^n　눈에 보이는 물건의 크기가 불안정해지는 병이야.^n　물건이 말도 안 되게 커 보이거나 작아 보이지.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00138",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00139",
      "source_text": "ああ、どうりで。",
      "source_raw_sha256": "10437FBBFF82D95D375AA711F128806CF97B2C60C9A1F37EEA4333274BF12FEE",
      "target_text": "아, 그래서.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00140",
      "source_text": "　アリスがドールハウスにはまって動けなくなったり、^n　抜け出した後「巨大な」僕に|怯[おび]えたりしたのは、^n「聖書」のせいだけではなくて、実際にそう見えていたからなんだ。",
      "source_raw_sha256": "DEB4A8D1496B2CCE9F6D398DE563367D2D469D650F8EF1DDCDA3E6B1A3FF8033",
      "target_text": "　앨리스가 인형의 집에 끼어 움직이지 못하고,^n　빠져나온 뒤 『거대한』 나를 무서워했던 것은,^n『성서』 때문만이 아니라 실제로 그렇게 보였기 때문이구나.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00141",
      "source_text": "看護師",
      "source_raw_sha256": "7C9BC55431F0BD999C9CBD3B5F2EF99ACBA567FB9D25297DB2871A3D7DF766FA",
      "target_text": "간호사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00142",
      "source_text": "ほんとねぇ、「不思議の国のアリス症候群」のせいで^nただでさえ深い病状が、もう一段階|厄介[やっかい]になっているのよね。",
      "source_raw_sha256": "479C6AC864A88AB0F3C9CBB83835035B89F711515F78196800D8D574AF8A62C2",
      "target_text": "정말이지 『이상한 나라의 앨리스 증후군』 때문에^n원래도 깊은 증상이 한 단계 더 까다로워졌어.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00143",
      "source_text": "看護師",
      "source_raw_sha256": "7C9BC55431F0BD999C9CBD3B5F2EF99ACBA567FB9D25297DB2871A3D7DF766FA",
      "target_text": "간호사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00144",
      "source_text": "本人が、毎日楽しそうにしているのが救いかしら。",
      "source_raw_sha256": "F9916D6F501464BDD21A76619CE0A863CBE897A47D633E4342B89EBB8328FD55",
      "target_text": "본인이 매일 즐거워 보이는 게 그나마 다행일까.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00145",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00146",
      "source_text": "（楽しそう、か……）",
      "source_raw_sha256": "D8676E7169E2BA5A741239232A792FCA69E238D35B471B2EC32B4C3C3959F466",
      "target_text": "(즐거워 보인다, 라…….)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00147",
      "source_text": "確かに、本気で困って、本気で|怯[おび]えていたアリスだけど、^n心の底では楽しんでいるのかもしれない。",
      "source_raw_sha256": "94A9BA0621C8F29F12FA21227B44205C3589CF138D72CC79F6DDB6A9BD6F261B",
      "target_text": "분명 진심으로 곤란해하고 진심으로 겁먹었던 앨리스지만,^n마음 깊은 곳에서는 즐기고 있는지도 모른다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1110.gsc::slot/00148",
      "source_text": "彼女の病室の電飾みたいに、^nいつもキラキラしているアリスの瞳を思って、^n僕は心から納得した。",
      "source_raw_sha256": "E821513936D269146DA1737F67B703D2DB0327CDFFFBF98D9FEE25B615F375EC",
      "target_text": "그녀의 병실 전구 장식처럼,^n늘 반짝이는 앨리스의 눈동자를 떠올리며,^n나는 진심으로 납득했다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    }
  ]
}
