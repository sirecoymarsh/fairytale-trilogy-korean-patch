  "review_passes_completed": 0,
  "release_ready": false,
  "entries": [
    {
      "uid": "scr.xfl::1112.gsc::slot/00226",
      "source_text": "オデット",
      "source_raw_sha256": "F217A5E379A89C13BBD7051450E207C13527FBE22024E0756D52AA104B755699",
      "target_text": "오데트",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00227",
      "source_text": "どれも素敵なお話ね。^n今の「楽園」には、そこから抜け出してきた^nアリスさんたちがいるんですよ。",
      "source_raw_sha256": "C4404F24CBD6FD8DE080859DD8E6B8431055FA937D1113D60A6D10147F870896",
      "target_text": "모두 멋진 이야기네.^n지금의 『낙원』에는 거기서 뛰쳐나온^n앨리스 씨들이 있어요.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00228",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00229",
      "source_text": "──ああ、みんな会ったよ。",
      "source_raw_sha256": "505181ED00AB7F8A4D6861446267118E1B7E3ADA363A5B201D2ADF9E9C5802EA",
      "target_text": "──응, 모두 만났어.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00230",
      "source_text": "オデット",
      "source_raw_sha256": "F217A5E379A89C13BBD7051450E207C13527FBE22024E0756D52AA104B755699",
      "target_text": "오데트",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00231",
      "source_text": "そう！　みんな、可愛らしくて素敵でしょ。^nわたし、今でも会うたびにドキドキするの。^nあのお話のあの人なんだって。",
      "source_raw_sha256": "B1A9823B90F8B407A89E7EB8142A0F5C0D335C31058865C541691BB5CCAE551E",
      "target_text": "그래요!　모두 귀엽고 멋지죠.^n저는 지금도 만날 때마다 두근거려요.^n그 이야기 속 그 사람이구나 하고.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00232",
      "source_text": "　僕自身も病人のはずなのに何だけれど、^n　自称「童話の登場人物」が童話を読んで、|憧[あこが]れて、^n「本人」同士が出会うなんて、なんだかシュールな気がする。",
      "source_raw_sha256": "22D51CFFBF73772C2E963810C1E20FD5170DC0ABB24B6166F697E41DAABD4BD4",
      "target_text": "　나 자신도 환자라 할 말은 아니지만,^n　자칭 『동화 속 등장인물』이 동화를 읽고 동경하며,^n『본인』끼리 만난다는 건 어딘가 초현실적으로 느껴진다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00233",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00234",
      "source_text": "オデットもそうだよね……？",
      "source_raw_sha256": "A1DD708B2A530AB1E8D70CF72560939AA733651016B8C030A476DFD594B4B13D",
      "target_text": "오데트도 그렇지……?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00235",
      "source_text": "オデット",
      "source_raw_sha256": "F217A5E379A89C13BBD7051450E207C13527FBE22024E0756D52AA104B755699",
      "target_text": "오데트",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00236",
      "source_text": "う……うん。",
      "source_raw_sha256": "B5E3906A5BD234458078699A61AC70CD887B0706FDFF26E70704E81523720007",
      "target_text": "으…… 응.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00237",
      "source_text": "何故か、歯切れ悪くオデットは|頷[うなず]いた。^n口調を改めて、話題を変える。",
      "source_raw_sha256": "37F105828C4FB328BC7FF29E21632085C88BDB41D82049633C4BF639F52507F8",
      "target_text": "어째서인지 오데트는 말끝을 흐리며 고개를 끄덕였다.^n말투를 고쳐 화제를 돌린다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00238",
      "source_text": "オデット",
      "source_raw_sha256": "F217A5E379A89C13BBD7051450E207C13527FBE22024E0756D52AA104B755699",
      "target_text": "오데트",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00239",
      "source_text": "ね、王子様はどんな物語が好きですか？^nわたし、まだ読んでいない本が沢山あるの。",
      "source_raw_sha256": "2105272F584A6DF7E72A4118B509FC924ED2A7C0CA592EF36FAF9073A2B5E466",
      "target_text": "저기, 왕자님은 어떤 이야기를 좋아하세요?^n저는 아직 읽지 않은 책이 아주 많아요.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00240",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00241",
      "source_text": "え？　ええと……そうだなぁ。",
      "source_raw_sha256": "ECC843D418234FE36DFDF5AC3AABF32CFC3E552BDEEFA44F2B743009FDC49831",
      "target_text": "뭐?　그러니까…… 글쎄.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00242",
      "source_text": "そんなに考える必要もなく、^nぽわんと頭の中に浮かび上がったものがある。",
      "source_raw_sha256": "3C8A11CFFA9B1947F5CCE675832E2C1921333AEC28AFD7353846CB71C030C27E",
      "target_text": "그렇게 고민할 필요도 없이,^n머릿속에 문득 떠오른 것이 있다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00243",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00244",
      "source_text": "ああ、そうだ。^nピーターパンが好きかな。",
      "source_raw_sha256": "F6E8549CA88AC5FAA7650F9FC643C432832CDA1B6498944A58A041D1C7FC0A1B",
      "target_text": "아, 맞다.^n피터 팬을 좋아하는 것 같아.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00245",
      "source_text": "オデット",
      "source_raw_sha256": "F217A5E379A89C13BBD7051450E207C13527FBE22024E0756D52AA104B755699",
      "target_text": "오데트",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00246",
      "source_text": "ピーターパン！^nわたし、まだ読んでいないです。^nいつも手にとって、戻すの。怖そうだから……。",
      "source_raw_sha256": "ADBD0DA800FACB6E4672CBC671A886FF5DF2C483882CB8B5A285CC1E2C170DC8",
      "target_text": "피터 팬!^n저는 아직 읽지 않았어요.^n언제나 집었다가 돌려놔요. 무서워 보여서…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00247",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00248",
      "source_text": "え、怖くないよ。",
      "source_raw_sha256": "849F5FC40AAC2B7031748195598D81E7718493F2B1E8E2AEA93FB5B49A6F0A64",
      "target_text": "뭐, 무섭지 않아.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00249",
      "source_text": "オデット",
      "source_raw_sha256": "F217A5E379A89C13BBD7051450E207C13527FBE22024E0756D52AA104B755699",
      "target_text": "오데트",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00250",
      "source_text": "ほんと？　怖くないんですか？^n──それなら、読んでみようかなぁ。",
      "source_raw_sha256": "BD5E4F2D2766C14005DB7F77055580986301FA77340FA6C3844AFB10D99EFFFF",
      "target_text": "정말요?　무섭지 않아요?^n──그렇다면 읽어 볼까.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00251",
      "source_text": "悩ましげなオデットの隣で、^n僕は僕で内心首を|傾[かし]げていた。",
      "source_raw_sha256": "A7F778EECEAB2AC37279AD9F9ED0CEEE6BA31A5F68C777F85F65F4E52B8075CC",
      "target_text": "고민하는 오데트 곁에서,^n나도 속으로 고개를 갸웃하고 있었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00252",
      "source_text": "　何の迷いもなくポンと出てきた^n「ピーターパン」という答え。^n　僕の本来の「聖書」はそれだったんだろうか。",
      "source_raw_sha256": "4819753137937A85EAB6FD6925C3C3236706C0B7ADBF8BADEC2FE60BB9FFDA9C",
      "target_text": "　아무 망설임 없이 툭 튀어나온^n『피터 팬』이라는 대답.^n　내 본래 『성서』가 그것이었을까.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00253",
      "source_text": "　しかし、考えれば考えるほど^n「柄じゃない」という気もする。",
      "source_raw_sha256": "AFD6FE569F52F619454EE705FDB194C8D33E4C011BF7987B57585311B7C27BB0",
      "target_text": "　하지만 생각하면 생각할수록^n『나답지 않다』는 느낌도 든다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00254",
      "source_text": "やんちゃで暴れん坊で|寂[さび]しがり屋の永遠の少年。^n──演じるとなると疲れそうだ。^nとなると、ただ単に好きだっただけなんだろうか。",
      "source_raw_sha256": "7E8D33683409C22EFE7F9D09EC99F888B713DF92F60C3165213ADC8B6764744A",
      "target_text": "장난꾸러기에 난폭하고 외로움을 타는 영원한 소년.^n──연기하려면 피곤할 것 같다.^n그렇다면 그저 좋아했을 뿐일까.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00255",
      "source_text": "オデット",
      "source_raw_sha256": "F217A5E379A89C13BBD7051450E207C13527FBE22024E0756D52AA104B755699",
      "target_text": "오데트",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00256",
      "source_text": "……王子様？^nジークフリート様、どうかしました？",
      "source_raw_sha256": "088195C1453DF3DF480D59FBAF985032CBCF81644B83B2AE0E91E69797E5F976",
      "target_text": "……왕자님?^n지크프리트 님, 무슨 일 있으세요?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00257",
      "source_text": "オデットに呼びかけられて、ハッと我に返る。",
      "source_raw_sha256": "DAF00C9A2DBB872782B94A9808F41B09FD0EA91F8D3DA247A015C8762BC86E7C",
      "target_text": "오데트가 말을 걸어 퍼뜩 정신을 차렸다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00258",
      "source_text": "そうだった。^n今の僕には「ジークフリート」という役柄がある。",
      "source_raw_sha256": "7CCF4945447AF8EE68001B9CEE202E9E792142A15874E6A305903FD2B33D6361",
      "target_text": "그랬다.^n지금의 내게는 『지크프리트』라는 역할이 있다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00259",
      "source_text": "何でもないよ、と首を横に振りながら^n僕は心にその名を刻むよう、自分に言い聞かせた。",
      "source_raw_sha256": "864969C24397643C82552E5D72AAC7C286129751C6FA6F66AD1E53D56D304574",
      "target_text": "아무것도 아니라고 고개를 저으며^n나는 마음에 그 이름을 새기듯 자신에게 되뇌었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00260",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00261",
      "source_text": "それが……わからないんだ。",
      "source_raw_sha256": "6501F358D7ACB53F6BA74BDFF3A61A67564A3D75E72B379F96013BC959AC90A6",
      "target_text": "그게…… 모르겠어.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00262",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00263",
      "source_text": "僕にはすべての記憶がない。^n自分がどんな名前で、どんな人間だったのか。^n何もわからないんだよ。",
      "source_raw_sha256": "383B56A2CA43BAFD3E6104F67156B8BA6B65B492FAD9732D626F7BD02716D353",
      "target_text": "내게는 모든 기억이 없어.^n내 이름이 무엇이고 어떤 사람이었는지.^n아무것도 몰라.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00264",
      "source_text": "僕は結局、正直に答えることにした。",
      "source_raw_sha256": "F98A04114BE1D7FE1DA83431A72B3D6EE0384C0D341FC092F8055EF604B98B15",
      "target_text": "나는 결국 솔직하게 대답하기로 했다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00265",
      "source_text": "言葉を|繋[つな]げれば|繋[つな]げるほど、そうしてよかったと思える。^nオデットを救いたいという気持ちは本物であったとしても、^n何も思い出せないのにそう名乗ってしまうのは、無責任じゃないか。",
      "source_raw_sha256": "11BFC9129AFD5146233D8A9528DFD5D10FE10021E81E82795940C0A87FA0E163",
      "target_text": "말을 이으면 이을수록 그러길 잘했다고 느낀다.^n오데트를 구하고 싶은 마음이 진짜라 해도,^n아무것도 기억나지 않는데 그런 이름을 대는 것은 무책임하지 않을까.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00266",
      "source_text": "オデット",
      "source_raw_sha256": "F217A5E379A89C13BBD7051450E207C13527FBE22024E0756D52AA104B755699",
      "target_text": "오데트",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00267",
      "source_text": "え……！",
      "source_raw_sha256": "4295AA57F73133794CCFF920A04010256510F1E41EF40BBBFA575E42CA45B384",
      "target_text": "네……!",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00268",
      "source_text": "オデットは衝撃を受けた様子で、^n金色の髪を波打たせながら僕を見た。",
      "source_raw_sha256": "E0C9DCDA189C2D2480F5D150E3AD57B02964E5B96904673E1E3DFE26DEC20607",
      "target_text": "오데트는 충격을 받은 듯,^n금빛 머리카락을 물결치며 나를 보았다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00269",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00270",
      "source_text": "「聖書」も──あったはずだけど、見つからない。^n　その、どこかで見かけたら、教えてね。",
      "source_raw_sha256": "C89BD86F43592E96134C709EF92C051E820657E71D1376EEDEE1D20A84201775",
      "target_text": "『성서』도──있었겠지만 찾지 못했어.^n　그, 어디선가 보면 알려 줘.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00271",
      "source_text": "オデット",
      "source_raw_sha256": "F217A5E379A89C13BBD7051450E207C13527FBE22024E0756D52AA104B755699",
      "target_text": "오데트",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00272",
      "source_text": "え、ええ、それはもちろん。^nけど、大変ね。記憶がない、なんて……。^n単に白鳥になるわたしより、ずっと大変だと思うの。",
      "source_raw_sha256": "E2CD80CCE741BA15F6BFF81D2D1490F64560A4663D6A268A10368AA7895FD480",
      "target_text": "네, 네. 그건 물론이죠.^n하지만 큰일이네요. 기억이 없다니…….^n그저 백조가 되는 저보다 훨씬 힘들 것 같아요.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00273",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00274",
      "source_text": "そ、そうかな？",
      "source_raw_sha256": "00C43EC4EF0BCEC0922B7C7749A1D9A101FC49D8F61165DDE265496FB6A538AE",
      "target_text": "그, 그런가?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00275",
      "source_text": "オデット",
      "source_raw_sha256": "F217A5E379A89C13BBD7051450E207C13527FBE22024E0756D52AA104B755699",
      "target_text": "오데트",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00276",
      "source_text": "そうよ、ええ。──やっぱりそうよ。^nちょっと想像しただけでも、怖くて苦しくて、^nどうしたらいいかわからなくなるもの。",
      "source_raw_sha256": "C87B33875322CA2046AFCD78B49123F1EE115B2B172FBE61D64EFF2D0633478D",
      "target_text": "그래요, 네. ──역시 그래요.^n조금 상상하기만 해도 무섭고 괴로워서,^n어떻게 해야 할지 모르게 되는걸요.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00277",
      "source_text": "束の間目を閉じて「記憶がない」状態を想像したらしい^nオデットは、不安そうに|眉[まゆ]をひそめて僕を見る。",
      "source_raw_sha256": "DCAD046C382E7DEC70933FD30CBEF8486E65C928D385A23070AF1520478398CA",
      "target_text": "잠시 눈을 감고 『기억이 없는』 상태를 상상한 듯한^n오데트는 불안한 듯 눈살을 찌푸리며 나를 본다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00278",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00279",
      "source_text": "　そうかな。そこまで怖くはないし、苦しくもないよ。^n「ない」のが当たり前だと、「ある」ことのありがたさが^n　よくわからないのかも。",
      "source_raw_sha256": "91CEE0EA682216B3D008F08698DC24B3763012B0BE85949EE81017FC69BA0D6F",
      "target_text": "　그럴까. 그렇게 무섭거나 괴롭지는 않아.^n『없는 것』이 당연하면 『있는 것』의 고마움을^n　잘 모르는 걸지도 몰라.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00280",
      "source_text": "オデット",
      "source_raw_sha256": "F217A5E379A89C13BBD7051450E207C13527FBE22024E0756D52AA104B755699",
      "target_text": "오데트",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00281",
      "source_text": "──あなた、強いのね。すごい。",
      "source_raw_sha256": "DADAD6E0913912F0161663050CC7F9F4FD0A00060B8594D74EC3CC3ECB98D508",
      "target_text": "──당신은 강하군요. 대단해요.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00282",
      "source_text": "オデット",
      "source_raw_sha256": "F217A5E379A89C13BBD7051450E207C13527FBE22024E0756D52AA104B755699",
      "target_text": "오데트",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00283",
      "source_text": "大丈夫よ、きっと。^n忘れているのは今だけで、いつか思い出せる。",
      "source_raw_sha256": "D640722D44F84249BAF5117653E928CC26F9928A2F6A0CF5D89F4704650AA9F8",
      "target_text": "분명 괜찮을 거예요.^n잊은 것은 지금뿐이고 언젠가 떠올릴 수 있어요.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00284",
      "source_text": "オデット",
      "source_raw_sha256": "F217A5E379A89C13BBD7051450E207C13527FBE22024E0756D52AA104B755699",
      "target_text": "오데트",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00285",
      "source_text": "あなたのことを誰かが憶えているかもしれないし、^nなくした「聖書」が見つかるかもしれないし。^nわたしだって探すわ。がんばるから。",
      "source_raw_sha256": "340613F10EE592418F3FB32E87497783950467F27D7E24E36ADA78EDB50211FC",
      "target_text": "당신을 기억하는 사람이 있을지도 모르고,^n잃어버린 『성서』가 발견될지도 모르고.^n저도 찾아볼게요. 노력할게요.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00286",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00287",
      "source_text": "──ありがとう。",
      "source_raw_sha256": "28A30CD442043900B11FB0C586323234028CAAD1947BAABF88D1D81657239B49",
      "target_text": "──고마워.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00288",
      "source_text": "必死で言葉を選んでいる様子が伝わってきて、^n僕にはその気持ちが嬉しかった。",
      "source_raw_sha256": "DE4B405C621C00001C06091C8190E4621F7BBF115BE93BD477BB8E60AA28EFF9",
      "target_text": "필사적으로 말을 고르는 것이 전해져,^n나는 그 마음이 기뻤다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00289",
      "source_text": "同時に、こんなにも僕のことを|憂[うれ]いてくれる^n彼女自身の幸せについて考えると、心が重たくなった。",
      "source_raw_sha256": "CEEFD316489E29D7021D53D0E2D3B397837F338D3E493091181C1214C293034B",
      "target_text": "동시에 이토록 나를 걱정해 주는^n그녀 자신의 행복을 생각하니 마음이 무거워졌다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00290",
      "source_text": "この「楽園」のオトナたち、お医者様や看護師さんたちが^n一刻も早く、オデットの病を治してくれるといい。",
      "source_raw_sha256": "838D05DB352BC40C70B628181B12F67A577971DA025FA056810C0B0ACBE53F26",
      "target_text": "이 『낙원』의 어른들, 의사와 간호사 선생님들이^n하루빨리 오데트의 병을 고쳐 주면 좋겠다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1112.gsc::slot/00291",
      "source_text": "そんなことを願いながら、僕はオデットと一緒に^n深い雲に閉ざされていく満月を見つめていた。",
      "source_raw_sha256": "592662139D1BB792089B87AD4ADC3311319922CA99A494C2C9C4C756C39DAFE5",
      "target_text": "그렇게 바라며 나는 오데트와 함께^n짙은 구름에 갇혀 가는 보름달을 바라보았다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    }
  ]
}
