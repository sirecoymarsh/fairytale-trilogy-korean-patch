  "translation_method": "Codex internal model only; no external MT/API",
  "review_passes_completed": 0,
  "release_ready": false,
  "entries": [
    {
      "uid": "scr.xfl::1114.gsc::slot/00061",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00062",
      "source_text": "落ち着かない風景のはずなのに、^nどうしてこうも馴染んでしまっているのかしらね、私は。",
      "source_raw_sha256": "4FCB6A1DC9F244830E3D48A45150969E52661581BC6968C0C1D0F45C9497E8F4",
      "target_text": "마음이 편치 않아야 할 풍경인데도,^n어째서 이렇게 익숙해져 버린 걸까, 나는.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00063",
      "source_text": "独り言のようにゲルダは|呟[つぶや]く。",
      "source_raw_sha256": "80997ACF6B0434C61CD63E5E399CC09CF9E9162EF0F5B11CE40C6064B14467D9",
      "target_text": "게르다는 혼잣말처럼 중얼거린다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00064",
      "source_text": "──彼女の中では、何が起きているんだろう。^nやはり「|お伽話症候群[フェアリーテイル・シンドローム]」から覚めかけているんだろうか。",
      "source_raw_sha256": "19A62E4AC4C46934B1C2F77858C52676C197902169B7A10436210C891D2750CC",
      "target_text": "──그녀 안에서는 무슨 일이 벌어지고 있는 걸까.^n역시 『동화 증후군』에서 깨어나기 시작한 걸까.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00065",
      "source_text": "けれど、それを聞くのははばかられた。^nきっとそういうのはお医者様がやってくれるはず。",
      "source_raw_sha256": "F25336F1DA0B111B90C6DB65EB860451D60548F62DBEDBCFA11B1A4039B3B275",
      "target_text": "하지만 그걸 묻기는 망설여졌다.^n분명 그런 건 의사 선생님이 해 줄 테니까.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00066",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00067",
      "source_text": "その……僕は、昼間きみが言っていたことが気になったんだ。",
      "source_raw_sha256": "9EF90B930E7248A2173198B4EE1DDAD90BF4CBE075A53BB4372DE043638C374C",
      "target_text": "그…… 낮에 네가 했던 말이 마음에 걸렸어.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00068",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00069",
      "source_text": "昼間、私が？",
      "source_raw_sha256": "FA999ADE3DD247EA465E6EDC10C85BBB39F04AC1D4433C3712C738120D98C4C7",
      "target_text": "낮에 내가?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00070",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00071",
      "source_text": "　うん。^n「何をしたかったか」を思い出すべきだって。^n　強い願いがあるのなら、|忘却[ぼうきゃく]と戦わなければって。",
      "source_raw_sha256": "A4A1A16D21077A881244E08C2DFE0854F556457E747E5658FC86988421AE9463",
      "target_text": "　응.^n『무엇을 하고 싶었는지』를 떠올려야 한다고.^n　강한 소망이 있다면 망각과 싸워야 한다고 했잖아.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00072",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00073",
      "source_text": "──ええ。^nその通りだと思うわ。",
      "source_raw_sha256": "96B7528B1193E424876C232AA2CE03824199CB16D8B5325EFBC6EAA1A7D6BA03",
      "target_text": "──응.^n그 말이 맞다고 생각해.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00074",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00075",
      "source_text": "僕にはそんなものが、^nあったのかなかったのかさえわからないけど。^nゲルダにはきっとあるんだよね。",
      "source_raw_sha256": "ECF8C1F7117D17949D2F78D081723D3C354EF220B0E190317CE71347DA8E3EF6",
      "target_text": "내게는 그런 게^n있었는지조차 알 수 없지만.^n게르다에게는 분명 있지?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00076",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00077",
      "source_text": "え……。",
      "source_raw_sha256": "F06DF0F5786A3D6D5071D29D2EE2345E95EA94A6CED70D83B9A418A73EFE97E9",
      "target_text": "어…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00078",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00079",
      "source_text": "そんな気がしたんだ。^nきみ自身に強い願いがあるから、そう思うんだろうって。",
      "source_raw_sha256": "79F27E9B6AE2320FF7CA4BBA236B8B78A0B4A4B015334EB547C3C1E559B58DA7",
      "target_text": "그런 느낌이 들었어.^n네게 강한 소망이 있으니까 그렇게 생각하는 거라고.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00080",
      "source_text": "ゲルダは目を|瞑[つむ]り、僕の言葉を|噛[か]みしめるように|頷[うなず]いた。",
      "source_raw_sha256": "21484DC1A3387B8F4DCA47C7EE95053582CD3D9EA34E33408C4217FD489117D8",
      "target_text": "게르다는 눈을 감고 내 말을 곱씹듯 고개를 끄덕였다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00081",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00082",
      "source_text": "ええ、その通りだわ。^nというか──私だって、あなたとそう変わらないのよ。",
      "source_raw_sha256": "134437BC5E1C92329D07D6164F1B022869B837F3E219B7B5249FCBF8AFA99FA7",
      "target_text": "응, 맞아.^n아니──나도 너와 크게 다르지 않아.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00083",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00084",
      "source_text": "私には、「行くべきところ」があったはず。",
      "source_raw_sha256": "2906919E8CA4FA52F64DFF10B7EB19C09CDEB2759141A9FC5B9AD883C1AB69EA",
      "target_text": "내게는 『가야 할 곳』이 있었을 거야.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00085",
      "source_text": "ゲルダは両の拳を、音がしそうなほど固く握りしめる。",
      "source_raw_sha256": "9186F04FC34B8549B41EDC2D5015A1EB40EF7C7AB7DC324C82E024A2EEFC5E63",
      "target_text": "게르다는 소리가 날 만큼 두 주먹을 세게 움켜쥐었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00086",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00087",
      "source_text": "「行くべきところ」──",
      "source_raw_sha256": "9A88D2F41803BAC7B52510197BC17265E8067123E748AB10DF20F5FD8B9C8F03",
      "target_text": "『가야 할 곳』──",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00088",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00089",
      "source_text": "──私にはあるの、あったはずなの。^nこのままではいけない、何かが足りない。^nそう思っているのに、思い出せない。",
      "source_raw_sha256": "4D939B1293BDB5692933C77319FC815F40D0F32A90EFB6063DB18DD86B55275E",
      "target_text": "──내게는 있어, 있었을 거야.^n이대로는 안 돼, 무언가 부족해.^n그렇게 생각하면서도 떠오르지 않아.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00090",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00091",
      "source_text": "…………。",
      "source_raw_sha256": "0A0A39A23D968038B6135EB7825A35667F28EF942D728F4925E6018672732E6B",
      "target_text": "………….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00092",
      "source_text": "それは「ゲルダ」としてのものなんだろうか。^nそれとも、「ゲルダ」の仮面をかぶる前の、素の彼女？",
      "source_raw_sha256": "E79F44F4ECC3720874D638DBC6E53227CFEDD5D417C2DCE4F14EDEBA67108A69",
      "target_text": "그건 『게르다』로서 품은 것일까.^n아니면 『게르다』의 가면을 쓰기 전, 본래의 그녀가 품은 것일까?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00093",
      "source_text": "薔薇の花を──",
      "source_raw_sha256": "61D38F51922D4FB1706985CFDCCFD19B61D75C7F55243FD65A0A5472FF5F11F4",
      "target_text": "장미꽃을──",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00094",
      "source_text": "持っている。",
      "source_raw_sha256": "8D891DC5A2D1A7472E222AA3E6E2C1839F18B3FC7BD1B042CB9F655FD6AF6A9A",
      "target_text": "가지고 있다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00095",
      "source_text": "持っていない。",
      "source_raw_sha256": "3684C52D88C331771979F9023BC403B95CDE5F75BE2C076AFDDBCC4F98C988B8",
      "target_text": "가지고 있지 않다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00096",
      "source_text": "どちらにしても、彼女がゲルダである以上、^n僕にはその閉ざされた記憶を解放する心当たりがあった。",
      "source_raw_sha256": "DF05D2AE2385F6871BE464D6BA1781658EA2EA546BEE93EE1B9B754B2BB2988E",
      "target_text": "어느 쪽이든 그녀가 게르다인 이상,^n나는 그 굳게 닫힌 기억을 풀어낼 실마리를 알고 있었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00097",
      "source_text": "これは、「雪の女王」の本で見かけた展開なのだ。",
      "source_raw_sha256": "CB1E4ADB7DB2D4FC8370B86DF173B0C97D60D1785866B2C79BD367F997BA6EA2",
      "target_text": "이건 『눈의 여왕』 책에서 본 전개다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00098",
      "source_text": "心を凍らされて|失踪[しっそう]したカイを探しに旅立ったゲルダ。^n最初に出会った老婆はゲルダを気に入り、^nずっと自分の手元に置くために記憶を消してしまう。",
      "source_raw_sha256": "5A5FA98C4C3E15A918CA4AE705B90FCE619586E3C692F590153856C4C667C8CF",
      "target_text": "얼어붙은 마음으로 실종된 카이를 찾아 길을 떠난 게르다.^n처음 만난 노파는 게르다를 마음에 들어 해,^n영원히 곁에 두고자 기억을 지워 버린다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00099",
      "source_text": "ゲルダが記憶を取り戻すきっかけとなったのは、^nカイとの絆の象徴であり、^nそれゆえに老婆が忘れさせていた「薔薇」の存在だった。",
      "source_raw_sha256": "449A1BE0F5EBFF28118D2E857ACF47092AFE4C295E849C50F1DBD1A874AB4945",
      "target_text": "게르다가 기억을 되찾은 계기는^n카이와의 유대를 상징하며,^n그 때문에 노파가 잊게 했던 『장미』의 존재였다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00100",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00101",
      "source_text": "……！^nそれは……。",
      "source_raw_sha256": "AD99DA3A2013C9093CF13DBF6531B8E5B16F53CDBCD764D7EFF68B51E1CD5177",
      "target_text": "……!^n그건…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00102",
      "source_text": "僕がポケットの中から取り出した薔薇を見て、^nゲルダは大きく目を見開いた。",
      "source_raw_sha256": "26A69DCC81E31BB9F6BFA79FDA608D6109C29706893DA91EDC533DCC5FB218C5",
      "target_text": "내가 주머니에서 꺼낸 장미를 보고,^n게르다는 눈을 크게 떴다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00103",
      "source_text": "思わず、といった感じで伸ばされた手が、^n直前で不作法に気づいて止まる。",
      "source_raw_sha256": "20706EC32B10319CCE12A5C1F4452D4BFB93458D162CA06768659FD5B11B877D",
      "target_text": "무심코 뻗은 듯한 손이^n닿기 직전에 무례하다는 걸 깨닫고 멈춘다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00104",
      "source_text": "僕は、その半ば|諦[あきら]めたように指を握る手に^n薔薇の|茎[くき]を握らせた。",
      "source_raw_sha256": "5501E956F5B5F7E742EA142BE6D08AAD4AC459D426EEFF8577A23EA739715570",
      "target_text": "나는 반쯤 포기한 듯 손가락을 오므리는 그 손에^n장미 줄기를 쥐여 주었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00105",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00106",
      "source_text": "あ……。",
      "source_raw_sha256": "1DA33B8724CF5322E55F21F6F37BD34A25B2A3AE5475B15DD45F503E9F718B0B",
      "target_text": "아…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00107",
      "source_text": "ゲルダの雪の結晶みたいな瞳が、揺らいだ。^n薔薇が震えているのは、それを持つゲルダの手の震えが^n伝わっているせいだろうか。",
      "source_raw_sha256": "E017F14D330E80A8E19A40AA9E93BF7EEDF59ADE1A3FF3FE7B6C0CA8CDF15FD7",
      "target_text": "눈의 결정 같은 게르다의 눈동자가 흔들렸다.^n장미가 떨리는 건 그것을 든 게르다의 손이 떠는 바람에^n그 진동이 전해져서일까.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00108",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00109",
      "source_text": "「薔薇の花、香る谷間に──」",
      "source_raw_sha256": "03DB87865F19C7164549CED598D0651BE653689AC9552F5F024C74852DECE4BB",
      "target_text": "『장미꽃, 향기로운 골짜기에──』",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00110",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00111",
      "source_text": "……！",
      "source_raw_sha256": "1A8E369E83AAD9740790D4F7808856D5E3967EFEEEC267023E41E843C8936E62",
      "target_text": "……!",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00112",
      "source_text": "細い呼吸を繰り返すゲルダの唇の隙間から、突然、^nそんな一節が|紡[つむ]がれた。",
      "source_raw_sha256": "640B9795D32BA7F6EC21AA1D808EB6002919E23F54064ABF7F24B52851FBEBFD",
      "target_text": "가쁜 숨을 거듭 내쉬는 게르다의 입술 사이에서 갑자기^n그런 한 구절이 흘러나왔다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00113",
      "source_text": "──聞き覚えがある。いや、見覚えか。",
      "source_raw_sha256": "4751B9998B67F77C735C1BA4759BD46270F3A444496BB56770168991E5731677",
      "target_text": "──들어 본 기억이 있다. 아니, 본 기억인가.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00114",
      "source_text": "「雪の女王」に書いてあった。^n　ゲルダがカイと口ずさんでいた思い出のフレーズだ。",
      "source_raw_sha256": "1AFE1D072045D91227EB8E7DB86721FAB24AF79DA7BEDD4FBD00E859907F0D8F",
      "target_text": "『눈의 여왕』에 쓰여 있었다.^n　게르다가 카이와 흥얼거리던 추억의 구절이다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00115",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00116",
      "source_text": "──ッ！",
      "source_raw_sha256": "35F65F9F46A25D5CAE0205B8EACE3C48817C0CD8ED94E1AAEB9BB55B008DE435",
      "target_text": "──읏!",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00117",
      "source_text": "ゲルダは、知らぬ間に口ずさんでいた自分自身に^nギョッとした様子で息を|呑[の]んだ。",
      "source_raw_sha256": "F03C0CF1037F853A3493DA54DAABEBCFFE1C8F1202F1551B3065BF70605B7A2E",
      "target_text": "게르다는 자기도 모르게 흥얼거린 자기 자신에게^n깜짝 놀란 듯 숨을 삼켰다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00118",
      "source_text": "手から、薔薇が滑り落ちる。",
      "source_raw_sha256": "2FBAAE861A4C9D9B0D748E9DA685D46EA74ED00B78A24CDD906EB3426FA06F3C",
      "target_text": "손에서 장미가 미끄러져 떨어진다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00119",
      "source_text": "ゲルダは空っぽになったてのひらを見つめて、^nやがてその手で顔を|覆[おお]った。",
      "source_raw_sha256": "08E6BB9EAEC201912565A99D211F4076F95345E52D2F21D166087F38FFBE8B8C",
      "target_text": "게르다는 텅 빈 손바닥을 바라보다가,^n이윽고 그 손으로 얼굴을 가렸다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1114.gsc::slot/00120",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    }
  ]
}
