  "entries": [
    {
      "uid": "scr.xfl::1116.gsc::slot/00141",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00142",
      "source_text": "ん、んんッ……は、はいっ。^nご、ごびょう……。",
      "source_raw_sha256": "410DD5B4C362D0D0B6F900D8C85E94E7F97B21A0AE491925FD97BFA3E9A30EA8",
      "target_text": "응, 으응…… 네, 네.^n오, 5초…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00143",
      "source_text": "グレーテルはホッと息をついて、自分に言い聞かせる。",
      "source_raw_sha256": "AE669A2F9D0F93CDBD23C6D6E90D55CF29AF999EC848133638C4F083AAFC4195",
      "target_text": "그레텔은 안도의 숨을 내쉬고 스스로에게 되뇐다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00144",
      "source_text": "医者",
      "source_raw_sha256": "1285809FCD66C2F753A0A086F75DD97DED40DD9BB52FBB18B57107E1BC64FB29",
      "target_text": "의사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00145",
      "source_text": "はい、ごー、",
      "source_raw_sha256": "A7D47ACA10EC4DB90F98263E7A5A0591E5B27CCC23048BF82B2F616E7758AABB",
      "target_text": "자, 다서엇,",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00146",
      "source_text": "よーん、",
      "source_raw_sha256": "F34DD16122A0F366FF879CA698F113EB3940D8C35C3A5C371A83C5567CA2BF23",
      "target_text": "네에엣,",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00147",
      "source_text": "さーーーーん。^n",
      "source_raw_sha256": "12FFAE96752AD19D3BC30666219B688A85877FC33840DED229C3D1F5E3E704C2",
      "target_text": "세에에에엣.^n",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00148",
      "source_text": "^d2……にーーーーーー。^n",
      "source_raw_sha256": "40DBEFBEDBE423A06BE5646B87B1C3B138326CF3F60A3AB3EB52079FD2E3A67B",
      "target_text": "^d2……두우우우우울.^n",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00149",
      "source_text": "^d2…………いーーーーーーーーーち。",
      "source_raw_sha256": "FA80ACCE2E4DA77C69B20802C579EB81F3A8DCF3C37E727003E8CC270409AB94",
      "target_text": "^d2…………하아아아아아아아나.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00150",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00151",
      "source_text": "んっ、ん……っ……。^n──ぇ？",
      "source_raw_sha256": "5322320B2106AAB0C63C7151AA2970F72CA6C50559DC22680D55981BFA7D27D5",
      "target_text": "응, 으응…….^n──어?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00152",
      "source_text": "医者",
      "source_raw_sha256": "1285809FCD66C2F753A0A086F75DD97DED40DD9BB52FBB18B57107E1BC64FB29",
      "target_text": "의사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00153",
      "source_text": "…………。",
      "source_raw_sha256": "0A0A39A23D968038B6135EB7825A35667F28EF942D728F4925E6018672732E6B",
      "target_text": "………….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00154",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00155",
      "source_text": "ふぁ、あ、や、や……っ。^n……っ、な、どうして。^nもう、ごびょ、たって……ひゃぅ！",
      "source_raw_sha256": "B9DFACA35E4F21C105BCDB67B4C60D88BAFBE916DF62314772FD80FF651C507B",
      "target_text": "후아, 아, 시, 싫…….^n……으, 왜요.^n벌써 5초, 지났…… 히야!",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00156",
      "source_text": "医者",
      "source_raw_sha256": "1285809FCD66C2F753A0A086F75DD97DED40DD9BB52FBB18B57107E1BC64FB29",
      "target_text": "의사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00157",
      "source_text": "^d3──ぜーろ。",
      "source_raw_sha256": "98E83659CB37CC794282E74BF18DB6754814B0587899C180D0CEFBDA5EA65C0F",
      "target_text": "^d3──제에로.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00158",
      "source_text": "最後に乳首をつまんだ指にギュッと力を入れて、^nお医者様は両手を離した。",
      "source_raw_sha256": "BA6085B6A8CF77BB295831661BF1AD63AE4AEE5316429A45680A1A78A4823DF4",
      "target_text": "마지막으로 유두를 꼬집은 손가락에 꽉 힘을 주고,^n의사 선생님은 두 손을 놓았다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00159",
      "source_text": "医者",
      "source_raw_sha256": "1285809FCD66C2F753A0A086F75DD97DED40DD9BB52FBB18B57107E1BC64FB29",
      "target_text": "의사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00160",
      "source_text": "うーん、グレーテルちゃんは心拍数早いねー。^n将来コウケツアツとかシンゾウビョウに気をつけてね。",
      "source_raw_sha256": "E8B17A3B3071A93D98DF54B3997877A206E6905BA3EF7EE3B4217BA3C42FA890",
      "target_text": "음, 그레텔은 심박수가 빠르구나.^n나중에 고혈압이나 심장병을 조심하렴.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00161",
      "source_text": "グレーテルは、お医者様の言葉をほとんど聞いていない。^n後ろのかごに置いてあった衣服に飛びついて、^nまとうのに必死で。",
      "source_raw_sha256": "A0E543B298A6885A95BDD19F665D882D1CEDE3886AE95A157F00230A62A63B64",
      "target_text": "그레텔은 의사 선생님의 말을 거의 듣지 않는다.^n뒤쪽 바구니에 놓인 옷에 달려들어,^n몸에 걸치느라 필사적이다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00162",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00163",
      "source_text": "コウケツアツ……シンゾウビョウ！^nなんだか危険なお名前の病気ね。^nグレーテル、気をつけないと。",
      "source_raw_sha256": "4822404D893C00A49FB90D240CC5351B290A1544632D3ACACE849897CF42679C",
      "target_text": "고혈압…… 심장병!^n왠지 위험한 이름의 병이네.^n그레텔, 조심해야 해.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00164",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00165",
      "source_text": "うぅ……。",
      "source_raw_sha256": "FD37558C0DB0BEE11F9C220198A4F838B3CF678CEB8ECBEE2D297ECEF29B70B5",
      "target_text": "으으…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00166",
      "source_text": "グレーテルは涙目で、ゆっくりと着替えているアリスを見る。^n病気の恐怖に|怯[おび]えているのはせいぜい半分で、^n残りの半分は「ほんとかなぁ？」と|訴[うった]えているようだ。",
      "source_raw_sha256": "DEB4F230FE679AFE91A25F44C48914D3D6226E380AE2C4BEA048C733F0D8D80B",
      "target_text": "그레텔은 눈물을 글썽이며 천천히 옷을 입는 앨리스를 본다.^n병이 무서워 떠는 마음은 기껏해야 절반이고,^n나머지 절반은 『정말일까?』라고 호소하는 듯하다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00167",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00168",
      "source_text": "先生、先生。^nコウケツアツやシンゾウビョウには、^nどんなお菓子が効くのかしら？",
      "source_raw_sha256": "672625C1B754180E0EBA6DA47D861A130D5E12B1EEB225EA8D0A298ABC38D406",
      "target_text": "선생님, 선생님.^n고혈압이나 심장병에는^n어떤 과자가 잘 들어요?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00169",
      "source_text": "医者",
      "source_raw_sha256": "1285809FCD66C2F753A0A086F75DD97DED40DD9BB52FBB18B57107E1BC64FB29",
      "target_text": "의사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00170",
      "source_text": "あんまりお菓子はよくないなー。^nやっぱりお野菜だよね。^nそれから規則正しい生活と、適度な運動。",
      "source_raw_sha256": "BC893004E2789EEDBC0D30521F7301BC9E4E1877FA95B59F97BAFC2D34BCCB18",
      "target_text": "과자는 별로 좋지 않단다.^n역시 채소를 먹어야지.^n그리고 규칙적인 생활과 적당한 운동.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00171",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00172",
      "source_text": "グレーテル、聞いた？^n今度のおやつはキャロットケーキにしましょうね。",
      "source_raw_sha256": "A1812A48FB9BA613192EB046DD424E786454D363E3D8C716362FD1D1D36F0ABE",
      "target_text": "그레텔, 들었어?^n다음 간식은 당근 케이크로 하자.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00173",
      "source_text": "医者",
      "source_raw_sha256": "1285809FCD66C2F753A0A086F75DD97DED40DD9BB52FBB18B57107E1BC64FB29",
      "target_text": "의사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00174",
      "source_text": "いやいやだから、お菓子はよくな",
      "source_raw_sha256": "D2147F8378A5C5881C84D40CE2997B95CBB12EC21EE18022B3DD27962BE69AE7",
      "target_text": "아니, 아니, 그러니까 과자는 좋지 않",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00175",
      "source_text": "ブツ。",
      "source_raw_sha256": "68708546581F32F463D5E5C259783EF051DD599113D2E92B437C04B848BB2465",
      "target_text": "뚝.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00176",
      "source_text": "唐突に、目にしていた世界のすべてが消えた。^nモニターの電源が切れたのだ。",
      "source_raw_sha256": "61FBF34F3C529B27E28A77F467907BE3D09CF4B8E07990CDB91A69571C859717",
      "target_text": "갑자기 눈앞에 있던 세계가 모조리 사라졌다.^n모니터의 전원이 꺼진 것이다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00177",
      "source_text": "僕はまばたきを繰り返した。^n夢から覚めたような心地だった。^nなまぬるい部屋の空気。冷えていく汗。",
      "source_raw_sha256": "7AB6C647BE517A71C706356C33593395AF9BCC3B17F66BAC02A078D82D284DFC",
      "target_text": "나는 몇 번이나 눈을 깜박였다.^n꿈에서 깨어난 듯한 기분이었다.^n미지근한 방 안 공기. 식어 가는 땀.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00178",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00179",
      "source_text": "（今の、何だったんだろう……）",
      "source_raw_sha256": "3543C67D77E137F10898A4C26A8699794925A4C001AAB1AB946A8A61850E1B48",
      "target_text": "(방금 건 뭐였을까…….)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00180",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00181",
      "source_text": "（アリスとグレーテルが、診察室で……。^n　──診察されていたんだ、よね。^n　ただそれだけで……）",
      "source_raw_sha256": "34698EF8A25B2A6E7BEF58D8DABF7F96CB05445F62FFEDC2356AD4C39B602345",
      "target_text": "(앨리스와 그레텔이 진찰실에서…….^n　──진찰을 받고 있었던 거지.^n　그저 그것뿐이고…….)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00182",
      "source_text": "僕は必死に自分に言い聞かせた。",
      "source_raw_sha256": "BA0506B7249889FE249AC09DF44031A73C5F7E0F45643B8FFFD522BBD409B098",
      "target_text": "나는 필사적으로 자신을 타일렀다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00183",
      "source_text": "そう。^nお医者様はちゃんとお仕事をしているだけで、^nいかがわしいことなんてひとつもないんだ。",
      "source_raw_sha256": "91631AB03D6823A87050172B22BD17FD7C802DB3AE5B4FA0923F602706825117",
      "target_text": "그래.^n의사 선생님은 제대로 자기 일을 했을 뿐이고,^n수상쩍은 짓은 하나도 없었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00184",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00185",
      "source_text": "（だったとしても。^n　どうして診察室にカメラがあるの。^n　どうしてそれが僕の部屋に流れてきたの）",
      "source_raw_sha256": "BC58A049C248AD3E6C1CC13E55286C2F32A9AE1F7C8440BC7C2801429E8BA1E7",
      "target_text": "(그렇다 해도.^n　왜 진찰실에 카메라가 있는 거지?^n　왜 그 영상이 내 방으로 흘러온 거야?)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00186",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00187",
      "source_text": "（ううん、何かの間違い……だよね。^n　そうだよ。きっと機械の故障か何か）",
      "source_raw_sha256": "499B76B059A69E056B87C5D4777F3770A56FBB219A741B8E28BF752CC869B331",
      "target_text": "(아니야, 뭔가 잘못된…… 거겠지.^n　그래. 분명 기계 고장 같은 거야.)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00188",
      "source_text": "浮かび上がる疑問になんとか理由をつけて、^n片づけたところで別の不信に襲われて。",
      "source_raw_sha256": "F6D31657B984E23B3F19783F3BED6B00FA4C66B664E7F69DB82B485AB3952F3A",
      "target_text": "떠오르는 의문에 어떻게든 이유를 붙여^n정리하고 나면 또 다른 불신이 덮쳐 오고.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00189",
      "source_text": "それでも、^n自分が目を|逸[そ]らさずにあの光景を見続けたことについては、^nどうしても|誤魔化[ごまか]しようがない。",
      "source_raw_sha256": "51D033630F7269F9395F9BA46A7B469041B8507FD76B7EF565E91E70439807A4",
      "target_text": "그래도^n내가 눈을 돌리지 않고 그 광경을 계속 보았다는 사실만큼은^n도저히 얼버무릴 수 없다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00190",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00191",
      "source_text": "（──気持ち悪い）",
      "source_raw_sha256": "3BD151C1D0CAA620131F57F6260773C0AE5EE967B89E38EEA6C95A1264CAF04D",
      "target_text": "(──기분 나빠.)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00192",
      "source_text": "僕は強い|目眩[めまい]を覚えて額を押さえた。",
      "source_raw_sha256": "86B212AC490B01EAC871E6622F81A0D55BD07AAE58E7FD0F7031B98C2D9723EC",
      "target_text": "나는 심한 현기증을 느끼며 이마를 짚었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00193",
      "source_text": "運ばれてきた朝ご飯を片づけ終わるころには^n僕はなんとか衝撃から立ち直っていた。",
      "source_raw_sha256": "D373AB549D667169673D696451928C457AF148F0AB3CCA2B70F49EE5D5DF07F3",
      "target_text": "배달된 아침밥을 다 먹을 무렵에는^n어떻게든 충격에서 벗어나 있었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00194",
      "source_text": "まっさらな陽の光と、^n照り返しにどこもかしこも発光したようなこの部屋と、^n湯気をたてるミルク|粥[がゆ]と。",
      "source_raw_sha256": "A3A7EC5CEB2090575DF62F1CFCDE8D93F51726D1D0FE33AE70623733B0308FE5",
      "target_text": "티 없이 맑은 햇살과,^n반사광으로 사방이 빛나는 듯한 이 방과,^n김을 피워 올리는 우유죽과.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00195",
      "source_text": "何もかもが、たった１日で「日常」になっていた。^nそれは「なんでもなかったんだよ」と僕の耳元で|囁[ささや]いて、^n今さっき起きたことを夢かまぼろしのように思わせた。",
      "source_raw_sha256": "6C81ABA6530181B72AC5FD26C888187D39D96BBE681C955D5D64D3CE154270CC",
      "target_text": "모든 것이 단 하루 만에 『일상』이 되어 있었다.^n그것은 『아무 일도 아니었어』라고 귓가에 속삭이며,^n방금 벌어진 일을 꿈이나 환상처럼 느끼게 했다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00196",
      "source_text": "──それでいいんだと思う。",
      "source_raw_sha256": "751995A8401BEB22C434A4D101EC2E6184FADDF8D307033EEBBB8D83141B5F4D",
      "target_text": "──그걸로 괜찮다고 생각한다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00197",
      "source_text": "この「楽園」に後ろ暗い気配を感じても、^n自分のことを気持ち悪いと思ってしまっても、^n僕は「楽園」からも自分の身体からも逃げ出せないのだ。",
      "source_raw_sha256": "3E9ECD66CBF917A750F1B4A9D6702117D7EB80BC38A0C2EC4A62E66B0A8F6AC3",
      "target_text": "이 『낙원』에서 떳떳하지 못한 기척을 느껴도,^n내 자신이 역겹다는 생각이 들어도,^n나는 『낙원』에서도 내 몸에서도 도망칠 수 없다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1116.gsc::slot/00198",
      "source_text": "僕はなるべくモニターを見ないように立ち上がって、^n午前の散歩に繰り出すことにした。",
      "source_raw_sha256": "2E8ECBB5DC400A17E7918489A2E83D8B403987CD34838DD719A0E23E9EE39732",
      "target_text": "나는 되도록 모니터를 보지 않으며 일어나,^n오전 산책을 나가기로 했다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    }
  ]
}
