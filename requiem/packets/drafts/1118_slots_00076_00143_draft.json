  "entries": [
    {
      "uid": "scr.xfl::1118.gsc::slot/00076",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00077",
      "source_text": "どんな人だった？　顔は？",
      "source_raw_sha256": "7AA2D0FAA46A95F29DC8072AC4D737A5FE11CE7A93ED63C57EBF2E2EE637DE12",
      "target_text": "어떤 사람이었어? 얼굴은?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00078",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00079",
      "source_text": "顔は──あんまり憶えてない。怖くて……。^nご、ごめんな、さ……。",
      "source_raw_sha256": "E4FE13E63FF030221EC8B3FF87D3A8EDB1F660E2231F23DCE2B53B09BB7ECC95",
      "target_text": "얼굴은──별로 기억나지 않아. 무서워서…….^n미, 미안, 해…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00080",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00081",
      "source_text": "いいんだよ。怖かったね。",
      "source_raw_sha256": "DC2C034EDEE778F6A172845AF8A3A96D35A406B75B6578B39908345837D7E2A6",
      "target_text": "괜찮아. 무서웠지.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00082",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00083",
      "source_text": "う、ふぐ、うぅ……っ。^nなんだか、わたしを見ながらずっと笑ってたのは憶えてる。^nく、口が気持ち悪くて、変なにおい、した……。",
      "source_raw_sha256": "E562CDF435F6D01DDDF07CA2C385665C5E7A76838BAB126CD4F708BAAAA28826",
      "target_text": "으, 흐윽, 으으…….^n왠지 나를 보면서 계속 웃었던 건 기억나.^n이, 입이 기분 나쁘고 이상한 냄새가 났어…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00084",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00085",
      "source_text": "わ、わたし、やめてって言ったのに。^nい、痛いから、そんなに引っ張らないでって……。^n笑ってるだけで、聞いてくれなかった……！",
      "source_raw_sha256": "C2B7688BD869AB1202E468C46A51343391DC086931190BA6BE422AF13D514C25",
      "target_text": "나, 나는 그만하라고 했는데.^n아, 아프니까 그렇게 당기지 말라고…….^n웃기만 하고 말을 들어주지 않았어……!",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00086",
      "source_text": "グレーテルの震えが|繋[つな]いだ手に伝わってくる。^n僕はぬくもりが伝わるように、握る力を強くした。",
      "source_raw_sha256": "DC7275227EEA652386B3A36DB105DA4D317B2CDD9EC1CD454BFE8ED2870630FE",
      "target_text": "그레텔의 떨림이 맞잡은 손으로 전해진다.^n나는 온기가 전해지도록 손에 더 힘을 주었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00087",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00088",
      "source_text": "無事でよかったよ。もう大丈夫だからね。^n──ほら、森を抜けるよ。",
      "source_raw_sha256": "552046289EA03039882F4232867D68445D439175BD6DDB368B7E865CB0CB4880",
      "target_text": "무사해서 다행이야. 이제 괜찮아.^n──자, 숲을 빠져나간다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00089",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00090",
      "source_text": "ん……、うん……！",
      "source_raw_sha256": "F7AB169683E386CE709A8AD2E3DE5710400B4C400D476645D2BE2F69B928FCD9",
      "target_text": "응…… 응……!",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00091",
      "source_text": "木の並びがまばらになると、^n優しい陽の光が僕たちの肌をあたためた。",
      "source_raw_sha256": "4C5B787DE466CC0D6D0CEDE714082D4CA6EDFAC4892834A4CEE7B5CE68E2771E",
      "target_text": "나무들이 듬성듬성해지자,^n부드러운 햇살이 우리의 피부를 따뜻하게 했다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00092",
      "source_text": "グレーテルは涙目で|頷[うなず]きながら、^nようやく全身の力を抜いたようだ。",
      "source_raw_sha256": "FCBC2353A5926E6EE025A26EB7B3C60CA6BF9F9B2B39809C15CF7793A99ECBC0",
      "target_text": "그레텔은 눈물 어린 눈으로 고개를 끄덕이며,^n그제야 온몸의 힘을 뺀 듯했다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00093",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00094",
      "source_text": "それにしても、怖いね。^n変な人が|紛[まぎ]れ込んできたのかな。",
      "source_raw_sha256": "E77E8370549D4B46DE69433B52DCCCF671DEEF00D99F3E25AF6DC9ACB00D633F",
      "target_text": "그나저나 무섭네.^n이상한 사람이 몰래 들어온 걸까.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00095",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00096",
      "source_text": "──お医者様だった。",
      "source_raw_sha256": "AF4B3A3DE3DA96BB407A105B5AC3A1DEA1ACFFBFE48CFD9F0E22479C62F57196",
      "target_text": "──의사 선생님이었어.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00097",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00098",
      "source_text": "え……？",
      "source_raw_sha256": "96116E591D11E894613110F253FA0F94686D0CBFA44D1AE698A0916A7D6C457D",
      "target_text": "어……?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00099",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00100",
      "source_text": "あ、え、ううん。違ったかもしれない。^n白い服を着ていたから、お医者様だと思った、けど……。",
      "source_raw_sha256": "B5BD67B96CC15847B6EBC2947EB45AF5134CCEB68BAFBE85315B08D0BA400B1B",
      "target_text": "아, 어, 아니야. 아니었을지도 몰라.^n하얀 옷을 입어서 의사 선생님인 줄 알았는데…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00101",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00102",
      "source_text": "きっと違う、と思う。^nあ、あんなこと、しない、お医者様は。^n……しないよ。",
      "source_raw_sha256": "05BDBCED4C232DFDCFD013BB23D9181B8B8354E81275924ED10815472BAA903B",
      "target_text": "분명 아닐 거야.^n그, 그런 짓은 안 해, 의사 선생님은.^n……안 해.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00103",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00104",
      "source_text": "…………。",
      "source_raw_sha256": "0A0A39A23D968038B6135EB7825A35667F28EF942D728F4925E6018672732E6B",
      "target_text": "………….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00105",
      "source_text": "僕の頭の中に、一瞬だけ^n今朝見た診察室の光景がよぎった。",
      "source_raw_sha256": "3542550165B86A13CA58AF761BCBD81EAE2CAEAFBBA436C72F69A4D0FCAEEBAB",
      "target_text": "내 머릿속에 아주 잠깐^n오늘 아침에 본 진찰실의 광경이 스쳐 지나갔다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00106",
      "source_text": "グレーテルはお医者様を信じているんだろうか。^nだとしたら、あれはやっぱり何かの見間違いか、^nあるいはあれでちゃんとした診察だったのか──",
      "source_raw_sha256": "0786159AC1765000192E789B322648A5E5F2F2C16C1CED7C2988DEFD60E2ADC3",
      "target_text": "그레텔은 의사 선생님을 믿는 걸까.^n그렇다면 그건 역시 내가 잘못 본 것이거나,^n아니면 그게 제대로 된 진찰이었을까──",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00107",
      "source_text": "どちらにしても、忘れるのがよさそうだと思った。",
      "source_raw_sha256": "28856A90FBE67BC6FA1C671BFB67CBB6655CF2BE034784C282E6423B2AF1B8EA",
      "target_text": "어느 쪽이든 잊는 게 좋겠다고 생각했다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00108",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00109",
      "source_text": "……それにしても、小石があってよかったね。",
      "source_raw_sha256": "4A2B1D05F0DFE56CACD1FED528B219229E0D889964E620DA3EB9966684D5F2B5",
      "target_text": "……그래도 조약돌이 있어서 다행이네.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00110",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00111",
      "source_text": "うん。^nこっちの手は|掴[つか]まれてたけど、^nこっちの手は自由だったから、ポケットから落とせたの……。",
      "source_raw_sha256": "E528DFD47A5E5CB6F92BCA99B1F560254731AC1CB4399F0F8F08373ADECBE10E",
      "target_text": "응.^n이쪽 손은 붙잡혀 있었지만,^n이쪽 손은 자유로워서 주머니에서 떨어뜨릴 수 있었어…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00112",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00113",
      "source_text": "こうして|辿[たど]って、森から帰ることもできた、し……。^n",
      "source_raw_sha256": "BC44CD890EF88D742D09F5CAF608E1F9935F77F00E5988DA767F2022E968CED7",
      "target_text": "이렇게 따라가서 숲에서 돌아올 수도 있었고…….^n",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00114",
      "source_text": "す、すごいね、ヘンゼルお兄ちゃんは。^n",
      "source_raw_sha256": "8D8C45C6E3B2CE5EF296DB3F029319FB1F7C3CC4118C522C83F94CED985965EB",
      "target_text": "저, 정말 대단해, 헨젤 오빠는.^n",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00115",
      "source_text": "お兄ちゃんが教えてくれなかったら、わたし、あのまま……。",
      "source_raw_sha256": "353A06270DDE135D343611E75E5C5293E40481B3330F4E99522B04057EA444E1",
      "target_text": "오빠가 가르쳐 주지 않았다면 나는 그대로…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00116",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00117",
      "source_text": "……グレーテル。",
      "source_raw_sha256": "E08BE2B172C56CAD64EB8747E7E0B2F41662064BF6C186CFFEAD77868071D410",
      "target_text": "……그레텔.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00118",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00119",
      "source_text": "僕がすごいんじゃないよ。^n自分で思いついたんじゃないし……。^nグレーテルも、よくがんばったね。",
      "source_raw_sha256": "77A4C24E2EC15ECAEAE699DAAF5B0844CF7F329D8EE83F800E05CDFB1806C257",
      "target_text": "내가 대단한 게 아니야.^n내가 생각해 낸 것도 아니고…….^n그레텔도 정말 잘했어.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00120",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00121",
      "source_text": "……うん。",
      "source_raw_sha256": "FEDD625442A89BBDA6022894F47741C745653F7E100D1D62B6A3742BEC8CCA5D",
      "target_text": "……응.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00122",
      "source_text": "グレーテルは僕を見上げて、^n今日はじめての微笑みを見せた。^n鼻の頭は赤いけれど、いい笑顔だった。",
      "source_raw_sha256": "81D92CD09AFEA89AF5DF789C642845CE7949A8B82A60C3AB409E14128DF11014",
      "target_text": "그레텔은 나를 올려다보며,^n오늘 처음으로 미소를 보였다.^n코끝은 빨갛지만 좋은 미소였다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00123",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00124",
      "source_text": "（本物のヘンゼルとグレーテルも、^n　こんな感じだったのかな）",
      "source_raw_sha256": "13907607095204F5EEA29C2D39EC96CE9E32E72CFE9BCCF536131FE032525AE7",
      "target_text": "(진짜 헨젤과 그레텔도^n　이런 느낌이었을까.)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00125",
      "source_text": "僕たちの来た道を、そして帰り道を教えてくれる小石は、^n陽差しを浴びてぴかぴかに輝いていた。",
      "source_raw_sha256": "064A4AE81EAE863DB7A52E72082500B5C5D9C2CB3F615D00D4CAA5590FC99948",
      "target_text": "우리가 온 길과 돌아갈 길을 알려 주는 조약돌은^n햇빛을 받아 반짝반짝 빛나고 있었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00126",
      "source_text": "僕は通りがかった看護師さんに、^nグレーテルが不在なこと、一緒に拾った石が^n彼女の行き先を示すように落ちていることを|訴[うった]えた。",
      "source_raw_sha256": "DE346BD05A65DF22985F0A781F46B632796F903A3A46DE3414299F5EE04AA4B9",
      "target_text": "나는 지나가던 간호사에게^n그레텔이 자리에 없다는 것과 함께 주운 돌이^n그녀가 간 곳을 가리키듯 떨어져 있다고 호소했다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00127",
      "source_text": "もし本当にグレーテルが|失踪[しっそう]したのだとしたら、^n石を|辿[たど]るよりもずっと正しい行動だと思ったからだ。",
      "source_raw_sha256": "F53D223629060EF5A5450115E8C30F3DA598551E18ADE4AB1E571EBBDA1FAC62",
      "target_text": "그레텔이 정말 실종된 것이라면,^n돌을 따라가는 것보다 훨씬 올바른 행동이라고 생각했기 때문이다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00128",
      "source_text": "看護師",
      "source_raw_sha256": "7C9BC55431F0BD999C9CBD3B5F2EF99ACBA567FB9D25297DB2871A3D7DF766FA",
      "target_text": "간호사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00129",
      "source_text": "うん、うん、うん。^nあらそう、そう、うん。そうなのね。",
      "source_raw_sha256": "BD7E0E26388FC36449C4A221609A9BD2E6A488AFB35461A44259E82286D41711",
      "target_text": "응, 응, 응.^n어머, 그래, 그래, 응. 그렇구나.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00130",
      "source_text": "看護師さんは僕の話を、少なくとも表面上は^n真剣に聞いてくれた。",
      "source_raw_sha256": "1BCCA0EC7BE6699C7AF42E04F72D207DD4E5253BC866771961B8FB464E44696C",
      "target_text": "간호사는 적어도 겉으로는^n내 이야기를 진지하게 들어 주었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00131",
      "source_text": "そしてひととおり聞き終えると^nにっこりと、頼りがいのあるオトナ特有の笑い方をした。",
      "source_raw_sha256": "373D112BBD1D66E43904FEDFFB4985A935D3F397B0E1FE0E20D174FD2027B7E1",
      "target_text": "그리고 이야기를 전부 듣고 나자^n방긋 웃으며 믿음직한 어른 특유의 미소를 지었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00132",
      "source_text": "看護師",
      "source_raw_sha256": "7C9BC55431F0BD999C9CBD3B5F2EF99ACBA567FB9D25297DB2871A3D7DF766FA",
      "target_text": "간호사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00133",
      "source_text": "大丈夫よ、探しておくから。^nそう簡単に病院の外に抜け出せやしないでしょうし、^nそうする意味もないでしょうし──すぐに見つかるわ。",
      "source_raw_sha256": "46148AFCDE4B5E80578D6EFB97DE5B57B5F42A2C97A75C47B44B2313116F9516",
      "target_text": "괜찮아, 찾아볼 테니까.^n그렇게 쉽게 병원 밖으로 빠져나갈 수도 없을 테고,^n그럴 이유도 없을 테니──금방 찾을 거야.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00134",
      "source_text": "看護師",
      "source_raw_sha256": "7C9BC55431F0BD999C9CBD3B5F2EF99ACBA567FB9D25297DB2871A3D7DF766FA",
      "target_text": "간호사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00135",
      "source_text": "　グレーテルちゃんは、ほら、グレーテルちゃんだから。^n　ポケットに小石があると、そういう行動をとっちゃうのよね。^n「聖書」がそういうふうに書いてあるものだから。",
      "source_raw_sha256": "919C255822C09C6CD8E63C8E1C5F4C0F626F0443F689BFC77F05451289AA069D",
      "target_text": "　그레텔은, 그레텔이잖아.^n　주머니에 조약돌이 있으면 그런 행동을 하고 마는 거야.^n『성서』에 그렇게 적혀 있으니까.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00136",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00137",
      "source_text": "あ……そういうこと、なんですか。",
      "source_raw_sha256": "ACECDAB2B5BD1340015A9735A081A87C9E0CD08717543C195202C178F3AC0427",
      "target_text": "아…… 그런, 건가요.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00138",
      "source_text": "膨れ上がっていた危機感が、急速に|萎[しぼ]んでいく。",
      "source_raw_sha256": "0DFBF816B62846E7D2A0F871A61C108D0BF0702DCFDC24711787D6BE8C3A11FE",
      "target_text": "부풀어 올랐던 위기감이 빠르게 쪼그라든다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00139",
      "source_text": "僕は一瞬だけでも「一大事」だと感じて、^n看護師さんのお仕事の邪魔になってしまったことを^n|恥[は]ずかしく思った。",
      "source_raw_sha256": "940B7C63EEBB77B37D00ADEA43BD77D161D19E0DD086EA9B8C3FDA57AA8C88CD",
      "target_text": "나는 잠깐이나마 『큰일』이라고 느껴,^n간호사의 일을 방해하고 만 것이^n부끄러웠다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00140",
      "source_text": "看護師さんの言ったとおり、^nしばらく時間はかかったけれど、^nグレーテルは無事に戻ってきた。",
      "source_raw_sha256": "EE98EC61BE2409AB7A0C5BC2A0EC23427E46881BA2436D7E71017F7E76773E61",
      "target_text": "간호사가 말한 대로^n시간은 조금 걸렸지만,^n그레텔은 무사히 돌아왔다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00141",
      "source_text": "見かけたときに声をかけたのに、^nどこかぼんやりとした知らない人を見るような目で^n僕を見返したのが気になったけど──",
      "source_raw_sha256": "9C12EB8C73E540A636149E2FAF0B8D15259C4558F2FD5BC6EAE7C14AA7E7A477",
      "target_text": "마주쳤을 때 말을 걸었는데도,^n어딘가 멍한 채 모르는 사람을 보듯^n나를 바라본 것이 마음에 걸렸지만──",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00142",
      "source_text": "聞きかじったところによると、^n患者さんが「誰を誰として認識するか」というのは^nかなり気まぐれらしい。",
      "source_raw_sha256": "391A6D7860ABB404EC5C2C2EEE7CD46A6B2FA60483C5B54B5E522E03EF8DD1A2",
      "target_text": "주워들은 바에 따르면,^n환자가 『누구를 누구로 인식하는지』는^n상당히 변덕스러운 모양이다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1118.gsc::slot/00143",
      "source_text": "グレーテルが僕のことを「お兄ちゃん」だと思いこんだのは^nあの小石を拾ったひと時のことだった。^nそれだけのことなのだ。",
      "source_raw_sha256": "0E2E6078F09A41159A284D23349C60FFE0610A47E8BB5764811779E8D83C1992",
      "target_text": "그레텔이 나를 『오빠』라고 믿은 건^n그 조약돌을 주웠던 한때뿐이었다.^n그뿐인 일이다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    }
  ]
}
