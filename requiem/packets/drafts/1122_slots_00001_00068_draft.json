  "target_language": "ko-KR",
  "target_encoding": "cp949",
  "translation_method": "Codex internal model only; no external MT/API",
  "review_passes_completed": 0,
  "release_ready": false,
  "entries": [
    {
      "uid": "scr.xfl::1122.gsc::slot/00001",
      "source_text": "医者",
      "source_raw_sha256": "1285809FCD66C2F753A0A086F75DD97DED40DD9BB52FBB18B57107E1BC64FB29",
      "target_text": "의사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00002",
      "source_text": "──うん、顔色は悪くないね。^n体調的にはおおむね問題なし。",
      "source_raw_sha256": "8D5879A64C507EE7FE5C6F0130245AD38B9EDD22A265883060A122FFEB62B5F5",
      "target_text": "──응, 안색은 나쁘지 않군.^n몸 상태에는 대체로 문제없어.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00003",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00004",
      "source_text": "はい。",
      "source_raw_sha256": "69126EF53A06EB7A0C2E24FDA4646D3DCC392409E895B42B1BADC23B04F56CEC",
      "target_text": "네.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00005",
      "source_text": "僕はどうにも落ち着かない気分で生返事をする。",
      "source_raw_sha256": "A00291B3FF30BAD1B5A98C264DD03534F85ED42D488733D4075DF120E69A2AA4",
      "target_text": "나는 영 마음이 진정되지 않아 건성으로 대답한다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00006",
      "source_text": "この診察室で薬っぽい匂いを|嗅[か]いでいると、いやでも^n今朝モニター越しに見た光景を思い出してしまう。",
      "source_raw_sha256": "5CC1E1245D776FB0F2243B938F05F9712B7284D0853D9E9F7729906A415288A5",
      "target_text": "이 진찰실에서 약품 같은 냄새를 맡고 있으면 싫어도^n오늘 아침 모니터 너머로 본 광경이 떠오르고 만다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00007",
      "source_text": "ここに呼び出されることにも抵抗はあった。^nけれどお医者様の手つきは|淀[よど]みなくテキパキとしていて、^nむしろいやな印象を持ったことが申し訳ないくらいだ。",
      "source_raw_sha256": "0102C049F5CF92FD85E7CC5C118DF2873B1F4F9AF440C01611FFE35AB1A9C8C4",
      "target_text": "이곳에 불려 오는 것도 꺼려졌다.^n하지만 의사 선생님의 손놀림은 막힘없이 재빠르고,^n오히려 나쁜 인상을 품은 것이 미안할 정도다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00008",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00009",
      "source_text": "（この人は、昨日の昼にお話したのと同じお医者様だよね。^n　──うん、たぶんそう）",
      "source_raw_sha256": "DB4B1F280908F89A1C488B851FF2CDB717E39F7BC77A79034D44FA438F9CA151",
      "target_text": "(이 사람은 어제 낮에 이야기한 것과 같은 의사 선생님이겠지.^n　──응, 아마 그럴 거야.)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00010",
      "source_text": "このお医者様は、白衣を着ていて、|恰幅[かっぷく]がよくて、眼鏡、^nという格好の人が多く、^n印象が似通いすぎていて、誰が誰だかわかりにくいのだ。",
      "source_raw_sha256": "1AE22F39E52CEE227A1254CF1B22ED538945743584B233BD495953760328F28C",
      "target_text": "이곳 의사 선생님들은 흰 가운을 입고 풍채가 좋으며 안경을 쓴^n차림의 사람이 많아,^n인상이 너무 비슷해서 누가 누군지 알아보기 어렵다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00011",
      "source_text": "わかりやすいのは、^n少し奇抜な格好をしていて雰囲気も違う^nイケノさんくらい。",
      "source_raw_sha256": "286A469ABD9B6781FD23233B580AE0007D8FC12DB8077ABD14CFF6DE82E9335E",
      "target_text": "알아보기 쉬운 사람은^n조금 기발한 차림에 분위기도 다른^n이케노 씨 정도다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00012",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00013",
      "source_text": "（今朝アリスたちを診察していたのは、この人……^n　じゃなかったかも？）",
      "source_raw_sha256": "9EB7D1800FE620F29A688B62D9238A1407B9E4D3B0E6FC50CD38D58419A2C230",
      "target_text": "(오늘 아침 앨리스들을 진찰한 건 이 사람……^n　이 아니었나?)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00014",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00015",
      "source_text": "（──そもそも、あれは本当にお医者様だったんだろうか）",
      "source_raw_sha256": "5207103511E7A4E86894E46441193BCD40651D125464909277616642F6A3BF16",
      "target_text": "(──애초에 그 사람은 정말 의사 선생님이었을까.)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00016",
      "source_text": "ふと思いついてしまって、僕は怖くなった。",
      "source_raw_sha256": "0468FAA651048CB12889767F0B90917A80143920F762EA38D7E5D4B0B0A933A9",
      "target_text": "문득 그런 생각이 들어 나는 두려워졌다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00017",
      "source_text": "得体の知れない誰かがお医者様の顔をして、^n好き勝手に診察や治療をするだなんて──ゾッとする。",
      "source_raw_sha256": "A1BF7D3B67699F0CE676CAE77741E2F492B92565012672080C07946F8D7B039E",
      "target_text": "정체 모를 누군가가 의사의 얼굴을 하고,^n제멋대로 진찰과 치료를 한다니──소름 끼친다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00018",
      "source_text": "医者",
      "source_raw_sha256": "1285809FCD66C2F753A0A086F75DD97DED40DD9BB52FBB18B57107E1BC64FB29",
      "target_text": "의사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00019",
      "source_text": "それで、頭の方はどうかね。^n何か思い出したかね。",
      "source_raw_sha256": "EFA0442893C6A3D17D87BC468E7A9B73C84379DC26B16392BD6AAE8B2F1C6BC8",
      "target_text": "그래서 머리 쪽은 어떤가.^n뭔가 기억났나?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00020",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00021",
      "source_text": "……何も。",
      "source_raw_sha256": "37BEBF559D90A5CACC695C5B4E7CAFE4F5A3EDF4AF57391430A208C79AEBE2A9",
      "target_text": "……아무것도요.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00022",
      "source_text": "僕はかぶりを振った。",
      "source_raw_sha256": "FBCD088871C02F8D5FA75FB04272F1C176AA86227986DA4F93B0AA0ED16756A1",
      "target_text": "나는 고개를 저었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00023",
      "source_text": "正確に言えば、「妹がいたこと」をぼんやりと思い出したし、^nまるっきりゼロではないんだけれど。^nなんとなく言う気になれなかった。",
      "source_raw_sha256": "FDF1E2C1EE8673AA180FA7BFB5BE8B30C22ACC3B7A5A647DCA3C856628343E81",
      "target_text": "정확히 말하면 『여동생이 있었다는 것』을 어렴풋이 떠올렸으니,^n완전히 아무것도 아닌 건 아니지만.^n왠지 말하고 싶지 않았다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00024",
      "source_text": "医者",
      "source_raw_sha256": "1285809FCD66C2F753A0A086F75DD97DED40DD9BB52FBB18B57107E1BC64FB29",
      "target_text": "의사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00025",
      "source_text": "ふむ、そうかね。^n外傷は見あたらなかったし、^n脳の検査の方も、今まで結果を貰っている分は問題ない。",
      "source_raw_sha256": "670C1B47DF88767B821A9B2C91E1939261A9FEC8F0C789BC9F2DB656E0AA62E6",
      "target_text": "흠, 그런가.^n외상은 발견되지 않았고,^n뇌 검사도 지금까지 결과가 나온 것은 문제없어.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00026",
      "source_text": "医者",
      "source_raw_sha256": "1285809FCD66C2F753A0A086F75DD97DED40DD9BB52FBB18B57107E1BC64FB29",
      "target_text": "의사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00027",
      "source_text": "そうなると、シンインテキなもの……。^nいやなことがあって忘れてしまった可能性が高いわけだけど。",
      "source_raw_sha256": "931BDF97D6264FC02D5B017C11653B11E913F0F39A635490F0AEF9C3F77D306E",
      "target_text": "그렇다면 심인성 문제…….^n불쾌한 일이 있어서 잊어버렸을 가능성이 크다는 얘기인데.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00028",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00029",
      "source_text": "いやなこと……。",
      "source_raw_sha256": "E19573554EE44F99B6A72DA44D1AE3ED79CBB016E09F5A57505AB86569F33641",
      "target_text": "불쾌한 일…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00030",
      "source_text": "医者",
      "source_raw_sha256": "1285809FCD66C2F753A0A086F75DD97DED40DD9BB52FBB18B57107E1BC64FB29",
      "target_text": "의사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00031",
      "source_text": "そう。憶えたままでいると強いストレスを感じて、^n心に負担がかかる──^nそんな記憶は後生大事に抱えておく必要がないからね。",
      "source_raw_sha256": "0FBCCF8591EEF191EEAC78C7F38F121DB6225F9C281BAA0DFE5E8C6A0A6D8294",
      "target_text": "그래. 계속 기억하고 있으면 심한 스트레스를 받아^n마음에 부담을 주는──^n그런 기억을 애지중지 품고 있을 필요는 없으니까.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00032",
      "source_text": "医者",
      "source_raw_sha256": "1285809FCD66C2F753A0A086F75DD97DED40DD9BB52FBB18B57107E1BC64FB29",
      "target_text": "의사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00033",
      "source_text": "いらないもの、害になるものを排除するのは、^n身体も心も同じだよ。",
      "source_raw_sha256": "0EE92FC01D4E0DDE932AEE96B5829572670EC1B534AA3B8A5DB860D97BE74F00",
      "target_text": "필요 없는 것, 해가 되는 것을 배제하는 건^n몸이나 마음이나 마찬가지야.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00034",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00035",
      "source_text": "…………。",
      "source_raw_sha256": "0A0A39A23D968038B6135EB7825A35667F28EF942D728F4925E6018672732E6B",
      "target_text": "………….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00036",
      "source_text": "チリ、と胸のどこかがかゆくなる程度の胸騒ぎがした。^nお医者様の言っていることは正しいのかもしれない。",
      "source_raw_sha256": "38F7EDC87D96AC7BDCC1CA4B8D362251802F13656F3BBF383A80A94800E9A3DB",
      "target_text": "가슴 어딘가가 따끔거리며 가려운 정도의 불길함이 들었다.^n의사 선생님의 말이 옳은지도 모른다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00037",
      "source_text": "医者",
      "source_raw_sha256": "1285809FCD66C2F753A0A086F75DD97DED40DD9BB52FBB18B57107E1BC64FB29",
      "target_text": "의사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00038",
      "source_text": "元々、「|お伽話症候群[フェアリーテイル・シンドローム]」がそんな病気なんだ。^n強い逃避行動と変身願望があわさったもの。",
      "source_raw_sha256": "F25BC3F8E8B7EFB8BBDE95C05839B9535381DAF1806CA7A7F7A979FDB90010EB",
      "target_text": "원래 『동화 증후군』은 그런 병이야.^n강한 도피 행동과 변신 욕구가 합쳐진 것.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00039",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00040",
      "source_text": "どういうことですか？",
      "source_raw_sha256": "5929C85702268235E592B932B27BEC1AEDA6A38C06F847BF01CE44D044F9083F",
      "target_text": "무슨 뜻인가요?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00041",
      "source_text": "医者",
      "source_raw_sha256": "1285809FCD66C2F753A0A086F75DD97DED40DD9BB52FBB18B57107E1BC64FB29",
      "target_text": "의사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00042",
      "source_text": "いやな思い出から逃げたい、他の自分になりたい、という願いを、^nお伽話の登場人物になることで叶えているんだよ。",
      "source_raw_sha256": "F9D10285BD0FFDD6DD35C8B5EE3588C578F018F836C6B58A0A2248367B8F8735",
      "target_text": "불쾌한 기억에서 도망치고 싶다, 다른 내가 되고 싶다는 소망을,^n동화의 등장인물이 되어 이루는 거야.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00043",
      "source_text": "医者",
      "source_raw_sha256": "1285809FCD66C2F753A0A086F75DD97DED40DD9BB52FBB18B57107E1BC64FB29",
      "target_text": "의사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00044",
      "source_text": "　例えば、養父に虐待を受けていた女の子が赤ずきんになって、^n「狼に食べられたけど、助けてもらった。もう大丈夫」^n　って自分に言い聞かせ、心の傷を閉じこめるとか。",
      "source_raw_sha256": "8B780E6E7C34C45795455E9679FC55E0BEB05A3E3F80D4FC559210A3E6DB520F",
      "target_text": "　예를 들어 양아버지에게 학대받던 여자아이가 빨간 모자가 되어,^n『늑대에게 잡아먹혔지만 구원받았어. 이제 괜찮아.』^n　라고 자신을 타이르며 마음의 상처를 가둬 두는 식이지.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00045",
      "source_text": "医者",
      "source_raw_sha256": "1285809FCD66C2F753A0A086F75DD97DED40DD9BB52FBB18B57107E1BC64FB29",
      "target_text": "의사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00046",
      "source_text": "　例えば、クラスでいじめに|遭[あ]った女の子がシンデレラになって、^n「でもいつかきっと舞踏会に行って、王子様に選ばれるはず」^n　といった具合に希望を持ち続けるとか。",
      "source_raw_sha256": "AF657980C347C251401ADFACCFFA447760A52C7E70FA95B02DD98CF7100EFDA6",
      "target_text": "　예를 들어 반에서 괴롭힘을 당한 여자아이가 신데렐라가 되어,^n『하지만 언젠가 꼭 무도회에 가서 왕자님에게 선택받을 거야.』^n　하는 식으로 희망을 계속 품는다든가.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00047",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00048",
      "source_text": "じゃあ、ここにいるアリスやグレーテルたちも？",
      "source_raw_sha256": "7DEF0BE32C1F0615C11D1BFF2A8772B8A6FF25D2B01176623A80CABFA0076080",
      "target_text": "그럼 여기 있는 앨리스나 그레텔도요?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00049",
      "source_text": "僕は６人の女の子の顔を順繰りに思い浮かべた。^nお医者様は|頷[うなず]く代わりに言葉を選んでいる様子だ。",
      "source_raw_sha256": "429943DC57923851E516E6A323E0DFA4178F8379ECCD197ABCE4D89CDE7E792D",
      "target_text": "나는 여섯 소녀의 얼굴을 차례로 떠올렸다.^n의사 선생님은 고개를 끄덕이는 대신 말을 고르는 모습이다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00050",
      "source_text": "医者",
      "source_raw_sha256": "1285809FCD66C2F753A0A086F75DD97DED40DD9BB52FBB18B57107E1BC64FB29",
      "target_text": "의사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00051",
      "source_text": "──幼いうちは、誰にでもあることなんだよ。^nただ、「楽園」に来るような子は心の傷が大きくて、^n癒すのに時間がかかるし、|慎重[しんちょう]を要する。",
      "source_raw_sha256": "19A55427CC8C4F329778FABF89354A6C6ECE4C257142E6EF099210B465544BB7",
      "target_text": "──어릴 때는 누구에게나 있는 일이야.^n다만 『낙원』에 올 정도의 아이는 마음의 상처가 커서,^n치유하는 데 시간이 걸리고 신중해야 하지.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00052",
      "source_text": "医者",
      "source_raw_sha256": "1285809FCD66C2F753A0A086F75DD97DED40DD9BB52FBB18B57107E1BC64FB29",
      "target_text": "의사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00053",
      "source_text": "心の殻に閉じこもって、長い時間をかけて傷を癒して、^n強く生きていけるように自分を変えている最中だ。^n……|蛹[さなぎ]のようなものだね。",
      "source_raw_sha256": "DED767CD933862E2442A3288B26235612615572CDEB40A4B6EDF7D00CBA243C5",
      "target_text": "마음의 껍질에 틀어박혀 오랜 시간에 걸쳐 상처를 치유하고,^n강하게 살아갈 수 있도록 자신을 바꾸는 중이야.^n……번데기 같은 거지.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00054",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00055",
      "source_text": "僕もそうなんですか。",
      "source_raw_sha256": "1B956E0429C7A746B11C41F7699F6E43745C0E1A406C8B54929F8997BC05D168",
      "target_text": "저도 그런 건가요?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00056",
      "source_text": "医者",
      "source_raw_sha256": "1285809FCD66C2F753A0A086F75DD97DED40DD9BB52FBB18B57107E1BC64FB29",
      "target_text": "의사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00057",
      "source_text": "そうかもしれないね。^nどっちにしろ、まだ柔らかい|蛹[さなぎ]の殻を^n無理矢理|毟[むし]るような真似はせんよ。",
      "source_raw_sha256": "78293432209A84D7B345E02ED8DB54F7AF06E9A7CD54D26CE860237D415CE3DD",
      "target_text": "그럴지도 모르지.^n어느 쪽이든 아직 부드러운 번데기 껍질을^n억지로 뜯는 짓은 하지 않을 거야.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00058",
      "source_text": "医者",
      "source_raw_sha256": "1285809FCD66C2F753A0A086F75DD97DED40DD9BB52FBB18B57107E1BC64FB29",
      "target_text": "의사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00059",
      "source_text": "羽化の時がくるまで、存分にゆっくりしていきたまえ。",
      "source_raw_sha256": "72A8DF6567BC24AECBF26E3696F8D0691BA8CD9F7C01297D8CA59E8B9541748C",
      "target_text": "우화할 때가 올 때까지 마음껏 푹 쉬게.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00060",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00061",
      "source_text": "はぁ……ありがとうございます。",
      "source_raw_sha256": "434EA78F351C181D02E7956D368DF0F70D82D261C8D49EF68915CC0520DB44D0",
      "target_text": "아…… 감사합니다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00062",
      "source_text": "もう行っていいよ、というそぶりのお医者様につられて^n腰を浮かせかけたところで、^n僕は聞き忘れたことに気づいた。",
      "source_raw_sha256": "1E90FF55DCF885AEC52BEAF9AE45CDD3EB83A93701CB7A960FE82227564A6834",
      "target_text": "이제 가도 좋다는 의사 선생님의 몸짓을 따라^n허리를 들려던 참에,^n나는 묻는 걸 깜빡한 것이 떠올랐다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00063",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00064",
      "source_text": "あの、ひとつ聞いていいですか。",
      "source_raw_sha256": "73647A7DB8B1A49D698EDC661BAB220397E60313D921BAF8FF5194FC18D77191",
      "target_text": "저기, 하나 물어봐도 될까요?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00065",
      "source_text": "医者",
      "source_raw_sha256": "1285809FCD66C2F753A0A086F75DD97DED40DD9BB52FBB18B57107E1BC64FB29",
      "target_text": "의사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00066",
      "source_text": "ん？　どうしたね。",
      "source_raw_sha256": "4D87E64A03CB383DF0EC0FF8AA4CA36372B370FC22309C6BF77083610C4EE6FB",
      "target_text": "응? 무슨 일인가.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00067",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1122.gsc::slot/00068",
      "source_text": "その、僕が言うのも変な話かもしれませんが……。^n患者さんたちには、^n物語から離れた物事や人間は、どう見えているんでしょうか？",
      "source_raw_sha256": "6CD433545E6B507FA52FEB3292787492BD361B8F1347EDECD7AE9F754F2E8F20",
      "target_text": "그, 제가 이런 말을 하는 것도 이상할지 모르지만…….^n환자들에게는^n이야기와 무관한 사물이나 사람이 어떻게 보이나요?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    }
  ]
}
