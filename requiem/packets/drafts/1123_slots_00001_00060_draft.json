  "review_passes_completed": 0,
  "release_ready": false,
  "entries": [
    {
      "uid": "scr.xfl::1123.gsc::slot/00001",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00002",
      "source_text": "（──あれ）",
      "source_raw_sha256": "39F26EC81E070DFFEBC6E2785970CBBE853ECADDD205E57A81BF16A2DF6CF0C5",
      "target_text": "(──어라.)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00003",
      "source_text": "見慣れないものを見かけて、僕は足を止めた。",
      "source_raw_sha256": "5B22EC933C4E713AC950EF58DB1908FECF7C9F03FF5CFFBBD4A39A443441D9AC",
      "target_text": "낯선 것을 보고 나는 걸음을 멈췄다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00004",
      "source_text": "少しだらしない毛並みの黒猫だった。^nあくびのような声を残し、長いしっぽを振り振り、^n廊下の向こう側へと走り去っていく。",
      "source_raw_sha256": "A3BE365665237D3B322FDE6F813F26BD11F1AD72047BCCB3D70518F00B85B2F6",
      "target_text": "털이 조금 흐트러진 검은 고양이였다.^n하품 같은 울음소리를 남기고 긴 꼬리를 살랑살랑 흔들며,^n복도 저편으로 달려가 버린다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00005",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00006",
      "source_text": "（今、アリスの部屋から出てきたように見えたけど）",
      "source_raw_sha256": "CC158B7C36E5665E44CB26BC188A066E88DC6670DA7643477A2A3D74ECB70815",
      "target_text": "(방금 앨리스의 방에서 나온 것처럼 보였는데.)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00007",
      "source_text": "ちょうど寄ろうと思っていたところだ。^n足を向けると、案の定左右のドアは半端に開いていて、^nちょうど猫がすり抜けられそうな隙間ができていた。",
      "source_raw_sha256": "8FD1DAD0E726B6703A77581C56AF008339A8A38586710D4BF20613DBEEF4D6E1",
      "target_text": "마침 들를 생각이던 참이다.^n그쪽으로 향하자 아니나 다를까 좌우 문이 어중간하게 열려,^n고양이 한 마리가 빠져나갈 만한 틈이 생겨 있었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00008",
      "source_text": "次の瞬間、その隙間を一気にこじ開けて^nアリスが飛び出してきた。",
      "source_raw_sha256": "D9F645905A495863C3485E4301B7FB5C0E48F6B829EEF6221F49D575D32A01A5",
      "target_text": "다음 순간 그 틈을 단숨에 밀어 열며^n앨리스가 뛰쳐나왔다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00009",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00010",
      "source_text": "ちょっと……あれ？　あれぇ！？^nどこへ行ったのよ。まだお茶の時間でしょう？",
      "source_raw_sha256": "38A87CFDEAE4F8A0CC703F2DD6EC0298957621C5886B787FC97A4D5CE8222AE2",
      "target_text": "잠깐…… 어라? 어라아!?^n어디로 간 거예요. 아직 차 마실 시간이잖아요?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00011",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00012",
      "source_text": "──あら。ごめんなさい。",
      "source_raw_sha256": "05069788A8CEABA742851077DD5640990B99CA15AB9DBFC4FB653090BB8D2060",
      "target_text": "──어머. 미안해요.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00013",
      "source_text": "なんとかドアの直撃を避けた僕に^nアリスはどこか上の空といった感じで|詫[わ]びる。",
      "source_raw_sha256": "BBD7AEBCA27C32C822B5ECD637448460E78777828CD56950E1BD82A6B73CD417",
      "target_text": "간신히 문에 정면으로 부딪히는 것을 피한 내게^n앨리스는 어딘가 정신이 팔린 듯 사과한다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00014",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00015",
      "source_text": "その、ちょっと急いでいたもので。^nあなた、帽子屋さんを見かけなかった？^nつい今し方出ていったと思うの。",
      "source_raw_sha256": "BF4CB1B35788D4826E0F4A55F9F06848517854C4ECE14B398B8E28E3C3FB50D0",
      "target_text": "그게, 조금 서두르고 있었거든요.^n당신, 모자 장수를 보지 못했나요?^n바로 방금 나간 것 같은데요.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00016",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00017",
      "source_text": "まったく、ずっとお茶の時間だって、^nいつもはしゃいでいるのはあの人なのに……。",
      "source_raw_sha256": "F0A38941F4B739D94BB9EA53EA53AFD9FD3F9E21FD8260B4A16F9052C6B9B100",
      "target_text": "정말이지, 언제나 차 마실 시간이라고^n늘 신이 나 떠드는 건 그 사람인데…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00018",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00019",
      "source_text": "ぼ、帽子屋……は見なかったかな。^n猫なら通っていったけど……。",
      "source_raw_sha256": "6E8F1C8DC9C7B1D0D4784BF331F87C79C463D4B939E265F7254E2591D7C5C9B2",
      "target_text": "모, 모자 장수……는 못 본 것 같아.^n고양이라면 지나갔지만…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00020",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00021",
      "source_text": "猫……。",
      "source_raw_sha256": "0F68F0F2C8997122776113556ADFE72D106693698B97E60372B9832AF0478DD3",
      "target_text": "고양이…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00022",
      "source_text": "アリスは神妙な顔で何か考え込んでいる様子だったが、^nやがて部屋の中にとって返していった。",
      "source_raw_sha256": "9DE3EC5E10D93758384DFD8AF0C9E100ACD96747230604CBB805AACEB9D6A8C4",
      "target_text": "앨리스는 진지한 얼굴로 무언가 생각에 잠긴 듯했지만,^n이윽고 방 안으로 되돌아갔다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00023",
      "source_text": "カリカリと、ペンを走らせているらしい音が聞こえてくる。",
      "source_raw_sha256": "8034089515C07AB4F70D43ADB21E9F59628BF4DA766FAC5ED09879C5B93405A2",
      "target_text": "사각사각 펜을 놀리는 듯한 소리가 들려온다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00024",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00025",
      "source_text": "アリス？　入っていい？",
      "source_raw_sha256": "6283019D395F0D44B7848A3EC16C96CB1E6F365C909A4FFA55D0A1487C9CA305",
      "target_text": "앨리스? 들어가도 돼?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00026",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00027",
      "source_text": "ええ、どうぞ。^nただあたし、今ちょっと忙しいの。^n何のおかまいもできませんけど。",
      "source_raw_sha256": "D8253E0D8601E0B4144C4522C19CC98669B07C873D44C0446AAD3E055C4B7CAA",
      "target_text": "네, 들어오세요.^n다만 난 지금 조금 바빠요.^n아무 대접도 못 해 드리겠지만요.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00028",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00029",
      "source_text": "それはいいけどさ……。^n何を書いているの？",
      "source_raw_sha256": "0F0BADC0BC798AE98E1C5C507D7BB29E7229454400361984B785EB97C0E69650",
      "target_text": "그건 괜찮은데…….^n뭘 쓰고 있어?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00030",
      "source_text": "　アリスは、キノコのチェストを椅子がわりに^n（おそらく「大きすぎる椅子」が使えないので）^n　書き物机にかじりついているところだった。",
      "source_raw_sha256": "4AB85ABBEC674880B9242FC6B4610F140C2CA341173CF7509BB2A070C4042546",
      "target_text": "　앨리스는 버섯 모양 서랍장을 의자 대신 삼아^n(아마 『너무 큰 의자』를 쓸 수 없어서)^n　글 쓰는 책상에 바싹 붙어 있었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00031",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00032",
      "source_text": "問題よ。数式といってもいいかしら。",
      "source_raw_sha256": "7B09C7A18E21FDF2558B16A067CA25546D6E9D364E76C9B2D21F043E2823F582",
      "target_text": "문제예요. 수식이라고 해도 될까요.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00033",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00034",
      "source_text": "問題？　数式？",
      "source_raw_sha256": "8B192AE364BEF230DD03CF04A3269FF16EB5E1CEF590B7A1B0A2C56EDF6F0FFF",
      "target_text": "문제? 수식?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00035",
      "source_text": "その手元を|覗[のぞ]き込むと、机の上には^nメモ用紙やノートの切れ端、チラシの裏などが、^nばらまかれたように乱雑に重なりあっていた。",
      "source_raw_sha256": "7B731C5775B9AC13922098E507A29C3DD492C003652DDF695233D42CEE890334",
      "target_text": "그 손가를 들여다보니 책상 위에는^n메모지와 공책 조각, 전단지 뒷면 같은 것들이^n뿌려 놓은 듯 어지럽게 겹쳐 있었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00036",
      "source_text": "大きさや質もバラバラな紙たちが、互いに|覆[おお]い隠しあうという^nとりとめのない|惨状[さんじょう]を１枚のカンバスとして、^nアリスは手にした羽根ペンを縦横無尽に|揮[ふる]っているところだった。",
      "source_raw_sha256": "E5D187715E630233352CFD2619E78515321EB7864817F7FA3CEB81CA47E570C0",
      "target_text": "크기와 재질도 제각각인 종이들이 서로를 가리고 있는^n두서없는 참상을 한 장의 캔버스 삼아,^n앨리스는 손에 든 깃펜을 종횡무진 휘두르고 있었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00037",
      "source_text": "インクの乾いていない、一番新鮮な書き込みいわく。",
      "source_raw_sha256": "AA0E2C5846039066135076F48803345F43FA9550DBC5C47BD33AFB02FBE9A6D5",
      "target_text": "잉크도 마르지 않은 가장 새로운 메모에 따르면.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00038",
      "source_text": "猫＝帽子屋？^n猫＋帽子＝帽子猫^n帽子猫＝帽子屋",
      "source_raw_sha256": "9B4FE2253235BA4DB85F97ABC1F08EDBDE1A59CDDF167B258BFA6E4346E62BFC",
      "target_text": "고양이＝모자 장수?^n고양이＋모자＝모자 고양이^n모자 고양이＝모자 장수",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00039",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00040",
      "source_text": "……きっと、猫は帽子屋じゃないわ。",
      "source_raw_sha256": "5A20CC97CA3C3BECF2BA4E5BDBE883799673169D167870BFEFEBF96A45FC5717",
      "target_text": "……분명 고양이는 모자 장수가 아니에요.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00041",
      "source_text": "アリスは真顔でこちらを振り向く。",
      "source_raw_sha256": "7433D5E900CDD314CEEE7642571F0C0612F45F7D3AB8010744B7288F76C33356",
      "target_text": "앨리스는 진지한 얼굴로 이쪽을 돌아본다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00042",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00043",
      "source_text": "うん……そうだね。",
      "source_raw_sha256": "636A35EE3A0905CBD6830FC991F1FCF502CFC8A78F4E181E3371E0BF4729A110",
      "target_text": "응…… 그렇지.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00044",
      "source_text": "僕は平坦に|頷[うなず]くしかない。",
      "source_raw_sha256": "79A08264C4CCE8E997FF82252E6ED11E31BFC0B9A1280FD9459C0AE2C00B1BE9",
      "target_text": "나는 무덤덤하게 고개를 끄덕일 수밖에 없다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00045",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00046",
      "source_text": "──あのね。以前、帽子屋さんに出された問題があったんだけど、^nあたし、ついに解くことができたのよ。^n頭の中でミントサイダーが弾けたような閃きだったわ。",
      "source_raw_sha256": "DAC3EB6C4BF44B9B8280B877E3C8FF883A2A51A81D92EF72A7302228AF7AD4F9",
      "target_text": "──있잖아요. 예전에 모자 장수가 낸 문제가 있었는데,^n내가 마침내 풀어냈어요.^n머릿속에서 민트 사이다가 터진 듯한 번뜩임이었죠.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00047",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00048",
      "source_text": "へ、へぇ。",
      "source_raw_sha256": "14037B8BFCEE8849004CBC154BD05CE97DF8EE7D3FAD31979A60A8444873D90A",
      "target_text": "그, 그래.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00049",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00050",
      "source_text": "それで、せっかくだから答えを見てもらおうと思って^nあたしの「はちゃめ|茶会[ちゃかい]」にご招待したんだけど……。",
      "source_raw_sha256": "78369F9BC8730FC39B2491F1258987975AF002C8313E2D9F3C7B762A8BD96415",
      "target_text": "그래서 모처럼이니 답을 보여 주려고^n내 『엉망진창 다과회』에 초대했는데…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00051",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00052",
      "source_text": "はちゃめちゃかい……？",
      "source_raw_sha256": "415D0ED143069C49312A9F76BFE8166218FA4AE62C873F4E7807826A998315FD",
      "target_text": "엉망진창 다과회……?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00053",
      "source_text": "もてなしの心がひとかけらもなさそうな会だ。",
      "source_raw_sha256": "CFBC99E8668A5DE19169A1AC34A403CEA6796E1743390158C64010CB01934639",
      "target_text": "대접하려는 마음이 한 조각도 없을 듯한 모임이다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00054",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00055",
      "source_text": "帽子屋さんたら、ずっと眠ってばかりなのよ。^nお茶も飲まないし、お菓子も食べないし。^n口にしたのはツナのキッシュくらいだったかしら。",
      "source_raw_sha256": "FE4C16465A58B6E19CBF3622EE380A5AF9EC8FBA6D2B7A9783B70FA6C6EDE335",
      "target_text": "모자 장수는 계속 잠만 자는 거예요.^n차도 안 마시고 과자도 안 먹고.^n입에 댄 건 참치 키슈 정도였던가요.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00056",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00057",
      "source_text": "　あたしが答えを|披露[ひろう]しても、ふにゃあとあくびをするばかりで。^n「そんな問題出したっけ？」みたいな顔でこっちを見るの。^n　あたしの苦労は、いったいなんだったの？",
      "source_raw_sha256": "0816D300B0B01556857E0F076D950A14324445239E39F26D0C0E2C54162FCC87",
      "target_text": "　내가 답을 선보여도 흐느적거리며 하품만 하고.^n『내가 그런 문제를 냈던가?』 하는 얼굴로 이쪽을 봐요.^n　내 고생은 대체 뭐였을까요?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00058",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00059",
      "source_text": "あげくのはてには、急に駆けだして^n部屋を飛び出していっちゃうし……。",
      "source_raw_sha256": "1180BA7B573B93FD04B90C92ED5280DB9326DAB6DA0515F8DC0C912D3DBBF108",
      "target_text": "급기야 갑자기 달려 나가더니^n방을 뛰쳐나가 버렸고…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00060",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    }
  ]
}
