  "review_passes_completed": 0,
  "release_ready": false,
  "entries": [
    {
      "uid": "scr.xfl::1123.gsc::slot/00061",
      "source_text": "（つまり、たぶんさっきの猫がアリスの中で^n「帽子屋」役を務めていたんだろうなぁ……）",
      "source_raw_sha256": "7CDDE03C42A84B8E5DCE4FF8FED39E7182499A9402BFB902963E1CC6821F1C7A",
      "target_text": "(그러니까 아마 아까 그 고양이가 앨리스 안에서^n『모자 장수』 역할을 맡고 있었던 거겠지…….)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00062",
      "source_text": "僕は遅まきながら把握した。",
      "source_raw_sha256": "30AEDEAAA01AB47B665E430CD39896D892FB69781710B65AFC58620C9655AFE8",
      "target_text": "나는 뒤늦게 사정을 파악했다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00063",
      "source_text": "僕がハイイロペリカンに見えるのだから、^n猫が帽子屋に見えてもおかしくはない。^nアリスはそんな世界の住人なのだ。",
      "source_raw_sha256": "257B5A8D5D21DCA41F44F34B39E87760587D89089DCEEC614B37F496472A989B",
      "target_text": "내가 회색 펠리컨으로 보일 정도니,^n고양이가 모자 장수로 보여도 이상하지 않다.^n앨리스는 그런 세계의 주민이다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00064",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00065",
      "source_text": "ちなみに、どんな問題？",
      "source_raw_sha256": "A5D0E0DBF158035319DDD3BCFC45943D3DA25C0477E7A25AF7555A08A167E83E",
      "target_text": "그런데 어떤 문제야?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00066",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00067",
      "source_text": "「カラスと書き物机は、なぜ似ているか」よ。",
      "source_raw_sha256": "46506AFB2BABE69ACE39B131AD9EAD91E70CC0DF73ADCE4717656E7CA6742774",
      "target_text": "『까마귀와 글 쓰는 책상은 왜 닮았는가』예요.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00068",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00069",
      "source_text": "ああ……。",
      "source_raw_sha256": "B9CD62EC860EADF1D9F2E835DA67B7D747E77E62F569EBBC4A8DCB8B2A8C0219",
      "target_text": "아아…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00070",
      "source_text": "やはり「不思議の国のアリス」にあったなぞなぞだ、と^n僕は思いだしていた。",
      "source_raw_sha256": "98AA33D011BC68DE73B3C39B852CDC9AA1AD5B52936257154A5381266726A8D8",
      "target_text": "역시 『이상한 나라의 앨리스』에 나온 수수께끼라고^n나는 떠올렸다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00071",
      "source_text": "目の前のアリスが言った通り、^nティーパーティ中に帽子屋が口にした問題だ。",
      "source_raw_sha256": "EB8235120190CB7CB00AB454A6708A7D289BB9179A7668DFE0D4F2AFF1FD4A70",
      "target_text": "눈앞의 앨리스가 말한 대로,^n다과회 도중 모자 장수가 낸 문제다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00072",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00073",
      "source_text": "（でも、あれってでたらめななぞなぞで、^n　作中でちゃんとした答えはなかったと思うけど）",
      "source_raw_sha256": "C66DEA6AC0F50B05569982BE8A74E389B036B91E73D7006DDC935C856C1DA846",
      "target_text": "(하지만 그건 엉터리 수수께끼라,^n　작품 속에 제대로 된 답은 없었던 것 같은데.)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00074",
      "source_text": "　アリスの手元には、^n「カラス＝書き物机」「カラス＋文字＝？」「書き物机×黒い羽根」",
      "source_raw_sha256": "D330EA8F6832512D315CAFBAEA6E5D2532E6E33674E952CD33E486CBAB02357A",
      "target_text": "　앨리스의 손밑에는,^n『까마귀＝글 쓰는 책상』『까마귀＋글자＝?』『글 쓰는 책상×검은 깃털』",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00075",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00076",
      "source_text": "──解けたって……どういう答え？",
      "source_raw_sha256": "91316D81E43BFDFE5E111B1ED7F63B7F76BFE9B496CE5310CB658E3572881A46",
      "target_text": "──풀었다니…… 답이 뭔데?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00077",
      "source_text": "アリスは待ってましたとばかりに胸を張り、^n積み重なった紙の下、あらわになった書き物机の^n表面を指さした。",
      "source_raw_sha256": "7E3D46A57B811684227A476F4FF0039691A96050B9E63B072064FB16588F9762",
      "target_text": "앨리스는 기다렸다는 듯 가슴을 펴고,^n겹겹이 쌓인 종이 아래 드러난 글 쓰는 책상의^n표면을 가리켰다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00078",
      "source_text": "よくよく見れば、黒インクの|滴[しずく]が飛んだ跡がある。",
      "source_raw_sha256": "F811221853B34480D01E96F49DB42B7A251CB546F3BB660C72EE5301F8812B10",
      "target_text": "자세히 보니 검은 잉크 방울이 튄 흔적이 있다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00079",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00080",
      "source_text": "　カラスも、書き物机も、^n「どちらも黒いはねが飛ぶ」──",
      "source_raw_sha256": "8691FF6A503D929C6D8E4E2D589734B86B07F35524153AB408E11E211A665928",
      "target_text": "　까마귀도 글 쓰는 책상도,^n『둘 다 검은 것이 날아다녀요』──",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00081",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00082",
      "source_text": "……へぇ……！",
      "source_raw_sha256": "8944D8FE24BD19E980033C734B64AB562BD36F9FDD740031AE0A835F89AD683E",
      "target_text": "……오……!",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00083",
      "source_text": "いつも通りのとんちんかんに備えていた僕は^n思った以上にまともな答えに感心してしまった。",
      "source_raw_sha256": "9BE7B4DA95F506829BE0D7AD359475209BF4E5BAD98376548D9427F270FD55AF",
      "target_text": "평소 같은 엉뚱한 답에 대비하던 나는^n생각보다 그럴듯한 답에 감탄하고 말았다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00084",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00085",
      "source_text": "うまいね。",
      "source_raw_sha256": "BE14959DE085A8C873AAEF7019153FA56F909849ACF7585574533DBDABA48BCD",
      "target_text": "재치 있네.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00086",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00087",
      "source_text": "うまいって、「良い」ってこと？^nこれで正解といえるかしら？",
      "source_raw_sha256": "BB656E8E494B3BBF6EE485F6F9443958E62D69576C516F92A29D69E51C866BAE",
      "target_text": "재치 있다는 건 『좋다』는 뜻인가요?^n이걸로 정답이라고 할 수 있을까요?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00088",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00089",
      "source_text": "うん、正解のひとつだとおもうよ！",
      "source_raw_sha256": "A94C6A49F618CC920B09A357E9B85DDCE33469679479042E907D43F53C9E9529",
      "target_text": "응, 정답 중 하나라고 생각해!",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00090",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00091",
      "source_text": "ほんと？　やったわ！",
      "source_raw_sha256": "C86B7CE915898A0F66B3BDF69920615236DC9D4FEA9AC6E5A1DDD65B9AF7AC5D",
      "target_text": "정말요? 해냈어요!",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00092",
      "source_text": "アリスは声を弾ませる。^nただでさえ満天の星空めいたキラキラの瞳が、^nほとんどビッグバンの輝きで喜びにさんざめく。",
      "source_raw_sha256": "B1B6F738F6D63BCFE8E973A5909B2A336FF5C46E4FF674BE68192FC02427E8FF",
      "target_text": "앨리스의 목소리가 들뜬다.^n안 그래도 별이 가득한 밤하늘처럼 반짝이던 눈동자가,^n거의 빅뱅 같은 빛을 내며 기쁨으로 반짝인다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00093",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00094",
      "source_text": "ああ、やったのね、あたし。^nこのおかしな世界で、ちゃんとした答えを見つけられたなんて^n初めてかもしれないわ……。",
      "source_raw_sha256": "85150F1ACBC1F5EE10F0A2E4F841EBAA433E40BF826E1ABB5A8D0759047AF2AB",
      "target_text": "아아, 해냈군요, 나.^n이 이상한 세계에서 제대로 된 답을 찾아낸 건^n처음일지도 몰라요…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00095",
      "source_text": "大いに喜びながらもくたびれて見えるのは、^n実際アリスが不休で問題に挑んでいたからなんだろう。^n書き散らされた数式や文字列の嵐がそれを示している。",
      "source_raw_sha256": "24F579CFCB7A33C7AF5990FCD7F5A237F66C1B989D381E02743385667D3304C0",
      "target_text": "크게 기뻐하면서도 지쳐 보이는 것은,^n실제로 앨리스가 쉬지 않고 문제에 도전했기 때문이겠지.^n휘갈겨 쓴 수식과 문자열의 폭풍이 그것을 보여 준다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00096",
      "source_text": "「カラスは飛べる、書き物机は飛べない」^n",
      "source_raw_sha256": "90029D4E5A6538592D824766B0049E1279D6EDC4ED62FE1025477C9587E7E23E",
      "target_text": "『까마귀는 날 수 있다, 글 쓰는 책상은 날 수 없다.』^n",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00097",
      "source_text": "「書き物机は書き物ができる、カラスはできない？」^n",
      "source_raw_sha256": "A5A8AD73FF58325C91FDD8ACB3C7361685812C652E0A1BE37F6026E9E10ECF0B",
      "target_text": "『글 쓰는 책상에서는 글을 쓸 수 있다, 까마귀는 못 쓴다?』^n",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00098",
      "source_text": "「↑場合によってはできる？」",
      "source_raw_sha256": "7EFE1A378CAF4141D24EAED46773B3D8424D15E32B8C0B7D24B4B616C82DFD64",
      "target_text": "『↑경우에 따라서는 쓸 수 있다?』",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00099",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00100",
      "source_text": "（あ……）",
      "source_raw_sha256": "464C18C1F1714C924D4C26AE902BE6A67D3E93AE329E6E5EBCD2B81ECD2DD17F",
      "target_text": "(아…….)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00101",
      "source_text": "意味があるようでない無数の書き込みの中に^n僕は気になるものを見つけた。",
      "source_raw_sha256": "B4975C518F2F24F727E715DD78BC2175A17AB60EE30D34F9F15F069456B4DD42",
      "target_text": "의미가 있는 듯 없는 수많은 메모 속에서^n나는 신경 쓰이는 것을 발견했다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00102",
      "source_text": "「人－記憶＝忘れる」^n",
      "source_raw_sha256": "6B5999D7DC916F7D46557DC649C532B3A40EACC42A38173F20314D49F76B05C7",
      "target_text": "『사람－기억＝잊는다.』^n",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00103",
      "source_text": "「人＋記憶＝思い出す」^n",
      "source_raw_sha256": "BBB162BF99F1D7FE4ACA2A22ADE5C256B052EA337904C65EF66F47BA48CD9C51",
      "target_text": "『사람＋기억＝떠올린다.』^n",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00104",
      "source_text": "「忘れる＋思い出す＝ふつうの人」",
      "source_raw_sha256": "1ED2EBBA40893413406E2206319B975B4D05F070737FF060E4BFA851CF2ECED6",
      "target_text": "『잊는다＋떠올린다＝평범한 사람』",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00105",
      "source_text": "「（人－記憶）＋（人＋記憶）＝人が２人……？」^n",
      "source_raw_sha256": "9BD457DC22894F9DC06009EF3FAACFEED7156733588178F39B6C2D1F778E7E9C",
      "target_text": "『(사람－기억)＋(사람＋기억)＝사람이 2명……?』^n",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00106",
      "source_text": "「２人＝ふつうの人？」",
      "source_raw_sha256": "218BF4AA9A213ABEDD2F45E5D0874289096E2C335292D60E484CD93744EBA487",
      "target_text": "『2명＝평범한 사람?』",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00107",
      "source_text": "「人－名前＝？」^n",
      "source_raw_sha256": "F3A0E7D8EB07F9921729C25EA106BB3DAA3396DC6C1FD971AA52041A10087C56",
      "target_text": "『사람－이름＝?』^n",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00108",
      "source_text": "「人＋名前＝名前のある人＝当たり前の人」^n",
      "source_raw_sha256": "19186162D10B474FFE26145E01CAC2996D2CC9330B7EE331E0C8B15C21B40FCE",
      "target_text": "『사람＋이름＝이름 있는 사람＝당연한 사람』^n",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00109",
      "source_text": "「当たり前の人－名前＝当たり前じゃない人」",
      "source_raw_sha256": "03EC96CC2AEDFADF9004ADAC10A2145AC525ADE90570AA465CB334FC0859C90A",
      "target_text": "『당연한 사람－이름＝당연하지 않은 사람』",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00110",
      "source_text": "「当たり前じゃない人＋名前＝まともな人」^n",
      "source_raw_sha256": "D8CD9DA0368C0697B7D7A8FC9A3D93DC2FF1B10EF3A8000FF1FE8FC18993C5B4",
      "target_text": "『당연하지 않은 사람＋이름＝멀쩡한 사람』^n",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00111",
      "source_text": "「まともな人－名前＝まともじゃない人！？」^n",
      "source_raw_sha256": "021159AA3D85008597044559D3536A0240E6ADF38F38396C2D777C2BF35E6FA1",
      "target_text": "『멀쩡한 사람－이름＝멀쩡하지 않은 사람!?』^n",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00112",
      "source_text": "「まともじゃない人＝危険！？」",
      "source_raw_sha256": "899B4754C4702098CBC6097FFD9227E6D2776B9C44265BD6D6CDCEA590F4CC68",
      "target_text": "『멀쩡하지 않은 사람＝위험!?』",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00113",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00114",
      "source_text": "（なんだ、この結論……）",
      "source_raw_sha256": "A5DEF414CC88333E09D04AC2BA7EBA35748DA44E9EA196854AA3E2C9D74658D5",
      "target_text": "(뭐야, 이 결론…….)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00115",
      "source_text": "|目眩[めまい]がするような試行錯誤の跡が残されていた。^n何度かやり直して、同じ結論にたどりつきかけて、^nぐしゃぐしゃと塗り潰した箇所もある。",
      "source_raw_sha256": "B50C8D2CF9AC60694A9581A51156618E441B9E31163295282D725AD9A04077E6",
      "target_text": "현기증이 날 듯한 시행착오의 흔적이 남아 있었다.^n몇 번인가 다시 시작해 같은 결론에 다다르려다,^n마구 휘갈겨 지운 곳도 있다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00116",
      "source_text": "それは何かのために、延々と|彷徨[さまよ]い続けたアリスの思考だ。",
      "source_raw_sha256": "FD0BBEDB7FB0C95E6C4117B152E71C8BC5F40DD78840F0A36B88568F95E79593",
      "target_text": "그것은 무언가를 위해 끝없이 헤맨 앨리스의 사고다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00117",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00118",
      "source_text": "アリス、これは？",
      "source_raw_sha256": "C1A3D1AA170E3E8375FA379982BE02CA67D79B9C8C9568918E08F3B2CE4A4D5F",
      "target_text": "앨리스, 이건?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00119",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1123.gsc::slot/00120",
      "source_text": "あなたの記憶がなくなってしまったということを、^nあたしなりに深刻に受け止めて、なんとかしたくて。^n数学なら、たいていの問題は解けるはずだから。",
      "source_raw_sha256": "FCC17F5B3AD28BAC6E843A65B75BF184CCE8EEB05BFBB92561A5B62AD322A5AE",
      "target_text": "당신이 기억을 잃었다는 사실을^n나 나름대로 심각하게 받아들이고 어떻게든 해 보려고 했어요.^n수학이라면 웬만한 문제는 풀 수 있을 테니까요.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    }
  ]
}
