  "translation_method": "Codex internal model only; no external MT/API",
  "review_passes_completed": 0,
  "release_ready": false,
  "entries": [
    {
      "uid": "scr.xfl::1124.gsc::slot/00001",
      "source_text": "今朝に見せられた診察室の光景と、^n連れ去られたグレーテルを連れ戻した昼間の記憶。",
      "source_raw_sha256": "0755AB2C275B1F8A9DCDF5753DCE928DED42F6187A059F0E3E95013CEEA71E74",
      "target_text": "오늘 아침에 보여진 진찰실의 광경과,^n끌려간 그레텔을 데려온 낮의 기억.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00002",
      "source_text": "　それに、さっきのお医者様とのやり取りで浮かんだ^n「偽のお医者様が|紛[まぎ]れ込んでいるのでは」という考えのせいで、^n　僕は少し不安な気持ちでグレーテルの部屋へと向かった。",
      "source_raw_sha256": "B94C9328A949D8C4A22CA902C3D7C5F5157B908B1E221E0086EFD1F3AC4D2A66",
      "target_text": "　게다가 아까 의사 선생님과 나눈 대화에서 떠오른^n『가짜 의사가 섞여 들어온 것은 아닐까』라는 생각 때문에,^n　나는 조금 불안한 마음으로 그레텔의 방으로 향했다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00003",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00004",
      "source_text": "（いや、考えすぎなんだろうけど。^n",
      "source_raw_sha256": "5C2E1FF2F333EDBCA9122C5D62427C6124CABB4EEA37434557A04BE3AEC90DF4",
      "target_text": "(아니, 너무 깊이 생각하는 거겠지만.^n",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00005",
      "source_text": "　──僕は、心配性で過保護なお兄ちゃんだったのかな）",
      "source_raw_sha256": "F763844C07A56F81F661E054A474FFE54B176150602ED247001907827725B811",
      "target_text": "　──나는 걱정이 많고 과보호하는 오빠였던 걸까.)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00006",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00007",
      "source_text": "……ヘンゼルお兄ちゃん？",
      "source_raw_sha256": "CABD8B9B8C40A5BD483B6F34B8D103E2D5858DDB25D089CEF44E8317890AAE83",
      "target_text": "……헨젤 오빠?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00008",
      "source_text": "か細い声が、^nドアの向こうから|見透[みす]かしたように僕を呼んだ。",
      "source_raw_sha256": "F7CC37E8AEC3DC1E9B351FC204BC39981119619AF7F122BDDDD22119012CEE6D",
      "target_text": "가느다란 목소리가^n문 너머에서 꿰뚫어 본 듯 나를 불렀다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00009",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00010",
      "source_text": "う、うん。入るよ？",
      "source_raw_sha256": "ACD5D1BCA90C860189118209EAA83307FE509C41C532B36DBBB141DF4A23DD91",
      "target_text": "으, 응. 들어가도 돼?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00011",
      "source_text": "うん、というグレーテルの声を聞いてドアノブに手をかける。",
      "source_raw_sha256": "BC8453246469E46A4642AC74A998F5028EFE06C6DD31ABFF7A33EC8C27A92DE5",
      "target_text": "응, 하는 그레텔의 목소리를 듣고 문손잡이에 손을 댄다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00012",
      "source_text": "グレーテルは、もし訪れたのが僕じゃなくても、^n僕だと思いこんで呼んでいるんだろうか──^n|気恥[きは]ずかしく思いながら、部屋に入った。",
      "source_raw_sha256": "D3442AB173F645BA5FC43FAE884C92F6FA9016CE0917F0450AF8517516514A57",
      "target_text": "그레텔은 찾아온 사람이 내가 아니어도,^n나라고 믿고 그렇게 부르는 걸까──^n어쩐지 부끄럽게 여기며 방에 들어갔다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00013",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00014",
      "source_text": "お……お兄ちゃん！",
      "source_raw_sha256": "CFCFDFBF57C5C948916D6370A953B21CDA49FDEC5A4C2E65B47958C0B941BD57",
      "target_text": "오…… 오빠!",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00015",
      "source_text": "グレーテルはやっぱり毛布にくるまっていた。^n|裾[すそ]を引きずりながら、ヤドカリのようにずりずりと^n戸口の僕へと向かって歩いてくる。",
      "source_raw_sha256": "6BC291844FC99150CB135C1EACB28C0F1C151929587F5D36533544925A1A745D",
      "target_text": "그레텔은 역시 이불을 뒤집어쓰고 있었다.^n자락을 끌며 소라게처럼 질질^n문간에 선 나를 향해 걸어온다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00016",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00017",
      "source_text": "グレーテル？^nいったいどうしたの。また何かあった？",
      "source_raw_sha256": "21E00DF4FCA232DACD3A5EDAE09BE604DF7E4B9B876CA776B06EA4C1F669656E",
      "target_text": "그레텔?^n대체 왜 그래. 또 무슨 일 있었어?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00018",
      "source_text": "その瞳いっぱいに涙が|溜[た]まって今にもこぼれ落ちそうなのを見て、^nさっきのいやな予感がぶり返した。",
      "source_raw_sha256": "DB3FF34570B2C445B4763D4489EF50CDC89E3AE9C8A05EB1D5CB5F4CBDF0AEE2",
      "target_text": "눈동자 가득 눈물이 고여 금방이라도 쏟아질 듯한 것을 보고,^n아까의 불길한 예감이 되살아났다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00019",
      "source_text": "もっとも、グレーテルの|潤[うる]んだ瞳には^nこの部屋を訪れる度に出会っている気もする。",
      "source_raw_sha256": "945C94767E2460EA60DA9A27B21C6755B3E35FAE1BBEDA80BAE418C7C9AF2666",
      "target_text": "그렇지만 그레텔의 촉촉한 눈동자는^n이 방을 찾을 때마다 마주치는 것 같기도 하다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00020",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00021",
      "source_text": "ぁ、あのね……昼間、石を落としたまま、拾わないで^n帰って来ちゃったでしょ……。",
      "source_raw_sha256": "8D8FC2A3E7BBACC081774D0CB570A6E7EDAE15844C586CEB8525F0CCB90BCE8D",
      "target_text": "저, 저기 있잖아…… 낮에 돌을 떨어뜨린 채 줍지 않고^n돌아와 버렸잖아…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00022",
      "source_text": "グレーテルは、^n何度見ても心が締め付けられるようないたいけなまなざしをして、^nおずおずと語り始めた。",
      "source_raw_sha256": "08980807D180FB5365BEB359E2A509A3FF583A15977DD8C1E1285D6FA781D87D",
      "target_text": "그레텔은^n몇 번을 봐도 가슴이 조여 올 듯 가련한 눈빛으로,^n머뭇거리며 이야기를 시작했다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00023",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00024",
      "source_text": "ああ、拾いながら帰るのも|億劫[おっくう]だったし、^n途中から帰り道がわかったら用はなくなったしね。",
      "source_raw_sha256": "0BF16EA6BCB8ADCC47A5F1E6D8270C6B37EF8C4189D41BDA97006D9338EB9826",
      "target_text": "아, 주우면서 돌아오기도 귀찮았고,^n중간부터 돌아가는 길을 알았으니 쓸모도 없어졌지.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00025",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00026",
      "source_text": "うん……。^nでも、またあんなことがあったらって思うと、怖くて。^nわたし、昨日みたいに石を拾っておこうって考えて……。",
      "source_raw_sha256": "5B55885EF32D305475D5417CE7D1BC4F399201D8783DE23B1CCBE9FF40A8F724",
      "target_text": "응…….^n하지만 또 그런 일이 생길까 봐 무서워서.^n나, 어제처럼 돌을 주워 두자고 생각하고…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00027",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00028",
      "source_text": "ああ……。",
      "source_raw_sha256": "B9CD62EC860EADF1D9F2E835DA67B7D747E77E62F569EBBC4A8DCB8B2A8C0219",
      "target_text": "아아…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00029",
      "source_text": "僕は「裏口」に続く扉に目をやる。^n早々に、話が見えてきた。",
      "source_raw_sha256": "758C0A0038C69F90FE1D114781399DC52A3A211351FE4A67CC3C3F19CD273754",
      "target_text": "나는 『뒷문』으로 이어지는 문을 바라본다.^n일찌감치 이야기의 윤곽이 보이기 시작했다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00030",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00031",
      "source_text": "そ、そしたら、か、鍵が……。^nあのドア、鍵かかってて、あかなくて……。",
      "source_raw_sha256": "663AB3A7AEC81F215B291689B1A16D0C30036D1B2147A3E68505CBD3037EF4A1",
      "target_text": "그, 그랬더니 자, 자물쇠가…….^n저 문, 잠겨 있어서 안 열리고…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00032",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00033",
      "source_text": "い……っ、いつのま、に……だれか、が……。",
      "source_raw_sha256": "E8B449122F07DD5C3D64AEEE65E603704319A4B320A39606C26E8F3D1ED81D76",
      "target_text": "어…… 어, 언제 누, 누가…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00034",
      "source_text": "グレーテルは胸元の「ヘンゼルとグレーテル」を^nすがりつくように強く抱きしめた。",
      "source_raw_sha256": "09CE7E6565C9FA20D13C3AFE5C774D60BDD5801BFBF4EF6154810F4AAB13358A",
      "target_text": "그레텔은 가슴께의 『헨젤과 그레텔』을^n매달리듯 강하게 끌어안았다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00035",
      "source_text": "　この展開は、彼女のその「聖書」に書かれていたことだ。^n「翌日は裏庭に行くドアに鍵がかかっていて、^n　石を拾うことはできませんでした」",
      "source_raw_sha256": "7F8CE57641C4735ED9D6769C278A1572BC209600E30A8B98FA77795475273EAF",
      "target_text": "　이 전개는 그녀의 그 『성서』에 적혀 있었다.^n『다음 날에는 뒤뜰로 가는 문이 잠겨 있어,^n　돌을 주울 수 없었습니다.』",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00036",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00037",
      "source_text": "もしかして──お、お父さんと、お母さん？^n石があると、わたしたちが帰って来ちゃうから……？",
      "source_raw_sha256": "F1C0C305500ED20025DF684BE53A72CED8E82C8C4EDF21499C9723261D07790B",
      "target_text": "혹시──아, 아빠와 엄마가?^n돌이 있으면 우리가 돌아와 버리니까……?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00038",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00039",
      "source_text": "（もしかして、グレーテルが自分で鍵をかけたとか……）",
      "source_raw_sha256": "C0B6B60E6FAABF6C48C1CC6491689CFBF09D786B2A6B964F1022AA97C243D954",
      "target_text": "(혹시 그레텔이 스스로 문을 잠갔다든가…….)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00040",
      "source_text": "肩をすぼめて全身を震わせるグレーテルを哀れみつつも、^n僕はそんなことを考えてしまった。",
      "source_raw_sha256": "05225662091C0B8EE3DF0CB43D48386B33A4F5910AE72F55C24C387CEC2B645D",
      "target_text": "어깨를 움츠리고 온몸을 떠는 그레텔을 안쓰럽게 여기면서도,^n나는 그런 생각을 하고 말았다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00041",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00042",
      "source_text": "（でも、この|怯[おび]えよう──^n　少なくとも意識的なものではないんだろうな）",
      "source_raw_sha256": "690662A50005FFCB11859C39B7C775494961A484E6A18CB5129AB5E2AF5542D6",
      "target_text": "(하지만 이렇게 두려워하는 걸 보면──^n　적어도 의식적으로 한 일은 아니겠지.)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00043",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00044",
      "source_text": "ど……どうしようお兄ちゃん。^nこれじゃ、小石を拾いにいけないよ……。",
      "source_raw_sha256": "4118D593C8C9DE65770F81DE919CB5F0A165D76D1A9B72BE5B993B40DF3676E5",
      "target_text": "어…… 어떡하지, 오빠.^n이래서는 조약돌을 주우러 갈 수 없어…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00045",
      "source_text": "ぐしゅ、と鼻をすすってグレーテルがつぶやく。^nこのままじゃ、ゆるゆるの涙腺がゆるみきってしまうのも^n時間の問題かもしれない。",
      "source_raw_sha256": "92F0D9BD3F629BAC864566DDF531475459EFA493818D06EE3F9023D9FD56FF20",
      "target_text": "훌쩍 코를 들이마시며 그레텔이 중얼거린다.^n이대로라면 느슨한 눈물샘이 완전히 풀려 버리는 것도^n시간문제일지 모른다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00046",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00047",
      "source_text": "（うーん、どうしよう。^n　別に裏庭に行かなくても、庭園ならいくらでも拾えるよね。^n　昼間のを回収してもいいんだし）",
      "source_raw_sha256": "9CBE9100090BD77F69F5D977333B272E9DC288EDF808764E2C3CEAB4AB525771",
      "target_text": "(음, 어떡하지.^n　굳이 뒤뜰에 가지 않아도 정원에서 얼마든지 주울 수 있잖아.^n　낮에 떨어뜨린 걸 회수해도 되고.)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00048",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00049",
      "source_text": "（でも、たぶんグレーテルが求めているのは^n　そんなことじゃなくて……）",
      "source_raw_sha256": "6DE95FBD271F7B3661154448DD209CB571FB06A564F7F6028E322EF3F0448DCC",
      "target_text": "(하지만 아마 그레텔이 원하는 건^n　그런 게 아니라…….)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00050",
      "source_text": "僕は、困り果てたグレーテルに対し──",
      "source_raw_sha256": "59BD494DDEE40A1463B91B4DAB4135C3A11470C51943FEA28C7B58F7B70AA2AC",
      "target_text": "나는 어쩔 줄 모르는 그레텔에게──",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00051",
      "source_text": "小石がないなら……。",
      "source_raw_sha256": "244A98E7FFB740633EBF0CA95D27AF3C380CDF903E44735C4AC8D2007DE53CB8",
      "target_text": "조약돌이 없다면…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00052",
      "source_text": "パンだ。",
      "source_raw_sha256": "F61FE69DFDC245EC7E0A71D5E9C593D79A54FC00F737FA2529E88C784C557A07",
      "target_text": "빵이다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00053",
      "source_text": "いや、小石なら他の場所にも……。",
      "source_raw_sha256": "D44AB2DD721D4379A243F0101D28C15051CD0282B74F10C1B5B0006F92CBD7FB",
      "target_text": "아니, 조약돌이라면 다른 곳에도…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00054",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00055",
      "source_text": "（まあ、ここはあれだよね）",
      "source_raw_sha256": "F8E88D7233EBB7EAD136A7FF4131CB9B87A8E2EE41D6DF7DE8099C0712DCBD77",
      "target_text": "(뭐, 여기서는 그거겠지.)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00056",
      "source_text": "僕はあるべき流れに乗ることにした。",
      "source_raw_sha256": "401F4B25E01706E697AA15687EBBA5E84099C35ABBDFAE5DBA05461D5A594446",
      "target_text": "나는 마땅한 흐름을 타기로 했다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00057",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00058",
      "source_text": "ちょっと待っててね、グレーテル。",
      "source_raw_sha256": "475F98DC0CAA7C6EA47023DAE7E780A3C4A28AA697853B47830807A3BB166B3C",
      "target_text": "잠깐만 기다려, 그레텔.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00059",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00060",
      "source_text": "え……？　お兄ちゃん？",
      "source_raw_sha256": "F3F382C188371357E93CD0850F91B380384FDA4303C45508D4D2FD39DEB19577",
      "target_text": "어……? 오빠?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00061",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00062",
      "source_text": "……！",
      "source_raw_sha256": "1A8E369E83AAD9740790D4F7808856D5E3967EFEEEC267023E41E843C8936E62",
      "target_text": "……!",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00063",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00064",
      "source_text": "お待たせ。",
      "source_raw_sha256": "697F5DB7249F07993E3F069A41524475FA5051D1D114E051A374EECECDF8032C",
      "target_text": "기다렸지.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00065",
      "source_text": "運良く、あれからすぐに^n夕食のトレイを下げている職員さんを見つけることができた。",
      "source_raw_sha256": "1A678FA81B7A8281224AA88189121D839B7497BFAD30982BD34D6C7F4226B799",
      "target_text": "운이 좋게도 그 뒤 곧바로^n저녁 식사 쟁반을 치우는 직원을 찾을 수 있었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00066",
      "source_text": "　理由も言わずにパンをねだった僕に対し、何も聞かず、^n「育ち盛りだもんね」みたいな顔をして応えてくれたのも^n　とてもありがたかった。",
      "source_raw_sha256": "5447A2DD57380E849C276B47FE30D47AEE234EDC2403D350E9433FE6C2C0F6D8",
      "target_text": "　이유도 말하지 않고 빵을 달라고 한 내게 아무것도 묻지 않고,^n『한창 자랄 나이니까』 하는 표정으로 응해 준 것도^n　무척 고마웠다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00067",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00068",
      "source_text": "グレーテル、パンをもらってきたよ。^nきみもさっき食べたよね。^n晩ご飯のシチューについてた残りで──",
      "source_raw_sha256": "3CD8BE432783FD33715D82F4D5013A09337114B13E5A64DBBAB75033796599B6",
      "target_text": "그레텔, 빵을 얻어 왔어.^n너도 아까 먹었지.^n저녁 스튜에 딸려 나온 나머지인데──",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00069",
      "source_text": "ばさっ、と音がした。^nグレーテルの肩から毛布が、その手から「聖書」が、^n床に滑り落ちたのだ。",
      "source_raw_sha256": "8667AB7526082AB7D81D176115095A6BF67691891BC2E634E4E0003A05993C3B",
      "target_text": "털썩, 하는 소리가 났다.^n그레텔의 어깨에서 이불이, 손에서는 『성서』가^n바닥으로 미끄러져 떨어진 것이다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00070",
      "source_text": "グレーテルは小さな手を僕に向かって伸ばし、^n物言いたげに目をキラキラ、口をパクパクさせながら^nおぼつかない足取りでこちらに向かってくる。",
      "source_raw_sha256": "8774D13D6E482DEFB894C9F977A79DFE76EE294AE67D04F4FC188BEF1AE28CA0",
      "target_text": "그레텔은 작은 손을 내게 뻗고,^n할 말이 있는 듯 눈을 반짝이고 입을 뻐끔거리며^n불안한 걸음으로 이쪽을 향해 온다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    }
  ]
}
