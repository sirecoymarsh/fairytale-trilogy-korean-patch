  "review_passes_completed": 0,
  "release_ready": false,
  "entries": [
    {
      "uid": "scr.xfl::1124.gsc::slot/00141",
      "source_text": "……うん。",
      "source_raw_sha256": "FEDD625442A89BBDA6022894F47741C745653F7E100D1D62B6A3742BEC8CCA5D",
      "target_text": "……응.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00142",
      "source_text": "グレーテルはまだ気まずそうな顔をして、うなずく。",
      "source_raw_sha256": "B6915ECCBDBEA43C5245397074C3EA349A08F32019F185D916482F5B472D3E51",
      "target_text": "그레텔은 여전히 어색한 표정으로 고개를 끄덕인다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00143",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00144",
      "source_text": "う、うち……貧しいのに食べる口だけは多いから、^nあんまり食べられなくても^n|贅沢[ぜいたく]言っちゃいけないって……おかあさんが。",
      "source_raw_sha256": "19A4CB314256B69AB36915F3201560444325F5CB284F23BA0DC31CB354F40EA5",
      "target_text": "우, 우리 집…… 가난한데 먹을 입만 많으니까,^n많이 먹지 못해도^n사치 부리면 안 된다고…… 엄마가.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00145",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00146",
      "source_text": "あ、ああ……。",
      "source_raw_sha256": "2C974841386A95408C09DC0E79B1981C6A3F353E02468CB25127A9D76725C9F2",
      "target_text": "아, 아아…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00147",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00148",
      "source_text": "（いや、病院食だからメニューは一緒だろうし、^n　充分な量が出ていると思うんだけど）",
      "source_raw_sha256": "22474FE6F0CA370F743903A15E7C84243EE5FE846AC97783AC03C2793845D8B3",
      "target_text": "(아니, 병원 식사니까 메뉴는 같을 테고,^n　충분한 양이 나오는 것 같은데.)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00149",
      "source_text": "僕は|喉[のど]まで出かかった言葉を飲み込む。",
      "source_raw_sha256": "4246388BAFF100F71ED6E7B41FB7D5FDA042569412EA214243605AE6618B9605",
      "target_text": "나는 목구멍까지 나온 말을 삼켰다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00150",
      "source_text": "　心から悲しそうにつぶやくグレーテルに、^n「きみの胃袋が大きいだけなんだよ」^n　とは言えなかった。",
      "source_raw_sha256": "E85C848BBBF993935DFE13E478E4A7C48F87DCCD3085C72508DDBDFD952D8196",
      "target_text": "　진심으로 슬픈 듯 중얼거리는 그레텔에게,^n『네 위가 클 뿐이야.』^n　라고 말할 수는 없었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00151",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00152",
      "source_text": "（とはいえ、パンじゃ「小鳥に食べられる」ことになっているし、^n　不安だろうな）",
      "source_raw_sha256": "3EB206FDFA0814FAED4E88B52579A47B02E5A750AF79ED56B2F66658F54F0A1F",
      "target_text": "(그렇다 해도 빵은 『새가 먹어 버리는』 걸로 되어 있으니,^n　불안하겠지.)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00153",
      "source_text": "僕はそんな風に考えた。",
      "source_raw_sha256": "36A839A036752FCCA1F23BA017D46E47D22BB31CB7948139F455DC57029A9DB6",
      "target_text": "나는 그렇게 생각했다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00154",
      "source_text": "本来の物語とは違うけれど、^nグレーテルを連れ去ろうとした人間がいたかもしれないし、^n安全な方向に変えたほうがいいだろうと。",
      "source_raw_sha256": "DF7C6F15D25354339C3BE2AD388DA9F48AAA3446683FB37CA26167912B870A1D",
      "target_text": "원래 이야기와는 다르지만,^n그레텔을 끌고 가려던 사람이 있었을지도 모르고,^n안전한 방향으로 바꾸는 편이 좋겠지.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00155",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00156",
      "source_text": "庭園に行こうか。",
      "source_raw_sha256": "705B8451F0261F22350E011999A64ACB1228AAF726E13E3A276B77FC784ACF14",
      "target_text": "정원에 갈까?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00157",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00158",
      "source_text": "……？",
      "source_raw_sha256": "5DFABE8B5F1FB385E794320F7C1DD6ED08B48978C9A54D65344343944FB2322D",
      "target_text": "……?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00159",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00160",
      "source_text": "石なら庭園にもあるよ。^nそこからいくらでも拾ってくれば大丈夫。",
      "source_raw_sha256": "78C64FE14C155980B218A8388D0EAA9FE4B4F464CA3C872A90722AAE43CB532A",
      "target_text": "돌이라면 정원에도 있어.^n거기서 얼마든지 주워 오면 괜찮아.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00161",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00162",
      "source_text": "…………。",
      "source_raw_sha256": "0A0A39A23D968038B6135EB7825A35667F28EF942D728F4925E6018672732E6B",
      "target_text": "………….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00163",
      "source_text": "グレーテルが示したのは、ひたすらに戸惑いだった。",
      "source_raw_sha256": "DFFA00E7339DE49C08C21F103BC7B9F614700466DC2477663191D55ACCB8825A",
      "target_text": "그레텔이 보인 것은 오직 당혹감이었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00164",
      "source_text": "不安や悲しみのかわりに純粋な当惑が現れて、^n軽く目だけを見張った無表情になる。",
      "source_raw_sha256": "0D62EB1157E8633DB270E7653D4CB4B84C2563488D180A3C3CE6095B2B7E7731",
      "target_text": "불안이나 슬픔 대신 순수한 당혹감이 드러나,^n눈만 살짝 크게 뜬 무표정이 된다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00165",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00166",
      "source_text": "グレーテル？　行かないの。^n何なら、昼間落とした物を回収すればいいんだよ。",
      "source_raw_sha256": "2630579EBCD6661B46C77589D5EFBF5B87EE5837E334E6D0ACC06F8B6D22E78D",
      "target_text": "그레텔? 안 갈 거야?^n정 그러면 낮에 떨어뜨린 걸 회수하면 돼.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00167",
      "source_text": "僕の呼びかけにも応えず、^nグレーテルはぱちぱちとまばたきを繰り返し……。",
      "source_raw_sha256": "3A0E267BA570F58341C7502F8A80D2E13104CCD0F960DBB193427401CD2E7908",
      "target_text": "내 부름에도 대답하지 않고,^n그레텔은 몇 번이나 눈을 깜박이다가…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00168",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00169",
      "source_text": "…………。",
      "source_raw_sha256": "0A0A39A23D968038B6135EB7825A35667F28EF942D728F4925E6018672732E6B",
      "target_text": "………….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00170",
      "source_text": "やがて壁際まで後ずさると、すとんと腰を下ろす。^n毛布が顔や手の先まで深く|覆[おお]って、^nただの布のかたまりになった。",
      "source_raw_sha256": "3E61F96C9F365A0024351C00B19B65D897D18E88109C1CC8121F14FD8475764A",
      "target_text": "이윽고 벽까지 뒷걸음질하더니 털썩 주저앉는다.^n이불이 얼굴과 손끝까지 깊이 덮어,^n그저 천 뭉치가 되었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00171",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00172",
      "source_text": "……？",
      "source_raw_sha256": "5DFABE8B5F1FB385E794320F7C1DD6ED08B48978C9A54D65344343944FB2322D",
      "target_text": "……?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00173",
      "source_text": "僕はキルティングの殻にこもったグレーテルに戸惑ったけれど、^nそこから彼女は声をかけても反応しなくなってしまったので、^nそのまま部屋を出るしかなかった。",
      "source_raw_sha256": "8C2EDFBD22B75D354FCDC5776088D931C07F3DA2F5461BECFEB32F42D525C9D2",
      "target_text": "나는 누비이불 껍데기에 틀어박힌 그레텔 때문에 당황했지만,^n그 뒤로 아무리 불러도 반응하지 않게 되어 버렸으므로,^n그대로 방을 나올 수밖에 없었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00174",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00175",
      "source_text": "（……なんだったんだろう。^n　やっぱり、ストーリーを外れたのがまずかったのかな）",
      "source_raw_sha256": "466B3E53025E84E75C82DCC30A9C69FBF49266012E298706AC755E308AC2EEE8",
      "target_text": "(……뭐였을까.^n　역시 이야기에서 벗어난 게 잘못이었나.)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00176",
      "source_text": "ドアを後ろ手に閉めて思案していると、^nイケノさんが通りかかった。",
      "source_raw_sha256": "05D6B40A3876F2A578BFE530CB188D084E1B87E57E2E52460EE4DC4260404F11",
      "target_text": "등 뒤로 문을 닫고 생각에 잠겨 있자,^n이케노 씨가 지나갔다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00177",
      "source_text": "イケノ",
      "source_raw_sha256": "92C809E9187A7974F07D5D0C48B21F3B995A046545D76998B5615854DDBE7203",
      "target_text": "이케노",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00178",
      "source_text": "どうしたんだい、ナナシくん。^n──いや、この部屋から出てきたということは、^nいまはヘンゼルかな？",
      "source_raw_sha256": "1563AF13143B84A12CB424780D67C427C3948FB1A9278CC74DBB6956620A3AFF",
      "target_text": "무슨 일이니, 나나시 군.^n──아니, 이 방에서 나왔다는 건,^n지금은 헨젤인가?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00179",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00180",
      "source_text": "さっきまではそう思われてたんですけど……。^n──もう、クビかなぁ。",
      "source_raw_sha256": "4E66571417FBD7025D4E0599587F32A0A90C5C27D712D1CAA761CF6AB34CA82E",
      "target_text": "아까까지는 그렇게 생각됐는데요…….^n──이제 잘린 걸까요.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00181",
      "source_text": "イケノ",
      "source_raw_sha256": "92C809E9187A7974F07D5D0C48B21F3B995A046545D76998B5615854DDBE7203",
      "target_text": "이케노",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00182",
      "source_text": "クビ？",
      "source_raw_sha256": "1A7F1754B416088E61274027A2B3B104F65F508BFFEEA3DEF28C518F78A8B500",
      "target_text": "잘려?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00183",
      "source_text": "イケノ",
      "source_raw_sha256": "92C809E9187A7974F07D5D0C48B21F3B995A046545D76998B5615854DDBE7203",
      "target_text": "이케노",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00184",
      "source_text": "ああ、確かにそれは、クビかもなぁ。",
      "source_raw_sha256": "7911FB6BBC05DAF142B811753660C59413D5751469D7A3B82D147EABB3B9EDC8",
      "target_text": "아, 확실히 그건 잘린 걸지도 모르겠네.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00185",
      "source_text": "話を聞き終えたイケノさんは、深いため息をついた。",
      "source_raw_sha256": "58E958E0488DBE590C5F23307201F75D2806CD1D21F62EB128C20F87B99FE803",
      "target_text": "이야기를 다 들은 이케노 씨는 깊은 한숨을 내쉬었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00186",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00187",
      "source_text": "やっぱりよくなかったですよね。",
      "source_raw_sha256": "CA7DBFF42877EBEDC00F80216EA399B4CF7A3FB594C0DCF51F4738AED2BE6272",
      "target_text": "역시 좋지 않았죠.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00188",
      "source_text": "イケノ",
      "source_raw_sha256": "92C809E9187A7974F07D5D0C48B21F3B995A046545D76998B5615854DDBE7203",
      "target_text": "이케노",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00189",
      "source_text": "んー、あきらかに正解はパンだったよね……。",
      "source_raw_sha256": "D1EBBA5576F0FB2D42208A8124D09F044C394097E4EB40107FC9AE8F380C54A5",
      "target_text": "음, 누가 봐도 정답은 빵이었지…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00190",
      "source_text": "僕は、グレーテルが最後に見せた奇妙な無表情を思い出す。",
      "source_raw_sha256": "163EE72CBB620CC520875FD9A13195BC7CC1EAD37F0FD16139B3DFB3C0C5954A",
      "target_text": "나는 그레텔이 마지막으로 보인 기묘한 무표정을 떠올린다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00191",
      "source_text": "　あれは、僕によって世界を壊されそうになったグレーテルが、^n　悩み、混乱し、自問していた顔なんだろう。^n「この人は誰だろう？」と。",
      "source_raw_sha256": "F630E5866435654CC85E12FADFBEFD041D15032269AD69AA6804F327D55BB81C",
      "target_text": "　그건 나 때문에 세계가 무너질 위기에 놓인 그레텔이^n　고민하고 혼란스러워하며 자문하던 얼굴이었겠지.^n『이 사람은 누구지?』라고.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00192",
      "source_text": "イケノ",
      "source_raw_sha256": "92C809E9187A7974F07D5D0C48B21F3B995A046545D76998B5615854DDBE7203",
      "target_text": "이케노",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00193",
      "source_text": "惜しいなぁ、きみならいいお兄ちゃんになれそうなのに。",
      "source_raw_sha256": "FECB023B1C57648CB47A3A4192A21F47DC77175C733F9C16E82EBDFA689D2545",
      "target_text": "아깝네. 너라면 좋은 오빠가 될 수 있을 것 같은데.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00194",
      "source_text": "イケノ",
      "source_raw_sha256": "92C809E9187A7974F07D5D0C48B21F3B995A046545D76998B5615854DDBE7203",
      "target_text": "이케노",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00195",
      "source_text": "ストーリーを忠実に追うより、^n妹の無事を考えて別の選択をするなんて、^n結構お兄ちゃんらしい判断だと思うけどなー。",
      "source_raw_sha256": "52EDBB31781EA025628F370B04FFEFB453582FADC9D3197FB7C954A80B2B4CBA",
      "target_text": "이야기를 충실히 따라가기보다,^n여동생의 안전을 생각해 다른 선택을 하다니,^n제법 오빠다운 판단이라고 생각하는데.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00196",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00197",
      "source_text": "そうですか？^nでも、グレーテルがいやがってるんじゃ、もう……。",
      "source_raw_sha256": "BD53F092BDAB816B918542C806CB8D2A2DBC444AD27CFAF0DCAC792F21E1D48B",
      "target_text": "그런가요?^n하지만 그레텔이 싫어한다면 이제…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00198",
      "source_text": "イケノ",
      "source_raw_sha256": "92C809E9187A7974F07D5D0C48B21F3B995A046545D76998B5615854DDBE7203",
      "target_text": "이케노",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00199",
      "source_text": "　まあ、グレーテルにとっては野暮だよね。^n「きみはグレーテルじゃない」って言われてるようなものだし。",
      "source_raw_sha256": "AFE7AEFB812FC465D4B16121033C2E48E965853E70A61D9067E3E0FECB4E17D3",
      "target_text": "　뭐, 그레텔에게는 눈치 없는 짓이지.^n『넌 그레텔이 아니야.』라는 말을 들은 것과 마찬가지니까.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00200",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00201",
      "source_text": "です、よね……。",
      "source_raw_sha256": "15614A992C8536F9F52B360F21156D8951EFB4BE048BB1D87FC7509E2C74668A",
      "target_text": "그렇, 죠…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00202",
      "source_text": "イケノさんはそれから、^n二言三言|慰[なぐさ]めの言葉をくれて立ち去っていった。",
      "source_raw_sha256": "F62FD3E694500311933E34009CC218AB24FAB5E43781E93F51EA7E50F6D856D7",
      "target_text": "이케노 씨는 그 뒤로^n두어 마디 위로의 말을 건네고 떠나갔다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00203",
      "source_text": "僕は僕で、いつまでも立ち尽くしているわけにはいかない。",
      "source_raw_sha256": "22806C9E868D5062039178D736AD8F9B63438D92D3A69CB18AA59945700B72DD",
      "target_text": "나도 언제까지고 우두커니 서 있을 수는 없다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1124.gsc::slot/00204",
      "source_text": "予想外に落ち込んでしまっている自分を持て余しながらも、^n次に行く場所について考えることにした。",
      "source_raw_sha256": "07CCB94CEB3B176EE53933EFF5D08B160A09F8A0B79E07780D887FFD31CCF032",
      "target_text": "예상 밖으로 풀이 죽은 자신을 어쩌지 못하면서도,^n다음에 갈 곳을 생각하기로 했다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    }
  ]
}
