  "review_passes_completed": 0,
  "release_ready": false,
  "entries": [
    {
      "uid": "scr.xfl::1127.gsc::slot/00056",
      "source_text": "大丈夫？",
      "source_raw_sha256": "2B802D1933EF82E1708918B02271D6095D14E7FE2900D8B65915912E12514BF4",
      "target_text": "괜찮아?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1127.gsc::slot/00057",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1127.gsc::slot/00058",
      "source_text": "ええ……。ごめんなさいね。^nなんだか寒気がして。",
      "source_raw_sha256": "7A7999B7F48BE6BF6826730A7AD0AA0ED5521D33782282B019C61F3C8B9DC58D",
      "target_text": "응……. 미안해.^n왠지 오한이 들어서.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1127.gsc::slot/00059",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1127.gsc::slot/00060",
      "source_text": "風邪とか？",
      "source_raw_sha256": "4741E270EF36E00F389FFF544EDD5CB3CDFB975C9A1AB3175EAC3597ED94C706",
      "target_text": "감기라도 걸린 거야?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1127.gsc::slot/00061",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1127.gsc::slot/00062",
      "source_text": "風邪……いやね。^nでも、このゾクゾクする感じは、そうなのかも。",
      "source_raw_sha256": "F09882811DF41B9DB667CFF9F949DA1D1A27A7B6333F60A43F5EF2EC83CE6817",
      "target_text": "감기…… 싫다.^n하지만 이 으슬으슬한 느낌은 그럴지도 모르겠네.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1127.gsc::slot/00063",
      "source_text": "ゲルダは|剥[む]き出しの腕をさする。",
      "source_raw_sha256": "3E0CFB723A9788A3302E0148EC934A67B393026293212F451489B5892A59B660",
      "target_text": "게르다는 드러난 팔을 문질렀다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1127.gsc::slot/00064",
      "source_text": "そういえば、さっき優しい桃色に染まった頬は、^nその後落ち着くどころかますます色味を強めている。^nただ単に、熱が上がってきているということだったんだろうか。",
      "source_raw_sha256": "FCA0BBD0634EEA4091663251DD34D6E6BCD01BCF3CA04C5BD3928C76516DFEDF",
      "target_text": "그러고 보니 조금 전 부드러운 복숭앗빛으로 물든 뺨은,^n그 뒤로 진정되기는커녕 더욱 짙어지고 있다.^n그저 열이 오르고 있었다는 뜻이었을까.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1127.gsc::slot/00065",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1127.gsc::slot/00066",
      "source_text": "あの、ごちそうさま。^n今日はこれで失礼するから、ゆっくり休んで。",
      "source_raw_sha256": "B59AC20A085408BE05AFBEA07C64532B788DA33FC2D837FB6C57DC4FFDE92F7F",
      "target_text": "저기, 잘 마셨어.^n오늘은 이만 갈 테니까 푹 쉬어.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1127.gsc::slot/00067",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1127.gsc::slot/00068",
      "source_text": "…………。",
      "source_raw_sha256": "0A0A39A23D968038B6135EB7825A35667F28EF942D728F4925E6018672732E6B",
      "target_text": "………….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1127.gsc::slot/00069",
      "source_text": "ゲルダはほんの一瞬、無防備な表情で僕を見た。^n僕の気遣いは、彼女にとって^nありがたいけれど|寂[さび]しいことだったみたいだ。",
      "source_raw_sha256": "1B0AF275F31B0E8BA41ECAFECEF5361D551AE7341A80D3B0C0D7D9AD4513EF1B",
      "target_text": "게르다는 아주 잠깐 무방비한 표정으로 나를 보았다.^n내 배려는 그녀에게^n고맙지만 외로운 일이었던 모양이다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1127.gsc::slot/00070",
      "source_text": "しかし次の瞬間には、いつもの^nいかにも優等生といったそつのない顔になって、^nなんでもないことのように|頷[うなず]いた。",
      "source_raw_sha256": "F45C3D982A91D4BAB815EDE06FEC18864CD631BD6E7F7F02DF01B38EBD77B5E3",
      "target_text": "하지만 다음 순간에는 평소처럼^n누가 봐도 모범생다운 빈틈없는 표정으로 돌아와,^n아무 일도 아니라는 듯 고개를 끄덕였다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1127.gsc::slot/00071",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1127.gsc::slot/00072",
      "source_text": "そうね。こじらせたらよくないし。^n早めにベッドに入って、ゆっくり眠ることにする。",
      "source_raw_sha256": "6A91020DD4BC6485B167A20CFE959A997FCA34B44E7AB07FF44C22EE0F292198",
      "target_text": "그러네. 심해지면 안 되니까.^n일찍 침대에 들어가서 푹 자야겠어.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1127.gsc::slot/00073",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1127.gsc::slot/00074",
      "source_text": "食器は僕が下げておくよ。",
      "source_raw_sha256": "56D139EC7651B82ECD9E1734F4BFC30EB57DC4821B8749171EC80680BFC23D35",
      "target_text": "그릇은 내가 가져다 놓을게.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1127.gsc::slot/00075",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1127.gsc::slot/00076",
      "source_text": "本当？　それは……助かるわ。^n申し訳ないけど、お願いできるかしら。",
      "source_raw_sha256": "5C5B7B1D11D1A86344A38547C6234EB6530051366C88709C62F51496DA3BF314",
      "target_text": "정말? 그건…… 고맙네.^n미안하지만 부탁해도 될까?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1127.gsc::slot/00077",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1127.gsc::slot/00078",
      "source_text": "うん。^n廊下のワゴンか、見つからなければキッチンに持っていけば、^n洗って部屋に返してくれるんだっけ。",
      "source_raw_sha256": "98B7D02F2EC76CAD767F093232275D48F338ECD413E9D067A362250E838A42AF",
      "target_text": "응.^n복도 카트에 두거나, 안 보이면 주방에 가져다 놓으면,^n씻어서 방으로 돌려보내 주는 거였지?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1127.gsc::slot/00079",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1127.gsc::slot/00080",
      "source_text": "ごめんなさい。私もこうしてお茶を|淹[い]れるのは初めてで、^nよく知らないんだけど……。^n確かそうだったと思う。",
      "source_raw_sha256": "4F0276B769E3AF55D147BACDB3073111CBDAFB78FF646DDC39C24C82A712FEC3",
      "target_text": "미안해. 나도 이렇게 차를 우려 본 건 처음이라,^n잘 모르지만…….^n아마 그랬던 것 같아.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1127.gsc::slot/00081",
      "source_text": "食器を乗せたトレーを手に出ていこうとする僕のために、^nゲルダはドアを開けて支えてくれた。",
      "source_raw_sha256": "0D1F025EED355C97834E8AEA5CDD8D37A6457584213F5DFF10FC6AF57B73BD8D",
      "target_text": "그릇을 올린 쟁반을 들고 나가려는 나를 위해,^n게르다는 문을 열어 붙잡아 주었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1127.gsc::slot/00082",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1127.gsc::slot/00083",
      "source_text": "それじゃ、お大事に……。",
      "source_raw_sha256": "7AE1F3FD3D0E4E839470512AEBA6423254D70040CCCA9D67263450F58268962D",
      "target_text": "그럼, 몸조리 잘해…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1127.gsc::slot/00084",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1127.gsc::slot/00085",
      "source_text": "いろいろありがとう。^n……また来てくれる？",
      "source_raw_sha256": "2A0467445E5C170262EF2443A2590BFB6139C6C6D5CB1FC991F8C73DB5C94768",
      "target_text": "여러모로 고마워.^n……또 와 줄래?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1127.gsc::slot/00086",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1127.gsc::slot/00087",
      "source_text": "もちろん。",
      "source_raw_sha256": "858AD62083C356B464E83A7961CC711DDF338EB1E423299F3B5B162D8BD1EB27",
      "target_text": "물론이지.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1127.gsc::slot/00088",
      "source_text": "僕が深く|頷[うなず]くと、ゲルダはホッとした様子で微笑んだ。",
      "source_raw_sha256": "F91E92996B424E5FA86D3BEA0BF79308A5A10F93947DCA3DB7470E67665DF724",
      "target_text": "내가 깊이 고개를 끄덕이자, 게르다는 안도한 듯 미소 지었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1127.gsc::slot/00089",
      "source_text": "たぶん、僕以上にゲルダは心細いんだろう。^nゲルダは僕とは違う意味で、「自分が誰だかわからない」んだ。",
      "source_raw_sha256": "1FC7BC94C5D4144B2B718441B81FB1E1654F6D6B92A901C1F39293F1B2E7CB49",
      "target_text": "아마 나보다 게르다가 더 불안할 것이다.^n게르다는 나와는 다른 의미로 『자기가 누군지 모른다』.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1127.gsc::slot/00090",
      "source_text": "もう一度くしゃみをした彼女が心配になって、^n僕はついつい余計なことを言ってしまった。",
      "source_raw_sha256": "B721A3875D4916134C781A6B685885F9145BC422FF14107E01DA4C7B045A7120",
      "target_text": "다시 한번 재채기한 그녀가 걱정돼서,^n나는 그만 쓸데없는 말을 해 버렸다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1127.gsc::slot/00091",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1127.gsc::slot/00092",
      "source_text": "その……お大事にね。^nお医者様に薬をもらえばいいんじゃないかな。^nせっかく、ここは病院なんだから。",
      "source_raw_sha256": "32DBE4199F58EBDAE5242B50771E0D039D88398782E238EA39B028F97CFA4ABD",
      "target_text": "그게…… 몸조리 잘해.^n의사 선생님께 약을 받으면 되지 않을까?^n모처럼 병원에 있으니까.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1127.gsc::slot/00093",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1127.gsc::slot/00094",
      "source_text": "……！",
      "source_raw_sha256": "1A8E369E83AAD9740790D4F7808856D5E3967EFEEEC267023E41E843C8936E62",
      "target_text": "……!",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1127.gsc::slot/00095",
      "source_text": "ゲルダは明らかに頬を強ばらせる。^n彼女の不信と警戒、その根深さが伝わってきて^n僕は告げたばかりの失言を後悔した。",
      "source_raw_sha256": "4BD1C83DD78B3A4FB68DD443083D49DBA35CC034D4EB0A66E8D78656DB5D6AA8",
      "target_text": "게르다는 눈에 띄게 표정이 굳었다.^n그녀의 불신과 경계가 얼마나 뿌리 깊은지 전해져,^n나는 방금 내뱉은 실언을 후회했다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1127.gsc::slot/00096",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1127.gsc::slot/00097",
      "source_text": "ご、ごめん。",
      "source_raw_sha256": "EE017131926E5CE1A40DD22A1945ACCD96D517EE895644D71A79105E1AA56ED0",
      "target_text": "미, 미안.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1127.gsc::slot/00098",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1127.gsc::slot/00099",
      "source_text": "いえ、いいのよ。私も過敏なんだと思う。^n──ただ……。",
      "source_raw_sha256": "0D021E26ED1A46945296DE4F6398CD1C02A03E6BD1A9BB553647B4537817E322",
      "target_text": "아니, 괜찮아. 나도 예민하게 구는 것 같아.^n──다만…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1127.gsc::slot/00100",
      "source_text": "ゲルダはしばらく口ごもっていたけれど、^nやがて顔をあげてこう言った。",
      "source_raw_sha256": "14398B0E01D4BDBE38AC7E5D7EBF6B2557488E5E6D2C2126683BDFCF6F53DCD0",
      "target_text": "게르다는 한동안 말을 더듬었지만,^n이윽고 고개를 들고 말했다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1127.gsc::slot/00101",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1127.gsc::slot/00102",
      "source_text": "私が調子を崩していること、誰にも言わないでね。",
      "source_raw_sha256": "812A6E5CA781DBB892D2F56501E08CB8F91C4288181D9CED9EA180EF7A7721E5",
      "target_text": "내가 몸이 안 좋다는 건 아무에게도 말하지 마.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1127.gsc::slot/00103",
      "source_text": "淡々とした、重みを感じさせない「お願い」だった。^nけれど僕には、ゲルダなりの必死さが伝わってきた。",
      "source_raw_sha256": "1DA6F2D1CBEECA2518EDA6A37FAC22B3760E70A265A1909E9F9CF2AA3DB4F437",
      "target_text": "담담하고 무게감이라고는 없는 『부탁』이었다.^n하지만 나는 게르다 나름의 절박함을 느꼈다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1127.gsc::slot/00104",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1127.gsc::slot/00105",
      "source_text": "……うん。",
      "source_raw_sha256": "FEDD625442A89BBDA6022894F47741C745653F7E100D1D62B6A3742BEC8CCA5D",
      "target_text": "……응.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1127.gsc::slot/00106",
      "source_text": "だから僕は彼女の瞳をまっすぐに見つめて|頷[うなず]く。^n味方だと充分に安心させなければ、ゲルダはまた^n警戒の壁を築いてしまうと思ったから。",
      "source_raw_sha256": "17466686BC47DA880D4E9201B4B9EC52973B8B32353ED265D1462B2BD9E661B8",
      "target_text": "그래서 나는 그녀의 눈을 똑바로 바라보며 고개를 끄덕인다.^n내가 자기 편이라고 충분히 안심시켜 주지 않으면, 게르다는 다시^n경계의 벽을 쌓아 올릴 것 같았기 때문이다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1127.gsc::slot/00107",
      "source_text": "せっかく心を許してくれたゲルダを^nまたひとりきりにしたくはなかった。",
      "source_raw_sha256": "4ED1D47B94E712C4583C8B3A8D43D6F8B08BE3A70F627DFA1B28B6299345A30C",
      "target_text": "모처럼 마음을 열어 준 게르다를^n다시 혼자 내버려 두고 싶지 않았다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    }
  ]
}
