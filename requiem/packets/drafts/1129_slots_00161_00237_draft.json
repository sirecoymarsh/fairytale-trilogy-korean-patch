  "entries": [
    {
      "uid": "scr.xfl::1129.gsc::slot/00161",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00162",
      "source_text": "な……っ！",
      "source_raw_sha256": "67D9983C3FB19228EB73873F64538858A59E24B07713675FAA68F8CBAF59BE06",
      "target_text": "뭐……!",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00163",
      "source_text": "看護師",
      "source_raw_sha256": "7C9BC55431F0BD999C9CBD3B5F2EF99ACBA567FB9D25297DB2871A3D7DF766FA",
      "target_text": "간호사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00164",
      "source_text": "はい、お待たせしましたっと。",
      "source_raw_sha256": "5B707F07DFFB29B27D75AD6F3E8DC7C51BF88EF2A96EF144360C668AD0F0201B",
      "target_text": "자, 오래 기다리셨습니다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00165",
      "source_text": "看護師さんは極彩色の液体で満たされた大きな注射器を、^nどん、とばかりにゲルダの目の前で突きつけた。^nただでさえ嫌いな注射がますます怖くなるような光景だ。",
      "source_raw_sha256": "24BBDA3DD11D4B21ABC687D337B66367285FA7BBB5C2FCB832429AC3DAA2F750",
      "target_text": "간호사는 극채색 액체로 가득 찬 커다란 주사기를,^n쿵 소리가 날 듯 게르다의 눈앞에 내밀었다.^n원래도 싫어하던 주사가 더욱 무서워질 광경이다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00166",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00167",
      "source_text": "……、……。",
      "source_raw_sha256": "4C4E177E90DE46CC838CF2D594485D1157333D3614E3294DD815234018B13578",
      "target_text": "……, …….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00168",
      "source_text": "それでもゲルダは唇をグッと結んで、^n動揺を見せないように表情を引き締めた。^nその様子が、|却[かえ]って悲愴だった。",
      "source_raw_sha256": "CBE7E291BE58B03946A86F758D657666AACD94533E901A8D4CBE639B60796591",
      "target_text": "그래도 게르다는 입술을 꽉 다물고,^n동요를 드러내지 않으려 표정을 굳혔다.^n그 모습이 오히려 비장했다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00169",
      "source_text": "看護師",
      "source_raw_sha256": "7C9BC55431F0BD999C9CBD3B5F2EF99ACBA567FB9D25297DB2871A3D7DF766FA",
      "target_text": "간호사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00170",
      "source_text": "それじゃ、おくすり入れますねー。^n先生、お願いします。",
      "source_raw_sha256": "D46B0C562FAA5E2D0B161B6F59747C1F28DD6D01DCAA06CD09B5636634A9E341",
      "target_text": "그럼 약 넣을게요.^n선생님, 부탁드려요.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00171",
      "source_text": "看護師さんはゲルダの腰をぽんぽんと叩いてから、^nお尻に両手をあてがって、ぐにい、と丸い肉を左右に分ける。",
      "source_raw_sha256": "FE1D1E3ABFCA4EA95F2466A75FAB5C1AA51A8C7318A8CD89844D8C0754C88F94",
      "target_text": "간호사는 게르다의 허리를 톡톡 두드린 뒤,^n엉덩이에 두 손을 대고 물컹, 둥근 살을 좌우로 벌린다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00172",
      "source_text": "きっと、ゲルダの背後に立つお医者様からは^n女の子が一番嫌がりそうな、^nとても|卑猥[ひわい]な光景が見えていることだろう。",
      "source_raw_sha256": "43CBFA1DF01F478ED38BF02BF3554AD0AB55E7AC5054584DF8B1F66AC51A740A",
      "target_text": "분명 게르다의 뒤에 선 의사 선생님에게는^n여자아이가 가장 싫어할 듯한,^n무척 외설스러운 광경이 보일 것이다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00173",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00174",
      "source_text": "く……っ……！",
      "source_raw_sha256": "392F70646869BC12A0693F40C926DB296EA6884919C76A94FC0EFDD1E63E6022",
      "target_text": "크……읏……!",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00175",
      "source_text": "ゲルダの指先が小刻みに震えながら診察台に食い込む。",
      "source_raw_sha256": "1EDEA90E9C318C94453EA94EB9C00BE475B463E5D92EFA71BBFB25A44B79955F",
      "target_text": "게르다의 손끝이 가늘게 떨리며 진찰대에 박힌다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00176",
      "source_text": "医者",
      "source_raw_sha256": "1285809FCD66C2F753A0A086F75DD97DED40DD9BB52FBB18B57107E1BC64FB29",
      "target_text": "의사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00177",
      "source_text": "はい、それじゃ動かないでね。",
      "source_raw_sha256": "801D8153659F6E4D51FD39394C71E05EE32D6723EC89B3F749BAD91CDF48C212",
      "target_text": "자, 그럼 움직이지 말게.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00178",
      "source_text": "看護師",
      "source_raw_sha256": "7C9BC55431F0BD999C9CBD3B5F2EF99ACBA567FB9D25297DB2871A3D7DF766FA",
      "target_text": "간호사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00179",
      "source_text": "お尻から力、抜いてくださいねー。^nうまく注射器が入らないと、|却[かえ]って痛いですからねー。",
      "source_raw_sha256": "F80037CB2B24327D1A53655BE215451CF7AB2E20AA7BC09139D7CFCD21EBBAF1",
      "target_text": "엉덩이에 힘 빼 주세요.^n주사기가 제대로 들어가지 않으면 오히려 아프니까요.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00180",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00181",
      "source_text": "早く、っ、早くしてください……！",
      "source_raw_sha256": "AF94CAEA394B30D4D48CDD10C31068C191FEA9CD0FEC41B7267DE4EDCDCAAD75",
      "target_text": "빨리, 읏, 빨리해 주세요……!",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00182",
      "source_text": "ゲルダはほんの少し声を震わせた。^nそれは固い意志のほころびから|漏[も]れた、彼女の悲鳴だった。",
      "source_raw_sha256": "AA66BA2570A75893C23B16A72916AAFB6D0BDB82532B3C02F70624D64187730E",
      "target_text": "게르다의 목소리가 아주 조금 떨렸다.^n굳은 의지가 벌어진 틈에서 새어 나온 그녀의 비명이었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00183",
      "source_text": "けれど、お医者様は動き出すまで少し間を置いた。^n注射器を構えて先端をあてがう仕草も、むやみにのろのろしていた。",
      "source_raw_sha256": "871B657E76B8A9620B7730739CF630C8E7EBCA89D566403E2130DF157170CA0F",
      "target_text": "하지만 의사 선생님은 움직이기 전 잠시 뜸을 들였다.^n주사기를 들고 끝을 갖다 대는 몸짓도 공연히 느릿느릿했다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00184",
      "source_text": "あてがってからも、ぐりっ、ぐりっと^nじらすように注射器を上下させている。",
      "source_raw_sha256": "CC6A63AD7880A21E5465A3D2B26A20704213520978C60F7C654932B0CE20090E",
      "target_text": "갖다 댄 뒤에도, 꾸욱, 꾸욱^n애태우듯 주사기를 위아래로 움직인다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00185",
      "source_text": "医者",
      "source_raw_sha256": "1285809FCD66C2F753A0A086F75DD97DED40DD9BB52FBB18B57107E1BC64FB29",
      "target_text": "의사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00186",
      "source_text": "うーん、力が入りすぎていて、これじゃなかなか……。",
      "source_raw_sha256": "5B327789A14D3402DAD1961176A7E61593D31ED0F30B4A0990CB18EFCC3522AF",
      "target_text": "음, 힘이 너무 들어가서 이래서는 좀처럼…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00187",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00188",
      "source_text": "──い……っ……！",
      "source_raw_sha256": "782972B4920B25FEC11E02B1A2AC470028C3596DCF47E266407C04674DFB7BF6",
      "target_text": "──아……읏……!",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00189",
      "source_text": "あからさまな苦痛の声をあげて、ゲルダの全身が揺れた。",
      "source_raw_sha256": "E40D9D011B518F9A49651527A47698EB0EA95097A5DAAB7218B9D7E00D5097DD",
      "target_text": "노골적인 고통의 신음을 내며 게르다의 온몸이 흔들렸다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00190",
      "source_text": "弓ぞりに起き上がりかけたゲルダの背を、^nあわてて看護師さんが押さえつける。",
      "source_raw_sha256": "F82C4211746D23471B31605A728B2FEEA0C69807661CB8D34DB0B876AE7B0F1D",
      "target_text": "활처럼 뒤로 젖혀져 일어나려던 게르다의 등을,^n간호사가 황급히 눌러 제압한다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00191",
      "source_text": "看護師",
      "source_raw_sha256": "7C9BC55431F0BD999C9CBD3B5F2EF99ACBA567FB9D25297DB2871A3D7DF766FA",
      "target_text": "간호사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00192",
      "source_text": "だめよゲルダさん、おとなしくして、力抜いてねー。",
      "source_raw_sha256": "86C48FDFA949BDAA5AB840B2D8480B7A8E1C069346FE323429F3DFD5E6DACE84",
      "target_text": "안 돼요, 게르다 씨. 얌전히 힘을 빼세요.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00193",
      "source_text": "医者",
      "source_raw_sha256": "1285809FCD66C2F753A0A086F75DD97DED40DD9BB52FBB18B57107E1BC64FB29",
      "target_text": "의사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00194",
      "source_text": "動いちゃだめだよ動いちゃ。^nじっとしていればすぐ済むからね。",
      "source_raw_sha256": "C5942E9F6C5B439C4BDC4B457A895A8BB5D6F10A5C83E32C92173A31A4AB3D55",
      "target_text": "움직이면 안 돼. 움직이면.^n가만히 있으면 금방 끝나니까.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00195",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00196",
      "source_text": "はやく……早く、終わって……！",
      "source_raw_sha256": "0158A18628892AC6B0655E593D1E6FAC683FDC7F5FA7F5259DA912554E2A1467",
      "target_text": "빨리…… 빨리, 끝내 줘요……!",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00197",
      "source_text": "看護師",
      "source_raw_sha256": "7C9BC55431F0BD999C9CBD3B5F2EF99ACBA567FB9D25297DB2871A3D7DF766FA",
      "target_text": "간호사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00198",
      "source_text": "ごめんなさいねー。この注射器ぶっといし、^nお尻の穴って無理にこじ開けようとすると痛いのよね。^nでも案外伸びるから大丈夫よー、ちょっとだけ我慢してね。",
      "source_raw_sha256": "65CAB3D30DD578238D124E0C33068343CD0104A36D83C07DAAD797673398AD32",
      "target_text": "미안해요. 이 주사기가 워낙 굵기도 하고,^n항문은 억지로 벌리려 하면 아프거든요.^n그래도 생각보다 잘 늘어나니까 괜찮아요. 조금만 참아요.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00199",
      "source_text": "医者",
      "source_raw_sha256": "1285809FCD66C2F753A0A086F75DD97DED40DD9BB52FBB18B57107E1BC64FB29",
      "target_text": "의사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00200",
      "source_text": "よし、ブスッと。",
      "source_raw_sha256": "5CA50EB3B6997B2EB23D534422D6169FEFD37296E9D6D33288BF17FC50044091",
      "target_text": "좋아, 푹 하고.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00201",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00202",
      "source_text": "んんッ……！　う、くぅ……。",
      "source_raw_sha256": "FBAE8F9D8980A524959E1EF8EF5D5BD3DF1082F574BD0AAF0D871DAD2D8FFF4F",
      "target_text": "으응……! 우, 크윽…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00203",
      "source_text": "看護師",
      "source_raw_sha256": "7C9BC55431F0BD999C9CBD3B5F2EF99ACBA567FB9D25297DB2871A3D7DF766FA",
      "target_text": "간호사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00204",
      "source_text": "はい、おくすりたっぷり入ってますよー。^nちょっとお時間かかるけど我慢してねー。^nようく効くおくすりですからねー。",
      "source_raw_sha256": "C27C4C107EF28CB60658EB09C422AE9F4CE1AA4E91292254C325D4B863700C11",
      "target_text": "자, 약이 듬뿍 들어가고 있어요.^n시간이 조금 걸리지만 참아 주세요.^n약효가 아주 좋은 약이니까요.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00205",
      "source_text": "注射器の中で黒いゴムがゆっくりと前進する。^n極彩色の液体が押し出されて、ゲルダの体内に消えていく。^n|残酷[ざんこく]なくらいに|慎重[しんちょう]に、長々と。",
      "source_raw_sha256": "E5CA563596F0C8F437075F6184D530C82B93634AF5D04AC9B4CB72F4DEEBDA2A",
      "target_text": "주사기 안에서 검은 고무가 천천히 앞으로 나아간다.^n극채색 액체가 밀려 나와 게르다의 몸속으로 사라져 간다.^n잔인할 만큼 신중하고 길게.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00206",
      "source_text": "ゲルダは歯を食いしばって耐えていたけれど、^nやがて耐えかねたように大きく口を開け、^n苦しげな呼吸を繰り返した。",
      "source_raw_sha256": "7DD02FE4AA9EA11E480124461368B0482083950729BBCC7713AC2CE30B22E821",
      "target_text": "게르다는 이를 악물고 견뎠지만,^n이윽고 견디지 못한 듯 입을 크게 벌리고,^n괴로운 숨을 거듭 내쉬었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00207",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00208",
      "source_text": "ん、っ……ふぅ、ふぅ、ふぅっ……。^nはぁ、はぁ、はぁ、はぁ、は……！",
      "source_raw_sha256": "037ED6F4F8D887038C947D92F7CECD25DC6082664B370CB7AC32B78DCD6F8798",
      "target_text": "으, 읏…… 후우, 후우, 후웃…….^n하아, 하아, 하아, 하아, 하……!",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00209",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00210",
      "source_text": "う……っ……く……！^n──ッ、もう、やめて……！",
      "source_raw_sha256": "60E423BEB6860F5E8430A03A0B221AD67DB917469AD00D9452325FA610F90352",
      "target_text": "우……읏…… 크……!^n──으, 이제, 그만해……!",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00211",
      "source_text": "脂汗を|滲[にじ]ませながらブルブルと震える下半身と、^n絶望的に暗いゲルダの目の色が、^n体内の冷たい圧迫を|訴[うった]えかけているようだ。",
      "source_raw_sha256": "3C09ED422DC1118F91CA62B070358C38AD194C60EB9F2A88F28C88EADC636C80",
      "target_text": "식은땀을 흘리며 부들부들 떠는 하반신과,^n절망적으로 어두운 게르다의 눈빛이,^n몸속의 차가운 압박감을 호소하는 듯하다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00212",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00213",
      "source_text": "──くぅっ……！",
      "source_raw_sha256": "5EF02E097F0AA8AAE124BE1328084BF6901A76AB7E66A79AB5DC2B0913828E50",
      "target_text": "──크윽……!",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00214",
      "source_text": "やがてすっかり中身を吐き出した注射器が^nいやな音を立てて引き抜かれると、^nゲルダの|四肢[しし]がガクリと崩れた。",
      "source_raw_sha256": "E769925054E744F513277DF82352898AF2D8D2E6426A6FC9EC9464A498475534",
      "target_text": "이윽고 내용물을 완전히 토해 낸 주사기가^n불쾌한 소리를 내며 뽑히자,^n게르다의 팔다리가 털썩 무너졌다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00215",
      "source_text": "看護師",
      "source_raw_sha256": "7C9BC55431F0BD999C9CBD3B5F2EF99ACBA567FB9D25297DB2871A3D7DF766FA",
      "target_text": "간호사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00216",
      "source_text": "──はい、終わりましたよー。^nよくがんばりましたねー。",
      "source_raw_sha256": "1B94BA02FB5513E2C54AC4FA79739514EA1116A9A60D9D7E1920F131921A4F66",
      "target_text": "──자, 끝났어요.^n잘 참았어요.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00217",
      "source_text": "こぼれてしまった薬を|拭[ぬぐ]い、ぞんざいに下着をあげながら、^n看護師さんがそらぞらしい声をかける。",
      "source_raw_sha256": "13AEDEC515A5080468DDEB6B9B454D80E2A6D60BD735F25D2A961BC1551F900D",
      "target_text": "흘러나온 약을 닦고 속옷을 아무렇게나 올려 주며,^n간호사가 마음에도 없는 위로를 건넨다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00218",
      "source_text": "ゲルダは一言もなく、^n世話を焼く手を振り払うように診察台を降りると、^n高い足音を響かせながらモニターの外へと消えていった。",
      "source_raw_sha256": "2F387587DE818AC2E74BB524793BFF5B4B42C0DD17E46DF09C11451E101DC6B9",
      "target_text": "게르다는 한마디도 하지 않고,^n자기를 돌보려는 손을 뿌리치듯 진찰대에서 내려와,^n날카로운 발소리를 울리며 모니터 밖으로 사라졌다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00219",
      "source_text": "ドアを叩きつける音は、^n張り裂けるゲルダの心の悲鳴のようだ。",
      "source_raw_sha256": "E271A91306AA51E24A2582FBD52A7404EB2D60E08ED3F86E7B99515E37BD6B11",
      "target_text": "문을 거세게 닫는 소리는,^n터질 듯한 게르다의 마음이 지르는 비명 같았다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00220",
      "source_text": "残されたお医者様や看護師さんが、口々に^nゲルダの敵意に満ちた態度を愚痴りはじめたところで^nモニターの電源が落ちた。",
      "source_raw_sha256": "E6C65AFC0F535B440FE4D5E624D1C154116EC8703888AB7B930BA5D57AB1D23A",
      "target_text": "남겨진 의사와 간호사가 저마다^n적의로 가득한 게르다의 태도를 불평하기 시작했을 때,^n모니터의 전원이 꺼졌다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00221",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00222",
      "source_text": "…………。",
      "source_raw_sha256": "0A0A39A23D968038B6135EB7825A35667F28EF942D728F4925E6018672732E6B",
      "target_text": "………….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00223",
      "source_text": "同時に僕は我に返った。^n白い部屋の真ん中に立ち尽くして、^nモニターに見入っていた自分自身に気づく。",
      "source_raw_sha256": "29FB6FAE4B05990228D0218C4A19767716661EC9CA068C3548023B25C3414CC1",
      "target_text": "동시에 나는 정신을 차렸다.^n하얀 방 한가운데 우두커니 서서,^n모니터를 뚫어지게 보던 나 자신을 깨닫는다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00224",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00225",
      "source_text": "（──何をやっているんだ、僕）",
      "source_raw_sha256": "5858123274E86E10BB9E0A1F9A118C0A0FEA95C3CDCBF27B53B32BA9D2F83AB6",
      "target_text": "(──뭘 하고 있는 거야, 나)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00226",
      "source_text": "前半はともかく、後半は見守っている必要なんてなかった。",
      "source_raw_sha256": "099EF1B897A18CE9E18085F4E9536E27BAB151E839369822D89449B0ECDFA08E",
      "target_text": "전반은 그렇다 쳐도, 후반은 지켜볼 필요가 없었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00227",
      "source_text": "ちょっと顔を背けるだけで視界に入れずにすむ。^nそれこそ、最初考えたようにこの部屋を出ていけばよかったんだ。",
      "source_raw_sha256": "440A4413FC29A0D165D19FE97B9F7DA6B3B255A33B64605CB395A595D08AF1BA",
      "target_text": "고개만 살짝 돌려도 보지 않을 수 있었다.^n그야말로 처음 생각한 대로 이 방을 나가면 됐다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00228",
      "source_text": "苦々しいものが胸の中にこみ上げてくる。^nその薄暗い罪悪感よりも、それを中和するように|湧[わ]いてきた^nもうひとつのものの方が|不愉快[ふゆかい]だった。",
      "source_raw_sha256": "EB8791860D2879EDA75B6425EFBE2B35726B71A1AA62496ACD5A9FB84C1BAFB4",
      "target_text": "씁쓸한 것이 가슴속에서 치밀어 오른다.^n그 어두운 죄책감보다, 그것을 중화하듯 솟아난^n또 하나의 감정이 더 불쾌했다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00229",
      "source_text": "──仕方ないよ。^n──|呆然[ぼうぜん]としているうちに見せられたんだ。^n──自分から見に行ったんじゃなくて、目の前に勝手に現れたんだ。",
      "source_raw_sha256": "F9C992C09B0EF7C3D551E10CCA46FB7D611DE1F6F18CD799E13EF1B9CA352DC1",
      "target_text": "──어쩔 수 없었어.^n──멍하니 있는 사이에 억지로 보게 된 거야.^n──내가 스스로 보러 간 게 아니라 눈앞에 멋대로 나타난 거야.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00230",
      "source_text": "──あんなもの見せられたら、興味がなくても見ちゃうよね。^n──男だから、そういうふうにできているんだから。",
      "source_raw_sha256": "56645420260F2736304792F017F9DE18C4C60FD7A56D18B61CA823FBCFD789B0",
      "target_text": "──그런 걸 보여 주면 관심이 없어도 보게 되잖아.^n──남자니까 원래 그렇게 되어 있는 거야.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00231",
      "source_text": "──誰にも知られなければいいんだよ。^n──黙っていればなかったことにできる。",
      "source_raw_sha256": "BFADEBFEF27B7B805E90A1C9D7548E7338C9B5AB8C6881112B13D1E867EB9098",
      "target_text": "──아무도 모르면 괜찮아.^n──입 다물고 있으면 없었던 일로 만들 수 있어.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00232",
      "source_text": "あれを見てしまった僕より、^nそんなふうに自分を|庇[かば]おうとする僕の方が汚いと思う。",
      "source_raw_sha256": "F8A27E31CD066E2C8F85631D8A284C775C2BEB054D53BC2CA0BDDC9F8E5F3F32",
      "target_text": "그걸 보고 만 나보다,^n그런 식으로 자신을 감싸려는 내가 더 추하다고 생각한다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00233",
      "source_text": "けれど、そうして|庇[かば]う僕がいなければ、^nとてもやっていけない、とも思った。",
      "source_raw_sha256": "142B3D54663855119D0B1E6DF60C0B4996BCE54850F36F1400A0BF9625E7056C",
      "target_text": "하지만 그렇게 나를 감싸는 내가 없다면,^n도저히 버텨 낼 수 없을 거라는 생각도 들었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00234",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00235",
      "source_text": "（ああ、いやだな）",
      "source_raw_sha256": "4152DAF8FB45C63FA15F5A0C654D29AF6A1D83567ED5C969FD6D7375FD1AF891",
      "target_text": "(아아, 싫다)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00236",
      "source_text": "──こうして僕は、この感じに慣れていくんだろうか。",
      "source_raw_sha256": "BBC9AB80E68EDC587A6ADDFDA361A5AFEDA7DEFB990029D17253FF0A7AFEECBF",
      "target_text": "──나는 이렇게 이 감각에 익숙해지는 걸까.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1129.gsc::slot/00237",
      "source_text": "僕はうんざりした気分を置き去るように、^n自分の部屋を後にした。",
      "source_raw_sha256": "E567D6F9C2B5E0B3384DD26EA83DD70C9DAB4B4610979834B2D43B96AC6871D2",
      "target_text": "나는 지긋지긋한 기분을 떨쳐 버리듯,^n내 방을 뒤로했다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    }
  ]
}
