  "entries": [
    {
      "uid": "scr.xfl::1131.gsc::slot/00161",
      "source_text": "ラプンツェル",
      "source_raw_sha256": "A7D1022630570BF73137A5F00E89638087B618CE5FBC41C301A483A64D1158E5",
      "target_text": "라푼젤",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00162",
      "source_text": "…………！",
      "source_raw_sha256": "D7EB78D623F890F6BFE79FD343045BBAA880FF71E4A3DBBFD4475FADB29B7F3D",
      "target_text": "…………!",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00163",
      "source_text": "ラプンツェルが息を|呑[の]み、よろめいた。",
      "source_raw_sha256": "B9D487A1A811B6607F06A3FCF7C14E5757D5B976091C3EBB19FB55A60E5D6FDC",
      "target_text": "라푼젤이 숨을 삼키며 비틀거렸다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00164",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00165",
      "source_text": "どうしたの、ラプンツェル……？",
      "source_raw_sha256": "D4935D77C9AEBC85D084FA672A832066D1684A0D4E9C781C7461B1C25F441FAF",
      "target_text": "왜 그래, 라푼젤……?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00166",
      "source_text": "ラプンツェル",
      "source_raw_sha256": "A7D1022630570BF73137A5F00E89638087B618CE5FBC41C301A483A64D1158E5",
      "target_text": "라푼젤",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00167",
      "source_text": "……っ、う……。",
      "source_raw_sha256": "A8D5C58E59FF8EAFFCE9EAA187D712149A3F1BCB26F5213931254AB43F0BDBD1",
      "target_text": "……읏, 으…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00168",
      "source_text": "声をかけても、ラプンツェルは低く|呻[うめ]くだけ。",
      "source_raw_sha256": "837E6831B255BB3BCA2718A9FB218A54ED9C8EA36A2B83B6A294C41DD4B98A01",
      "target_text": "말을 걸어도 라푼젤은 낮게 신음할 뿐.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00169",
      "source_text": "見開いた瞳で僕を見ている。^n僕を通して地獄を見ているような、張りつめたまなざし。",
      "source_raw_sha256": "686B273715AFA221FE5A51C9F7F55CC5D7DB88B9A559F900D93D43FDAA647770",
      "target_text": "크게 뜬 눈으로 나를 보고 있다.^n나를 통해 지옥을 보는 듯 팽팽하게 긴장한 눈빛.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00170",
      "source_text": "自分の後ろに何か恐ろしいものがいるんだろうか、と考えて^n一瞬ゾッとしてしまったほど、^nラプンツェルの瞳には恐怖が|凝縮[ぎょうしゅく]されていた。",
      "source_raw_sha256": "C7AC5E454D30CC62726F6DFEEE967DC6EC845275A3E2AF647CB0B35C0094FE27",
      "target_text": "내 뒤에 무언가 무서운 게 있나 생각해^n순간 소름이 돋을 만큼,^n라푼젤의 눈동자에는 공포가 응축되어 있었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00171",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00172",
      "source_text": "（な、なんだろう。どうしたんだろう）",
      "source_raw_sha256": "C2EAA0F049E21F4F14A7B4A096177E8844C4F4500B46212515D53833EAFCB1E5",
      "target_text": "(뭐, 뭐지. 왜 저러는 거지)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00173",
      "source_text": "秘密について指摘した時よりも、^nよほど大きな衝撃を受けたようなラプンツェルに対し、^n僕はどう接すればいいかわからなくなる。",
      "source_raw_sha256": "CC6F09559393D4BBD2A1AEAE238B08CE637C97FC58ED6DEB3FCED03CC26FEC78",
      "target_text": "비밀을 지적했을 때보다^n훨씬 큰 충격을 받은 듯한 라푼젤에게,^n나는 어떻게 대해야 할지 몰라졌다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00174",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00175",
      "source_text": "あ、あの……。",
      "source_raw_sha256": "A1A20BCC220485657F79251B7C6AF77DAB7EFE9C35B18C636C598F5BCA50396A",
      "target_text": "저, 저기…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00176",
      "source_text": "ラプンツェル",
      "source_raw_sha256": "A7D1022630570BF73137A5F00E89638087B618CE5FBC41C301A483A64D1158E5",
      "target_text": "라푼젤",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00177",
      "source_text": "──ッ！",
      "source_raw_sha256": "35F65F9F46A25D5CAE0205B8EACE3C48817C0CD8ED94E1AAEB9BB55B008DE435",
      "target_text": "──읏!",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00178",
      "source_text": "やがて悲鳴のような息切れを残して、^nラプンツェルは身を|翻[ひるがえ]した。",
      "source_raw_sha256": "AE91E56F38814DB31F5E7FB8C6369419C0419B7CFDA9083DD3D2E20B36C4D23E",
      "target_text": "이윽고 비명 같은 가쁜 숨을 남기고,^n라푼젤은 몸을 홱 돌렸다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00179",
      "source_text": "その身を|覆[おお]っていたフードが振り捨てられて、^nばさりと足元に落ちる──",
      "source_raw_sha256": "FD6A047EDB5EF96442AF36B83826E4EA23EF777233E36E5AFEFBDCDFC3702CD9",
      "target_text": "몸을 덮고 있던 후드가 벗겨져,^n펄럭이며 발밑에 떨어진다──",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00180",
      "source_text": "その時にはすでに、ラプンツェルはドアの向こうに消えていた。",
      "source_raw_sha256": "7B44EFB2D8F93C6BC1EABB7AAA426108F1CBB5BFF924ED058EAF512F55A50E7F",
      "target_text": "그때 라푼젤은 이미 문 너머로 사라진 뒤였다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00181",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00182",
      "source_text": "（──どうしたんだろう、ラプンツェル）",
      "source_raw_sha256": "329A91FDF952C9F29BEC82FD92F7E2D3373FCF9324ADE9D6C334122A4CF395ED",
      "target_text": "(──왜 저러는 걸까, 라푼젤)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00183",
      "source_text": "後を追って|螺旋[らせん]階段を降り、廊下に戻る。",
      "source_raw_sha256": "5257D67709D1E787239B7C7CBAD3B83B40CEEB183B84AE1454ADB73F3C985250",
      "target_text": "뒤를 쫓아 나선계단을 내려가 복도로 돌아간다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00184",
      "source_text": "ラプンツェルはなりふり構わない勢いで駆け抜けたようで、^n廊下に彼女の姿はない。",
      "source_raw_sha256": "741581311934CE4BA41242ACD325B303670CAF57E8993B0618CD115F05444829",
      "target_text": "라푼젤은 앞뒤 가리지 않을 기세로 달려간 듯,^n복도에는 그녀의 모습이 없다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00185",
      "source_text": "その代わり、^n彼女を見かけて驚いているオトナたちが、^n未だ|呆然[ぼうぜん]として彼女の駆けた先を見つめていた。",
      "source_raw_sha256": "2E6E6412C665669F1A077C27D60FF1629368C1F7982CC712AA4C3967202F2F37",
      "target_text": "대신,^n그녀를 보고 놀란 어른들이,^n아직도 멍하니 그녀가 달려간 쪽을 바라보고 있었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00186",
      "source_text": "職員",
      "source_raw_sha256": "A25AF2E1BA962C6FA3A7775820C13167D6ED6E03ADB4A6F920C25C5436AAFB8D",
      "target_text": "직원",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00187",
      "source_text": "何があったんだ、一体。^n始めて見たよ、ラプンツェルが部屋を出てるところ。",
      "source_raw_sha256": "1473B846BB79AB9E2EF040AFF454D9A6E0384D5BAFB4037CEDBB71A5D9FB029D",
      "target_text": "대체 무슨 일이야.^n라푼젤이 방을 나오는 건 처음 봤어.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00188",
      "source_text": "職員",
      "source_raw_sha256": "A25AF2E1BA962C6FA3A7775820C13167D6ED6E03ADB4A6F920C25C5436AAFB8D",
      "target_text": "직원",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00189",
      "source_text": "だよな。実際初めてなんじゃないか？^nいつも診察も風呂も、何もかも部屋で済ませてるもんな。",
      "source_raw_sha256": "FFCB4935206FC987531C89152FD6A651D47888AFE83732417C3DEB5BB85455BA",
      "target_text": "그러게. 실제로 처음인 거 아냐?^n진찰도 목욕도 언제나 방에서 다 해결했잖아.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00190",
      "source_text": "職員",
      "source_raw_sha256": "A25AF2E1BA962C6FA3A7775820C13167D6ED6E03ADB4A6F920C25C5436AAFB8D",
      "target_text": "직원",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00191",
      "source_text": "え、そうなんですか？^nでも、目の前でドアが開いて人が出入りするところは見ているし、^n別に鍵をかけたりもしてないですよね。",
      "source_raw_sha256": "DADAAE18C8096D5F60879F3E777167ABD462F4AF670788156539F870E3CA900C",
      "target_text": "네, 정말요?^n하지만 눈앞에서 문이 열리고 사람이 드나드는 건 봤을 테고,^n딱히 문을 잠가 두지도 않았잖아요.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00192",
      "source_text": "職員",
      "source_raw_sha256": "A25AF2E1BA962C6FA3A7775820C13167D6ED6E03ADB4A6F920C25C5436AAFB8D",
      "target_text": "직원",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00193",
      "source_text": "「できる」けど「やらない」「やれない」んだよ。^n　そういう設定──というか病状だから。",
      "source_raw_sha256": "17D2358507249049BEF6B04964A0DAA976BFC012F8CC602D1F648629DB0AA40B",
      "target_text": "『할 수』 있지만 『하지 않는』, 『할 수 없는』 거야.^n그런 설정──아니, 병세니까.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00194",
      "source_text": "職員",
      "source_raw_sha256": "A25AF2E1BA962C6FA3A7775820C13167D6ED6E03ADB4A6F920C25C5436AAFB8D",
      "target_text": "직원",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00195",
      "source_text": "「自分のためのドアじゃない」──^n　以前、そう言っていたっけ。",
      "source_raw_sha256": "005690E027A0138F227A0FA2C11C4415B805872A59D51236B479A6003658E398",
      "target_text": "『자기를 위한 문이 아니다』──^n전에 그렇게 말했던가.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00196",
      "source_text": "職員",
      "source_raw_sha256": "A25AF2E1BA962C6FA3A7775820C13167D6ED6E03ADB4A6F920C25C5436AAFB8D",
      "target_text": "직원",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00197",
      "source_text": "はぁ……難しいですねぇ。",
      "source_raw_sha256": "61E5A22125CC5AA97FD0457D71318A68E2EDAA352F1FEFDE49EEA29D4F9D0D07",
      "target_text": "하아…… 어렵네요.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00198",
      "source_text": "職員",
      "source_raw_sha256": "A25AF2E1BA962C6FA3A7775820C13167D6ED6E03ADB4A6F920C25C5436AAFB8D",
      "target_text": "직원",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00199",
      "source_text": "なのに、今日は不意に外に出たと。^n病状が回復したのか、悪化したのか──尋常じゃないな。^nとりあえず報告しないと。",
      "source_raw_sha256": "8AB63237D396593195424D12900CFF7BA428261A2870D60A006059EB12D67BE1",
      "target_text": "그런데 오늘은 갑자기 밖으로 나왔다고.^n병세가 호전된 건지 악화된 건지──보통 일이 아니야.^n일단 보고해야겠어.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00200",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00201",
      "source_text": "（これは……もしかして、もしかしなくても^n　大変なことになってしまったのかな……）",
      "source_raw_sha256": "ECA288858D77721F3716A631D541DB63ABFEA059E65AE8AEBEE6BAAAA2C3176D",
      "target_text": "(이건…… 혹시, 혹시고 뭐고^n큰일이 나 버린 건가……)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00202",
      "source_text": "交わされるやりとりを聞きながらラプンツェルを探すうちに、^n僕はイケノさんに出くわした。",
      "source_raw_sha256": "5F0B9657D8D3DEF524156EDF72836018C042473D486FD3DD83CF6A797BA6D2DC",
      "target_text": "오가는 대화를 들으며 라푼젤을 찾다가,^n나는 이케노 씨와 마주쳤다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00203",
      "source_text": "イケノさんはすでにあったことを聞いているようで、^n僕に向かって身をかがめ、ひそひそと話しかけてきた。",
      "source_raw_sha256": "7EDD8A5B6FEEDC906BBE2FE7E7788E2155D79E36F3729A5B9D7A5CD26DFAB174",
      "target_text": "이케노 씨는 이미 무슨 일이 있었는지 들은 듯,^n내게 몸을 숙여 소곤소곤 말을 걸었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00204",
      "source_text": "イケノ",
      "source_raw_sha256": "92C809E9187A7974F07D5D0C48B21F3B995A046545D76998B5615854DDBE7203",
      "target_text": "이케노",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00205",
      "source_text": "──ラプンツェルが出ていったらしいけど……。^nきみ、何かした？",
      "source_raw_sha256": "FE8AE7D1DCAF39920D878667B92661F18425C4408BC9283159EE2A48BCE71041",
      "target_text": "──라푼젤이 나갔다던데…….^n너, 무슨 짓 했어?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00206",
      "source_text": "どうして原因が僕にあると思ったんだろう。",
      "source_raw_sha256": "7175D8B69E5B2A9632E9DE9D71E94B26D575654B05B47E91EFE6FF17891671DA",
      "target_text": "왜 원인이 내게 있다고 생각한 걸까.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00207",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00208",
      "source_text": "した、といえばした、のかな……。",
      "source_raw_sha256": "2414F40DCD7973FFD89E69BC6BD54A97DA4FEE3630F559A5E06150BBD223C18E",
      "target_text": "했다고 하면 한 건가…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00209",
      "source_text": "打ち明ける相手を見つけてホッとして、^nしかしのっけから僕は口ごもった。",
      "source_raw_sha256": "319CB0A51FFA54446798537936DD3AB90D62D694ADA3BB1EA78B617DEA1ACD64",
      "target_text": "털어놓을 상대를 찾았다는 안도감에,^n하지만 시작부터 나는 말을 더듬었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00210",
      "source_text": "いきさつをたどればやましすぎて、^nとてもじゃないがすべては話せない。",
      "source_raw_sha256": "C9F23F242C71CE0B975DC9F8F3FFB6E0C5977656A40AC302495A1CF09FE420D8",
      "target_text": "경위를 따라가면 너무나 떳떳하지 못해서,^n도저히 모든 걸 말할 수는 없다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00211",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00212",
      "source_text": "（昨晩見たことについては^n「ラプンツェルの部屋に、夜中髪を伝って入っていく人間を見た」^n　って言い換えれば、なんとか……）",
      "source_raw_sha256": "6C212D2484AFE4560F0A8165B2A09FB3C6F5FA09F244ECB17A2924E08CBC9A7E",
      "target_text": "(어젯밤 본 건^n『한밤중에 라푼젤의 방으로 머리카락을 타고 들어가는 사람을 봤다』^n라고 바꾸어 말하면 어떻게든……)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00213",
      "source_text": "それを不用意に彼女に告げてしまったこと、^n無意識にお腹を|撫[な]でる彼女を見て、「男女の双子を産むんだっけ」^nと|呟[つぶや]いたら、どうやら最後の引き金を引いてしまったこと。",
      "source_raw_sha256": "D5FEFBA8275102E65F8E9477B21075B9B93CD054867F9E4034B39A715A1C56DB",
      "target_text": "그 사실을 경솔하게 그녀에게 말한 것,^n무의식적으로 배를 쓰다듬는 그녀를 보고 『남녀 쌍둥이를 낳았던가』^n하고 중얼거리자, 아무래도 마지막 방아쇠를 당겨 버린 것.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00214",
      "source_text": "──なんとか、つじつまを合わせて伝えられたと思う。",
      "source_raw_sha256": "FCF8D3EBC3D6FF676B131220B771EE23E54CCF1A96BAC5C0726B1D4CED024A90",
      "target_text": "──어떻게든 앞뒤를 맞춰 전달한 것 같다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00215",
      "source_text": "イケノ",
      "source_raw_sha256": "92C809E9187A7974F07D5D0C48B21F3B995A046545D76998B5615854DDBE7203",
      "target_text": "이케노",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00216",
      "source_text": "あー、なるほど……。",
      "source_raw_sha256": "8A2885D1D929DF0B85D2E0279236AEE5E754336426E77F6426961451B21EC033",
      "target_text": "아, 그렇구나…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00217",
      "source_text": "イケノ",
      "source_raw_sha256": "92C809E9187A7974F07D5D0C48B21F3B995A046545D76998B5615854DDBE7203",
      "target_text": "이케노",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00218",
      "source_text": "つまりラプンツェルは、きみという「おばあさま」に^n妊娠したことを気づかれたと思い、^n塔から追い出されるストーリーに従ったんだね。",
      "source_raw_sha256": "75ACB1F05B43FDB958CDDA79F0510DB8289BA8B20299784494FF0C7E90281824",
      "target_text": "그러니까 라푼젤은 『할머니』인 너에게^n임신 사실을 들켰다고 생각해서,^n탑에서 쫓겨나는 줄거리를 따른 거구나.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00219",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00220",
      "source_text": "やっぱり、そういうことなんでしょうか……。",
      "source_raw_sha256": "7C56BB268C921DA14FFAC81DF0C49CF36C739953290462DED43387184C71325F",
      "target_text": "역시 그런 건가요…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00221",
      "source_text": "イケノ",
      "source_raw_sha256": "92C809E9187A7974F07D5D0C48B21F3B995A046545D76998B5615854DDBE7203",
      "target_text": "이케노",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00222",
      "source_text": "　まあ、気に病むことはないよ。^n「ラプンツェル」がそういう物語だったってだけで。",
      "source_raw_sha256": "79032087BB5F389FF4F726A2ABEEDC4F64209CDDF56B1C2B5FA5F0089F4E2CF8",
      "target_text": "뭐, 마음 쓰지 마.^n『라푼젤』이 원래 그런 이야기였을 뿐이니까.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00223",
      "source_text": "イケノ",
      "source_raw_sha256": "92C809E9187A7974F07D5D0C48B21F3B995A046545D76998B5615854DDBE7203",
      "target_text": "이케노",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00224",
      "source_text": "　それに──今回のは^n「なかったこと」になるんじゃないかな。",
      "source_raw_sha256": "A76D050F08E03FA2003D2EBA780CF8A919F9E9BA85F3AE579805D996220937CE",
      "target_text": "게다가──이번 일은^n『없었던 일』이 되지 않을까.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00225",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00226",
      "source_text": "……？^nそうなんでしょうか……。",
      "source_raw_sha256": "4D2F2A4DA5E2ED2CC742E582361C932D93D7B75C78A28C6D9BCD47CF111F3A70",
      "target_text": "……?^n그럴까요…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00227",
      "source_text": "僕はその言葉にすがるようにイケノさんを見上げた。",
      "source_raw_sha256": "08B2CCF741D75C22A14D7E6926500C7FF439C2D5D2D64489DB6558110CCBAB18",
      "target_text": "나는 그 말에 매달리듯 이케노 씨를 올려다보았다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00228",
      "source_text": "なんだかんだで、僕が余計なことを言って^nラプンツェルを恐慌に追い込んだのは間違いない。^nなかったことにできるなら、そうなってほしかった。",
      "source_raw_sha256": "4BE1DAB754C5E650D2AEACB8A35C881FDA78DE0918302C43ECDFBEDC99140BBF",
      "target_text": "어쨌든 내가 쓸데없는 말을 해서^n라푼젤을 공황 상태로 몰아넣은 건 틀림없다.^n없던 일로 만들 수 있다면 그렇게 되길 바랐다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00229",
      "source_text": "イケノさんはにっこりと笑いかけて、^n僕にはいまいちわからないことを口にした。",
      "source_raw_sha256": "E52B3D3A56B565BDE9B1772834BCF7F4DCFAFC2CBEE7917A6AD170ED103E0AE8",
      "target_text": "이케노 씨는 방긋 웃으며,^n내게는 잘 이해되지 않는 말을 꺼냈다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00230",
      "source_text": "イケノ",
      "source_raw_sha256": "92C809E9187A7974F07D5D0C48B21F3B995A046545D76998B5615854DDBE7203",
      "target_text": "이케노",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1131.gsc::slot/00231",
      "source_text": "──まだ彼女の髪は長いままだからね。",
      "source_raw_sha256": "7B54394AB06E0E935F9DB884BBA6C1B78791D7829DCC29B2130C1EF863A48FAE",
      "target_text": "──아직 그 애의 머리카락은 긴 그대로니까.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    }
  ]
}
