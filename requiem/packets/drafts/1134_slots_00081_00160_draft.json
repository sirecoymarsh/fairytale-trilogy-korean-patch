  "review_passes_completed": 0,
  "release_ready": false,
  "entries": [
    {
      "uid": "scr.xfl::1134.gsc::slot/00081",
      "source_text": "恐る恐る問いかけたけれど、返事はない。",
      "source_raw_sha256": "CC82C5E3E6687A4F9B0978C4A4D4BE90CF97D8C49542469942BB23224822ED14",
      "target_text": "두려운 마음으로 물었지만 대답은 없다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00082",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00083",
      "source_text": "きゃあ！　だ、誰？^n誰か触った……？",
      "source_raw_sha256": "77023E738CA8DAC2B55D5F0246F7D078EED3CB9AEE00CEA247450F54038DB983",
      "target_text": "꺄악! 누, 누구죠?^n누가 건드렸어요……?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00084",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00085",
      "source_text": "わ、わたしじゃないよ。",
      "source_raw_sha256": "F3F5B0DC99ACD9A485A0A744254E6E150C61400425AFCF9CB0396550CBCB73B4",
      "target_text": "나, 나는 아니야.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00086",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00087",
      "source_text": "僕でもないよ。",
      "source_raw_sha256": "207822296A88565FA77D331D37BD610AFB5842D4B5DE2B580D92F65181E612CB",
      "target_text": "나도 아니야.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00088",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00089",
      "source_text": "何よこれ、何があったの！？^n火事ではなさそうだけど……ひどい煙。",
      "source_raw_sha256": "AD090DE273992F5B78D4665BA64014B258DCD8F94F4CD3C2D06EF7856B723383",
      "target_text": "뭐야, 이게. 무슨 일이 있었던 거야!?^n화재는 아닌 것 같지만…… 연기가 심해.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00090",
      "source_text": "背後──^n僕の感覚が確かなら、入ってきたドアのあたりで声がした。",
      "source_raw_sha256": "926377D59BAFB61BE38D757DCF9D5BAA679934A08EEA36193D394F4452ED4741",
      "target_text": "뒤쪽──^n내 감각이 맞다면 들어왔던 문 근처에서 목소리가 났다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00091",
      "source_text": "たぶん、ゲルダだ。^n声がくぐもっているのは、布か何かで口を|覆[おお]っているからだろう。",
      "source_raw_sha256": "576E97D3BBEDD2EB4842A3C5DE29937DF7F92CED879ECB5DE9BE75536E39E1D9",
      "target_text": "아마 게르다다.^n목소리가 먹먹한 건 천 같은 것으로 입을 가렸기 때문이겠지.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00092",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00093",
      "source_text": "わ、わからない！^nここに来たらすでにこうなっていて、^n何が原因か誰もわからないんだ。",
      "source_raw_sha256": "127B43B7E679E642E1D95294067F1A284A22AA3C106FC85A0EA1901C34F34F10",
      "target_text": "모, 모르겠어!^n여기 왔을 때 이미 이렇게 되어 있었고,^n원인이 뭔지는 아무도 몰라.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00094",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00095",
      "source_text": "ア……アリスちゃんが、かまどの中から人が出てきたって。^nく、黒焦げの人、が……も、燃えて……っ。^n",
      "source_raw_sha256": "ABC2B3CFFF6ECDED81F4A036A8B72967552C57430EF183AC87795F7E81AC84D2",
      "target_text": "애…… 앨리스가 화덕 안에서 사람이 나왔다고 했어.^n새, 새까맣게 탄 사람이…… 타, 타고…… 읏.^n",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00096",
      "source_text": "──ど、どうしよう。げほ、こほこほ……！",
      "source_raw_sha256": "B17262CCB61F1EB000C8A6BAA625FEB2F98D3AB00C4B6E7489CBD3B18A405672",
      "target_text": "──어, 어떡하지. 콜록, 콜록콜록……!",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00097",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00098",
      "source_text": "落ち着いて、グレーテル。^nあんまり煙を吸わないように……。",
      "source_raw_sha256": "803D237FA3D0A47D9805FA17061B872764EFC7C7AEA90769BE98DAA95A24BA50",
      "target_text": "진정해, 그레텔.^n연기를 너무 많이 마시지 않게…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00099",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00100",
      "source_text": "何ですって？^n黒焦げの……人？　かまど？^n",
      "source_raw_sha256": "F6F99DCF8E5867A9DAA1A86DB0ABCCAC1847A192B6223C59FB025F8E4E20495E",
      "target_text": "뭐라고?^n새까맣게 탄…… 사람? 화덕?^n",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00101",
      "source_text": "──そんな馬鹿な。",
      "source_raw_sha256": "35DC07987EF7F05B90F66205CB52DBEE1E73A2DD7AB23C1700BCFBFAA0F3140F",
      "target_text": "──말도 안 돼.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00102",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00103",
      "source_text": "とにかく今は、この煙をなんとかしよう。^n窓、窓を開けないと……。",
      "source_raw_sha256": "BA7936D13373522DB345EAF3021B0CA3E644C61A87C7C7A742111731ED656F76",
      "target_text": "아무튼 지금은 이 연기를 어떻게든 하자.^n창문, 창문을 열어야 해…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00104",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00105",
      "source_text": "ひっ、……ひゃあああ！",
      "source_raw_sha256": "B0EEA5869EDD85ED67DE4CCEEDD834083DCF294FD7FBE29106CB40743452679F",
      "target_text": "히익, ……꺄아악!",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00106",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00107",
      "source_text": "どうしたの？",
      "source_raw_sha256": "0FE83BA666F023AFF1DEF50771BE94643A2F10DF97558B5B4A62B3F1036D70E8",
      "target_text": "왜 그래?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00108",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00109",
      "source_text": "つまずいた、の……。^nあ……ジュースの|瓶[びん]がある。^nこれを飲めば、大きくなってこの部屋から出られるかしら……。",
      "source_raw_sha256": "66672EAD37C8D104147589D7C0FA8F4C3D47EEEE39912ED8419B559CF4DD87A6",
      "target_text": "넘어졌어요…….^n아…… 주스 병이 있네요.^n이걸 마시면 커져서 이 방에서 나갈 수 있을까요…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00110",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00111",
      "source_text": "そ、そんなことされたら、わたしたち潰れちゃうよ……。",
      "source_raw_sha256": "B94C5A7404B089F104680945063D151C9432C0576E0880809B7B39AF8D0C63A4",
      "target_text": "그, 그러면 우리가 깔려 버려…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00112",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00113",
      "source_text": "それもそうね。やめておくわ。",
      "source_raw_sha256": "E6FC3E562D50DA4EF79DCA6DF2F10796AEE645F99373C6C66C7056CB769C6362",
      "target_text": "그것도 그렇네요. 그만둘게요.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00114",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00115",
      "source_text": "（こんな時でもこんな調子なんだ……。^n　なんていうか……）",
      "source_raw_sha256": "9015A96E1DD40DE21116653CE48A81515F3967DF49347DE8025A9FF461660B03",
      "target_text": "(이럴 때도 이런 식이구나…….^n뭐랄까……)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00116",
      "source_text": "間抜けなやりとりを聞いて、僕はひとり脱力する。",
      "source_raw_sha256": "1EA81960AC2AFA8A65A03EAB63955813D91A67B2F0BE90FA719B20AD3EA4E5B7",
      "target_text": "맥 빠지는 대화를 듣고 나는 혼자 힘이 풀린다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00117",
      "source_text": "謎の煙と臭い、黒焦げ死体。^nとんでもない事態だと思いこんで焦っていたけれど、^nこれは結局ただの茶番に落ち着くのでは──",
      "source_raw_sha256": "A9F12B5E3DDF5C5F435628579A35449268A95F64345752C46A2423FDDCC00602",
      "target_text": "수수께끼의 연기와 냄새, 새까맣게 탄 시체.^n엄청난 사태라고 믿고 초조해했지만,^n결국 이건 그저 한바탕 소동으로 끝나는 게 아닐까──",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00118",
      "source_text": "煙をかき分けかき分け、|慎重[しんちょう]に前進するうちに、^n僕は煙の色が少し薄くなってきた気がした。",
      "source_raw_sha256": "66350E2E86BEE46508A9F438E5829A3F24CA5E5C082345A2E2A9FA01CCFC3C44",
      "target_text": "연기를 헤치고 또 헤치며 조심스럽게 나아가는 동안,^n연기 색이 조금 옅어진 듯했다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00119",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00120",
      "source_text": "あ……。",
      "source_raw_sha256": "1DA33B8724CF5322E55F21F6F37BD34A25B2A3AE5475B15DD45F503E9F718B0B",
      "target_text": "아…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00121",
      "source_text": "気のせいではないようだった。^n涼しい空気が一筋、髪を揺らす。",
      "source_raw_sha256": "ABD7739B5D445B8B1A5328F3C0F9D45B1108D89C461A935DC3A121576F3D30B0",
      "target_text": "기분 탓은 아닌 듯했다.^n서늘한 공기 한 줄기가 머리카락을 흔든다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00122",
      "source_text": "重ねられた煙の幕が、１枚、また１枚と取り外されて、^nあちらこちらからキッチンの本来の光景が^nうっすらと浮かび上がってくる。",
      "source_raw_sha256": "07C039C3BE04B92C25BB7F5A0E5BE00AF31C1E00A469B866B85F43CB2C0FB46C",
      "target_text": "겹겹이 드리운 연기 장막이 한 장, 또 한 장 걷히고,^n이곳저곳에서 주방의 본래 모습이^n희미하게 떠오른다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00123",
      "source_text": "オディール",
      "source_raw_sha256": "9A32E06D50E7B4A1663EEA46065CE26A49748CCE0A4311A9776A8E9114F5FDBC",
      "target_text": "오딜",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00124",
      "source_text": "──ああ、空気がおいしいわ。",
      "source_raw_sha256": "1E76D12C0D964A224EE43C9B95C277E6AA085E431467489F767E147B8845E8F7",
      "target_text": "──아아, 공기가 맛있네.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00125",
      "source_text": "大きく開いた窓の前、腰の高さの棚に寄りかかり、^n新鮮な空気を手で扇ぎながらオディールが|呟[つぶや]いた。",
      "source_raw_sha256": "7DBA50CC92186250248B8632A2823C763943CA827F7C8194EA1CF3C2ABAEA2F8",
      "target_text": "활짝 열린 창문 앞 허리 높이 선반에 기대어,^n신선한 공기를 손으로 부치며 오딜이 중얼거렸다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00126",
      "source_text": "どうやら、彼女が窓を全開にしてくれたみたいだ。",
      "source_raw_sha256": "08676E0645BFD4B8B790FC1C2BC90FA45317527F5F73AC0BC26457F8D6721E51",
      "target_text": "아무래도 그녀가 창문을 활짝 열어 준 모양이다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00127",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00128",
      "source_text": "すう、はぁ、すう、はぁ。^nよ、よかった……。",
      "source_raw_sha256": "DCEA4A94F4D33A50A97B1C39046F1EFB5FE09CAEB43D1CD4FEBCDCF54E0410F4",
      "target_text": "스읍, 하아, 스읍, 하아.^n다, 다행이다…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00129",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00130",
      "source_text": "ああ、助かった！^n",
      "source_raw_sha256": "43023F490CD31DD92D7FE921D27BC13FA27E3B71EC63AD3740FE859557BF5542",
      "target_text": "아아, 살았어요!^n",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00131",
      "source_text": "|燻製器[くんせいき]の中の七面鳥って、こんな気分なのかしら。^n",
      "source_raw_sha256": "6A424D74BDA0A1B08ADC6A2E28884C6F2369F1BD8B09F01661E65538E5FE75A8",
      "target_text": "훈연기 속 칠면조는 이런 기분일까요.^n",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00132",
      "source_text": "ありがとう、オディール。",
      "source_raw_sha256": "2B09F43F77D8FC92FDB46B59ADC85536A0B3F115F31D7064D63E7A782B504931",
      "target_text": "고마워요, 오딜.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00133",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00134",
      "source_text": "あ、そうだ。その……ありがとう。",
      "source_raw_sha256": "2DE56F4211C023A70B30329A9FB44D588976E203227F6CB9F889C15BDBCCA5A3",
      "target_text": "아, 맞다. 그…… 고마워.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00135",
      "source_text": "オディール",
      "source_raw_sha256": "9A32E06D50E7B4A1663EEA46065CE26A49748CCE0A4311A9776A8E9114F5FDBC",
      "target_text": "오딜",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00136",
      "source_text": "…………。",
      "source_raw_sha256": "0A0A39A23D968038B6135EB7825A35667F28EF942D728F4925E6018672732E6B",
      "target_text": "………….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00137",
      "source_text": "オディールは僕たちのお礼に対し、ほとんど反応しなかった。^nかすかに|眉[まゆ]を上げただけで、窓の外に向けた視線は動かさない。",
      "source_raw_sha256": "F2B11E7D3F9B2BC55D954C59F3FBE2908A92AFE38CDFA2EE35DAF103D56F954C",
      "target_text": "오딜은 우리의 감사 인사에 거의 반응하지 않았다.^n희미하게 눈썹을 올렸을 뿐, 창밖을 향한 시선은 움직이지 않는다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00138",
      "source_text": "──何か、深く考え込んでいるような印象だった。",
      "source_raw_sha256": "CD1EA237DE930D0006A5369C6369F1D166582F825D6C719609389863095927A9",
      "target_text": "──무언가를 깊이 생각하고 있는 듯한 인상이었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00139",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00140",
      "source_text": "（まあ、いいや。^n　改めて──一体、何があったんだろう）",
      "source_raw_sha256": "B510F37AB11E0AC60B2116BBF63DEEDDA0A5118E8E53A7B91F9EA21DF3AA9177",
      "target_text": "(뭐, 됐어.^n다시 생각해 보면──대체 무슨 일이 있었던 거지)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00141",
      "source_text": "僕はぐるりとキッチンを見渡した。",
      "source_raw_sha256": "70895197002BA3929C5D86A6C279674619C1BAC1733D52CF60DB752A28295D4C",
      "target_text": "나는 주방을 빙 둘러보았다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00142",
      "source_text": "煙の中で騒ぎを聞きながら、なんとなく^n食器や食品がぶちまけられたしっちゃかめっちゃかな光景を^n思い浮かべていたけれど、実際はそこまでではない。",
      "source_raw_sha256": "776D4F4CA4FE35EB22D1F929BE303B06C20865B10A3D99C9BC8832D7967EE77D",
      "target_text": "연기 속에서 소동을 들으며 막연히^n식기와 식재료가 흩뿌려진 엉망진창인 광경을^n떠올렸지만 실제로는 그 정도가 아니다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00143",
      "source_text": "ボウルや|瓶[びん]が落ちた後はあるけれど割れてはいないし、^n|煤[すす]もそれほど散らばってはいない。^nこれなら少し片づければ元に戻るだろう。",
      "source_raw_sha256": "8F18A5E53C4C5AD8DFBB423CC0EC6DE645E663F7D7DF657323D491CFAA62FD55",
      "target_text": "그릇과 병이 떨어진 흔적은 있지만 깨지지 않았고,^n그을음도 그렇게 많이 흩어지지 않았다.^n이 정도면 조금 정리하면 원래대로 돌아갈 것이다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00144",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00145",
      "source_text": "かまどの中から死体が出てきたって、さっき言ってたけど……。",
      "source_raw_sha256": "E06CDC3F717A1208BEE22F4A797B69CA337A67DD70EEAB253277BDD080DE7572",
      "target_text": "화덕 안에서 시체가 나왔다고 아까 말했는데…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00146",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00147",
      "source_text": "え、ええ。そうなの！^nあたし|換気扇[かんきせん]はどこだったかしらって、^nそこのかまどの中を見てみたら──",
      "source_raw_sha256": "E70697D965FCD5AA24879E733EAC2E8FB5F5C51300EBF43037C053BD30021485",
      "target_text": "네, 네. 그랬어요!^n제가 환풍기가 어디였더라 하고,^n저기 화덕 안을 들여다보니──",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00148",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00149",
      "source_text": "く、黒焦げの、人が……。",
      "source_raw_sha256": "BEE18A11960FC89547B948831F4D546010A09D79744D8E32E8F15CE5E07DF5CF",
      "target_text": "새, 새까맣게 탄 사람이…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00150",
      "source_text": "アリスは珍しく言葉を|詰[つ]まらせた。^nかまどを指さしながらも、^nその身体はじりじりと遠ざかろうとしている。",
      "source_raw_sha256": "5C6FA99E66C0C49D0EC6C9AFF50C3FC28F4265643CDAD91C0C32D1F9E542A7D6",
      "target_text": "앨리스는 드물게 말문이 막혔다.^n화덕을 가리키면서도,^n몸은 조금씩 뒤로 물러나려 한다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00151",
      "source_text": "煙が晴れて事態に直面することになったら、^n忘れかけていた恐慌がぶり返してきた──という印象だ。",
      "source_raw_sha256": "1ED86CDEC37FBB0873276B385048EF7FC789797CD7DA302CD297FCBAA3E3BAAF",
      "target_text": "연기가 걷혀 상황과 마주하게 되자,^n잊어 가던 공황이 다시 밀려온 것 같았다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00152",
      "source_text": "アリスよりよほど気が弱いはずのグレーテルが、^nかまどに歩み寄って中を|覗[のぞ]いた。",
      "source_raw_sha256": "8EDC5BE259050AAABB44DE41D304101F0DBEDFB37809AE644BA608B245BA912D",
      "target_text": "앨리스보다 훨씬 겁이 많을 그레텔이,^n화덕으로 다가가 안을 들여다보았다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00153",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00154",
      "source_text": "…………。^nでも、もう何もいないよ。",
      "source_raw_sha256": "A899612C06EF544CC34C19294DF46D47438189618359EAAABD248A6F10B68E5F",
      "target_text": "………….^n그런데 이제 아무도 없어.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00155",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00156",
      "source_text": "え……？　い、いない？^nあたし、この目で見たのよ？",
      "source_raw_sha256": "1427B3D15C3F627BCBBE9C02FDB326956B65E57EC0E3B770A2B22DCD89385395",
      "target_text": "네……? 어, 없다고요?^n저는 이 두 눈으로 봤어요.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00157",
      "source_text": "アリスはかまどに歩み寄りかけたけれど、^n結局は見えない壁に|阻[はば]まれたみたいに足を止めてしまった。",
      "source_raw_sha256": "EEE6220C15D9CA12528851568394A582F70ED2C9FD96B1E44F36E4830F1F8B63",
      "target_text": "앨리스는 화덕으로 다가가려 했지만,^n결국 보이지 않는 벽에 가로막힌 듯 걸음을 멈췄다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00158",
      "source_text": "僕はその肩越しにかまどの中を確かめる。",
      "source_raw_sha256": "CBBFC8EDDC181E51700D2F53A27D1B061D28E728B3B4505956D2C0A41BA165B8",
      "target_text": "나는 그 어깨 너머로 화덕 안을 확인한다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00159",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1134.gsc::slot/00160",
      "source_text": "──うん。何もないよ。",
      "source_raw_sha256": "33E780FF9C1A4BE291E00FCCCC192F2C49E13BE06FB9D0D6F0FDC5345EECE18D",
      "target_text": "──응. 아무것도 없어.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
