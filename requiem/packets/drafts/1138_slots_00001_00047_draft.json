  "review_passes_completed": 0,
  "release_ready": false,
  "entries": [
    {
      "uid": "scr.xfl::1138.gsc::slot/00001",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1138.gsc::slot/00002",
      "source_text": "やあ、グレーテル。気分はどう？",
      "source_raw_sha256": "CE4A20001658F0FCCDE0EF97DF02613E20A80F28F5506861E8B40B8BF68BB7D4",
      "target_text": "안녕, 그레텔. 기분은 어때?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1138.gsc::slot/00003",
      "source_text": "また、半泣きで毛布にくるまって、^nという姿を想像していたけれど、そんなことはなかった。",
      "source_raw_sha256": "B758F91F599A2E4BF4389A49EAFC64FB92BAF415283562FBC07608BA2BCEAA26",
      "target_text": "또 반쯤 울면서 담요를 뒤집어쓴^n모습을 상상했지만, 그러지는 않았다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1138.gsc::slot/00004",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1138.gsc::slot/00005",
      "source_text": "お兄ちゃん……。",
      "source_raw_sha256": "ADE2E9E0D521BBDFA600014C63A61EB4B81B6E794B97CF3AB2D09DD2B3FAE36D",
      "target_text": "오빠…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1138.gsc::slot/00006",
      "source_text": "振り向いて僕の姿を見つけると、^nグレーテルは少しホッとした様子でこちらに寄ってきた。",
      "source_raw_sha256": "01B96B0DDCD1C1D44F09E5DFD5E2027D04C0FA8E7A5B0808C3EFDF4C41F22B4D",
      "target_text": "뒤돌아 내 모습을 발견하자,^n그레텔은 조금 안도한 듯 이쪽으로 다가왔다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1138.gsc::slot/00007",
      "source_text": "顔色はあまりよくないし、^n表情も浮かない感じではあったけれど、^n泣いたり取り乱したりといった気配はない。",
      "source_raw_sha256": "6B5469EB61790EA69BCD9323824221AAD1D5BF2BDC23538D681002DB28784540",
      "target_text": "안색은 그리 좋지 않고,^n표정도 어두워 보였지만,^n울거나 허둥대는 기색은 없다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1138.gsc::slot/00008",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1138.gsc::slot/00009",
      "source_text": "大丈夫？",
      "source_raw_sha256": "2B802D1933EF82E1708918B02271D6095D14E7FE2900D8B65915912E12514BF4",
      "target_text": "괜찮아?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1138.gsc::slot/00010",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1138.gsc::slot/00011",
      "source_text": "……うん。ちょっとだけ怖いけど……。",
      "source_raw_sha256": "8D4E54918B5CC1F7A997211C8BA21688806A96232E567CF588BB70D2B1634595",
      "target_text": "……응. 조금 무섭지만…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1138.gsc::slot/00012",
      "source_text": "　毛布にはくるまらずに、その端を握るだけに止まっている。^n「ちょっとだけ怖い」からだろうか。",
      "source_raw_sha256": "1F0A00FA87D42F2FCC3081CD5B52D94DB47674859CC5193024F9C00EBF98E54C",
      "target_text": "담요를 뒤집어쓰지 않고 끝자락만 쥐는 데 그치고 있다.^n『조금 무서운』 정도라서일까.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1138.gsc::slot/00013",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1138.gsc::slot/00014",
      "source_text": "でも、怖いよりも、不思議って気がするの。^nだから……大丈夫。",
      "source_raw_sha256": "0B74B4937F80A66CDFA8423F162A6AB718B9A37F9CD493FB1C1599B3262A2935",
      "target_text": "그런데 무섭다기보다 이상하다는 느낌이야.^n그러니까…… 괜찮아.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1138.gsc::slot/00015",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1138.gsc::slot/00016",
      "source_text": "不思議？",
      "source_raw_sha256": "CB0A342753511F6032E5A7274318E02F7DD5E13967E70FFAC7F159C2D06775D6",
      "target_text": "이상해?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1138.gsc::slot/00017",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1138.gsc::slot/00018",
      "source_text": "──うん。",
      "source_raw_sha256": "5A69F667698287B451E1519C40F936AFDD70368DB8A6989077336E82F84BA6BF",
      "target_text": "──응.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1138.gsc::slot/00019",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1138.gsc::slot/00020",
      "source_text": "怖いなら無理して思い出さなくてもいいけど、^nあのとき、グレーテルは何か見た？",
      "source_raw_sha256": "CA4E95FF243B68B44C9F871ADC5AC5525B395B8F434AA1155B86DD453B8EEB5D",
      "target_text": "무서우면 억지로 떠올리지 않아도 되지만,^n그때 그레텔은 뭔가 봤어?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1138.gsc::slot/00021",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1138.gsc::slot/00022",
      "source_text": "あのとき……。",
      "source_raw_sha256": "D910FAE01485837B8AE1593077BB4797668982035438E1DC8563AE2549360646",
      "target_text": "그때…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1138.gsc::slot/00023",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1138.gsc::slot/00024",
      "source_text": "かまどから黒焦げ死体が出てきた時。",
      "source_raw_sha256": "6FA5E516C79AAE419A30B8ACEB3BA39E0E620535D919A56BF7EA427076C7FA81",
      "target_text": "화덕에서 새까맣게 탄 시체가 나왔을 때.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1138.gsc::slot/00025",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1138.gsc::slot/00026",
      "source_text": "…………。",
      "source_raw_sha256": "0A0A39A23D968038B6135EB7825A35667F28EF942D728F4925E6018672732E6B",
      "target_text": "………….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1138.gsc::slot/00027",
      "source_text": "グレーテルはそっと目を|逸[そ]らした。^n後ろめたいとか|誤魔化[ごまか]したいとか、そういう気配はなかった。",
      "source_raw_sha256": "E56E23D5EB5101620EAAECFE67F8B19A48DD757548E10F48CF169DE716BE3121",
      "target_text": "그레텔은 살며시 시선을 피했다.^n떳떳하지 못하다거나 얼버무리고 싶다거나 하는 기색은 없었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1138.gsc::slot/00028",
      "source_text": "見たものに、グレーテル自身も戸惑っている。^n何を見たのかわからないから、説明しようがない──^nそんな印象だった。",
      "source_raw_sha256": "2A114AE2DC6F57A3EA39BE94FFD3DFB21582B879E46C9E824B2FFD7BCDF347C3",
      "target_text": "그레텔 자신도 본 것 때문에 당황하고 있다.^n무엇을 봤는지 모르니 설명할 수 없다──^n그런 인상이었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1138.gsc::slot/00029",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1138.gsc::slot/00030",
      "source_text": "（何にしても、教えてくれなさそうだな）",
      "source_raw_sha256": "8A5CEB90A1BD0855E838F7430B0E660375A482213D5554F2529289B921C94E05",
      "target_text": "(어쨌든 말해 줄 것 같지는 않네.)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1138.gsc::slot/00031",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1138.gsc::slot/00032",
      "source_text": "まあ、思ってたより平気そうでよかった。^n今日は早く眠って忘れた方がいいよ。",
      "source_raw_sha256": "D449FE28C4E161C2A2EA8D34FA8D37A5B6D8DE6895AC6599AA51B66E4ADC91A2",
      "target_text": "뭐, 생각보다 괜찮아 보여서 다행이야.^n오늘은 일찍 자고 잊는 편이 좋아.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1138.gsc::slot/00033",
      "source_text": "グレーテルに背を向けて、部屋を出ていこうとしたその時。",
      "source_raw_sha256": "6A64E83A28E7C99AB0336951B049FBBB9CC98240A1E19E578FE36630404BBC3A",
      "target_text": "그레텔에게 등을 돌리고 방을 나서려던 순간.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1138.gsc::slot/00034",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1138.gsc::slot/00035",
      "source_text": "あの……あれは……。^nあれは何だったんだろう。",
      "source_raw_sha256": "6F1B5299814AF17F595EF9BC635032D4695230CC6318E210E7E143655E02AF5F",
      "target_text": "저기…… 그건…….^n그건 뭐였을까.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1138.gsc::slot/00036",
      "source_text": "グレーテルがか細くつぶやくのが聞こえてきた。",
      "source_raw_sha256": "88F5AFEEC976EBB9494FD760ECCFEFF1BC9A00A902AB778E380D670EE2256830",
      "target_text": "그레텔이 가냘프게 중얼거리는 소리가 들렸다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1138.gsc::slot/00037",
      "source_text": "僕は首だけで振り返った。^nグレーテルは|傍[かたわ]らに置いていた人形をたぐり寄せながら^n記憶をたどっている様子だ。",
      "source_raw_sha256": "19BEC88E5350EA18914B988859C0BB81B2CCD50C4AF244C6177E58989F80CC08",
      "target_text": "나는 고개만 돌려 뒤를 보았다.^n그레텔은 곁에 두었던 인형을 끌어당기며^n기억을 더듬는 듯했다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1138.gsc::slot/00038",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1138.gsc::slot/00039",
      "source_text": "わたし……わたしが見たのは……。^n──アリスちゃんとは違うもの。",
      "source_raw_sha256": "4D2E278C28452B4F9AABB8A71AAC020A7997153BEE97C6171010CB60B0036BD5",
      "target_text": "나…… 내가 본 건…….^n──앨리스와는 다른 거야.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1138.gsc::slot/00040",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1138.gsc::slot/00041",
      "source_text": "そうなんだ……。",
      "source_raw_sha256": "C9567662BA00DECA0AE1C62389D08F6A7857D5318AE37BB903AEF1D03CC91942",
      "target_text": "그렇구나…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1138.gsc::slot/00042",
      "source_text": "アリスの見た「黒焦げの人の死体」は見ていない。^nそのかわり、もっと奇妙なものを見た。^nそういうことなんだろうか。",
      "source_raw_sha256": "56C8972C57D3FE667FF62D5CA71BA9778686A9110CDD7551A02D6042CE86BF5F",
      "target_text": "앨리스가 본 『새까맣게 탄 사람의 시체』는 보지 않았다.^n대신 훨씬 기묘한 것을 보았다.^n그런 뜻일까.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1138.gsc::slot/00043",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1138.gsc::slot/00044",
      "source_text": "ありがとう、グレーテル。^nおやすみ。",
      "source_raw_sha256": "18665BDD34DE16FAAE3A566CC6D08989E0AAA4C2CEB0BC7D25858DEEB0E4E824",
      "target_text": "고마워, 그레텔.^n잘 자.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1138.gsc::slot/00045",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1138.gsc::slot/00046",
      "source_text": "…………。",
      "source_raw_sha256": "0A0A39A23D968038B6135EB7825A35667F28EF942D728F4925E6018672732E6B",
      "target_text": "………….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    },
    {
      "uid": "scr.xfl::1138.gsc::slot/00047",
      "source_text": "グレーテルはぬいぐるみの手を握ったまま^n深く考え込んでいる様子で、^n僕の|挨拶[あいさつ]にも反応を返さなかった。",
      "source_raw_sha256": "4235AE92861DAFE05A30BC032FD309E8D72CA71F72CB51E4218576814B54AD20",
      "target_text": "그레텔은 봉제인형의 손을 잡은 채^n깊이 생각에 잠긴 듯,^n내 인사에도 반응하지 않았다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 1차 검수 전"
    }
