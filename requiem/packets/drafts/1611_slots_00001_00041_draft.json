{
  "schema": "fairytale-requiem-translation-map-v1",
  "scope": "1611_slots_00001_00041_draft",
  "semantic_source": "ja-JP",
  "target_language": "ko-KR",
  "target_encoding": "cp949",
  "translation_method": "Codex internal model only; no external MT/API",
  "review_passes_completed": 0,
  "release_ready": false,
  "entries": [
    {
      "uid": "scr.xfl::1611.gsc::slot/00001",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1611.gsc::slot/00002",
      "source_text": "なっ──何をやらせてるの！？^nやめさせないと！！",
      "source_raw_sha256": "AEB10BE441BB61222E5B75055A44010AFA6B1393CA4BC26C8F5676950F9E7D3E",
      "target_text": "무, 무슨 짓을 시키는 거야!?^n당장 그만두게 해야 해!!",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1611.gsc::slot/00003",
      "source_text": "モニターに映ったアリスのあられもない姿を見て、^nゲルダが顔を真っ赤にして部屋を飛び出していった。",
      "source_raw_sha256": "4F4FCB57A26528C88DE6036D11437E367F50A2C6929D2460554734450F1837BC",
      "target_text": "모니터에 비친 앨리스의 알몸이나 다름없는 모습을 보고,^n게르다는 얼굴이 새빨개져 방을 뛰쳐나갔다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1611.gsc::slot/00004",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1611.gsc::slot/00005",
      "source_text": "あっ、待って！　僕も行くよ！！！",
      "source_raw_sha256": "84B4E5783D0AF8844F981D148EB454869AE877120877BC0172C1721C6DCF83F3",
      "target_text": "아, 기다려! 나도 갈게!!!",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1611.gsc::slot/00006",
      "source_text": "僕もゲルダの後を追って駆けだそうとした。",
      "source_raw_sha256": "0A56D2FC1A75F23A1D084CA52E24548112ECE825F4836B52E5B4114F64BE149B",
      "target_text": "나도 게르다의 뒤를 쫓아 달려가려 했다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1611.gsc::slot/00007",
      "source_text": "──と、その時。^n僕は背後に誰かの視線を感じて足を止めた。",
      "source_raw_sha256": "3181FB36C845CCFA6E499474C3D078A821866CCECF7D39FDC926B0AD9F40E6D8",
      "target_text": "──바로 그때.^n나는 등 뒤에서 누군가의 시선을 느끼고 걸음을 멈췄다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1611.gsc::slot/00008",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1611.gsc::slot/00009",
      "source_text": "だ……誰？",
      "source_raw_sha256": "A9011E53A0184659E642EAA2D52F8288AAC61C52E1210AA2CDF4394F5EE2FBC0",
      "target_text": "누…… 누구야?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1611.gsc::slot/00010",
      "source_text": "部屋には僕とゲルダしかいなかった|筈[はず]なのに。^n途中で誰かが入って来た様な気配もなかったのに。",
      "source_raw_sha256": "1C1FE504261A189EC20CE1C58B93BBDC94E03430BE672223DE7B9A0F33581650",
      "target_text": "방에는 나와 게르다밖에 없었을 텐데.^n도중에 누가 들어온 듯한 기척도 없었는데.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1611.gsc::slot/00011",
      "source_text": "振り返ろうとした瞬間、^n|それ[・・]はずっしりと僕の肩に|覆[おお]い|被[かぶ]さってきた！",
      "source_raw_sha256": "DFC6796F97DB2F32B090E87985B09B40FA4A7C727C870C22BDE9CA74F6D25273",
      "target_text": "뒤를 돌아보려는 순간,^n『그것』이 묵직하게 내 어깨를 뒤덮듯 올라탔다!",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1611.gsc::slot/00012",
      "source_text": "荷物を担いだような重さじゃない。^n身体中を見えない何かで縛りつけられたように、それこそ^n指先ひとつに至るまで、まるで身動きが取れなかった。",
      "source_raw_sha256": "400EB157FE82CF986BE785F4170BC8252BA3051699B770BBA359437A15C414E5",
      "target_text": "짐을 짊어진 정도의 무게가 아니다.^n온몸이 보이지 않는 무언가에 묶인 듯,^n손가락 하나까지도 전혀 움직일 수 없었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1611.gsc::slot/00013",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1611.gsc::slot/00014",
      "source_text": "（なにが起きてるんだ……？）",
      "source_raw_sha256": "7AE78D21E2CDE1A8E4D4BCD2018817F6C48281C62C8223F919D413CF1B3E914F",
      "target_text": "(무슨 일이 벌어진 거지……?)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1611.gsc::slot/00015",
      "source_text": "僕はどうにか正体をつきとめようと、^n全力を|傾[かたむ]けて振り返ろうとした。",
      "source_raw_sha256": "85DD6034A2211EE74B5B02B068EFBA9A6ADE78D9C40D03B1F63681F392499C12",
      "target_text": "나는 어떻게든 정체를 알아내려고,^n온 힘을 다해 뒤를 돌아보려 했다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1611.gsc::slot/00016",
      "source_text": "ギリギリと音を立てる人形の首の様に、^n僕の首が僅かに動き出した。",
      "source_raw_sha256": "A0BCA76BD106F195BBEFD202533FFEE6AD1D87EA70F52137695C98CC56AE9367",
      "target_text": "끼익끼익 소리를 내는 인형의 목처럼,^n내 목이 아주 조금 움직이기 시작했다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1611.gsc::slot/00017",
      "source_text": "肩越しに|それ[・・]が見えた。",
      "source_raw_sha256": "0150A33B8773EF6AEBC0F399A2610C358DE44843549BC3203DAB10DD4009491B",
      "target_text": "어깨너머로 『그것』이 보였다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1611.gsc::slot/00018",
      "source_text": "僕",
      "source_raw_sha256": "97C6A5A29BB404B6800D26BD1061E5BAD3B4BE5DF5E6A8C1D181FADFFA70F942",
      "target_text": "나",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1611.gsc::slot/00019",
      "source_text": "…………っ！？",
      "source_raw_sha256": "861FD0B495C5E224943268DBFDB6D93CB28675A8F7A46711122660A4F94F7DB7",
      "target_text": "…………!?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1611.gsc::slot/00020",
      "source_text": "声にならない悲鳴が|喉[のど]の奥で|軋[きし]みを上げた。",
      "source_raw_sha256": "673E66FEF6A236D80B29ABB772C9DD07C7AB8CEC552CE4EBC9926EF5C1E7346E",
      "target_text": "소리도 되지 못한 비명이 목구멍 깊은 곳에서 삐걱거렸다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1611.gsc::slot/00021",
      "source_text": "それは黒を|纏[まと]った少女の青白い顔だった。",
      "source_raw_sha256": "B820B318744793084E1D1E31775DAF1E0B88C5C2C01FBA8AC1071BBD6AB900AB",
      "target_text": "그것은 검은색을 두른 소녀의 창백한 얼굴이었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1611.gsc::slot/00022",
      "source_text": "その少女は、西洋のお葬式に参加する女性が|被[かぶ]る^nベールのような黒い布を顔に|被[かぶ]っていた。",
      "source_raw_sha256": "915D1B27FD244486B65328C8AF6D3553D47DD583377D4124AB8A423D77406FC3",
      "target_text": "그 소녀는 서양식 장례식에 참석한 여자가 쓰는^n베일 같은 검은 천으로 얼굴을 가리고 있었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1611.gsc::slot/00023",
      "source_text": "布？　本当に布なのかも怪しかった。",
      "source_raw_sha256": "63A34E60A6DB613403D20789CEDB249528633E74A826D2CDD11DE7B725FCFE8A",
      "target_text": "천? 정말 천인지조차 의심스러웠다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1611.gsc::slot/00024",
      "source_text": "だってそれは、ゆらゆらと、煙や霧の様に^n定まった形もなく|蠢[うごめ]いていたのだから。",
      "source_raw_sha256": "E403DF72D3C86EAE1462FD5778EA85096743E5587C18BB27F8F3EC9FED4BFDB8",
      "target_text": "그것은 연기나 안개처럼 일렁이며,^n일정한 형태도 없이 꿈틀거리고 있었으니까.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1611.gsc::slot/00025",
      "source_text": "謎めいた黒い少女が僕を抱きしめる。^nやんわりと抱き留めているのに、僕はもう|身動[みじろ]ぎ一つできない。^n彼女から目を背ける事さえも。",
      "source_raw_sha256": "DB625A8FC2E6DF61B1AC643C6947330573DDEF6DC3929A699E152B9EF2CA1A7B",
      "target_text": "수수께끼의 검은 소녀가 나를 끌어안았다.^n부드럽게 감싸 안았는데도 나는 이제 꼼짝도 할 수 없다.^n그녀에게서 눈을 돌리는 것조차.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1611.gsc::slot/00026",
      "source_text": "意識が何かに|覆[おお]われていく。^n羽虫の様に群がって来る「黒」に、僕の意識が|蝕[むしば]まれていく。",
      "source_raw_sha256": "A70AE64BF58A8709B6A4C87C0AD54D272B25CF1F04CFF7AAAEF9FE0BD91CDDC2",
      "target_text": "의식이 무언가에 뒤덮여 간다.^n날벌레처럼 몰려드는 『검정』에 내 의식이 좀먹혀 간다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1611.gsc::slot/00027",
      "source_text": "寒い。骨の奥まで染み渡るくらいに寒い。",
      "source_raw_sha256": "EC8E7B5AAFC331515A547FD2C98493E952FE2A61B65BC177BF7CB81C2C939F8F",
      "target_text": "춥다. 뼛속 깊이 스며들 만큼 춥다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1611.gsc::slot/00028",
      "source_text": "ひどい耳鳴りがする。^nこれは虫の羽音？　カラスの翼の音？^nそれとも打ち捨てられた教会の黒ずんだ破鐘の音？",
      "source_raw_sha256": "4AB4E15E83F61F674053FAC9F835E961BB4FECAABD9B1D8E11F1F2801B75857A",
      "target_text": "지독한 이명이 들린다.^n이건 벌레의 날갯소리인가? 까마귀의 날갯짓인가?^n아니면 버려진 교회의 검게 변한 깨진 종소리인가?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1611.gsc::slot/00029",
      "source_text": "わからない。^nとにかく黒い|雑音[ノイズ]が、僕の意識をかき乱す。",
      "source_raw_sha256": "C941932A0C992152EF23CF9BB08178452390130BA0634A00AEB749908E314FA1",
      "target_text": "모르겠다.^n아무튼 검은 잡음이 내 의식을 휘저었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1611.gsc::slot/00030",
      "source_text": "見えない冷たい手が僕の頭の中をまさぐり、^n|無遠慮[ぶえんりょ]に僕の中をかき回す。",
      "source_raw_sha256": "BB422E04FC4D753869DCD6AE968B7B769F14925598E3BC2B19669E098B34D1B6",
      "target_text": "보이지 않는 차가운 손이 내 머릿속을 헤집으며,^n거리낌 없이 내 안을 마구 휘저었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1611.gsc::slot/00031",
      "source_text": "僕の中に眠った何かを探して、^n|容赦[ようしゃ]なく引っ張り出し、突きつける。",
      "source_raw_sha256": "5973E96D1D565EBA4526C29156AC200413A678F377428BA262FBE900B482E1E9",
      "target_text": "내 안에 잠든 무언가를 찾아,^n가차 없이 끌어내 눈앞에 들이민다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1611.gsc::slot/00032",
      "source_text": "黒い|雑音[ノイズ]は、やがて|哄笑[こうしょう]に変わった。",
      "source_raw_sha256": "F3A387997FBBAB1906306A22377A10381125699AA165077E696088C777A8D674",
      "target_text": "검은 잡음은 이윽고 큰 웃음소리로 변했다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1611.gsc::slot/00033",
      "source_text": "無邪気な子供の邪悪な笑い声。^n良識、節度、思いやりといったものを混ぜっ返し、あざ笑う。",
      "source_raw_sha256": "476F3D177D5DB9A6B7682DDBFD45C63EADACB2C0E678B36B56B6EA874B546950",
      "target_text": "천진한 아이의 사악한 웃음소리.^n상식과 절도, 배려 따위를 마구 뒤섞으며 비웃었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1611.gsc::slot/00034",
      "source_text": "大概のオトナは、やれやれと肩をすくめながら^nやり過ごせば終わると思っている。",
      "source_raw_sha256": "227BDD2B29AD2C2A8EC7FBC60A5767C413194A5E6984370354232C72E776DEA3",
      "target_text": "대부분의 어른은 어쩔 수 없다는 듯 어깨를 으쓱하고^n넘기면 끝날 일이라고 생각한다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1611.gsc::slot/00035",
      "source_text": "子供の反抗期、自意識の芽生え、|或[ある]いは不安定な心の裏返し、^n|寂[さび]しさからの爆発、そんな他愛もないものだと思っている。",
      "source_raw_sha256": "05772D9B2D93821A79FA3472F32D596199D61FE021D0B0FB280BFAF5DC4E69EE",
      "target_text": "아이의 반항기, 자의식의 싹, 혹은 불안정한 마음의 반작용,^n외로움이 폭발한 것뿐인 시시한 일이라고 생각한다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1611.gsc::slot/00036",
      "source_text": "だが、そうじゃない。^nコドモの世界ではそれは凶器だ。爆弾だ。",
      "source_raw_sha256": "59BE07C3B7743BAF77F5F0D4A0A36ED61AB469C51B6F4BC543A9883E3174181B",
      "target_text": "하지만 그렇지 않다.^n아이의 세계에서 그것은 흉기다. 폭탄이다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1611.gsc::slot/00037",
      "source_text": "こいつを叩きのめしたい。でもできない。^n|憤[いきどお]りが生まれては、|諦[あきら]めにかき消されていく。",
      "source_raw_sha256": "16DB65D4503907595291062D077867669CE8126CDCB473E6C550FF05FF862D64",
      "target_text": "이 녀석을 때려눕히고 싶다. 하지만 할 수 없다.^n분노가 태어나도 체념에 휩쓸려 사라진다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1611.gsc::slot/00038",
      "source_text": "やがて、大音響と共に世界にひびが入った。",
      "source_raw_sha256": "5C2FE2E279AA5BD27DF169C9FC5AF1FBEF0FB5ECA68890A6EE12C2700EAF4CFB",
      "target_text": "마침내 굉음과 함께 세계에 금이 갔다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1611.gsc::slot/00039",
      "source_text": "それは鏡に映る僕の鏡像だった。^nそして僕そのものだった。",
      "source_raw_sha256": "B89C3937CB05372F01A20041309EFFA72EC114429465B69E6735E6F21B9C45A6",
      "target_text": "그것은 거울에 비친 나의 모습이었다.^n그리고 나 자신이었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1611.gsc::slot/00040",
      "source_text": "飛び散った破片が僕の目に飛び込んでくる。^n同時に僕が飛び散った無数の世界へと吸い込まれる。",
      "source_raw_sha256": "AC067F39FD455E6C00A4D1CAFCC9EEA03E265E7EB886CC7A51E773EF69A1A5C3",
      "target_text": "튀어 오른 파편이 내 눈으로 날아든다.^n동시에 나는 산산이 흩어진 무수한 세계로 빨려 들어간다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1611.gsc::slot/00041",
      "source_text": "僕は鏡の破片に映った僕の顔が、^n唇の端をゆがめていやらしく笑う様を見た。",
      "source_raw_sha256": "5761587FC088FF5B532A1AD535F13E796E0FEE3EBC2F86A6A058EC3DB78CD5F7",
      "target_text": "나는 거울 파편에 비친 내 얼굴이,^n입가를 비틀어 음흉하게 웃는 모습을 보았다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    }
  ]
}
