  "entries": [
    {
      "uid": "scr.xfl::1812.gsc::slot/00001",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00002",
      "source_text": "──ある日カレンは靴屋の店先で見つけた赤い靴に目を奪われ、^n養い親である老婦人の目を盗んで買ってしまいました。",
      "source_raw_sha256": "E0C0DE701E8F9F27D6BCE9E72CA0BEE21FFC923760D46FF51D57B65009FAFAEC",
      "target_text": "──어느 날 카렌은 구둣가게 앞에서 발견한 빨간 구두에 마음을 빼앗겨,^n양어머니인 노부인의 눈을 피해 사 버렸습니다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00003",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00004",
      "source_text": "カレンはその赤い靴がとても気に入っていたので、^n色のない服で出るべき教会に|履[は]いて行って|窘[たしな]められたり──",
      "source_raw_sha256": "DC96D8DCBE7E8766602194C0DF9F776B515DFC95DBC0CCEE029A755E49586447",
      "target_text": "카렌은 빨간 구두가 무척 마음에 들어,^n수수한 옷차림으로 가야 할 교회에도 신고 갔다가 꾸지람을 듣기도 하고──",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00005",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00006",
      "source_text": "あげくのはてには、老婦人が死の床についているその時に、^n舞踏会に行ってしまう始末。^nひたすら、赤い靴を|履[は]いて|踊[おど]りたいあまりに。",
      "source_raw_sha256": "21A2162379D784C832A1ABED99880A10D3DA429DC9D1F5D8B661459407594806",
      "target_text": "급기야 노부인이 병상에 누워 있을 때,^n무도회에 가 버리고 말았습니다.^n그저 빨간 구두를 신고 춤추고 싶은 마음에.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00007",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00008",
      "source_text": "……うぅ……。",
      "source_raw_sha256": "82AA3AB6AD04747767DFE305CF6B4D1EC3BBA271BF7BB0A33BB66E3761F470E6",
      "target_text": "……으으…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00009",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00010",
      "source_text": "すると不思議なことにカレンの足は勝手に|踊[おど]りつづけ、^n夜も昼も止まらずにカレンを引き回すようになりました。",
      "source_raw_sha256": "2E45174D7604FC25DA97BAD2E12FD4D61A8656FE87F37F58999CF2DC190C8202",
      "target_text": "그러자 기묘하게도 카렌의 발은 제멋대로 계속 춤추며,^n밤낮으로 멈추지 않고 카렌을 끌고 다니기 시작했습니다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00011",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00012",
      "source_text": "彼女が看病しないので、^nそのうちに老婦人も亡くなってしまいました。^nカレンは葬儀にさえ出席できずに、|踊[おど]りながら疲弊していくだけ。",
      "source_raw_sha256": "6BAA5EF84995C2D58CFAF285E06F1E50CECD4669CD1AC3AD414E5C3A84C7FA92",
      "target_text": "그녀가 간호하지 않았기에,^n이윽고 노부인도 세상을 떠나고 말았습니다.^n카렌은 장례식에도 참석하지 못한 채 춤추며 지쳐 갈 뿐이었지요.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00013",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00014",
      "source_text": "彼女はとうとう、首斬り役人にお願いして、^n|踊[おど]りつづける赤い靴を、両の足首ごと切断してもらいました。",
      "source_raw_sha256": "79A0801D9FF4488C28B154428A995F904B84037F120A643B170FF88644871300",
      "target_text": "결국 그녀는 사형 집행인에게 부탁해,^n계속 춤추는 빨간 구두를 양쪽 발목째 잘라 내 달라고 했습니다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00015",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00016",
      "source_text": "ひぃっ……。",
      "source_raw_sha256": "8A297F279040BD6E8D2060E69CB7BC69BDE42F580D91B985FC89FDF86B5D9BAE",
      "target_text": "히익…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00017",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00018",
      "source_text": "すると、切り離された両足と赤い靴は^n|踊[おど]りながらどこかへ行ってしまいました。",
      "source_raw_sha256": "663787E7524BCA73E47318B3D982D100DEB28B7527C9E0C40BB9B6233BA77DB5",
      "target_text": "그러자 잘려 나간 두 발과 빨간 구두는^n춤을 추며 어딘가로 가 버렸습니다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00019",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00020",
      "source_text": "カレンは、それからどうなったの？",
      "source_raw_sha256": "54D7E1E89169D21CC5C55DCDAB5F6310440171B95AC640EAE5719EF2704FDB79",
      "target_text": "카렌은, 그 뒤 어떻게 됐어?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00021",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00022",
      "source_text": "彼女は悔い改めました。^n松葉杖をついて教会へ行き、世のため人のための奉仕を続けました。^nみんな、カレンのことが好きになりました。",
      "source_raw_sha256": "D2BBFD920E509B536BC549027FCFBB4CAA1CEE6A4D70DDF61ABA0151569908D2",
      "target_text": "그녀는 회개했습니다.^n목발을 짚고 교회에 가서 세상과 사람들을 위해 봉사했습니다.^n모두 카렌을 좋아하게 되었습니다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00023",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00024",
      "source_text": "|慎[つつ]ましい暮らし、信心深い心持ち。^nある日、カレンのもとに天使が現れ、罪を赦しました。",
      "source_raw_sha256": "8D20DC12F86FFBBB8E5B31B8314C8A69F74C8A44C166CE3A99F2BAAF1D5E5721",
      "target_text": "검소한 생활과 독실한 마음.^n어느 날 카렌 앞에 천사가 나타나 죄를 용서했습니다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00025",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00026",
      "source_text": "カレンの魂はお日さまの光に乗って神様の|御許[みもと]へ飛んでいきました。^nそして、そこではもう誰も赤い靴のことを口にしませんでした。",
      "source_raw_sha256": "2595ED108BD0476C4457B192B6E929AA3FCBD14621F26F0492DD87DF1619C251",
      "target_text": "카렌의 영혼은 햇빛을 타고 신의 곁으로 날아갔습니다.^n그리고 그곳에서는 아무도 더는 빨간 구두 이야기를 하지 않았습니다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00027",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00028",
      "source_text": "…………。",
      "source_raw_sha256": "0A0A39A23D968038B6135EB7825A35667F28EF942D728F4925E6018672732E6B",
      "target_text": "………….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00029",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00030",
      "source_text": "──おしまい。^nどうだった？　グレーテル。",
      "source_raw_sha256": "03A9535286B70AF20223BE167810DB12DA70F67CADF00A27895216CAF0D4F215",
      "target_text": "──끝.^n어땠어? 그레텔.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00031",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00032",
      "source_text": "う、うん……。^nちょっと怖かった、かな……。",
      "source_raw_sha256": "F58BBED14FCAD5573B6D10248BF654A3B07E7113A9AD95A761F081E0C14BFF09",
      "target_text": "으, 응…….^n조금 무서웠던, 것 같아…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00033",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00034",
      "source_text": "まあ、わりに|陰惨[いんさん]なお話よね。^nいったいどうして、急に「赤い靴」を読んでほしいなんて^n言い出したの？",
      "source_raw_sha256": "A66AB3D869C2B98109CC5C047EF75EB0FBAB9CA9B0A7D4881EF4BE52EAA2414B",
      "target_text": "뭐, 제법 음산한 이야기지.^n그런데 대체 왜 갑자기 『빨간 구두』를 읽어 달라고^n말한 거야?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00035",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00036",
      "source_text": "それは、そのう……。",
      "source_raw_sha256": "062E1E7F1EB299EB2CA345C8BC4DAFC886C879DCA9FCD780E609AE8040849132",
      "target_text": "그게, 그러니까…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00037",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00038",
      "source_text": "……もしかして、最近噂になっていることが気になったの？^nあの、墓地で|踊[おど]っているという赤い靴の怪談──",
      "source_raw_sha256": "B84A544A77B0BF60AE1A6D8791DFB77374ECFE1913E9760CAF73221E11ABC222",
      "target_text": "……혹시 요즘 떠도는 소문이 신경 쓰였어?^n그 묘지에서 춤춘다는 빨간 구두 괴담──",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00039",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00040",
      "source_text": "うぅ……じ、実はね、わたし、見てしまったの。^n誰かが|履[は]いているわけじゃないのに、赤い靴だけが宙に浮いて^nトントン足音を響かせながら|踊[おど]っていたの……！",
      "source_raw_sha256": "CC9DA177945980345853D2D06CF9A9404C3ADA1FFA072FE750AD08BA651830FA",
      "target_text": "으으…… 시, 실은, 나, 보고 말았어.^n누가 신고 있는 것도 아닌데 빨간 구두만 허공에 떠서^n또각또각 발소리를 내며 춤추고 있었어……!",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00041",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00042",
      "source_text": "ほんとだよ、嘘じゃないの……。",
      "source_raw_sha256": "1FA07DAA72C06B3BA4E34AE39000FBA11D9A1D7E8C4A9132AF60A4E0218C0364",
      "target_text": "정말이야, 거짓말 아니야…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00043",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00044",
      "source_text": "ええ、信じるわ。落ち着いて。^n足はついていたの？",
      "source_raw_sha256": "CE97E78907A1768825925C05DF11735E85A85994D4AB8D9946DE67BD1225F56D",
      "target_text": "응, 믿어. 진정해.^n발은 붙어 있었어?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00045",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00046",
      "source_text": "う、ううん。靴だけ。",
      "source_raw_sha256": "F18EE1B339F968639BEF3D327A5AACA3DE34A36F3B0FB32E595A6B31E0A5DFA1",
      "target_text": "으, 으응. 구두뿐이었어.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00047",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00048",
      "source_text": "それなら、「赤い靴」とは少し違うのね。^n原作通りなら、足ごと切断したのだから、^n足と靴のセットで|踊[おど]っていないと忠実とはいえないわ。",
      "source_raw_sha256": "3583C75376C2A67D5B7EF9DD474D54E3E9801A653A3EEF1769C4ED5165FACB2F",
      "target_text": "그렇다면 『빨간 구두』와는 조금 다르네.^n원작대로라면 발째 잘라 냈으니까,^n발과 구두가 한 세트로 춤춰야 충실하다고 할 수 있겠지.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00049",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00050",
      "source_text": "う、うううっ……。",
      "source_raw_sha256": "D8A9021EAE2D50333FCD9976199EE6E21F09B2C95C8A8016B4C45FF4AA932553",
      "target_text": "으, 으으읏…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00051",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00052",
      "source_text": "ああ、ごめんなさい。^n怖がらせるつもりはなかったのよ。",
      "source_raw_sha256": "EE2F585AB50E7E437922A553DF198DC1A4A6D76CCFF3D7A27D2357AB82DDBEE7",
      "target_text": "아아, 미안해.^n겁주려던 건 아니었어.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00053",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00054",
      "source_text": "まあ何にしても、当のカレンは立派に悔い改めて^n天に召されているのよ。^n靴だけ残されていても、|踊[おど]るくらいしかできないんじゃない？",
      "source_raw_sha256": "374101B40CE76F6D0AE58AFCC80A063FE7DE4AF4C01FF213EF6E391634A12587",
      "target_text": "뭐 어쨌든 카렌은 훌륭히 회개해서^n하늘로 불려 갔잖아.^n구두만 남았어도 춤추는 것밖에 못 하지 않겠어?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00055",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00056",
      "source_text": "だからそんなに|怯[おび]えないで。^n墓地へ行かなければ見なくてすむんだから。",
      "source_raw_sha256": "62C41D105D0F91A08DA036B4918D51C83BDA8972090E8D27E6921F6A18350686",
      "target_text": "그러니 그렇게 무서워하지 마.^n묘지에 가지 않으면 볼 일도 없으니까.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00057",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00058",
      "source_text": "う、うん……！^nそ、そうだよね、墓地で見かけたって話ばかりだったし、^nじゃあ、行かなければいいんだよね。",
      "source_raw_sha256": "9DDE00E32D33897B7C7B0D88C9E6FA7AA13C7DCE159807112E3D728DE9A8CABB",
      "target_text": "으, 응……!^n그, 그렇지, 묘지에서 봤다는 이야기뿐이었으니까,^n그럼 가지 않으면 되는 거지.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00059",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    },
    {
      "uid": "scr.xfl::1812.gsc::slot/00060",
      "source_text": "そういうことよ。",
      "source_raw_sha256": "C991474D3934880F6FFD90D565442A08DF9AEB4839BD4D7A342D925E7FA09EA0",
      "target_text": "바로 그거야.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "Initial translation; exactly one review pass pending"
    }
  ]
}
