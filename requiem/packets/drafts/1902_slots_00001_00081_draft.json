  "review_passes_completed": 0,
  "release_ready": false,
  "entries": [
    {
      "uid": "scr.xfl::1902.gsc::slot/00001",
      "source_text": "医者",
      "source_raw_sha256": "1285809FCD66C2F753A0A086F75DD97DED40DD9BB52FBB18B57107E1BC64FB29",
      "target_text": "의사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00002",
      "source_text": "あのね、グレーテルくん……。",
      "source_raw_sha256": "3841FE731E8081D0732A74D5E931AC95ADBD49E814E93E77BD0F48366A209FB7",
      "target_text": "있잖니, 그레텔…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00003",
      "source_text": "それは診察の時間のこと。^n医者はグレーテルに|噛[か]んで含めるように語りかけた。",
      "source_raw_sha256": "DD2B5E7677097E455C259BA52D00A6285DED9C20E5C69A30A41868CA4FD81684",
      "target_text": "진찰 시간이었을 때의 일이다.^n의사는 그레텔이 알아듣도록 차근차근 타일렀다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00004",
      "source_text": "医者",
      "source_raw_sha256": "1285809FCD66C2F753A0A086F75DD97DED40DD9BB52FBB18B57107E1BC64FB29",
      "target_text": "의사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00005",
      "source_text": "おくすりはね、そんなに一度に^nたくさん|摂[と]るものじゃあないんだよ？^n決められた量というものがあるんだ。",
      "source_raw_sha256": "E7D28330D5B70034E3DD1A369451DA0FE810D2AABA4C7A66E900AF25DD0A483D",
      "target_text": "약은 말이다, 한꺼번에 그렇게^n많이 먹는 게 아니란다.^n정해진 양이라는 게 있어.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00006",
      "source_text": "どうやら彼女は診察で処方される甘いお菓子みたいなおくすり、^nカラフルケーキやメディカルチョコを^nもっと欲しいと医者にねだったようだった。",
      "source_raw_sha256": "DE1B82D354215D012EAE3A490A5D07DBB3EE9718E21EB4E683BB4706E36F1F25",
      "target_text": "아무래도 그녀는 진찰 때 처방되는 달콤한 과자 같은 약,^n컬러풀 케이크와 메디컬 초코를^n더 달라고 의사에게 조른 모양이었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00007",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00008",
      "source_text": "う……でも、お、おなかが……。",
      "source_raw_sha256": "67153CF7CA5DF1F85FF760279E333E8FBB684058521D10109FF78490F967D497",
      "target_text": "으…… 하지만 배, 배가…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00009",
      "source_text": "グレーテルはお腹を|掻[か]き|抱[いだ]いて、^n|憐[あわ]れみを誘うように弱々しい声を|絞[しぼ]り出した。",
      "source_raw_sha256": "1617FB6B579BD4AACE67E269C6EAFA2DE68098249F63F54C965144663972D07A",
      "target_text": "그레텔은 배를 감싸 안고,^n동정심을 자아내려는 듯 힘없는 목소리를 짜냈다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00010",
      "source_text": "けれど、医者には仮病などお見通しだった。",
      "source_raw_sha256": "24CED2D0B7C3A8FB5ADF39F8A8F9015F0C97F1A13BEDD841FA8AF41520972973",
      "target_text": "하지만 의사는 꾀병쯤은 훤히 꿰뚫어 보았다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00011",
      "source_text": "医者",
      "source_raw_sha256": "1285809FCD66C2F753A0A086F75DD97DED40DD9BB52FBB18B57107E1BC64FB29",
      "target_text": "의사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00012",
      "source_text": "別段、どこも悪くなさそうだがね。^nおくすりなら、さっきあげたひとつで我慢しておきなさい。",
      "source_raw_sha256": "A339C1A68660EFD40338A2395AFA271A8BB67ABEADA3DDD9845C4D63EE653BCD",
      "target_text": "딱히 어디가 아파 보이지는 않는데.^n약은 아까 준 하나로 만족하렴.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00013",
      "source_text": "|窘[たしな]められたグレーテルはお腹を抱え、^n椅子の上でじたばたと|悶[もだ]えだした。",
      "source_raw_sha256": "287731312AEB4BB41F512E926B436EA417FF4F0A11159388CE139921AE4374B2",
      "target_text": "꾸지람을 들은 그레텔은 배를 움켜안고,^n의자 위에서 버둥거리며 몸부림치기 시작했다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00014",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00015",
      "source_text": "ううう……おなかが、おなかがいたいよう！^nとっても、とっても、いたくなってきたっ！",
      "source_raw_sha256": "AB95E5DB7D97C932B802FD579829A4A4A777810E8B9D2662EC428496F189FB1A",
      "target_text": "으으으…… 배가, 배가 아파요!^n정말, 정말로 아파지기 시작했어요!",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00016",
      "source_text": "医者",
      "source_raw_sha256": "1285809FCD66C2F753A0A086F75DD97DED40DD9BB52FBB18B57107E1BC64FB29",
      "target_text": "의사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00017",
      "source_text": "やれやれ、困ったねぇ……。",
      "source_raw_sha256": "5F5AA889FED863228BF90A774EA5FC4260500219922099F008D1B4CA8C72EBC9",
      "target_text": "이런, 곤란하구나…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00018",
      "source_text": "看護師",
      "source_raw_sha256": "7C9BC55431F0BD999C9CBD3B5F2EF99ACBA567FB9D25297DB2871A3D7DF766FA",
      "target_text": "간호사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00019",
      "source_text": "でも、本当に苦しそうですよ、先生？",
      "source_raw_sha256": "5D25C89DDD9DA174B31B0F22B69CA11B22B0F4E654BD0BD3C11669B12D4ABF0B",
      "target_text": "하지만 정말로 괴로워 보여요, 선생님.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00020",
      "source_text": "グレーテルの見えすいた演技を気の毒そうに見つめて、^n看護師が心配げな声を医者に投げる。",
      "source_raw_sha256": "CADA3EDC48A46A25A58AD203935620E7575322B65B0C58EB026DD5A02FA27886",
      "target_text": "그레텔의 속이 훤히 보이는 연기를 가엾다는 듯 바라보며,^n간호사가 걱정스러운 목소리로 의사에게 말했다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00021",
      "source_text": "しかし彼女の目は何事かを彼に|訴[うった]えかけるように^n底意地の悪い光を浮かべていた。",
      "source_raw_sha256": "3B8C563BAEA46D99E926CD15833BF0D99FB3A720C9AB82F544E21EA46191A7B1",
      "target_text": "하지만 그녀의 눈에는 무언가를 호소하는 듯^n심술궂은 빛이 떠올라 있었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00022",
      "source_text": "医者",
      "source_raw_sha256": "1285809FCD66C2F753A0A086F75DD97DED40DD9BB52FBB18B57107E1BC64FB29",
      "target_text": "의사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00023",
      "source_text": "うむ……ならば、しかたあるまいな。",
      "source_raw_sha256": "AA235A5F369F552FAF91B7D5366253A6701EB0ADCB405BBA7927DE1988E60FC5",
      "target_text": "흠…… 그렇다면 어쩔 수 없겠군.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00024",
      "source_text": "その意を|汲[く]んで、医者は薄笑いを浮かべつつ|頷[うなず]く。^nだが|前屈[まえかが]みでお腹を押さえるグレーテルには見えない。",
      "source_raw_sha256": "B01419CBAC707E124A229C05D31F10F33B51BE0C8E766482B66517BC41EF32D3",
      "target_text": "그 뜻을 알아챈 의사는 엷은 미소를 지으며 고개를 끄덕였다.^n하지만 몸을 숙여 배를 누르는 그레텔에게는 보이지 않았다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00025",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00026",
      "source_text": "（やったぁ！）",
      "source_raw_sha256": "395B0D0B4CC56BE9A7685F9FF3CD32A992F2335D4A8CEE40EF1BB29382424D6B",
      "target_text": "(해냈다!)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00027",
      "source_text": "耳をそばだてていたグレーテルは、^n心の中で勝利のおたけびをあげた。",
      "source_raw_sha256": "6BB9595BFCCDBCBB43B5FE541A72062241BA831EDDBB0A08E0D3D90627E66CDA",
      "target_text": "귀를 기울이던 그레텔은^n마음속으로 승리의 함성을 질렀다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00028",
      "source_text": "──しかし。^n",
      "source_raw_sha256": "05CD95E8729259BA74E2C6F1AB0BF1CC297081CCE4A01FC372B39D2F2D18B3C8",
      "target_text": "──하지만.^n",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00029",
      "source_text": "その喜びもほんの一瞬のことだった。",
      "source_raw_sha256": "18B4791917CAA4927D3BE350150B661A30CD7A49A6C0EAE8CFA9934F4B24F147",
      "target_text": "그 기쁨도 아주 잠깐뿐이었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00030",
      "source_text": "医者",
      "source_raw_sha256": "1285809FCD66C2F753A0A086F75DD97DED40DD9BB52FBB18B57107E1BC64FB29",
      "target_text": "의사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00031",
      "source_text": "それじゃきみ、注射の用意を。^nたくさんおくすりを入れないといけないから、一番太い奴をね。",
      "source_raw_sha256": "477950939109DB8058E5AB90FAA184E5BF51018331A36C35123EE0AE0FC8A43A",
      "target_text": "그럼 자네, 주사를 준비하게.^n약을 많이 넣어야 하니 가장 굵은 걸로.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00032",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00033",
      "source_text": "（えっ……？）",
      "source_raw_sha256": "DA813E02242B10446315FBC41C55F743D0692D1D91991334DCFC97CEF739BE80",
      "target_text": "(네……?)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00034",
      "source_text": "看護師",
      "source_raw_sha256": "7C9BC55431F0BD999C9CBD3B5F2EF99ACBA567FB9D25297DB2871A3D7DF766FA",
      "target_text": "간호사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00035",
      "source_text": "はい、先生。^nとっても痛い奴ですね。",
      "source_raw_sha256": "1332CDEAAD3F0D931E50E652AA5097C1B42985CA9F696844F468ABB3A3F7F5F5",
      "target_text": "네, 선생님.^n아주 아픈 녀석 말이군요.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00036",
      "source_text": "看護師が棚から一抱えもある注射器を持ちだして来た。",
      "source_raw_sha256": "CA967E08A098E88DC213A24821C73DAF29EE23FB1642B92165DAB4139049A776",
      "target_text": "간호사는 선반에서 한 아름이나 되는 주사기를 꺼내 왔다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00037",
      "source_text": "医者",
      "source_raw_sha256": "1285809FCD66C2F753A0A086F75DD97DED40DD9BB52FBB18B57107E1BC64FB29",
      "target_text": "의사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00038",
      "source_text": "そうそう、それだよ。",
      "source_raw_sha256": "C59B3829B9136B346AF9EFDCF8D4CF3A76E9F968479D2A82D6A4B0F0AC96A218",
      "target_text": "그래, 바로 그거야.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00039",
      "source_text": "恐る恐る顔を上げたグレーテルの瞳に、^n極太の注射針がギラリと凶悪な光を投げかける。",
      "source_raw_sha256": "1B1C4C4419836BF05736B6EDA3553B000B7F19060A961CA6A9B3E1159F22CB3C",
      "target_text": "두려워하며 고개를 든 그레텔의 눈동자에,^n엄청나게 굵은 주삿바늘이 번뜩이며 흉악한 빛을 던졌다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00040",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00041",
      "source_text": "（えええええええっ！？）",
      "source_raw_sha256": "574F6E5FC74A7580A3AD127E42A1B2FDCE37FB8D543C2EECABAB3A39BA9A0584",
      "target_text": "(에에에에에에엣!?)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00042",
      "source_text": "グレーテルの顔色が|瞬[またた]く間に青ざめた。^n無論、お腹の痛みからではなく、恐怖のためである。",
      "source_raw_sha256": "B592747426DCC2A5DC7FC50FF09AB8FBE4F7020C86BFE46B39326F14FA3AED99",
      "target_text": "그레텔의 안색이 순식간에 새파래졌다.^n물론 배가 아파서가 아니라 두려움 때문이었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00043",
      "source_text": "その顔色の変化を看護師は見て取って──",
      "source_raw_sha256": "3AA1402CFFC2571BCAD8963E031B602863F96F30FBCC5CB78F4607DF2FFADC0E",
      "target_text": "간호사는 그 안색 변화를 알아차리고──",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00044",
      "source_text": "看護師",
      "source_raw_sha256": "7C9BC55431F0BD999C9CBD3B5F2EF99ACBA567FB9D25297DB2871A3D7DF766FA",
      "target_text": "간호사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00045",
      "source_text": "あら大変、どんどん顔色が悪くなってますわ！^n急がないと！",
      "source_raw_sha256": "736F06C0721DC10FA885723687E9D9C43CF1C105D09F7A3956E2E18A226C0BC6",
      "target_text": "어머, 큰일이에요. 점점 안색이 나빠지고 있어요!^n서둘러야겠어요!",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00046",
      "source_text": "──と、ことさら大袈裟に騒ぎ立てた。",
      "source_raw_sha256": "50822C7693050F768BD10AD250132A7ED858899373530FD5108EE3F735D97E28",
      "target_text": "──하고 일부러 호들갑스럽게 떠들었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00047",
      "source_text": "医者",
      "source_raw_sha256": "1285809FCD66C2F753A0A086F75DD97DED40DD9BB52FBB18B57107E1BC64FB29",
      "target_text": "의사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00048",
      "source_text": "うむ、いかんな。^n注射を打って、それでも駄目なら緊急手術だね。^n手術室を一応仮押さえしておいて。",
      "source_raw_sha256": "D136B11E9363F018DB2EFC97B01942EF70C0CD21F85C671D8A6181013FB3EBDB",
      "target_text": "흠, 안 되겠군.^n주사를 놓고 그래도 낫지 않으면 긴급 수술을 해야겠어.^n일단 수술실을 임시로 잡아 두게.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00049",
      "source_text": "医者も看護師も調子に乗って演技に拍車がかかってくる。",
      "source_raw_sha256": "BBD58A8C0E3869FE5AA737E0FA64D6AD1F40C5303974FD14B9D3B5E697E60CC0",
      "target_text": "의사도 간호사도 신이 나서 연기가 갈수록 심해졌다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00050",
      "source_text": "看護師",
      "source_raw_sha256": "7C9BC55431F0BD999C9CBD3B5F2EF99ACBA567FB9D25297DB2871A3D7DF766FA",
      "target_text": "간호사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00051",
      "source_text": "はい、先生。",
      "source_raw_sha256": "2BDC212E9B28ABCB35B552282A5BB89B1C09AFE792D438DC6B2302773349239C",
      "target_text": "네, 선생님.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00052",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00053",
      "source_text": "（そそそそそんな～～っ！？）",
      "source_raw_sha256": "0D9E3EE0CF692439694444528DF3D86D5299D854C3CC91B6A93E85B2314C1C5F",
      "target_text": "(그그그그럴 수가~~!?)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00054",
      "source_text": "看護師が内線をプッシュし出すのを聞いて、^nグレーテルはたまらず立ち上がった。^nまるでばね仕掛けの|玩具[おもちゃ]のような動きだった。",
      "source_raw_sha256": "4CD06A1E41FCF257C9EA0790AFAE9CF49EC139E30ED6EC6CFD188EC223696A69",
      "target_text": "간호사가 내선 버튼을 누르기 시작하는 소리를 듣자,^n그레텔은 견디지 못하고 벌떡 일어섰다.^n마치 태엽 장난감 같은 움직임이었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00055",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00056",
      "source_text": "せ、せんせい。^nなんだかすっかりよくなったみたいです。",
      "source_raw_sha256": "7A0FCBDAF029AEDEC73B7721B684151ED6A9D8B88B5F4E205D27D791D421C053",
      "target_text": "서, 선생님.^n왠지 완전히 나은 것 같아요.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00057",
      "source_text": "言いつつ出口へじりじりと|後退[こうたい]するグレーテルに、^n医者と看護師は引き留めようとにじり寄る。",
      "source_raw_sha256": "FE5E8585238EA70A02B04F7B04D7D7C63211F716F5A2093B4E527942298597EB",
      "target_text": "말하면서 출구로 슬금슬금 물러나는 그레텔에게,^n의사와 간호사는 붙잡으려는 듯 조금씩 다가갔다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00058",
      "source_text": "医者",
      "source_raw_sha256": "1285809FCD66C2F753A0A086F75DD97DED40DD9BB52FBB18B57107E1BC64FB29",
      "target_text": "의사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00059",
      "source_text": "まぁまぁそういわず。^nまたぶりかえしてもいけないからね。^nお注射くらいは打って行きなさい。",
      "source_raw_sha256": "2BE526C0F942A6A5729439DA8D4625B729B7DF59FABDDAAFFC559DFFBA7AA141",
      "target_text": "자자, 그러지 말고.^n다시 도지면 안 되잖니.^n주사 정도는 맞고 가렴.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00060",
      "source_text": "看護師",
      "source_raw_sha256": "7C9BC55431F0BD999C9CBD3B5F2EF99ACBA567FB9D25297DB2871A3D7DF766FA",
      "target_text": "간호사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00061",
      "source_text": "そうよ、そんな脂汗まで垂らしちゃって。^n無理は良くないわ。",
      "source_raw_sha256": "3B7DE09826DC0AF1DE5A2EDBAA4B63D29B227C72CCCA46B160158D98874B1915",
      "target_text": "그래, 식은땀까지 그렇게 흘리고 있잖아.^n무리하면 안 돼.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00062",
      "source_text": "努めて真剣な顔を演じているが、^n口元は|堪[こら]え切れない笑みで|綻[ほころ]んでいた。",
      "source_raw_sha256": "7DEBAE29028BD65B64FE790C5E132A5269FEF66E70A80D15916D9D0438C791E3",
      "target_text": "애써 진지한 표정을 연기하고 있었지만,^n입가에는 참을 수 없는 웃음이 피어났다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00063",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00064",
      "source_text": "いえいえだいじょうぶですからそれじゃあしつれいしますー！",
      "source_raw_sha256": "C96D93A6AE79B0D015A870A75CCA0A75494E4656D6DD340F4C8788368330BCD0",
      "target_text": "아니에요괜찮으니까그럼이만실례할게요!",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00065",
      "source_text": "医者と看護師の静止を振り切り、^nグレーテルは文字通り脱兎の如く逃げだした。",
      "source_raw_sha256": "700D0781822EEA592095EFA47CC6B53D3031A61AA537F77BE15652359D747BEF",
      "target_text": "의사와 간호사의 제지를 뿌리치고,^n그레텔은 말 그대로 줄행랑을 쳤다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00066",
      "source_text": "グレーテルが退席したのを確認して、^nふたりは押しこらえていた苦笑を解放した。",
      "source_raw_sha256": "B8DDF78230E94703A8720D8C5B871EA77C3A44A55FDACE4A0E4557DD59C11750",
      "target_text": "그레텔이 진찰실을 나간 것을 확인하자,^n두 사람은 억누르던 쓴웃음을 터뜨렸다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00067",
      "source_text": "医者",
      "source_raw_sha256": "1285809FCD66C2F753A0A086F75DD97DED40DD9BB52FBB18B57107E1BC64FB29",
      "target_text": "의사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00068",
      "source_text": "やれやれ。^nまったく、毎度困ったもんだねぇ。",
      "source_raw_sha256": "9C23DCB83310FDC1825A08E5AC2A3CAF30A36470640102F4EDD0056AACBF58E3",
      "target_text": "이런.^n정말 매번 곤란한 아이로군.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00069",
      "source_text": "看護師",
      "source_raw_sha256": "7C9BC55431F0BD999C9CBD3B5F2EF99ACBA567FB9D25297DB2871A3D7DF766FA",
      "target_text": "간호사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00070",
      "source_text": "本当ですね。^nさっきお昼出たばっかりなんですけどね。",
      "source_raw_sha256": "D8E33767EDD0301151CAFF855256AD3B29A33A4F14A8C29EFF485196C5871882",
      "target_text": "그러게요.^n조금 전에 점심을 먹었는데 말이에요.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00071",
      "source_text": "医師はカルテに所見を書き始め、^n看護師は|脅[おど]しで出した注射器を棚に片付け始めた。",
      "source_raw_sha256": "6A541199819531D2F9E359354B6ED700D3C50ECF542349605BDF788A94736A7A",
      "target_text": "의사는 차트에 소견을 적기 시작했고,^n간호사는 겁주려고 꺼낸 주사기를 선반에 정리했다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00072",
      "source_text": "医者",
      "source_raw_sha256": "1285809FCD66C2F753A0A086F75DD97DED40DD9BB52FBB18B57107E1BC64FB29",
      "target_text": "의사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00073",
      "source_text": "しかし、なんだね、^n彼女の腹の虫にはつける薬はないね。",
      "source_raw_sha256": "7C8AA74746C41CBDEFFE49FDF1499C4D98746BC0D35DDFB41C0824C090CFA529",
      "target_text": "하지만 뭐랄까,^n저 아이 뱃속 벌레에는 듣는 약이 없구먼.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00074",
      "source_text": "看護師",
      "source_raw_sha256": "7C9BC55431F0BD999C9CBD3B5F2EF99ACBA567FB9D25297DB2871A3D7DF766FA",
      "target_text": "간호사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00075",
      "source_text": "食事代も馬鹿にならないみたいですしねぇ。",
      "source_raw_sha256": "A3FB8FBEAACEDAA6E2F8F89D47EC71CF6C3FB8133BA2BB5B5B06EB4A32FFB142",
      "target_text": "식비도 만만치 않은 모양이고요.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00076",
      "source_text": "ふたりの苦笑は、そこで|溜息[ためいき]へと変わった。",
      "source_raw_sha256": "EA07F1F78D3558FAA1FCD251032E7A491FD04D73B3BCFF155C35366ADAC43D7E",
      "target_text": "두 사람의 쓴웃음은 그곳에서 한숨으로 바뀌었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00077",
      "source_text": "医者",
      "source_raw_sha256": "1285809FCD66C2F753A0A086F75DD97DED40DD9BB52FBB18B57107E1BC64FB29",
      "target_text": "의사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00078",
      "source_text": "彼女の「聖書」は「はらぺこ青虫」だったかね？",
      "source_raw_sha256": "49F5B38D346DF6A69E902607D100E0D58C1D5A870E6E8DFD4C81701D5A586C76",
      "target_text": "저 아이의 『성서』는 『배고픈 애벌레』였던가?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00079",
      "source_text": "看護師",
      "source_raw_sha256": "7C9BC55431F0BD999C9CBD3B5F2EF99ACBA567FB9D25297DB2871A3D7DF766FA",
      "target_text": "간호사",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00080",
      "source_text": "違ったはずですけど、今度確認してみましょうか？",
      "source_raw_sha256": "A73E9072C53D8A6C128A746BAAB12B67FFCEBE44EE1217E03FF2740D43E6C151",
      "target_text": "아니었던 것 같은데, 다음에 확인해 볼까요?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1902.gsc::slot/00081",
      "source_text": "その考えは、あながち冗談ではないように思われた。",
      "source_raw_sha256": "9EDFC284715FCBB4D7662F681E2E71DA0F97A7230148EA3B0927589FC5F005B7",
      "target_text": "그 생각은 결코 농담만은 아닌 듯했다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    }
  ]
}
