  "review_passes_completed": 0,
  "release_ready": false,
  "entries": [
    {
      "uid": "scr.xfl::1904.gsc::slot/00001",
      "source_text": "ラプンツェル",
      "source_raw_sha256": "A7D1022630570BF73137A5F00E89638087B618CE5FBC41C301A483A64D1158E5",
      "target_text": "라푼젤",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1904.gsc::slot/00002",
      "source_text": "………………。",
      "source_raw_sha256": "6EC763B0F0941B3359F61B3F4928AE6B40657240D39A269A1C34FE6BA980D868",
      "target_text": "……………….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1904.gsc::slot/00003",
      "source_text": "「王子様」の訪れぬ、ひとりきりの夜──",
      "source_raw_sha256": "A96809AA59BBAD5D1CFC63E92937594E2DFCF9868C84C1414E6BB8216D9EF805",
      "target_text": "『왕자님』이 찾아오지 않는, 홀로 지새우는 밤──",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1904.gsc::slot/00004",
      "source_text": "|無聊[ぶりょう]を|託[かこ]つ|囚[とら]われの姫のまなざしは、^nすがるような、あきらめたような、捜しつづけるような、^n痛切な矛盾に満ちて夜空を|彷徨[さまよ]う。",
      "source_raw_sha256": "DB05F12E2CD2F3CF9CEBDFC699BD0D6E6DA5886CD458DE5309FCE2E34835D110",
      "target_text": "무료함을 한탄하는 붙잡힌 공주의 눈길은,^n매달리는 듯, 체념한 듯, 계속 찾아 헤매는 듯,^n애달픈 모순으로 가득한 채 밤하늘을 떠돈다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1904.gsc::slot/00005",
      "source_text": "自らが住まう塔の頂上に|据[す]えられた天体望遠鏡で^n|宇宙[そら]の星々を眺めることを、^n彼女はことのほか愛していた。",
      "source_raw_sha256": "294CCE7406E435697A8B44636CA68F83E29D5FDA598B57520F75DAE231189065",
      "target_text": "자신이 사는 탑 꼭대기에 설치된 천체망원경으로^n우주의 별들을 바라보는 일을,^n그녀는 유난히도 사랑했다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1904.gsc::slot/00006",
      "source_text": "永遠を体現するような無数の星々の|煌[きら]めき。^nけれど、|散華[さんげ]した星のかけらの集う星雲は、^n万物に|永劫[えいごう]不変など決して有り得ぬのだと無言で語る。",
      "source_raw_sha256": "390C0C881EC55B5022A9FC8E38E28C35F050E18D5FF3D2D059FD50B62AA82E9C",
      "target_text": "영원을 구현한 듯한 무수한 별의 반짝임.^n하지만 스러진 별의 조각들이 모인 성운은,^n만물에 영원불변이란 결코 있을 수 없다고 말없이 이야기한다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1904.gsc::slot/00007",
      "source_text": "その反面で|星雲[それ]は新たな|星[いのち]の源でもある。^n悠久の時の中で|遷[うつ]ろいつつ|煌[きら]めく膨大な生命の群──^n彼女は星々の輝きの中に強く「命」を感じるのだった。",
      "source_raw_sha256": "5EC3252AF17A7819F64F1EC3377FAF804195FA7FDBFCD933C54CEE4ABBB51B1A",
      "target_text": "반면 성운은 새로운 별, 곧 생명의 근원이기도 하다.^n유구한 세월 속에서 변해 가며 빛나는 방대한 생명의 무리──^n그녀는 별들의 빛 속에서 강한 『생명』을 느꼈다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1904.gsc::slot/00008",
      "source_text": "ラプンツェルのお話を",
      "source_raw_sha256": "6C8E5F25436BCEF491440AECEC97D9D79827008529436E7AA397A4A08D736AC6",
      "target_text": "라푼젤의 이야기를",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1904.gsc::slot/00009",
      "source_text": "読み終わった。",
      "source_raw_sha256": "1E3154A2BD232B95CC6D7A0E90BC817B157AA62AE648B8C22712923F170C26AD",
      "target_text": "다 읽었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1904.gsc::slot/00010",
      "source_text": "読み終わってない。 ",
      "source_raw_sha256": "A525F90D31EB0CC1374A5D5B61CC96CF1E1152547C522505DB63A7577F896952",
      "target_text": "다 읽지 않았다. ",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1904.gsc::slot/00011",
      "source_text": "ラプンツェル",
      "source_raw_sha256": "A7D1022630570BF73137A5F00E89638087B618CE5FBC41C301A483A64D1158E5",
      "target_text": "라푼젤",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1904.gsc::slot/00012",
      "source_text": "命……。",
      "source_raw_sha256": "1751EB0F5EAD3D992EBFCFC53F7C9B6B06DDC04F541E52817C4C69485FF5AD88",
      "target_text": "생명…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1904.gsc::slot/00013",
      "source_text": "|呟[つぶや]いた瞬間、どくん、と。^nラプンツェルの下腹部が|疼[うず]いた。",
      "source_raw_sha256": "26834E1E91827CE29DBD5EA074255E393F5572A5B8EBD14BE61B9958D3C73C13",
      "target_text": "중얼거린 순간, 두근, 하고.^n라푼젤의 아랫배가 욱신거렸다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1904.gsc::slot/00014",
      "source_text": "両手をそこへ当てると、^n自分ではない「なにか」の温かな感触が|甦[よみがえ]ってくるような──^nそんな錯覚を覚えた。",
      "source_raw_sha256": "57E59CD2F8C979C3078F2A9F5975C9B12A3C4FFDE86AC3F51B2F56D33B75F2B5",
      "target_text": "두 손을 그곳에 대자,^n자신이 아닌 『무언가』의 따뜻한 감촉이 되살아나는 듯한──^n그런 착각이 들었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1904.gsc::slot/00015",
      "source_text": "生まれた命、失われゆく命──^n",
      "source_raw_sha256": "D9EF4B91836150D4583A910ADFD2187D297E4DF1A9182F8636F01D376D2039B5",
      "target_text": "태어난 생명, 사라져 가는 생명──^n",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1904.gsc::slot/00016",
      "source_text": "なぜかそんな言葉が彼女の頭を|過[よ]ぎった。",
      "source_raw_sha256": "B245B4B89DFA4E02853C2BB71E1CB6C586B417FE36D2824337471A32F39559EA",
      "target_text": "어째서인지 그런 말이 그녀의 머리를 스쳤다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1904.gsc::slot/00017",
      "source_text": "ラプンツェル",
      "source_raw_sha256": "A7D1022630570BF73137A5F00E89638087B618CE5FBC41C301A483A64D1158E5",
      "target_text": "라푼젤",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1904.gsc::slot/00018",
      "source_text": "あ……流星……。",
      "source_raw_sha256": "CE57F3000F34E44E7CF82B2F8E5F17A4419A3E1B9713EAEF7314351CE19D8212",
      "target_text": "아……별똥별…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1904.gsc::slot/00019",
      "source_text": "彼女が目にする星雲の近くを、ひと筋の流星が偶然横切った。",
      "source_raw_sha256": "0AE8D7D983C9A3C287571B67C501D80D2897923577B0929326A4E2DBF4F78E97",
      "target_text": "그녀가 바라보는 성운 가까이로 한 줄기 별똥별이 우연히 가로질렀다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1904.gsc::slot/00020",
      "source_text": "瞬くほどの瞬間だけ、現れては消えてゆく|儚[はかな]い「命」──^nそれは自分たち人間の生き様にとても良く似ているように思えた。",
      "source_raw_sha256": "6B906C57C1BEB4ABD4221C0E2C3CE4691DB1C6F62D0434022ACC92B54BE7BB17",
      "target_text": "눈 깜짝할 순간만 나타났다 사라지는 덧없는 『생명』──^n그 모습은 자신들 인간의 삶과 무척 닮았다고 느껴졌다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1904.gsc::slot/00021",
      "source_text": "失われゆく命に、新たに生まれくる命──",
      "source_raw_sha256": "0DFAEF499A1E378EDDBE11EF2A4BE695091CDFEE6741BB4C81965B71D4F8B4AB",
      "target_text": "사라져 가는 생명과, 새로 태어나는 생명──",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1904.gsc::slot/00022",
      "source_text": "やがていつか、自分も命を育むことになるのだろう。^n彼女の|許[もと]を毎夜のように|訪[おと]なう「王子様」との間の子を。",
      "source_raw_sha256": "5472D9023BA825F69AF20B3DB2F0A0BF4461A95A9CEB2FF6B5C935C19FB3C26C",
      "target_text": "언젠가는 자신도 생명을 키우게 되리라.^n밤마다 자신을 찾아오는 『왕자님』과의 사이에서 낳을 아이를.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1904.gsc::slot/00023",
      "source_text": "その予感は祝福のようでもあり、また呪いのようでもある。^n期待と不安という相反するものを彼女に抱かせるのであった。",
      "source_raw_sha256": "8D54F572E994F895BBD058B31E3065F7391EC75901A30510AA3D9F675C04276A",
      "target_text": "그 예감은 축복 같기도 하고, 저주 같기도 하다.^n기대와 불안이라는 상반된 감정을 그녀에게 품게 했다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1904.gsc::slot/00024",
      "source_text": "ただ状況に流され身を捧げるだけの彼女には、^n自ら進んで「それ」を望むという気持ちはない。",
      "source_raw_sha256": "7B6BD0016D217A2BA3F9314DA12681C88C0792AC84D0EE10277569BE2F5E69A2",
      "target_text": "그저 상황에 휩쓸려 몸을 맡길 뿐인 그녀에게는,^n스스로 『그것』을 바라겠다는 마음은 없다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1904.gsc::slot/00025",
      "source_text": "　ただ、彼女の「聖書」に記されているから──^n「いつかそうなるのだろう」という予感だけを頼りに、^n「その時」がやって来るのを|漠然[ばくぜん]と待つのだった。",
      "source_raw_sha256": "D7FDDE0BF7DD0DCBA0D403AF3EF32F2E26F089FED390D2C695FA7EAB6EE25D2C",
      "target_text": "　그저 그녀의 『성서』에 적혀 있기에──^n『언젠가는 그렇게 되겠지』라는 예감에만 의지해,^n『그때』가 찾아오기를 막연히 기다렸다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1904.gsc::slot/00026",
      "source_text": "ラプンツェル",
      "source_raw_sha256": "A7D1022630570BF73137A5F00E89638087B618CE5FBC41C301A483A64D1158E5",
      "target_text": "라푼젤",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1904.gsc::slot/00027",
      "source_text": "やっぱり、今夜はいらっしゃらないみたいね。",
      "source_raw_sha256": "C080DFFA6EF264FD81556A6626E4606994D6CAFA97A630EBA2C19C72CA6A119E",
      "target_text": "역시 오늘 밤은 오시지 않는 모양이네요.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1904.gsc::slot/00028",
      "source_text": "いつの間にか日付が変わっていた。^nこれ程遅くに「王子様」が彼女の許を訪れてきた試しはない。",
      "source_raw_sha256": "12F3E62D5ADC9E895A6BD49FFCE5E91F8BD04B2053F0F7B9F119010D963A50F1",
      "target_text": "어느 틈엔가 날짜가 바뀌어 있었다.^n이렇게 늦은 시각에 『왕자님』이 그녀를 찾아온 적은 없다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1904.gsc::slot/00029",
      "source_text": "ラプンツェル",
      "source_raw_sha256": "A7D1022630570BF73137A5F00E89638087B618CE5FBC41C301A483A64D1158E5",
      "target_text": "라푼젤",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1904.gsc::slot/00030",
      "source_text": "なら、今夜はゆっくり星を眺めていようかしら。",
      "source_raw_sha256": "FE5C10916654E96A14875EC3A6EE16B11B93081B7182743B9B8F454BF4DCAC98",
      "target_text": "그렇다면 오늘 밤은 느긋하게 별을 바라볼까요.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1904.gsc::slot/00031",
      "source_text": "彼女は果てしなく広がる命の海から、^n命の精を自らの中へ取り込もうとでもするかのように、^n飽きることなく星々を眺め、心に刻むのだった。",
      "source_raw_sha256": "2663886D12CE2F2966C64CD782FEEFE539B48ECE70CBAAFB3DC1E9E87C1B0C2C",
      "target_text": "그녀는 끝없이 펼쳐진 생명의 바다에서,^n생명의 정기를 자기 안으로 받아들이기라도 하듯,^n싫증도 내지 않고 별들을 바라보며 마음에 새겼다.",
