{
  "schema": "fairytale-requiem-translation-map-v1",
  "scope": "1905_slots_00001_00049_draft",
  "semantic_source": "ja-JP",
  "target_language": "ko-KR",
  "target_encoding": "cp949",
  "translation_method": "Codex internal model only; no external MT/API",
  "review_passes_completed": 0,
  "release_ready": false,
  "entries": [
    {
      "uid": "scr.xfl::1905.gsc::slot/00001",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1905.gsc::slot/00002",
      "source_text": "こんなところにお墓と教会があったなんて……。",
      "source_raw_sha256": "C2B309FD41DE46627B24259070648B5BFC8E26B90C612E7201C8364F94A9F4CD",
      "target_text": "이런 곳에 묘지와 교회가 있었다니…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1905.gsc::slot/00003",
      "source_text": "野外の探索を進めていたゲルダは、^n森に隣接した敷地の北西の外れに、^n打ち捨てられた墓地と教会を発見した。",
      "source_raw_sha256": "3171EE2390A09686231F461135B505882894BC6B3E54202685C5388C3008F225",
      "target_text": "야외 탐색을 이어 가던 게르다는,^n숲과 맞닿은 부지의 북서쪽 끝에서^n버려진 묘지와 교회를 발견했다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1905.gsc::slot/00004",
      "source_text": "そこにカラスでも群れていたら、^nホラー映画のワンシーンと見間違えるくらいの、^nおどろおどろしい雰囲気を|醸[かも]し出している。",
      "source_raw_sha256": "C86725D074FE7B22256FD6FD97A8C09726130E09B87F6130C1B5594372AA55A8",
      "target_text": "까마귀 떼라도 몰려 있었다면,^n공포 영화의 한 장면으로 착각할 만큼^n으스스한 분위기를 자아내고 있었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1905.gsc::slot/00005",
      "source_text": "ついつい探索に没頭し、そこへ|辿[たど]り着いた時には^nすっかりと陽が落ち切ってしまっており、^nその不気味さをより一層際立たせていた。",
      "source_raw_sha256": "D25A0F7C89469A095831288758A1184CF2C44F5EE8E66E887737445D487BE544",
      "target_text": "탐색에 몰두한 나머지 그곳에 도착했을 때는^n이미 해가 완전히 져 있었고,^n그 때문에 음산함이 한층 더 도드라졌다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1905.gsc::slot/00006",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1905.gsc::slot/00007",
      "source_text": "ずいぶんと傷んでるけど、^nいつから建っているのかしら……？",
      "source_raw_sha256": "47AA351365F3A5170588464256C7E1001E9B950E59B7777B19C8092B11B8F59D",
      "target_text": "상당히 낡았는데,^n언제부터 세워져 있던 걸까……?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1905.gsc::slot/00008",
      "source_text": "墓地の鉄柵の|錆[さ]び具合、教会の外壁の|朽[く]ち果て具合から、^n手を入れなくなって相当の年月が経っていると思われた。",
      "source_raw_sha256": "CFCB35D47041568C85305C538631ED875EC8B27A33D05035A474272FA4E13681",
      "target_text": "묘지 철책의 녹슨 정도와 교회 외벽이 썩어 문드러진 상태를 보면,^n손을 놓은 지 상당한 세월이 흐른 듯했다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1905.gsc::slot/00009",
      "source_text": "赤茶と黒とに埋もれた|陰鬱[いんうつ]な風景の中、^n月光を反射してきらめく物が彼女の目に止まった。",
      "source_raw_sha256": "76E659B6799CC020044AA28E7D52962815429C51A70CBB3C329A0B7641D9E110",
      "target_text": "적갈색과 검은색에 파묻힌 음울한 풍경 속에서,^n달빛을 반사해 반짝이는 무언가가 그녀의 눈에 들어왔다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1905.gsc::slot/00010",
      "source_text": "黒ずんだ歯列に混じった銀歯の如く輝いて^n周囲の景色から浮き上がって見えたのは、^nいくつかの、まだ比較的新しい墓石だった。",
      "source_raw_sha256": "9454ED1789DCD1D311089F308680999748C70CDE11246A8297CFC04FC8FA3B81",
      "target_text": "검게 변한 치열 사이에 박힌 은니처럼 빛나며^n주변 풍경에서 홀로 떠오른 듯 보인 것은,^n아직 비교적 새것인 몇 기의 묘비였다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1905.gsc::slot/00011",
      "source_text": "彼女はその中の一つへと歩み寄る。^n墓標には「Ｉｎｇｈｅｌ」と刻まれていた。",
      "source_raw_sha256": "4EBC26949BCC9659D593D2563B4AD41EA9955D5E7BA109AE2B4404A80BD986B2",
      "target_text": "그녀는 그중 하나로 다가갔다.^n묘표에는 『Inghel』이라고 새겨져 있었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1905.gsc::slot/00012",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1905.gsc::slot/00013",
      "source_text": "インゲル……とでも読むのかしら。^nずいぶんと新しそう。^n墓石に享年は刻まれてない様だけれど。",
      "source_raw_sha256": "91239C64AD7716EEBEE7C400F6BA6753025655988133A222F997D01A6FD25769",
      "target_text": "인겔……이라고 읽는 걸까.^n상당히 새것 같아.^n묘비에는 사망 당시 나이가 새겨져 있지 않은 모양이지만.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1905.gsc::slot/00014",
      "source_text": "墓石には没年や|墓碑銘[ぼひめい]は記載されず、^nただ苗字もない名前のみが刻まれていた。",
      "source_raw_sha256": "B657EB5763B7EF23DE747AC41A7C214E12DBA3276AC445ECD6F1E545B999CCFF",
      "target_text": "묘비에는 사망 연도나 묘비명도 적혀 있지 않고,^n성도 없이 이름 하나만 새겨져 있었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1905.gsc::slot/00015",
      "source_text": "ゲルダは周囲の墓石も見渡してみた。",
      "source_raw_sha256": "5AB329FE28A5B0CEBC8EEB874CE14330CC8C68D4B2AD364FB07A4B566C825AB3",
      "target_text": "게르다는 주변의 묘비도 둘러보았다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1905.gsc::slot/00016",
      "source_text": "シンデレラ、ドロシー、クララ、カレン。^nアリス、グレーテル、オデットとオディールに^nラプンツェルといった、彼女の良く知る名前もあった。",
      "source_raw_sha256": "89F90DF979E384C6297997EF90FF95BB2EB236016836DB93498ACEE79E37FC01",
      "target_text": "신데렐라, 도로시, 클라라, 카렌.^n앨리스, 그레텔, 오데트와 오딜,^n라푼젤처럼 그녀가 잘 아는 이름도 있었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1905.gsc::slot/00017",
      "source_text": "墓石には。いずれもお伽話の登場人物の名が刻まれていた。",
      "source_raw_sha256": "2BCCFDFD3D718416184FBD9C1EAD42F054DFE579D094DA5B403319F37F16F08D",
      "target_text": "어느 묘비에나 동화 속 등장인물의 이름이 새겨져 있었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1905.gsc::slot/00018",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1905.gsc::slot/00019",
      "source_text": "なによ、これ……^nもしかして、これ全部、|お伽話症候群[フェアリーテイル・シンドローム]の患者の──？",
      "source_raw_sha256": "96207DAE1234FC179A6BD87BD0ECFBAD02A6935E35919F3C4BA4D59183C9087A",
      "target_text": "뭐야, 이거……^n설마 이게 전부 『동화 증후군』 환자들의──?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1905.gsc::slot/00020",
      "source_text": "その異様なまでの数に、ゲルダの背筋を|怖気[おぞけ]が走った。",
      "source_raw_sha256": "9DD4418B9015A0F9FFF921E83DAD0AB41AE3063BE65B76BDA888D10CC3EC78C2",
      "target_text": "그 기이할 정도로 많은 수에 게르다의 등골이 오싹해졌다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1905.gsc::slot/00021",
      "source_text": "もしかして「|お伽話症候群[フェアリーテイル・シンドローム]」は、^n不治の、しかも致死性の業病だったのだろうか。",
      "source_raw_sha256": "4E4A3C73F9926385C565EAFEB46FACEBF86672E7CD48FFE398624FA655D2C2F6",
      "target_text": "혹시 『동화 증후군』은^n불치인 데다 목숨까지 앗아 가는 몹쓸 병이었던 걸까.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1905.gsc::slot/00022",
      "source_text": "頭の中身に狂いが生じている、というものではなく、^n肉体をいやらしく|蝕[むしば]んで死にいたらしめる類の──",
      "source_raw_sha256": "09BECE8E610A55C28951EF8E044798BE9BA9B23E1A8EACF249A7D15CF751542B",
      "target_text": "머릿속에 이상이 생기는 정도가 아니라,^n육체를 음습하게 좀먹어 죽음에 이르게 하는 종류의──",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1905.gsc::slot/00023",
      "source_text": "ありえない妄想だと頭を振りながらも、^n息苦しさを覚えた彼女は近くの|墓碑[ぼひ]に手をついた。",
      "source_raw_sha256": "08EEC47893CF60C3975CDDCCE6026A472AC33AEFDCC47BE30360E073BB2BDEA4",
      "target_text": "말도 안 되는 망상이라며 고개를 저으면서도,^n숨이 막힌 그녀는 가까운 묘비에 손을 짚었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1905.gsc::slot/00024",
      "source_text": "……が。^nそこに記されていた名は、より深く強く彼女を打ちのめした。",
      "source_raw_sha256": "C19D4A62177D29BFB4329044C4F9E90B15246E91BDED96F6126B12EA78CBDDF5",
      "target_text": "……하지만.^n그곳에 적힌 이름은 그녀를 더욱 깊고 세게 짓눌렀다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1905.gsc::slot/00025",
      "source_text": "　^n^m──「Ｋａｙ」──",
      "source_raw_sha256": "AA2D861193984559A7D859B6A431DB076144B4826C0AEC212710EBF48A56EA21",
      "target_text": "　^n^m──『Kay』──",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1905.gsc::slot/00026",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1905.gsc::slot/00027",
      "source_text": "カイ──！？",
      "source_raw_sha256": "B728BC8A18C7D0221153D38FFC4A5528CAE017DC98841C378E2092E9887496C9",
      "target_text": "카이──!?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1905.gsc::slot/00028",
      "source_text": "冷たい手で心臓を|鷲掴[わしづか]みにされたような感覚に、^nゲルダの全身が硬直し、呼吸が一瞬止まった。",
      "source_raw_sha256": "24C4821D31B3AF054FB565C9E21D3FB83F698CA21A2DAEF79CBA5510B55A9366",
      "target_text": "차가운 손에 심장을 움켜잡힌 듯한 감각에,^n게르다의 온몸이 굳고 호흡이 순간 멎었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1905.gsc::slot/00029",
      "source_text": "その名は、彼女が持たされた「聖書」──「雪の女王」で、^nヒロインのゲルダが探し求める幼なじみの恋人の名前だった。",
      "source_raw_sha256": "CA449439E8EFFD5F7E6A4A98138F8A3A0E8D51DCE724574EA7C379847172907C",
      "target_text": "그 이름은 그녀가 받은 『성서』──『눈의 여왕』에서,^n주인공 게르다가 찾아 헤매는 소꿉친구이자 연인의 이름이었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1905.gsc::slot/00030",
      "source_text": "酸素を求める脳の指令で心臓がその鼓動を早めるが、^n|濁[にご]った血の循環は、脳と肺とを灼熱で焦がしていく。",
      "source_raw_sha256": "E13FC431C6759D5749990179FE3A344973B02F1CA0338810258DD56F5EE40F78",
      "target_text": "산소를 요구하는 뇌의 명령에 심장이 박동을 재촉하지만,^n탁한 피가 돌며 뇌와 폐를 작열하는 열기로 태워 간다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1905.gsc::slot/00031",
      "source_text": "正気を吹きさらっていく業火と吹雪の中で^n無力に立ち尽くすような思いだった。",
      "source_raw_sha256": "9F428844D563D8C2B14A2DBB745DFDC382E977C7F4C82D8CAEF173C20A885004",
      "target_text": "이성을 날려 버리는 겁화와 눈보라 속에서^n무력하게 서 있기만 하는 듯한 기분이었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1905.gsc::slot/00032",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1905.gsc::slot/00033",
      "source_text": "（お、落ち着いて。^n　これが私の探している人のお墓と決まったわけじゃないわ）",
      "source_raw_sha256": "F061982AB0635A676D629F64F7EC03836117B9A88217DAE5BC840731ED58900F",
      "target_text": "(자, 진정해.^n　이게 내가 찾는 사람의 무덤이라고 정해진 건 아니야)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1905.gsc::slot/00034",
      "source_text": "必死に理性を保とうと、ゲルダはそれに|抗[あらが]った。",
      "source_raw_sha256": "190E27330E39D22F64CD8613B2CF26507320686CAAA02AA689167FA34304154E",
      "target_text": "게르다는 필사적으로 이성을 붙들며 그 감각에 저항했다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1905.gsc::slot/00035",
      "source_text": "ゲルダは、その名前しか刻まれていない墓石から、^n何か手がかりを得ようと、目を皿にして懸命に観察する。",
      "source_raw_sha256": "16DC05E22FCF131B8C0BB27BE068EAAECCA92BC6775B3A565022CBD5CC8417E9",
      "target_text": "이름 하나만 새겨진 묘비에서^n무슨 단서라도 얻으려는 듯, 눈을 부릅뜨고 샅샅이 살폈다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1905.gsc::slot/00036",
      "source_text": "その墓石の汚れ具合や角の|磨滅[まめつ]具合をみると、^nとてもここ数年の物のものとは思えなかった。",
      "source_raw_sha256": "384785D9D1AAF447B905052BA274AF0CDF27F60434BB28C44330943CE24184BD",
      "target_text": "묘비의 때가 낀 정도와 모서리가 닳은 상태를 보면,^n도저히 최근 몇 년 사이에 세워진 것으로는 보이지 않았다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1905.gsc::slot/00037",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1905.gsc::slot/00038",
      "source_text": "──ほら、やっぱり……。^n別の人のお墓じゃない……。",
      "source_raw_sha256": "51E956B21663EAC1549BD5D7FA7114D8A602FA4480CF2B10803231E9590D4277",
      "target_text": "──봐, 역시…….^n다른 사람의 무덤이잖아…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1905.gsc::slot/00039",
      "source_text": "彼女は深い|安堵[あんど]のため息をついた。^n額や首筋にどっと生ぬるい汗が噴き出てきた。",
      "source_raw_sha256": "1A2EE521004872115794145F7B5A849CBB00D17AF528D91C4FE2ACF94D7FF8F4",
      "target_text": "그녀는 안도의 깊은 한숨을 내쉬었다.^n이마와 목덜미에는 미지근한 땀이 한꺼번에 솟았다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1905.gsc::slot/00040",
      "source_text": "その後、よくよく調べてみれば、^nカイの名は他のいくつかの墓石にも刻まれていた。",
      "source_raw_sha256": "81633B7E795C6EF3F0D3A1C8AA7CCAA4720EAFB070CEFFE4F8E16423A3655076",
      "target_text": "그 뒤 자세히 조사해 보니,^n카이의 이름은 다른 여러 묘비에도 새겨져 있었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1905.gsc::slot/00041",
      "source_text": "カイやゲルダばかりではない。^nアリスやその他のお伽話の登場人物の名前も、^n同じ名前で複数の墓石があることがわかった。",
      "source_raw_sha256": "F842A30CFC8FD87968AD8D5C7AFD97145AF59606B1624517BBE2EC12D9CBE5A3",
      "target_text": "카이나 게르다뿐만이 아니었다.^n앨리스와 그 밖의 동화 속 등장인물 이름도,^n같은 이름으로 된 묘비가 여러 기씩 있었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1905.gsc::slot/00042",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1905.gsc::slot/00043",
      "source_text": "ここで幾人のゲルダがカイを探し求め、^nそしてその中の何人が再会を果たせたのかしら……。",
      "source_raw_sha256": "91076C3C25858115779780F9FC3813F6C029C8FE26ACAD2C9F1D68AF885B3BEF",
      "target_text": "여기서 얼마나 많은 게르다가 카이를 찾아 헤맸고,^n그중 몇 명이나 다시 만날 수 있었을까…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1905.gsc::slot/00044",
      "source_text": "無念にも志半ばで倒れた多くのゲルダとカイたちの^n墓石に彼女は|跪[ひざまず]いて祈りを捧げた。",
      "source_raw_sha256": "172DE9BF9D5D19CDFBFCCC648AAF0031EA3486BB515005E4506803C2594DCA3B",
      "target_text": "뜻을 이루지 못한 채 쓰러진 수많은 게르다와 카이의^n묘비 앞에 그녀는 무릎 꿇고 기도를 올렸다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1905.gsc::slot/00045",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1905.gsc::slot/00046",
      "source_text": "お願いです……^nどうか、私が彼を見つけられるように、^nあなたたちの力を貸してしてください。",
      "source_raw_sha256": "829C25619CA671580970A96FA829E5D08B6EA3B89EDAA05E2065A17B2AE342D7",
      "target_text": "부탁드립니다…….^n부디 제가 그를 찾을 수 있도록,^n여러분의 힘을 빌려 주세요.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1905.gsc::slot/00047",
      "source_text": "ゲルダ",
      "source_raw_sha256": "C0B05571F4644C93AB988A304158622DD743480BB45CE77D0BB7E449FEDF70FF",
      "target_text": "게르다",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1905.gsc::slot/00048",
      "source_text": "（たとえ「|お伽話症候群[フェアリーテイル・シンドローム]」が致死性の業病であろうとも。^n　彼に会うまで、倒れるわけにはいかない）",
      "source_raw_sha256": "AA1A878878C798E304CAC64BF011364CE3BF140A9E924F6DA8852ED147F3988E",
      "target_text": "(설령 『동화 증후군』이 목숨을 앗아 가는 몹쓸 병이라 해도.^n　그를 만나기 전에는 쓰러질 수 없어)",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1905.gsc::slot/00049",
      "source_text": "そう決意を新たにして、ゲルダは墓地を立ち去るのだった。",
      "source_raw_sha256": "CFD2AD7EAECDFC195D5B981BD6435E8E069798129AE9301CA77F1C74B260D45E",
      "target_text": "그렇게 결의를 새롭게 다지고, 게르다는 묘지를 떠났다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    }
  ]
}
