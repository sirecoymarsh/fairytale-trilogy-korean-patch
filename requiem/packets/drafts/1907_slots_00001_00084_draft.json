{
  "schema": "fairytale-requiem-translation-map-v1",
  "scope": "1907_slots_00001_00084_draft",
  "semantic_source": "ja-JP",
  "target_language": "ko-KR",
  "target_encoding": "cp949",
  "translation_method": "Codex internal model only; no external MT/API",
  "review_passes_completed": 0,
  "release_ready": false,
  "entries": [
    {
      "uid": "scr.xfl::1907.gsc::slot/00001",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00002",
      "source_text": "──決めたわ。^nお茶会の続きを開きましょう！",
      "source_raw_sha256": "C093C8297043A8FDF05FF7DBCE070E5CF1367B5979B44F25E939234B19AC5204",
      "target_text": "──결정했어.^n다과회를 이어서 열자!",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00003",
      "source_text": "アリスはそんな独り言とともに立ち上がって、^nその後から思った。^n",
      "source_raw_sha256": "D6448907531212A7C66D7700AC87566FC0110A1DC5C46EF890A6CDF381382E30",
      "target_text": "앨리스는 그런 혼잣말과 함께 일어서고 나서,^n뒤늦게 생각했다.^n",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00004",
      "source_text": "──「続き」ってなんだろう？",
      "source_raw_sha256": "A4776BE662FD81CE60B84AE8CAD3F7F828BCF9B2844E939DD2F9DB9CB5EDDD1E",
      "target_text": "──『이어서』라는 게 뭐지?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00005",
      "source_text": "いつでも今日を生きているアリスの中では、^n昨日のことは遠い昔の白昼夢のように薄れ|霞[かす]んで^nすでになかったことになっている。",
      "source_raw_sha256": "9C55EEF222B6D3C643DF0D6CAF96415B683AADB0B6FC51890DAE8E981DC88FB6",
      "target_text": "언제나 오늘을 살아가는 앨리스에게,^n어제 일은 먼 옛날의 한낮 꿈처럼 희미하게 흐려져^n이미 없었던 일이 되어 있었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00006",
      "source_text": "しかし、お茶会が黒焦げ死体のせいでぎくしゃくとして、^n美味しいお茶や甘いお菓子、心地いい風や花の匂いが^n台無しになったことへの不満は胸の奥に消えることはなく──",
      "source_raw_sha256": "CE956225F24839A5D32F3ABB3BD41D4CCADD089C9B2075E960B9268A128BC963",
      "target_text": "하지만 다과회가 새까맣게 탄 시체 때문에 어색해지고,^n맛있는 차와 달콤한 과자, 기분 좋은 바람과 꽃향기까지^n엉망이 된 것에 대한 불만은 가슴속에서 사라지지 않았고──",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00007",
      "source_text": "　自分でもよくわからないままに、^n「いいことを思いついた！」という興奮にのぼせたアリスは、^n　せっせと客人を招く準備にかかった。",
      "source_raw_sha256": "48E3AAC0CA70039B52E93F1271EEE79AA090D626F0ED75B80E60A7C161A972D0",
      "target_text": "　자기도 정확히 모르는 채,^n『좋은 생각이 났어!』라는 흥분에 달아오른 앨리스는,^n　부지런히 손님을 초대할 준비를 시작했다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00008",
      "source_text": "オディール",
      "source_raw_sha256": "9A32E06D50E7B4A1663EEA46065CE26A49748CCE0A4311A9776A8E9114F5FDBC",
      "target_text": "오딜",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00009",
      "source_text": "──で。^nお茶会の続きだっていうから来たのに、^nなんであたししかいないわけ？",
      "source_raw_sha256": "2A7A4AE20D3DF659F50FF9C980247C02F671DA8091585C906184A6CB64451DE8",
      "target_text": "──그래서.^n다과회를 이어서 한다길래 왔는데,^n왜 나밖에 없는 거야?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00010",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00011",
      "source_text": "あら。せっかくだからオデットも^n連れて来てくださってよかったのよ？",
      "source_raw_sha256": "CC61BDFD81D962F16F586008709747E27D2FBE5C50E4ADF0596E9FF4A748B526",
      "target_text": "어머. 모처럼이니 오데트도^n데려오셔도 괜찮았는데요?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00012",
      "source_text": "オディール",
      "source_raw_sha256": "9A32E06D50E7B4A1663EEA46065CE26A49748CCE0A4311A9776A8E9114F5FDBC",
      "target_text": "오딜",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00013",
      "source_text": "あいつは今、白鳥の姿でお昼寝中。^n呼びたいなら夜中に開くことね。",
      "source_raw_sha256": "86B1D92BF5E08A5A338EB9F1690E8CABA6BD1644A845488946612596BDA8AE68",
      "target_text": "그 애는 지금 백조 모습으로 낮잠 중이야.^n부르고 싶으면 한밤중에 열어.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00014",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00015",
      "source_text": "だめよ、それでは正しい^n|お茶会[アフタヌーンティー]の作法じゃないもの。",
      "source_raw_sha256": "0D739E080DC7F88B8115D81E60A5F1A3E88ADF7BAA71BDA0F8E28E2A7C012A33",
      "target_text": "안 돼, 그러면 올바른^n다과회의 예법이 아니잖아.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00016",
      "source_text": "オディール",
      "source_raw_sha256": "9A32E06D50E7B4A1663EEA46065CE26A49748CCE0A4311A9776A8E9114F5FDBC",
      "target_text": "오딜",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00017",
      "source_text": "いいかげんな性格のくせして、^nそういうところはこだわるのね……。",
      "source_raw_sha256": "A211D4A667E5347B728673F5D8AA81D2ACE1C20C715269C7E2AA00727AB80F12",
      "target_text": "되는대로 사는 성격이면서,^n그런 데는 또 깐깐하네…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00018",
      "source_text": "まるで|躾[しつけ]けるようにたしなめられて、オディールはため息をつく。",
      "source_raw_sha256": "76026867567BF346100BB84335D9B142707CCED3BA5AAE33A5B1B1001F61F4F0",
      "target_text": "마치 훈육받듯 꾸지람을 들은 오딜은 한숨을 내쉬었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00019",
      "source_text": "　しかし、以前こんなふうに引っ張られて招待に預かった時は、^n　時間を理由に|拒[こば]むオディールに対し、^n「いつでもお茶の時間！」という主張で押し切っていた気がする。",
      "source_raw_sha256": "D8470B4A389FACCDA6341F52C8DB73A880538CAB43A10E199A2A4E0D049920E1",
      "target_text": "　하지만 예전에 이런 식으로 끌려와 초대받았을 때는,^n　시간을 이유로 거절하는 오딜에게,^n『언제든 차 마실 시간이야!』라는 주장으로 밀어붙였던 것 같다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00020",
      "source_text": "お茶会を開きたいという欲望が先に来て、^nその他のことは後づけなのだろう。^n実にアリスらしい。",
      "source_raw_sha256": "28D6D2C97054B227CB5F2BC4C566FF2E6BD12757B2B6318BD8CF1F4AA23BA652",
      "target_text": "다과회를 열고 싶다는 욕망이 먼저고,^n다른 건 나중에 갖다 붙인 이유일 것이다.^n실로 앨리스다웠다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00021",
      "source_text": "オディール",
      "source_raw_sha256": "9A32E06D50E7B4A1663EEA46065CE26A49748CCE0A4311A9776A8E9114F5FDBC",
      "target_text": "오딜",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00022",
      "source_text": "ラプンツェル……は、ここまで来る訳ないか。^n",
      "source_raw_sha256": "6F25DFA94085609D7A45116C103865FADD0D2E90FC26E7291736D30B0A40397A",
      "target_text": "라푼젤……은 여기까지 올 리 없나.^n",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00023",
      "source_text": "ゲルダはどうしたのよ？",
      "source_raw_sha256": "C36CE8BB563F8951A4133CD1925549C6B961EE55573CDE71F4D19EC3BF07FF25",
      "target_text": "게르다는 어떻게 했어?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00024",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00025",
      "source_text": "ゲルダなら、キッチンでつまみ食いして、^nお茶も入らないくらいお腹がいっぱいなんですって。^n",
      "source_raw_sha256": "9BE2A1B2BA8BBDF77F0F164443915DE6F6C13AA654E8D198FFF6CA06D7CF6D1E",
      "target_text": "게르다는 주방에서 음식을 집어 먹다가,^n차도 못 마실 만큼 배가 불러졌대요.^n",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00026",
      "source_text": "ああ見えて、いやしんぼさんなのね。ふふっ。",
      "source_raw_sha256": "BF7D6FD635D8B423969311245C013657289D05F421482EC27C58F56958DAFD5B",
      "target_text": "그렇게 안 보이는데 욕심쟁이 먹보였네요. 후훗.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00027",
      "source_text": "我慢の効かない幼い妹を微笑ましく思う^n姉のような表情で口元を押さえたが、^nもちろん実際の関係性はその正反対だ。",
      "source_raw_sha256": "462B78FBEEFE4E841B2938CB4BF592FD8D9784588DB856AC51D938ACA3B3BBF2",
      "target_text": "참을성 없는 어린 여동생을 귀엽게 바라보는^n언니 같은 표정으로 입가를 가렸지만,^n물론 실제 관계는 정반대였다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00028",
      "source_text": "いったいどんなやり取りがあったというのだろう。",
      "source_raw_sha256": "87292B8DA9F80D116136AF61BB906A5A7955DD4C4B6B399C0BAB6022CF8F4907",
      "target_text": "대체 어떤 대화가 오갔던 것일까.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00029",
      "source_text": "オディール",
      "source_raw_sha256": "9A32E06D50E7B4A1663EEA46065CE26A49748CCE0A4311A9776A8E9114F5FDBC",
      "target_text": "오딜",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00030",
      "source_text": "じゃあ、あのおチビは？",
      "source_raw_sha256": "D64528357161260BBD0E8862AD04C599FF0B021A1F296DA8E98E6B530A8EE6E1",
      "target_text": "그럼 그 꼬맹이는?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00031",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00032",
      "source_text": "グレーテル？^nそれがどこにも見当たらないのよねぇ。^nどこ行っちゃったのかしら。",
      "source_raw_sha256": "EC4E7D2E787A7DB6E4FF933C1AFEEEAC6393AAB18FB15EAE6D394C989A33C5CC",
      "target_text": "그레텔?^n그게 어디에도 안 보이더라.^n어디로 가 버린 걸까.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00033",
      "source_text": "オディール",
      "source_raw_sha256": "9A32E06D50E7B4A1663EEA46065CE26A49748CCE0A4311A9776A8E9114F5FDBC",
      "target_text": "오딜",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00034",
      "source_text": "なんだかね……。^nふたりじゃお茶会って言うより、ただの|駄弁[だべ]りじゃない。^n",
      "source_raw_sha256": "8190FE2D7CB34F950ED12C7BEB7A90ADEB95B27222646B227C42A29186C009DA",
      "target_text": "뭔가 말이야…….^n둘뿐이면 다과회라기보다 그냥 수다잖아.^n",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00035",
      "source_text": "まあ、|暇[ひま]してたから別にいいけどね。",
      "source_raw_sha256": "5C1158A576861F862E17E1F178526B130A07082A8E13E25505FB6086E7AF7571",
      "target_text": "뭐, 한가했으니 상관없지만.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00036",
      "source_text": "ぶつぶつ言いながらオディールは紅茶をひとすすり。^nそしてテーブルの上のケーキスタンドに手を伸ばす。^nが──",
      "source_raw_sha256": "36ED992543558313C02F0D8F3306DAFD45764550AF34F414E6E333166259FC04",
      "target_text": "투덜거리며 오딜은 홍차를 한 모금 마셨다.^n그러고는 테이블 위 케이크 스탠드로 손을 뻗었다.^n하지만──",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00037",
      "source_text": "オディール",
      "source_raw_sha256": "9A32E06D50E7B4A1663EEA46065CE26A49748CCE0A4311A9776A8E9114F5FDBC",
      "target_text": "오딜",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00038",
      "source_text": "あら？^nあたしのサンドイッチどこいったの？",
      "source_raw_sha256": "BEE46477D20B698FB99D2FC0B773222BEA6B8CD9E34BD56E06AEFA095A7B80D1",
      "target_text": "어라?^n내 샌드위치는 어디 갔어?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00039",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00040",
      "source_text": "知らないわよ。^nあなた、もう食べてしまったのじゃなくて？",
      "source_raw_sha256": "5CC1C0E9CE00905BC3DE534B22E7F4F1031A01EED3FC0F067A1DCB67105C98E5",
      "target_text": "나야 모르죠.^n벌써 다 먹어 버린 것 아니에요?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00041",
      "source_text": "オディール",
      "source_raw_sha256": "9A32E06D50E7B4A1663EEA46065CE26A49748CCE0A4311A9776A8E9114F5FDBC",
      "target_text": "오딜",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00042",
      "source_text": "まだひとつも食べてないわよ。",
      "source_raw_sha256": "12B48F8027D8F29CFC57DC5B707C2E8C8211626A031A63D9A244DDE27DFECB92",
      "target_text": "아직 하나도 안 먹었어.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00043",
      "source_text": "しかしケーキスタンドには、あれほど積んであった^nサンドイッチやスコーンが欠片もなくなっていた。",
      "source_raw_sha256": "9B94D546A9A73F6705C8E3F7E09D1484A0E211E1720A2ADDE4F0B9FA6C352DEA",
      "target_text": "하지만 케이크 스탠드에는 그렇게나 쌓여 있던^n샌드위치와 스콘이 부스러기 하나 없이 사라져 있었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00044",
      "source_text": "オディール",
      "source_raw_sha256": "9A32E06D50E7B4A1663EEA46065CE26A49748CCE0A4311A9776A8E9114F5FDBC",
      "target_text": "오딜",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00045",
      "source_text": "はっ……まさか……！？",
      "source_raw_sha256": "83837C8B9EE9EC77FF50296703377B1C942370015CB393BCBC6D4265C31E7464",
      "target_text": "헉…… 설마……!?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00046",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00047",
      "source_text": "もぐもぐもぐもぐもぐもぐもぐもぐ……。",
      "source_raw_sha256": "1D3F69FB0C5A349347B1B8A81768AAF3367E5E6C0A60C3EF9F3728F64C99204A",
      "target_text": "우물우물우물우물우물우물우물우물…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00048",
      "source_text": "オディールがテーブルクロスをめくると、^nそこにはグレーテルが座り込んで^nせわしなく口を動かしていた。",
      "source_raw_sha256": "AA2562B500DBEDE689B1E93469535C5131E8978EEC049A4E5B5F93D9213F1CAE",
      "target_text": "오딜이 테이블보를 들추자,^n그 아래에는 그레텔이 주저앉아^n쉴 새 없이 입을 움직이고 있었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00049",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00050",
      "source_text": "まぁグレーテル！^nなんてところで食べてるの？^nお|行儀[ぎょうぎ]の悪いことしないのよ！",
      "source_raw_sha256": "D50450B7B0B031EACE2DED3EBC369FAA8A8F24CFF4E22ECB04D7AC9B846076EF",
      "target_text": "어머, 그레텔!^n왜 그런 곳에서 먹고 있는 거야?^n버릇없이 굴면 안 돼!",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00051",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00052",
      "source_text": "もぐ？",
      "source_raw_sha256": "68346B55805EE4FF6143BFB824E5AA7ED9C6CDA0A1C960F555B26AE5DE16DF40",
      "target_text": "우물?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00053",
      "source_text": "口いっぱいに食べ物を頬張ったまま、^nグレーテルは小首を|傾[かし]げた。",
      "source_raw_sha256": "BF1FA48C323BBEC5B2046B1A6CD215719F65787D04D6278901713D01CD87082B",
      "target_text": "입안 가득 음식을 볼이 미어지게 넣은 채,^n그레텔은 고개를 갸웃했다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00054",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00055",
      "source_text": "それにそんな大きくなっちゃって。^nあなた、キノコも盗み食いしたわね？",
      "source_raw_sha256": "951B3ADC8A1F519B76699780AD0E64BDE27DDBE461233A06D64263E11EBDB647",
      "target_text": "게다가 그렇게 커져 버리다니.^n너, 버섯도 몰래 먹었지?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00056",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00057",
      "source_text": "その体でどうやってテーブルの下に^n隠れられるのかしら。ほんと不思議よね。",
      "source_raw_sha256": "920F54FB260C8D506D9960BBB7E13D45B905CEE0DAA5CCC91451513916F884F2",
      "target_text": "그 몸으로 어떻게 테이블 아래에^n숨을 수 있는 걸까. 정말 신기해.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00058",
      "source_text": "アリスの目には小さなテーブルの下に^n巨大なグレーテルがもぐりこんでいるように^n見えているらしかった。",
      "source_raw_sha256": "B73E5DB29DD97B4EE7016CC036D4E1E1A139DA6B24677C8AF93569255F525A28",
      "target_text": "앨리스의 눈에는 작은 테이블 아래에^n거대한 그레텔이 파고들어 있는 것처럼^n보이는 모양이었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00059",
      "source_text": "オディール",
      "source_raw_sha256": "9A32E06D50E7B4A1663EEA46065CE26A49748CCE0A4311A9776A8E9114F5FDBC",
      "target_text": "오딜",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00060",
      "source_text": "いや、別に普通の大きさだし……。^n",
      "source_raw_sha256": "283F697DC06EB11F30D237409A91FC74A3A72A23195818D90921D7A70D58C261",
      "target_text": "아니, 그냥 평범한 크기잖아…….^n",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00061",
      "source_text": "って、今さらあんたに言っても無駄か。",
      "source_raw_sha256": "33871E7662F0429317E20357C0587A9B1D651CE402717386A8589CA658303072",
      "target_text": "뭐, 이제 와서 너한테 말해 봤자 소용없나.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00062",
      "source_text": "オディール",
      "source_raw_sha256": "9A32E06D50E7B4A1663EEA46065CE26A49748CCE0A4311A9776A8E9114F5FDBC",
      "target_text": "오딜",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00063",
      "source_text": "どうてもいいけど、グレーテル！^nあんた、返しなさいよ、あたしのサンドイッチ！",
      "source_raw_sha256": "75EA43584E5F23B3B3D1274B212B1C7E36768DAB4880B6961C5F7A203C84A8FC",
      "target_text": "아무래도 좋지만, 그레텔!^n너, 돌려줘. 내 샌드위치!",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00064",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00065",
      "source_text": "もぎゅもぎゅもぎゅもぎゅもぎゅ……ごっくん。^n",
      "source_raw_sha256": "23F46200590241FC28794C8D3F5F528C6C1B10F85CC168E0F5952D4CE98F5C6C",
      "target_text": "우물우물우물우물우물…… 꿀꺽.^n",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00066",
      "source_text": "……ごちそうさまでした。",
      "source_raw_sha256": "3971946F644870F4209FF9D829BC7A4B76BD8235D7562CCD45C8E39A6066142B",
      "target_text": "……잘 먹었습니다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00067",
      "source_text": "オディール",
      "source_raw_sha256": "9A32E06D50E7B4A1663EEA46065CE26A49748CCE0A4311A9776A8E9114F5FDBC",
      "target_text": "오딜",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00068",
      "source_text": "ご、ごちそうさまじゃないでしょう、^nこの巨大リスもどき！",
      "source_raw_sha256": "D47975FBBABB01125F18042BC766DD6FF4328B86C1B19ECC82CDAAD6BC479DDF",
      "target_text": "자, 잘 먹었습니다가 아니잖아,^n이 거대 다람쥐 비슷한 녀석아!",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00069",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00070",
      "source_text": "いひゃいいひゃいいひゃいいひゃい！",
      "source_raw_sha256": "0FF15226DD5F821D2C97F6EB9BB25E366491E8542DB2F75C53E5CE266C01DA1C",
      "target_text": "아야아야아야아야!",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00071",
      "source_text": "オディールはグレーテルの頬を左右に引っ張ったまま^nテーブルの上に引きずり出し、そのまま持ち上げた。",
      "source_raw_sha256": "68A6102F960F4148D9984D156397F75ABE2EF6B8ABC4688398852C1F0341D47D",
      "target_text": "오딜은 그레텔의 양 볼을 잡아당긴 채^n테이블 위로 끌어낸 뒤 그대로 들어 올렸다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00072",
      "source_text": "オディール",
      "source_raw_sha256": "9A32E06D50E7B4A1663EEA46065CE26A49748CCE0A4311A9776A8E9114F5FDBC",
      "target_text": "오딜",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00073",
      "source_text": "ほんといったいこの身体のどこに消えるのよ^nこのチビっこい身体に！",
      "source_raw_sha256": "BAED16DD7E494DF5169B24024245F1E856D54A8B3A3F580C30C4B871421598D4",
      "target_text": "정말 대체 이 작은 몸 어디로^n그 많은 게 사라지는 거야!",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00074",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00075",
      "source_text": "わあ、すごいわ！^nオディールってばノミみたいに小さいのに力持ちなのね！^nノミが小山を持ち上げてるみたいだわ。",
      "source_raw_sha256": "7975315535BB089B9600A7BF5B8CD66CB1429A4D067DEB81F197460E78619D91",
      "target_text": "와, 굉장해!^n오딜은 벼룩처럼 작은데 힘은 세구나!^n벼룩이 작은 산을 들어 올리는 것 같아.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00076",
      "source_text": "オディール",
      "source_raw_sha256": "9A32E06D50E7B4A1663EEA46065CE26A49748CCE0A4311A9776A8E9114F5FDBC",
      "target_text": "오딜",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00077",
      "source_text": "誰がノミよ、誰が！^nもう、あんたたちと付き合ってるとほんとイライラするわね！",
      "source_raw_sha256": "31EC2C599D2CFC14FEA3D387AC711A4DAAFB2E7AB7631416D61979BF2A74F696",
      "target_text": "누가 벼룩이야, 누가!^n정말, 너희랑 어울리면 진짜 짜증 난다니까!",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00078",
      "source_text": "グレーテル",
      "source_raw_sha256": "0D03C736A9281620601DA4D5F22F2770D5A257C7C331A95EC31CE3668615C438",
      "target_text": "그레텔",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00079",
      "source_text": "おひーるおろひてよぉぉぉ～！",
      "source_raw_sha256": "6AE81280237A625593432AE52822EB356F87A8FC60D160991E7A8576B13C6F4E",
      "target_text": "오디일, 내려 줘어어어~!",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00080",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00081",
      "source_text": "ああ、楽しいわ！^nやっぱりお茶会はこんな風に|賑[にぎ]やかでなくちゃ！",
      "source_raw_sha256": "8C1AD16CA3F87C9EC60A81B7651D21F3B624E6773FA7DA9C2C91F0E52B52A2A3",
      "target_text": "아아, 즐거워!^n역시 다과회는 이렇게 떠들썩해야지!",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00082",
      "source_text": "オディールとグレーテルの繰り広げるドタバタ騒ぎに^nアリスは満足そうに笑った。",
      "source_raw_sha256": "EC635B28E39F5F05D30F4FD9EE8B0F654D6B347D77CFF59FE69FEE3C335E2091",
      "target_text": "오딜과 그레텔이 벌이는 부산스러운 소동을 보며^n앨리스는 만족스럽게 웃었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00083",
      "source_text": "「楽園」の日々は変わらずに進んでいる様に見える。",
      "source_raw_sha256": "3A43083BC254BA510AA9F845BDA084790F6D1E56AB3F07CFFD30E341390349A4",
      "target_text": "『낙원』의 나날은 변함없이 흘러가는 듯 보였다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1907.gsc::slot/00084",
      "source_text": "しかしその裏で──着々と何かが進み始めていることに、^n彼女たちはまだ気づいていない。",
      "source_raw_sha256": "5FC97C4E0280D101814744FDE50E8DC332769E271224C9EED993C71BC0AC9B43",
      "target_text": "하지만 그 뒤에서는── 무언가가 착실히 진행되기 시작했다는 사실을,^n그녀들은 아직 깨닫지 못하고 있었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    }
  ]
}
