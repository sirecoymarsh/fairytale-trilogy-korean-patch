  "semantic_source": "ja-JP",
  "target_language": "ko-KR",
  "target_encoding": "cp949",
  "translation_method": "Codex internal model only; no external MT/API",
  "review_passes_completed": 0,
  "release_ready": false,
  "entries": [
    {
      "uid": "scr.xfl::1908.gsc::slot/00001",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1908.gsc::slot/00002",
      "source_text": "ねぇ、ラプンツェル。^n今日、こちらにグレーテル来なかったかしら？",
      "source_raw_sha256": "A26E512273BC37FBFCC22C40898181526AC77A27F92CA88D8A4D964F06316C88",
      "target_text": "있잖아, 라푼젤.^n오늘 그레텔이 이쪽에 오지 않았어?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1908.gsc::slot/00003",
      "source_text": "ラプンツェルの部屋を訪れたアリスは、^n彼女にしては珍しく|憂鬱[ゆううつ]そうな顔をしていた。",
      "source_raw_sha256": "B395AABF9754BF5ED93AB4FE61CF13480B73B97A8B28AA5C206672FC5157696B",
      "target_text": "라푼젤의 방을 찾아온 앨리스는,^n그녀답지 않게 우울한 표정을 짓고 있었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1908.gsc::slot/00004",
      "source_text": "ラプンツェル",
      "source_raw_sha256": "A7D1022630570BF73137A5F00E89638087B618CE5FBC41C301A483A64D1158E5",
      "target_text": "라푼젤",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1908.gsc::slot/00005",
      "source_text": "いいえ、今日はいらっしゃってないわね。^nどうかなさいましたの？",
      "source_raw_sha256": "E8A53483E79F649278A092A16CE90AA363D3ECA43F43118C9B3FB74D5F0914DB",
      "target_text": "아니요, 오늘은 오시지 않았어요.^n무슨 일이라도 있으신가요?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1908.gsc::slot/00006",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1908.gsc::slot/00007",
      "source_text": "それがね、おかしいのよ。^nお茶会にでも誘おうと思ってたんだけど、^n部屋にもどこにもいないの。",
      "source_raw_sha256": "64D7E4064B08C42D44D854ADA7B291A180A1D437D252911FC0D5AD16D8554B82",
      "target_text": "그게 말이야, 이상해.^n다과회에라도 초대하려 했는데,^n방에도 없고 어디에도 없는 거야.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1908.gsc::slot/00008",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1908.gsc::slot/00009",
      "source_text": "あちこち探したんだけれど。^n三月うさぎさんもウミガメさんも知らないって言うのよ。^n帽子屋さんは、まぁ聞いても無駄だから聞いてないけれど。",
      "source_raw_sha256": "5E0E6DD82F80B9EBE0D433BE4413769BFB849530A09DD827E951452135D9A060",
      "target_text": "여기저기 찾아봤거든.^n3월 토끼 씨도 바다거북 씨도 모른다는 거야.^n모자 장수는, 뭐, 물어봤자 소용없으니 안 물어봤지만.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1908.gsc::slot/00010",
      "source_text": "アリスは小首を|傾[かし]げ、|溜息[ためいき]をついた。^nオディールやオデットにも聞いたが、^nやはり見かけてはいないのだという。",
      "source_raw_sha256": "26FA09535E26E458BD571887A00AEDD4A07C4E0D993EAFBFF0B18BDD3F206572",
      "target_text": "앨리스는 고개를 갸웃하고 한숨을 내쉬었다.^n오딜과 오데트에게도 물었지만,^n역시 본 적이 없다고 했다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1908.gsc::slot/00011",
      "source_text": "ラプンツェル",
      "source_raw_sha256": "A7D1022630570BF73137A5F00E89638087B618CE5FBC41C301A483A64D1158E5",
      "target_text": "라푼젤",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1908.gsc::slot/00012",
      "source_text": "まぁ……それは心配ね。^nいったいどうかなさったのかしら……。",
      "source_raw_sha256": "16D80293919C7376FA515EB0B2B6D424252B74D4810A09F66A230055880309A6",
      "target_text": "어머…… 그건 걱정이네요.^n대체 무슨 일이 있으신 걸까요…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1908.gsc::slot/00013",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1908.gsc::slot/00014",
      "source_text": "あたし、いやな予感がするわ……。^n彼女、このまま帰ってこないんじゃないかしら。",
      "source_raw_sha256": "7B10E611644C92E33410C828B0622BB94B6888FBA1B7C6D0D28FCFBF38ADACD4",
      "target_text": "나, 불길한 예감이 들어…….^n그 애, 이대로 돌아오지 않는 건 아닐까.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1908.gsc::slot/00015",
      "source_text": "星々がさんざめくようなアリスの瞳が、^n雨雲にでも|覆[おお]われたかの様に、にわかにかき|曇[くも]る。",
      "source_raw_sha256": "1EDCD686D7F384EFF77835F1404C0D590A1644D3BE59E41F4FE9A80E521A6C27",
      "target_text": "별들이 반짝이는 듯하던 앨리스의 눈동자가,^n비구름에라도 뒤덮인 것처럼 갑자기 흐려졌다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1908.gsc::slot/00016",
      "source_text": "ラプンツェル",
      "source_raw_sha256": "A7D1022630570BF73137A5F00E89638087B618CE5FBC41C301A483A64D1158E5",
      "target_text": "라푼젤",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1908.gsc::slot/00017",
      "source_text": "そんな……考え過ぎじゃないかしら。",
      "source_raw_sha256": "73CE31545FB77EFADBDF77B01096076E19DC6F04ED3ABB5122CEA9D7D02A76D0",
      "target_text": "설마요…… 너무 걱정하시는 것 아닐까요.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1908.gsc::slot/00018",
      "source_text": "この時のラプンツェルは、まださほど、^n事態を深刻に受け止めてはいなかったが──",
      "source_raw_sha256": "D78C2D8489434BEA2195EBCAA9A5FBAF30F7A0DC310FAE01CDE030CB862E552C",
      "target_text": "이때의 라푼젤은 아직 그리 심각하게^n사태를 받아들이지는 않았지만──",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1908.gsc::slot/00019",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1908.gsc::slot/00020",
      "source_text": "でも、ゲルダもいなくなっちゃったでしょ？^nお部屋も片付けられちゃったみたい。^nまるでインゲルやドロシーの時みたいだわ。",
      "source_raw_sha256": "890438D76FCBCABE8AF5E0853850C6F12F397F00CE3CF1BEFDF6A3D10CC50D1D",
      "target_text": "하지만 게르다도 사라졌잖아?^n방도 정리된 모양이야.^n마치 인겔이나 도로시 때처럼.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1908.gsc::slot/00021",
      "source_text": "ラプンツェル",
      "source_raw_sha256": "A7D1022630570BF73137A5F00E89638087B618CE5FBC41C301A483A64D1158E5",
      "target_text": "라푼젤",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1908.gsc::slot/00022",
      "source_text": "そうなのですか？^nわたくし、この部屋からあまり出ませんから……。^nそれは存じませんでしたわ。",
      "source_raw_sha256": "DF751431DDD38950CFFBC29B41A25DD35301D8E1066F703DBABAA3B770A1EBB7",
      "target_text": "그런가요?^n저는 이 방에서 거의 나가지 않으니까요…….^n그건 몰랐어요.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1908.gsc::slot/00023",
      "source_text": "──彼女たちの聖書にあわせて作られた^nその居室までが片付けられていると聞いて、^nどうやら事態がただごとではないと察したようだ。",
      "source_raw_sha256": "E9E2868620C50A83BDC1AD5E20EE35799B2AE75C22BE0D49746FC87CDD58D5AE",
      "target_text": "──그녀들의 성서에 맞춰 만들어진^n개인실마저 정리되었다는 말을 듣고,^n아무래도 심상치 않은 일임을 눈치챈 모양이다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1908.gsc::slot/00024",
      "source_text": "フードの中のラプンツェルの容色も、^n雲間の月明かりの如くに|翳[かげ]り出す。",
      "source_raw_sha256": "FEAABF7BE528476BC60C7D97DF136D02BCE5BA2D12AE6F01EDF323361E7F22FF",
      "target_text": "후드 속 라푼젤의 아름다운 얼굴에도,^n구름 사이의 달빛처럼 그늘이 드리우기 시작했다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1908.gsc::slot/00025",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1908.gsc::slot/00026",
      "source_text": "なんだか、この「楽園」も^n随分とさみしくなっちゃったわね……。",
      "source_raw_sha256": "5D82606A2E535DF2AF3D2F639ADE0C04F54B03B54BEA7A6DBAB89EF3638CDF11",
      "target_text": "어쩐지 이 『낙원』도^n상당히 쓸쓸해졌네…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1908.gsc::slot/00027",
      "source_text": "ラプンツェル",
      "source_raw_sha256": "A7D1022630570BF73137A5F00E89638087B618CE5FBC41C301A483A64D1158E5",
      "target_text": "라푼젤",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1908.gsc::slot/00028",
      "source_text": "そう……ですわね……。",
      "source_raw_sha256": "9157EB4DD08965AB8EBFC91A995DBBDBA65834B7C8AB57E8B4C6053C46370E3F",
      "target_text": "그러게…… 말이에요…….",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1908.gsc::slot/00029",
      "source_text": "深刻そうに|項垂[うなだ]れていたふたりであったが、^nしばしして、壁かけ時計がその刻を告げると、^nラプンツェルが申し訳ないような顔で口を開いた。",
      "source_raw_sha256": "1AB7FEE06BBC93351DBA5800EF3DE77AEEE554EEEA8D8F750792579470CCF8FF",
      "target_text": "심각한 표정으로 고개를 떨구던 두 사람이었지만,^n잠시 뒤 벽시계가 시간을 알리자,^n라푼젤이 미안한 표정으로 입을 열었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1908.gsc::slot/00030",
      "source_text": "ラプンツェル",
      "source_raw_sha256": "A7D1022630570BF73137A5F00E89638087B618CE5FBC41C301A483A64D1158E5",
      "target_text": "라푼젤",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1908.gsc::slot/00031",
      "source_text": "あら、いけない。^n",
      "source_raw_sha256": "F25A84E88308C31EFE6CEDFB7685624220AF2446D11D2CEF39D8C016BDF656D8",
      "target_text": "어머, 이런.^n",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1908.gsc::slot/00032",
      "source_text": "あ、あの、アリス。^n申し訳ないのですけど、今日はそろそろ──",
      "source_raw_sha256": "62B23DDE16DDE9490FFF872EAA6C83947C85AC26EE7236E50976C1BD0B3243B2",
      "target_text": "저, 저기, 앨리스.^n미안하지만 오늘은 이제 슬슬──",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1908.gsc::slot/00033",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1908.gsc::slot/00034",
      "source_text": "えっ？　ああ！^n",
      "source_raw_sha256": "B8DA53E4BCE8CB16F4B09B465417A21F0CB80CF9990082DA3ADF0FD903E26BA0",
      "target_text": "응?　아!^n",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1908.gsc::slot/00035",
      "source_text": "もしかして、王子様が来る時間？",
      "source_raw_sha256": "F5AE5DFB2D5485CC43BD9A428BE7B37A6EA117225A51693B0F725FB69233CC48",
      "target_text": "혹시 왕자님이 오실 시간이야?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1908.gsc::slot/00036",
      "source_text": "いつの間にかラプンツェルの秘密をかぎつけていた^nアリスが、訳知り顔で微笑んだ。",
      "source_raw_sha256": "4C1111128ECDDA4174CF146139061CC7AE203C8E846992BF34466EB381D79B9D",
      "target_text": "어느새 라푼젤의 비밀을 알아챈 앨리스가^n다 안다는 듯 미소 지었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1908.gsc::slot/00037",
      "source_text": "先程まで見せていた|憂[うれ]い顔は幻のように消し飛んでいた。",
      "source_raw_sha256": "5C6885EC047F0D9376B92384FD580DC48605E9AFD8CDB1AE0CE118822E860878",
      "target_text": "조금 전까지 보이던 근심 어린 얼굴은 환상처럼 사라져 버렸다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1908.gsc::slot/00038",
      "source_text": "ラプンツェル",
      "source_raw_sha256": "A7D1022630570BF73137A5F00E89638087B618CE5FBC41C301A483A64D1158E5",
      "target_text": "라푼젤",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1908.gsc::slot/00039",
      "source_text": "ええ、そうなの……ごめんなさいね。^n最近、ことのほか頻繁にお通いなの。",
      "source_raw_sha256": "B21C4E8BFA57FA46D934F8ECAA48D5A928C5D2B11CF3FA6B7CFFF5AA9D9A9B98",
      "target_text": "네, 그래요…… 미안해요.^n요즘은 유난히 자주 들르셔서요.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1908.gsc::slot/00040",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1908.gsc::slot/00041",
      "source_text": "相変わらずお熱い事ね。^n|妬[や]けちゃうわ。",
      "source_raw_sha256": "2A38B84AB40E24CD4AC50C3FBEB30D2C61199EC062437E581434A0A5064CDC29",
      "target_text": "여전히 뜨겁네.^n질투 나겠어.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1908.gsc::slot/00042",
      "source_text": "口笛でも吹きだしそうな調子のアリスの冷やかしに、^nラプンツェルは|恥[は]ずかしげに目を伏せるが、^n朱に染まったその顔は満更でもなさそうであった。",
      "source_raw_sha256": "417E50F5F2ECC0D5BE8E0FC8AA98CBA61372BF6EE5DC5453515426ABB44A9FCA",
      "target_text": "휘파람이라도 불 듯한 앨리스의 놀림에,^n라푼젤은 부끄러운 듯 눈을 내리깔았지만,^n붉게 물든 얼굴은 마냥 싫지만도 않은 모양이었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1908.gsc::slot/00043",
      "source_text": "アリス",
      "source_raw_sha256": "3FC13A62286D75D204D547042279E5A94241319D14D585FA6F4057DFB77CFEAC",
      "target_text": "앨리스",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1908.gsc::slot/00044",
      "source_text": "わたしもそろそろ、^nおくすり飲みに戻ろうかしら。^n芋虫さん、今晩も来るかしら？",
      "source_raw_sha256": "3B20E615FDCF202D1887B9E75E352F9173CCCB63650F5588969B6D508C2375AF",
      "target_text": "나도 슬슬^n약을 먹으러 돌아갈까.^n애벌레 씨, 오늘 밤에도 오려나?",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1908.gsc::slot/00045",
      "source_text": "|櫛[くし]の歯が抜けるように仲間の姿が消えても尚、^n残ったふたりの少女は無邪気な笑顔で語り合った。",
      "source_raw_sha256": "767AA3E8393A3A622381AACD51B0AB4A1E3D867CCB5A53BE0A60F4AAF083BCC9",
      "target_text": "빗살이 빠지듯 동료들의 모습이 사라지고 있는데도,^n남은 두 소녀는 천진한 미소로 이야기를 나누었다.",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    },
    {
      "uid": "scr.xfl::1908.gsc::slot/00046",
      "source_text": "偽りの「楽園」の夜は、|今宵[こよい]も更けてゆく──",
      "source_raw_sha256": "53019E8355004980C05A83E10230F1EF92ED9DD87182D70C29DA02A98CB93943",
      "target_text": "거짓된 『낙원』의 밤은 오늘도 깊어 간다──",
      "translator": "Codex internal model draft",
      "review_status": "draft_pending_single_review",
      "notes": "초벌 번역; 정확히 1회 검수 대기"
    }
  ]
}
